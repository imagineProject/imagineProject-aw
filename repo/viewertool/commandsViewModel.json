{
  "commands": {},
  "commandHandlers": {
    "viewerOptionsCommandHandler": {
      "id": "Awv0ViewerSettings",
      "action": "showViewerOptionsPanel",
      "activeWhen": {
        "condition": "conditions.viewerSettingPanelOutside3DTab"
      },
      "visibleWhen": {
        "condition": "conditions.viewerSettingPanelOutside3DTab"
      },
      "enableWhen": {
        "condition": "conditions.viewerSettingPanelOutside3DTab"
      }
    }
  },
  "commandPlacements": {
    "viewerOptionsCommandPlacement": {
      "id": "Awv0ViewerSettings",
      "parentGroupId": "Awp0ViewGroup",
      "priority": 500
    }
  },
  "actions": {
    "showViewerOptionsPanel": {
      "actionType": "JSFunction",
      "method": "activateViewerCommandDialog",
      "deps": "js/viewerContext.service",
      "inputData": {
        "commandId": "Awv0ViewerSettings",
        "context": "{{commandContext}}"
      }
    }
  },
  "conditions": {
    "viewerSettingPanelOutside3DTab": {
      "expression": "conditions.isACESublocation && ((conditions.isStructureViewerInSecondaryTabId && !conditions.isAltPwaAvailable && !commandContext.occmgmtContext) || conditions.isStructureViewerInaltPwaViews)"
    },
    "isACESublocation": {
      "expression": "ctx.sublocation.nameToken==='com.siemens.splm.client.occmgmt:OccurrenceManagementSubLocation'"
    },
    "isStructureViewerInSecondaryTabId": {
      "expression": "commandContext.pageContext && commandContext.pageContext.secondaryActiveTabId && commandContext.pageContext.secondaryActiveTabId !== 'Awv0StructureViewerPageContainer'"
    },
    "isAltPwaAvailable": {
      "expression": "commandContext.occContext && commandContext.occContext.currentState && commandContext.occContext.currentState.altPwa"
    },
    "isStructureViewerInaltPwaViews": {
      "expression": "conditions.isAltPwaAvailable && commandContext.occContext.currentState.altPwa !== 'Awv0StructureViewerPageContainer'"
    }
  },
  "i18n": {}
}
