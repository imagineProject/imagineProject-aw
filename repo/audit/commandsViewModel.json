{
  "commands": {},
  "commandHandlers": {
    "auditLogStartEditSummaryHandler": {
      "id": "Awp0StartEditSummary",
      "activeWhen": {
        "condition": "conditions.AuditLogPageStartEditSummaryCondition"
      },
      "visibleWhen": false
    },
    "auditLogAwp0StartEditCommandHandler": {
      "id": "Awp0StartEdit",
      "activeWhen": {
        "condition": "conditions.AuditLogPageStartEditCondition"
      },
      "visibleWhen": false
    },
    "auditLogAwp0NewGroupHandler": {
      "id": "Awp0NewGroup",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelected"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditLogAwp0EditGroupHandler": {
      "id": "Awp0EditGroup",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelected"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditLogAwp0ManageGroupHandler": {
      "id": "Awp0ManageGroup",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelected"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditLogAwp0ShareGroupHandler": {
      "id": "Awp0ShareGroup",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelected"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditLogAwp0ViewGroupHandler": {
      "id": "Awp0ViewGroup",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelected"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditLogAwp0CutCommandHandler": {
      "id": "Awp0Cut",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelected"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditLogOpenInIllustratorCommandHandler": {
      "id": "openInIllustrator",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelected"
      },
      "visibleWhen": false
    },
    "auditLogAwp0CopyCommandHandler": {
      "id": "Awp0Copy",
      "activeWhen": {
        "condition": "conditions.isAuditObjectSelectedLocal"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditAwp0OpenGroupCommandHandler": {
      "id": "Awp0OpenGroup",
      "activeWhen": {
        "condition": "conditions.isPropAuditObjectSelected"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "auditAwp0ShowObjectCellCommandHandler": {
      "id": "Awp0ShowObjectCell",
      "activeWhen": {
        "condition": "conditions.isPropAuditPageOrInfoPage"
      },
      "visibleWhen": false
    }
  },
  "commandPlacements": {},
  "actions": {},
  "conditions": {
    "AuditLogPageStartEditCondition": {
      "expression": "conditions.isStartEditAllowed && conditions.isAuditLogPage"
    },
    "AuditLogPageStartEditSummaryCondition": {
      "expression": "conditions.isStartEditSummaryAllowed && conditions.isAuditLogPage"
    },
    "isAuditLogPage": {
      "expression": "commandContext.pageContext.primaryActiveTabId === 'tc_xrt_AuditLogs' || commandContext.pageContext.secondaryActiveTabId === 'tc_xrt_AuditLogs'"
    },
    "isAuditObjectSelected": {
      "expression": "ctx.selected.modelType.parentTypeName==='Fnd0AuditLog' || ctx.selected.modelType.typeHierarchyArray.indexOf( 'Fnd0PropAuditLog' ) > -1"
    },
    "isAuditObjectSelectedLocal": {
      "expression": "(conditions.isLocalSelectionNotApplicable && conditions.isAuditObjectSelected) || (conditions.isSelectionDataPopulated && commandContext.selectionData.selected[0].modelType.parentTypeName==='Fnd0AuditLog') || ctx.xrtSummaryContextObject.modelType.typeHierarchyArray.indexOf( 'Fnd0AuditLog' ) > -1"
    },
    "isAuditPageOrObject": {
      "expression": "conditions.isAuditObjectSelected && conditions.isAuditLogPage"
    },
    "isPropAuditObjectSelected": {
      "expression": "ctx.selected.modelType.typeHierarchyArray.indexOf( 'Fnd0PropAuditLog' ) > -1"
    },
    "isPropAuditPageOrInfoPage": {
      "expression": "ctx.xrtSummaryContextObject.modelType.typeHierarchyArray.indexOf( 'Fnd0AuditLog' ) > -1"
    }
  },
  "onEvent": [],
  "i18n": {},
  "messages": {}
}
