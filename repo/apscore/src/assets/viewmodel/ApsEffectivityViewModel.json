{
    "schemaVersion": "1.0.0",
    "i18n": {
        "effectivity": [
            "ApsEffectivityMessages"
        ],
        "addEffectivity": [
            "ApsEffectivityMessages"
        ],
        "editEffectivity": [
            "ApsEffectivityMessages"
        ],
        "ApsBulkEffWarningMessage": [
            "ApsEffectivityMessages"
        ]
    },
    "messages": {
        "bulkEffectivityWarnMessage": {
            "messageType": "INFO",
            "messageText": "{{i18n.ApsBulkEffWarningMessage}}"
        }
    },
    "lifecycleHooks" :
    {
        "onUpdate": [
            {
                "action": "validateSelectedObjects",
                "observers": [ "viewModel.ctx.mselected" ]
            }
        ]     
    },
    "conditions": {
        "isSingleSelected":
        {
            "expression": "ctx.mselected.length === 1"
        }
    },
    "data": {
        "apsExpEffState": {
            "initialValues": {
                "activeView": "ApsEffectivitySub",
                "effectivities":{
                },
                "editEffectivity":{
                }
            },
            "meta": { }
        },
        "isValidObjectSelected": {
            "initialValues": true,
            "meta": { }
        },
        "selectedObjects": {
            "initialValues": {
                "selectedObjects": []
            },
            "meta": { }
        }
    },
    "actions": {
        "backAction":
        {
            "actionType": "JSFunction",
            "method": "setActiveView",
            "inputData":
            {
                "destinationPanelId":"ApsEffectivitySub",
                "apsExpEffState": "{{data.apsExpEffState}}"
            },
            "outputData": {
                "apsExpEffState":""
            },
            "deps": "js/apsEffectivityAuthoringService"
        },
        "validateSelectedObjects": {
            "actionType": "JSFunction",
            "method": "validateSelectedObjects",
            "outputData": {
                "isValidObjectSelected": "isValidObjectSelected"
            },
            "deps": "js/apsEffectivityAuthoringService"
        },
        "closePanel": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "onEvent": [ {
        "eventId": "primaryWorkArea.invalidSelectionEvent",
        "action": "closePanel"
    } ]
}
