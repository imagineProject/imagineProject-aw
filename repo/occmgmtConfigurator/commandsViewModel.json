{
  "commands": {
    "Awb0VariantFormulaEditorInTableCell": {
      "iconId": "cmdEdit",
      "title": "{{i18n.edit}}",
      "description": "{{i18n.editVariantFormulaInTextEditor}}"
    },
    "Awb0WhereUsedOpenInNewTabStructures": {
      "iconId": "cmdOpenInNewTab24",
      "title": "{{i18n.Awb0WUOpenInNewTab}}",
      "isGroup": false,
      "description": "{{i18n.Awb0WUOpenInNewTabCmdEnabled}}"
    },
    "Pca0VariantConfiguration": {
      "iconId": "cmdVariantOptions24",
      "title": "{{i18n.variantConfigurationTitle}}",
      "description": "{{i18n.variantConfigurationDescription}}"
    }
  },
  "commandHandlers": {
    "Awb0VariantFormulaEditorInTableCellCommandHandler": {
      "id": "Awb0VariantFormulaEditorInTableCell",
      "action": "Awb0VariantFormulaEditorInTableCell",
      "activeWhen": true,
      "visibleWhen": {
        "condition": "conditions.isVariantFormulaEditable"
      }
    },
    "Awb0WhereUsedMoreGroupObjectSetCommandHandler": {
      "id": "Awp0MoreGroupObjectSetSection",
      "action": "",
      "activeWhen": {
        "condition": "conditions.occmgmtVariantIsWhereUsedObjectSet"
      },
      "visibleWhen": false
    },
    "Awb0WUShowObjectCellCommandHandler": {
      "id": "Awp0ShowObjectCell",
      "action": "OccmgmtVarShowDelegatedObject",
      "activeWhen": {
        "condition": "conditions.isSectionWhereUsed"
      },
      "visibleWhen": true
    },
    "occmgmtConfiguratorPasteHandler": {
      "id": "Awp0Paste",
      "activeWhen": {
        "condition": "conditions.occmgmtVariantIsFeatureTab"
      },
      "visibleWhen": false
    },
    "occmgmtConfiguratorCheckoutHandler": {
      "id": "Awp0Checkout",
      "activeWhen": {
        "condition": "conditions.occmgmtVariantIsFeatureTab"
      },
      "visibleWhen": false
    },
    "Awb0WhereUsedOpenInNewTabStructuresCommandHandler": {
      "id": "Awb0WhereUsedOpenInNewTabStructures",
      "action": "createNavigationParameters",
      "activeWhen": {
        "condition": true
      },
      "visibleWhen": {
        "condition": true
      },
      "enableWhen": {
        "condition": "conditions.Awb0OpenInNewTabIsObjectSelected"
      }
    },
    "Pca0VariantConfigurationCommandHandler": {
      "id": "Pca0VariantConfiguration",
      "action": "setPca0VariantConfigurationView",
      "activeWhen": {
        "condition": "conditions.supportsPca0VariantConfigurationView"
      },
      "visibleWhen": {
        "condition": "conditions.supportsPca0VariantConfigurationView"
      },
      "selectWhen": {
        "condition": "conditions.isVariantConfigurationView"
      }
    },
    "SaveEditVCA2TableACECommandHandler": {
      "id": "SaveEditVCA2Table",
      "action": "SaveEditVCA2TableACE",
      "activeWhen": {
        "condition": "conditions.editVariantTableInAceSubUnderECN"
      },
      "visibleWhen": {
        "condition": "conditions.editVariantTableInAceSubUnderECN"
      }
    }
  },
  "commandPlacements": {
    "Awb0VariantFormulaEditorInTableCellCommandPlacement": {
      "id": "Awb0VariantFormulaEditorInTableCell",
      "uiAnchor": "occmgmt_tree_cell_commands",
      "priority": 1,
      "cellDisplay": {
        "position": "TOP_RIGHT",
        "selected": true
      }
    },
    "CbaVariantFormulaEditorInTableCellCommandPlacement": {
      "id": "Awb0VariantFormulaEditorInTableCell",
      "uiAnchor": "cba_tree_cell_commands",
      "priority": 1,
      "cellDisplay": {
        "position": "TOP_RIGHT",
        "selected": true
      }
    },
    "Awb0WhereUsedOpenInNewTabStructuresTabCommandPlacement": {
      "id": "Awb0WhereUsedOpenInNewTabStructures",
      "uiAnchor": "objectSet_structureWU",
      "priority": 250
    },
    "Awb0WhereUsedStructuresFullScreenEnterCommandPlacement": {
      "id": "AwFullScreenEnter",
      "uiAnchor": "objectSet_structureWU",
      "priority": 250
    },
    "Pca0VariantConfigurationPlacement": {
      "id": "Pca0VariantConfiguration",
      "parentGroupId": "Awp0DisplayToggles",
      "priority": 20
    },
    "Pca0VariantConfigurationSummaryCmdPlacement": {
      "id": "Pca0VariantConfiguration",
      "parentGroupId": "Awp0DisplayTogglesSummary",
      "priority": 20
    }
  },
  "actions": {
    "Awb0VariantFormulaEditorInTableCell": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "Awb0ChangeCommandVmoEditState",
          "condition": "commandContext.vmo.isEditing === undefined || commandContext.vmo.isEditing === false"
        },
        {
          "action": "getConfigPerspective"
        },
        {
          "action": "Awb0OpenVariantFormulaPopupEditor"
        },
        {
          "action": "Awb0OpenVariantFormulaTextEditorPopup"
        }
      ]
    },
    "getConfigPerspective": {
      "actionType": "JSFunction",
      "method": "getConfigPerspective",
      "inputData": {
        "commandContext": "{{commandContext.vmo}}"
      },
      "outputData": {
        "configPerspective": ""
      },
      "deps": "js/aceVariantFormulaEditorPopupService"
    },
    "Awb0ChangeCommandVmoEditState": {
      "actionType": "JSFunction",
      "method": "changeCommandVmoEditState",
      "inputData": {
        "commandContext": "{{commandContext.vmo}}"
      },
      "deps": "js/pca0ConstraintsEditorPopupService"
    },
    "Awb0OpenVariantFormulaPopupEditor": {
      "actionType": "JSFunction",
      "method": "openVariantFormulaPopupEditor",
      "inputData": {
        "commandContext": "{{commandContext.vmo}}",
        "contextKey": "variantFormulaContext"
      },
      "outputData": {
        "configContext": ""
      },
      "deps": "js/aceVariantFormulaEditorPopupService"
    },
    "Awb0OpenVariantFormulaTextEditorPopup": {
      "actionType": "popup",
      "inputData": {
        "options": {
          "view": "AceVariantFormulaEditorPopup",
          "height": "fill",
          "width": 500,
          "hasPadding": 5,
          "clickOutsideToClose": false,
          "draggable": true,
          "resizable": true,
          "autoFocus": true,
          "hasArrow": true,
          "forceCloseOthers": true,
          "configPerspective": "{{data.configPerspective}}",
          "popUpContext": "{{commandContext}}",
          "placement": "bottom-start"
        }
      }
    },
    "OccmgmtVarShowDelegatedObject": {
      "actionType": "Navigate",
      "navigateTo": "com_siemens_splm_clientfx_tcui_xrt_showObject",
      "navigationParams": {
        "uid": "{{commandContext.vmo.props['REF(bl_window,BOMWindow).REF(top_line,BOMLine).REF(bl_revision,ItemRevision).object_string'].intermediateObjectUids[2]}}"
      }
    },
    "createNavigationParameters": {
      "actionType": "JSFunctionAsync",
      "method": "createNavigationParameters",
      "inputData": {
        "commandContext": "{{commandContext}}"
      },
      "outputData": {
        "navigateToPageId": "navigateToPageId",
        "contextUid": "contextUid"
      },
      "events": {
        "success": [
          {
            "name": "occmgmtVariantNavigateViaOpenCellCommand.openSelectedObjects"
          }
        ]
      },
      "deps": "js/featureWhereUsedStructureService"
    },
    "occmgmtVariantNavigateToTabForCellCommand": {
      "actionType": "Navigate",
      "navigateTo": "com_siemens_splm_clientfx_tcui_xrt_showObject",
      "navigationParams": {
        "uid": "{{data.contextUid}}",
        "pageId": "{{data.navigateToPageId}}"
      },
      "navigateIn": "newTab"
    },
    "setPca0VariantConfigurationView": {
      "actionType": "JSFunction",
      "method": "changeViewMode",
      "deps": "js/pageLayoutService",
      "inputData": {
        "viewTupleState": "{{commandContext.viewTuple}}",
        "viewTuple": {
          "alternatePWA": "Pca0FullScreenConfiguration"
        },
        "sublocationState": "{{commandContext.pageContext.sublocationState}}",
        "title": {
          "source": "/i18n/ConfiguratorMessages",
          "key": "variantConfigurationTitle"
        }
      }
    },
    "SaveEditVCA2TableACE": {
      "actionType": "JSFunction",
      "method": "saveEditVCA2TableACE",
      "deps": "js/variantConditionService",
      "inputData": {
        "data": "{{commandContext}}"
      }
    }
  },
  "conditions": {
    "supportsPca0VariantConfigurationView": {
      "expression": "commandContext.occContext.configuratorViewsDisplayContext.showVariantConfigurationView  && !commandContext.fullScreenState.value"
    },
    "isVariantConfigurationView": {
      "expression": "commandContext.viewTuple.alternatePWA === 'Pca0FullScreenConfiguration' || commandContext.fscState !== undefined"
    },
    "editVariantTableInAceSubUnderECN": {
      "expression": "ctx.isVariantTableEditing === true && conditions.inECNContext && commandContext.subPanelContext.context.occContext.supportedFeatures.Awb0DateEffectivityConfigFeature"
    },
    "isVariantFormulaEditable": {
      "expression": {
        "$and": [
          {
            "$source": "commandContext.prop.propertyName",
            "$query": {
              "$in": [
                "awb0VariantFormula"
              ]
            }
          },
          {
            "$source": "ctx.aceActiveContext.context.supportedFeatures.Awb0SupportsVariantConditionAuthoring",
            "$query": {
              "$eq": true
            }
          }
        ]
      }
    },
    "isSectionWhereUsed": {
      "expression": "commandContext.objectSetUri === 'Smc0WhereUsed'"
    },
    "Awb0OpenInNewTabIsObjectSelected": {
      "expression": "commandContext.selectionModel.selectionData.selected !== undefined && commandContext.selectionModel.selectionData.selected.length === 1"
    },
    "occmgmtVariantIsWhereUsedObjectSet": {
      "expression": {
        "$source": "commandContext",
        "$query": {
          "$source": "objectSetSourceArray",
          "$query": {
            "$in": [
              "Fnd0WUInStructuresProvider.BOMLine"
            ]
          }
        }
      }
    },
    "Awb0IsWhereUsedTabForFeaturesOrModels": {
      "expression": {
        "$or": [
          {
            "$source": "commandContext.gridId",
            "$query": {
              "$in": [
                "NONE_objectSet_constraints_Provider",
                "NONE_objectSet_contexts_Provider",
                "NONE_objectSet_variants_Provider",
                "NONE_objectSet_structureWU_Provider"
              ]
            }
          },
          {
            "$source": "commandContext.pageContext.secondaryActiveTabId",
            "$query": {
              "$eq": "Pca0WhereUsed"
            }
          },
          {
            "$source": "commandContext.activeTab.view",
            "$query": {
              "$eq": "Pca0WhereUsed"
            }
          }
        ]
      }
    },
    "occmgmtVariantIsFeatureTab": {
      "expression": "ctx.sublocation.clientScopeURI === 'Pca0VariabilityExplorerFeatures' && (commandContext.activeTab.view === 'Pca0WhereUsed' || commandContext.objectSetUri === 'Smc0WhereUsed')"
    }
  },
  "onEvent": [
    {
      "eventId": "occmgmtVariantNavigateViaOpenCellCommand.openSelectedObjects",
      "action": "occmgmtVariantNavigateToTabForCellCommand"
    }
  ],
  "i18n": {
    "edit": [
      "OccurrenceManagementConfiguratorConstants"
    ],
    "editVariantFormulaInTextEditor": [
      "OccurrenceManagementConfiguratorConstants"
    ],
    "Awb0WUOpenInNewTab": [
      "OccurrenceVariantConstants"
    ],
    "Awb0WUOpenInNewTabCmdEnabled": [
      "OccurrenceVariantConstants"
    ],
    "variantConfigurationTitle": [
      "ConfiguratorMessages"
    ],
    "variantConfigurationDescription": [
      "ConfiguratorMessages"
    ]
  }
}
