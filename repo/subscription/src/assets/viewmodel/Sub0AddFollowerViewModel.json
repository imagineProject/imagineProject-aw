{
    "schemaVersion": "1.0.0",
    "imports": [],
    "i18n": {
        "followersXRTTitle": [
            "SubscriptionMessages"
        ],
        "addFollower": [ "SubscriptionMessages" ]
    },

    "data": {
        "addUserPanelState": {
            "initialValues": {
                "provider": "Awp0PeoplePickerProvider",
                "selectionModelMode": "multiple",
                "criteria": {
                    "providerContentType": "User",
                    "searchString": ""
                },
                "selectedUsers": ""
            },
            "meta": {
                "selectedUsers": {
                    "field": "true",
                    "type": "OBJECTARRAY"
                }
            }
        },
        "activeView": "Sub0AddFollowerSub"
    },

    "actions" : {
        "addFollowers":{
            "actionType":"JSFunction",
            "method":"applyFollowerChange",
            "deps":"js/awSubscriptionFollowerTableService",
            "inputData":{
                "dataProvider":"{{subPanelContext.dataProviders.followers_provider}}",
                "followerObjects": "{{ctx.sub0Follower.followerObjects}}",
                "columnDefs":"{{ctx.sub0Follower.columnDefs}}",
                "props": {
                    "handler_parameters": "{{addUserPanelState.selectedUsers}}"
                }
            },
            "events":{
                "success":[
                    {
                        "name":"subscriptionFollowerObjects.updated"
                    },
                    {
                        "name": "closeDialog"
                    }
                ]
            }
        },
        "closePanelDialog": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "INFO_PANEL_CONTEXT",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "onEvent": [
        {
            "eventId": "closeDialog",
            "action": "closePanelDialog"
        }
    ]
}
