{
    "schemaVersion" : "1.0.0",
    "conditions": {
        "checkIfSWAIsEmpty": {
            "expression": "props.subPanelContext.selection.length === 0 && subPanelContext.context.searchState.totalFound > 0"
        },
        "checkIfPWAIsEmpty": {
            "expression": "props.subPanelContext.selection.length === 0 && !subPanelContext.context.searchState.totalFound"
        }
    },
    "i18n": {
        "subscriptionSwaTitle": [
            "SubscriptionMessages"
        ],
        "subscriptionSwaHint": [
            "SubscriptionMessages"
        ]
    }
}

