{
  "$schema": "declarativeSecondaryWorkareaTabsSchema-1.0.0.json",
  "tabs": {
    "Pca0EmptyViewPca0Empty": {
      "name": "Pca0EmptyView",
      "priority": 0,
      "view": "Pca0Empty",
      "visibleWhen": "ctx.locationContext['ActiveWorkspace:SubLocation'] === 'Pca0ProductConfigurator' && selection.length === 0"
    },
    "Pca0GridEditorPca0ConstraintsGridEditorWrapper": {
      "name": {
        "source": "/i18n/ConfiguratorExplorerMessages",
        "key": "Pca0GridEditor"
      },
      "priority": 200,
      "pageId": "Pca0GridEditor",
      "view": "Pca0ConstraintsGridEditorWrapper",
      "visibleWhen": {
        "$and": [
          {
            "$source": "ctx.locationContext['ActiveWorkspace:SubLocation']",
            "$query": {
              "$eq": "Pca0ConstraintsSubLocation"
            }
          },
          {
            "$source": "selection.length",
            "$query": {
              "$gt": 0
            }
          },
          {
            "$source": {
              "$adapt": "selection"
            },
            "$query": {
              "$all": {
                "$source": "modelType.typeHierarchyArray",
                "$query": {
                  "$in": [
                    "Cfg0AbsArithmeticConstraint",
                    "Cfg0AbsAvailabilityRule",
                    "Cfg0AbsExceptionRule",
                    "Cfg0AbsDefaultRule",
                    "Cfg0AbsExcludeRule",
                    "Cfg0AbsIncludeRule",
                    "Cfg0ProductItem",
                    "Cfg0Dictionary"
                  ]
                }
              }
            }
          },
          {
            "$source": "ctx.ConfiguratorCtx.appliedSettings.configSettings.props.pca0RevisionRule.dbValues[0].length",
            "$query": {
              "$gt": 0
            }
          }
        ]
      }
    },
    "Pca0SnOMatrixPca0ConstraintsSnOMatrixWrapper": {
      "name": {
        "source": "/i18n/ConfiguratorExplorerMessages",
        "key": "Pca0SnOMatrix"
      },
      "priority": 250,
      "pageId": "Pca0SnOMatrix",
      "view": "Pca0ConstraintsSnOMatrixWrapper",
      "visibleWhen": {
        "$and": [
          {
            "$source": "ctx.locationContext['ActiveWorkspace:SubLocation']",
            "$query": {
              "$eq": "Pca0ConstraintsSubLocation"
            }
          },
          {
            "$source": "selection.length",
            "$query": {
              "$gt": 0
            }
          },
          {
            "$source": {
              "$adapt": "selection"
            },
            "$query": {
              "$all": {
                "$source": "modelType.typeHierarchyArray",
                "$query": {
                  "$in": [
                    "Cfg0AbsMatrixRule",
                    "Cfg0ProductItem"
                  ]
                }
              }
            }
          },
          {
            "$source": "ctx.ConfiguratorCtx.appliedSettings.configSettings.props.pca0RevisionRule.dbValues[0].length",
            "$query": {
              "$gt": 0
            }
          }
        ]
      }
    },
    "Pca0MultipleVariantsConfiguration": {
      "name": {
        "source": "/i18n/FullScreenConfigurationMessages",
        "key": "configuration"
      },
      "priority": 250,
      "pageId": "Pca0MultipleVariantsConfiguration",
      "view": "Pca0MultipleVariantsConfigurationWrapper",
      "data": {},
      "visibleWhen": {
        "$and": [
          {
            "$source": "ctx.locationContext['ActiveWorkspace:SubLocation']",
            "$query": {
              "$eq": "Pca0VariantRuleSubLocation"
            }
          },
          {
            "$source": "ctx.ConfiguratorCtx.appliedSettings.configSettings.props.pca0RevisionRule.dbValues[0].length",
            "$query": {
              "$gt": 0
            }
          }
        ]
      }
    },
    "PcaExpressionEditorFreeFormConstraint": {
      "name": {
        "source": "/i18n/ConfiguratorExplorerMessages",
        "key": "PcaExpressionEditorFreeFormConstraint"
      },
      "priority": 200,
      "pageId": "PcaExpressionEditorFreeFormConstraint",
      "view": "Pca0FreeFormEditor",
      "visibleWhen": {
        "$and": [
          {
            "$source": "ctx.locationContext['ActiveWorkspace:SubLocation']",
            "$query": {
              "$eq": "Pca0ConstraintsSubLocation"
            }
          },
          {
            "$source": {
              "$adapt": "selection"
            },
            "$query": {
              "$all": {
                "$source": "modelType.typeHierarchyArray",
                "$query": {
                  "$in": [
                    "Cfg0AbsFreeFormRule",
                    "Cfg0ProductItem"
                  ]
                }
              }
            }
          },
          {
            "$source": "selection.length",
            "$query": {
              "$eq": 1
            }
          },
          {
            "$source": "ctx.ConfiguratorCtx.appliedSettings.configSettings.props.pca0RevisionRule.dbValues[0].length",
            "$query": {
              "$gt": 0
            }
          }
        ]
      }
    },
    "Pca0WhereUsed": {
      "name": {
        "source": "/i18n/ConfiguratorExplorerMessages",
        "key": "Pca0WhereUsed"
      },
      "priority": 200,
      "view": "Pca0WhereUsed",
      "data": {},
      "visibleWhen": {
        "$and": [
          {
            "$source": "selection.length",
            "$query": {
              "$eq": 1
            }
          },
          {
            "$source": {
              "$adapt": "selection"
            },
            "$query": {
              "$all": {
                "$source": "modelType.typeHierarchyArray",
                "$query": {
                  "$in": [
                    "Cfg0AbsValue",
                    "Cfg0AbsFamily",
                    "Cfg0AbsFamilyGroup"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
