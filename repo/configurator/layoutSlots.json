{
  "slots": {
    "fullscreenConstraintsHeader": {
      "name": "aw_fullScreenHeader",
      "view": "Pca0ConstraintsSublocationFullScreenHeader",
      "activeWhen": {
        "condition": "conditions.Pca0IsConstraintsSublocation"
      }
    },
    "fullscreenVariantsHeader": {
      "name": "aw_fullScreenHeader",
      "view": "Pca0VariantsSublocationFullScreenHeader",
      "activeWhen": {
        "condition": "conditions.Pca0IsVariantsSublocation"
      }
    }
  },
  "conditions": {
    "Pca0IsConstraintsSublocation": {
      "expression": "commandContext.clientScopeURI === 'Pca0Constraints' || ctx.sublocation.clientScopeURI === 'Pca0Constraints'"
    },
    "Pca0IsVariantsSublocation": {
      "expression": "commandContext.clientScopeURI === 'Pca0VariantRule' || ctx.sublocation.clientScopeURI === 'Pca0VariantRule'"
    }
  }
}
