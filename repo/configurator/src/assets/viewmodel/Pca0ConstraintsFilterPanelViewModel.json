{
    "schemaVersion": "1.0.0",
    "data": {
        "selectedFilters": {
            "type": "STRING",
            "displayName": "{{i18n.selectedFilters}}",
            "dispValue": ""
        },
        "selectionsLabel": {
            "type": "STRING",
            "displayName": "{{i18n.selections}}",
            "dispValue": ""
        },
        "advancedFeatureSelectorLink": {
            "displayName": "{{i18n.advancedFeatureSelector}}",
            "type": "STRING",
            "isRequired": "false"
        },
        "operationRadioProp": {
            "displayName": "{{i18n.featureOperator}}",
            "type": "STRING",
            "isEditable": "true",
            "labelPosition": "PROPERTY_LABEL_AT_TOP"
        },
        "operationRadioPropValues": {
            "type": "STRING",
            "dbValue": [ {
                    "propDisplayValue": "{{i18n.orLabel}}",
                    "propInternalValue": "or"
                },
                {
                    "propDisplayValue": "{{i18n.andLabel}}",
                    "propInternalValue": "and"
                }
            ]
        },
        "filterByRadioProp": {
            "displayName": "{{i18n.filterBy}}",
            "type": "STRING",
            "isEditable": "true",
            "labelPosition": "PROPERTY_LABEL_AT_TOP"
        },
        "filterByValues": {
            "type": "STRING",
            "dbValue": [ {
                    "propDisplayValue": "{{i18n.subject}}",
                    "propInternalValue": "search_only_in_subject"
                },
                {
                    "propDisplayValue": "{{i18n.condition}}",
                    "propInternalValue": "search_only_in_condition"
                },
                {
                    "propDisplayValue": "{{i18n.subjectOrCondition}}",
                    "propInternalValue": "search_either_in_subject_or_condition"
                }
            ]
        },
        "showUnreferencedFilter": {
            "displayName": "{{i18n.showUnreferencedFilter}}",
            "type": "BOOLEAN",
            "isEditable": "true",
            "dbValue": "",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        }
    },
    "dataProviders": {
        "featureFacetsDataProvider": {
            "response": "{{props.subPanelContext.searchState.featuresFilterCategory.featureFacetValues}}",
            "moreValuesExist": false
        }
    },
    "actions": {
        "cacheFeaturesFilterCategoryDataAfterFacetSearch": {
            "actionType": "JSFunction",
            "method": "cacheFeaturesFilterCategoryDataAfterFacetSearch",
            "inputData": {
                "soaResponse": "{{data.soaResponse}}",
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "deps": "js/pca0ConstraintsFilterService"
        },
        "applyConstraintsFilter": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "Pca0ConstraintsGrid.applyConstraintsFilter",
                    "eventData": {
                        "selection": "{{props.subPanelContext.selection}}"
                    }
                } ]
            }
        },
        "navigateToSubView": {
            "actionType": "JSFunction",
            "method": "setActiveView",
            "inputData": {
                "subView": "Pca0ConstraintsFilterPanelView",
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "events": {
                "success": [ {
                    "name": "Pca0ConstraintsFilterPanel.scrollToBottom"
                } ]
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "selectFeatureFacetsFromVariabilityPickerSubPanel": {
            "actionType": "JSFunction",
            "method": "selectFeatureFacetsFromVariabilityPickerSubPanel",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "eventData": "{{parameters.eventData}}"
            },
            "events": {
                "success": [
                    {
                        "name": "Pca0ConstraintsFilterPanel.navigateToSubView",
                        "eventData": {
                            "subView": "Pca0ConstraintsFilterPanelView"
                        }
                    }
                ]
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "toggleConstraintTypeCategoryPanelState": {
            "actionType": "JSFunction",
            "method": "toggleConstraintTypeCategoryPanelState",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "isCollapsed": "{{parameters.isCollapsed}}"
            },
            "deps": "js/pca0ConstraintsFilterService"
        },
        "toggleFeaturesFilterCategoryPanelState": {
            "actionType": "JSFunction",
            "method": "updateFeaturePanelCollapsedState",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "isCollapsed": "{{parameters.isCollapsed}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "removeFeaturesFilter": {
            "actionType": "JSFunction",
            "method": "removeFeaturesFilter",
            "inputData": {
                "chipToRemove": "{{parameters.chip}}",
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "removeConstraintTypesFilter": {
            "actionType": "JSFunction",
            "method": "removeConstraintTypesFilter",
            "inputData": {
                "chipToRemove": "{{parameters.chip}}",
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "deps": "js/pca0ConstraintsFilterService"
        },
        "removeUnreferencedConstraintsFilter": {
            "actionType": "JSFunction",
            "method": "removeUnreferencedConstraintsFilter",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "deps": "js/pca0ConstraintsFilterService"
        },
        "clearFilters": {
            "actionType": "JSFunction",
            "method": "clearFilters",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "events": {
                "success": [ {
                    "name": "pca0ConstraintsGrid.plTable.reload"
                } ]
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "scrollToBottom": {
            "actionType": "JSFunction",
            "method": "scrollToBottom",
            "deps": "js/pca0ConstraintsFilterService"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "functions": {},
    "lifecycleHooks": { },
    "onEvent": [
        {
            "eventId": "Pca0VariabilityFilterPanel.updateFeatureFacetsSelections",
            "action": "selectFeatureFacetsFromVariabilityPickerSubPanel",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0ConstraintsFilterPanel.scrollToBottom",
            "action": "scrollToBottom"
        },
        {
            "eventId": "Pca0ConstraintsFilterPanel.updateFeaturesListSelections",
            "action": "updateFeaturesListSelections"
        },
        {
            "eventId": "Pca0ConstraintsFilterPanel.navigateToSubView",
            "action": "navigateToSubView",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        }
    ],
    "messages": {},
    "conditions": {
        "fetchCategories": {
            "expression": "!props.subPanelContext.searchState.featuresFilterCategory.isPopulated"
        },
        "showFeaturesFilterCategory": {
            "expression": "props.subPanelContext.searchState.featuresFilterCategory.filterValues.length > 0"
        },
        "showConstraintTypeFilterCategory": {
            "expression": "props.subPanelContext.searchState.constraintTypeFilterCategory.filterValues.length > 0"
        },
        "showFeatureSelectorView": {
            "expression": "props.subPanelContext.searchState.activeView === 'Pca0SelectFeaturesSubPanel'"
        },
        "showFeaturesFilterCategoryChip": {
            "expression": "props.subPanelContext.searchState.featuresFilterChipData.labelDisplayName"
        },
        "showConstraintTypeFilterCategoryChip": {
            "expression": "props.subPanelContext.searchState.typesFilterChipData.labelDisplayName"
        },
        "showUnreferencedConstraintsFilterCategoryChip": {
            "expression": "props.subPanelContext.searchState.unreferencedConstraintsFilterChipData.labelDisplayName"
        },
        "showSelectedFilterChips": {
            "expression": "(conditions.showFeaturesFilterCategoryChip || conditions.showConstraintTypeFilterCategoryChip || conditions.showUnreferencedConstraintsFilterCategoryChip) && !conditions.showFeatureSelectorView"
        },
        "enableFilterApply": {
            "expression": "props.subPanelContext.searchState.enableApplyFilter"
        },
        "constraintTypesPanelCollapsedState": {
            "expression": "props.subPanelContext.searchState.constraintTypeFilterCategory.panelCollapsedState"
        }
    },
    "i18n": {
        "advancedFeatureSelector": [ "ConfiguratorExplorerMessages" ],
        "filters": [ "ConfiguratorExplorerMessages" ],
        "familiesAndFeatures": [ "ConfiguratorExplorerMessages" ],
        "unreferencedType": [ "ConfiguratorExplorerMessages" ],
        "constraintType": [ "ConfiguratorExplorerMessages" ],
        "filter": [ "ConfiguratorMessages" ],
        "selectedFilters": [ "ConfiguratorExplorerMessages" ],
        "clear": [ "ConfiguratorMessages" ],
        "selectFeature": [ "ConfiguratorExplorerMessages" ]
    }
}
