{
    "schemaVersion": "1.0.0",
    "lifecycleHooks": {
        "onUpdate": [ {
            "action": "updateUnreferencedCheckboxSelection",
            "observers": [ "props.subPanelContext.searchState.activeFiltersInfo.showUnreferencedConstraints" ]
        } ]
    },
    "data": {
        "unreferencedFilterCheckBox": {
            "displayName": "{{i18n.unreferencedFilterCheckBoxDispName}}",
            "type": "BOOLEAN",
            "isEditable": "true",
            "dbValue": "",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        }
    },
    "dataProviders": {
        "featuresDataProvider": {
            "response": "{{props.subPanelContext.searchState.showUnreferencedConstraints}}",
            "moreValuesExist": false
        }
    },
    "actions": {
        "toggleUnreferencedFilterCategoryPanelState": {
            "actionType": "JSFunction",
            "method": "updateUnreferencedPanelCollapsedState",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "isCollapsed": "{{parameters.isCollapsed}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "handleUnreferencedFilterCheckboxClickAction": {
            "actionType": "JSFunction",
            "method": "handleUnreferencedFilterCheckboxClick",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "unreferencedFilterCheckBox": "{{data.unreferencedFilterCheckBox}}"
            },
            "deps": "js/pca0ConstraintsFilterService"
        },
        "applyConstraintsFilter": {
            "actionType": "JSFunction",
            "method": "updateFilteringInputs",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "outputData": {
                "updatedFilterState": ""
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "updateUnreferencedCheckboxSelection": {
            "actionType": "JSFunction",
            "method": "updateUnreferencedCheckboxSelection",
            "inputData": {
                "unreferencedFilterCheckBox": "{{data.unreferencedFilterCheckBox}}",
                "searchState": "{{props.subPanelContext.searchState.activeFiltersInfo.showUnreferencedConstraints}}"
            },
            "outputData": {
                "unreferencedFilterCheckBox": ""
            },
            "events": {
                "success": [ {
                    "name": "Pca0ConstraintsFilterPanel.scrollToBottom"
                } ]
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "scrollToBottom": {
            "actionType": "JSFunction",
            "method": "scrollToBottom",
            "deps": "js/pca0ConstraintsFilterService"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "functions": {
        "getPerformFacetSearchInput": {
            "functionName": "getPerformFacetSearchInput"
        },
        "cachedFeaturesData": {
            "functionName": "cachedFeaturesData",
            "parameters": [
                "{{props.subPanelContext.searchState}}"
            ]
        }
    },
    "onEvent": [
        {
            "eventId": "featureNamesList.lovValueChanged",
            "action": "updateFilterValuesAsPerFeatureSelection"
        },
        {
            "eventId": "Pca0ConstraintsGrid.applyConstraintsFilter",
            "action": "applyConstraintsFilter",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0ConstraintsFilterPanel.scrollToBottom",
            "action": "scrollToBottom"
        }
    ],
    "messages": {},
    "conditions": {
        "unreferencedFilterPopulated": {
            "expression": "props.subPanelContext.searchState.unreferencedTypeFilterCategory.isPopulated"
        },
        "unreferencedPanelCollapsedState": {
            "expression": "props.subPanelContext.searchState.unreferencedTypeFilterCategory.panelCollapsedState"
        },
        "isShowUnreferencedConstraintsSelected": {
            "expression": "props.subPanelContext.searchState.showUnreferencedConstraints === true"
        },
        "showSelectedFilterChips": {
            "expression": "conditions.showFeaturesFilterCategory"
        }
    },
    "i18n": {
        "unreferencedType": [ "ConfiguratorExplorerMessages" ],
        "unreferencedFilterCheckBoxDispName": [ "ConfiguratorExplorerMessages" ]
    }
}
