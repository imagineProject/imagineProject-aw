{
    "schemaVersion": "1.0.0",
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "actions": {
        "initializeLoadSVRInputPanel": {
            "actionType": "JSFunction",
            "method": "initializeLoadSVRInputPanel",
            "deps": "js/pca0LoadSavedVariantsService",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData": {
                "searchCriteriaLink": "searchCriteriaLink",
                "currentRevisionRule": "revisionRule",
                "considerRevRuleForSearch": "considerRevRuleForSearch",
                "featurePropLabel": "featurePropLabel",
                "expressionPropLabel": "expressionPropLabel",
                "searchCriteria": "searchCriteria",
                "configPerspectiveUid": "configPerspectiveUid",
                "isWaitingForTcFormulaUpdate": "isWaitingForTcFormulaUpdate"
            }
        },
        "handleSelectionInSearchInputTab": {
            "actionType": "JSFunction",
            "method": "handleSelectionInSearchInputTab",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData": {
                "activeSearchCriteria": "result.activeSearchCriteria",
                "featurePropLabel": "result.featurePropLabel",
                "activeSearchResultPropLabel": "result.activeSearchResultPropLabel",
                "searchCriteriaLink": "result.searchCriteriaLink"
            },
            "deps": "js/pca0LoadSavedVariantsService"
        },
        "saveInputTabData": {
            "actionType": "JSFunction",
            "method": "setSearchCriteria",
            "inputData": {
                "data": "{{data}}"
            },
            "deps": "js/pca0LoadSavedVariantsService"
        },
        "launchResultsPanelAndSearch": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "Pca0LoadSVRSearchTab.tabChange",
                    "eventData": {
                        "pageId": "Pca0LoadSVRSearchResultsTab",
                        "tabKey": "Results",
                        "searchCriteria": "{{data.searchCriteria}}",
                        "searchCriteriaLink": "{{data.searchCriteriaLink}}",
                        "considerRevRuleForSearch":"{{data.considerRevRuleForSearch}}"
                    }
                } ]
            }
        },
        "updateParentComponent": {
            "actionType": "JSFunction",
            "method": "updateParentComponent",
            "inputData": {
                "viewModel": "{{data}}"
            },
            "outputData": {
                "currentRevisionRule": "currentRevisionRule"
            },
            "deps": "js/pca0RevisionRuleProviderForSearchPanelService"
        },
        "navigateToSubView": {
            "actionType": "JSFunction",
            "method": "setActiveView",
            "inputData": {
                "subView": "Pca0LoadSVRSearchInputTab",
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "selectFeatureFacetsFromVariabilityPickerSubPanel": {
            "actionType": "JSFunction",
            "method": "selectFeatureFacetsFromVariabilityPickerSubPanel",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "eventData": "{{parameters.eventData}}"
            },
            "events": {
                "success": [ {
                    "name": "Pca0LoadSVRFeatureFilterView.navigateToSubView",
                    "eventData": {
                        "subView": "Pca0LoadSVRSearchInputTab"
                    }
                } ]
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "triggerEditorInternalFormulaUpdateBatch": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "setIsWaitingForTcFormulaToUpdate"
                },
                {
                    "action": "triggerEditorInternalFormulaUpdate"
                }
            ]
        },
        "clearFeaturesSelections": {
            "actionType": "JSFunction",
            "method": "clearFilters",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "setIsWaitingForTcFormulaToUpdate": {
            "actionType": "JSFunction",
            "method": "echoInput",
            "inputData": {
                "value": true
            },
            "outputData": {
                "isWaitingForTcFormulaUpdate": ""
            },
            "deps": "js/pca0CommonUtils"
        },
        "triggerEditorInternalFormulaUpdate": {
            "actionType": "JSFunction",
            "method": "changeFormulaSuggesterEditContext",
            "inputData": {
                "editorObject": "{{props.subPanelContext.editorObject}}",
                "editContext": "saveInProgress"
            },
            "deps": "js/pca0CommonUtils"
        },
        "handleFormulaUpdateBatch": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "resetWaitFlagAndLaunchResultsPanelAndSearch",
                "condition": "conditions.expressionSearchCriteriaSelected && data.isWaitingForTcFormulaUpdate"
            } ]
        },
        "resetWaitFlagAndLaunchResultsPanelAndSearch": {
            "actionType": "JSFunction",
            "method": "echoInput",
            "inputData": {
                "value": false
            },
            "outputData": {
                "isWaitingForTcFormulaUpdate": ""
            },
            "events": {
                "success": [ {
                    "name": "Pca0LoadSVRSearchTab.tabChange",
                    "eventData": {
                        "pageId": "Pca0LoadSVRSearchResultsTab",
                        "tabKey": "Results",
                        "searchCriteria": "{{data.searchCriteria}}",
                        "searchCriteriaLink": "{{data.searchCriteriaLink}}",
                        "considerRevRuleForSearch":"{{data.considerRevRuleForSearch}}"
                    }
                } ]
            },
            "deps": "js/pca0CommonUtils"
        },
        "updateEnableFlagForSearchButton": {
            "actionType": "JSFunction",
            "method": "echoInput",
            "inputData": {
                "value": "{{props.subPanelContext.editorObject.value.editorHasContent}}"
            },
            "outputData": {
                "isEditorContentNotEmpty": ""
            },
            "deps": "js/pca0CommonUtils"
        },
        "handleUseExpressionsFromVCV": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "useExpressionFromVCV",
                    "condition": "data.useExpressionFromVCV.dbValue"
                },
                {
                    "action": "clearFormulaInSuggester",
                    "condition": "!data.useExpressionFromVCV.dbValue"
                }
            ]
        },
        "useExpressionFromVCV": {
            "actionType": "JSFunction",
            "method": "validateIfAnyExprsAreAuthored",
            "inputData": {
                "contextKey": "fscContext"
            },
            "outputData": {
                "areAnyExprsAuthored": ""
            },
            "events": {
                "success": [ {
                        "name": "Pca0LoadSVRFilterByExpr.convertVariantExpressions",
                        "condition": "data.areAnyExprsAuthored"
                    },
                    {
                        "name": "Pca0LoadSVRFilterByExpr.clearFormulaInSuggester",
                        "condition": "!data.areAnyExprsAuthored"
                    }
                ]
            },
            "deps": "js/pca0LoadSavedVariantsService"
        },
        "convertVariantExpressions": {
            "actionType": "TcSoaService",
            "serviceName": "Configurator-2023-06-ConfiguratorManagement",
            "method": "convertVariantExpressions",
            "inputData": {
                "perspective": "{{function:getPerspectiveForFormulaConversion}}",
                "variantExpressions": "{{function:getVariantExpressionsForConversionToTcFormula}}",
                "expressionFormat": "tc_formula",
                "requestInfo": []
            },
            "outputData": {
                "convertVariantExpressionsResponse": ""
            },
            "events": {
                "success": [ {
                    "name": "Pca0LoadSVRFilterByExpr.writeFormulaIntoEditorObject",
                    "eventData": {
                        "formula": "{{data.convertVariantExpressionsResponse.displayFormulae[0]}}"
                    }
                } ]
            },
            "actionMessages": {
                "failure": [ {
                    "message": "displayErrorCode"
                } ]
            },
            "deps": "js/pca0LoadSavedVariantsService"
        },
        "clearFormulaInSuggester": {
            "actionType": "JSFunction",
            "method": "updateEditorObjectToClearFormula",
            "inputData": {
                "editorObject": "{{props.subPanelContext.editorObject}}"
            },
            "deps": "js/pca0FormulaSuggesterService"
        },
        "writeFormulaIntoEditorObject": {
            "actionType": "JSFunction",
            "method": "writeFormulaIntoEditorObject",
            "inputData": {
                "formulaRef": "{{props.subPanelContext.formula}}",
                "formulaString": "{{parameters.eventData.formula}}"
            },
            "deps": "js/pca0LoadSavedVariantsService"
        }
    },
    "data": {
        "searchCriteria": {
            "type": "STRING",
            "dbValue": "",
            "isRequired": "true"
        },
        "featurePropLabel": {
            "displayName": "{{i18n.feature}}",
            "type": "STRING",
            "dbValue": "Feature"
        },
        "expressionPropLabel": {
            "displayName": "{{i18n.expression}}",
            "type": "STRING",
            "dbValue": "Expression"
        },
        "searchCriteriaLink": {
            "displayName": "{{i18n.name}}",
            "type": "STRING",
            "isRequired": "false",
            "dbValue": "object_name",
            "uiValue": "{{i18n.name}}"
        },
        "subPanelContextInfo": {
            "contextKey": "fscContext",
            "isRevRuleActionDefaultBehavior": {
                "type": "BOOLEAN",
                "dbValue": false
            },
            "isConfigurationReadOnly": {
                "dbValue": false,
                "type": "BOOLEAN"
            }
        },
        "currentRevisionRule": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "displayName": "{{i18n.revisionRule}}"
        },
        "considerRevRuleForSearch": {
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": true,
            "displayName": "{{i18n.applyRevisionRule}}",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        },
        "useExpressionFromVCV": {
            "displayName": "{{i18n.useExpressionFromVCV}}",
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": false,
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        }
    },
    "lifecycleHooks": {
        "onMount": "initializeLoadSVRInputPanel",
        "onUnmount": "saveInputTabData",
        "onUpdate": [ {
                "action": "handleFormulaUpdateBatch",
                "observers": [ "props.subPanelContext.formula" ]
            },
            {
                "action": "updateEnableFlagForSearchButton",
                "observers": [ "props.subPanelContext.editorObject.editorHasContent" ]
            }
        ]
    },
    "onEvent": [ {
            "eventId": "Pca0LoadSVRSearchCriteriaPanel.launchResultsPanel",
            "action": "launchResultsPanelAndSearch"
        },
        {
            "eventId": "Pca0LoadSVRSearchCriteriaPanel.updateActiveSearchCriteria",
            "cacheEventData": true,
            "action": "handleSelectionInSearchInputTab"
        },
        {
            "eventId": "Pca0RevisionRulePopupContent.contentUnloaded",
            "action": "resetContentSelection"
        },
        {
            "eventId": "Pca0FilterCriteriaSettings.refreshRevisionRuleContent",
            "cacheEventData": true,
            "action": "updateParentComponent"
        },
        {
            "eventId": "Pca0LoadSVRFeatureFilterView.navigateToSubView",
            "action": "navigateToSubView",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0VariabilityFilterPanel.updateFeatureFacetsSelections",
            "action": "selectFeatureFacetsFromVariabilityPickerSubPanel",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0LoadSVRSearchInput.clearFeaturesSelections",
            "action": "clearFeaturesSelections"
        },
        {
            "eventId": "Pca0LoadSVRFilterByExpr.writeFormulaIntoEditorObject",
            "action": "writeFormulaIntoEditorObject",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0LoadSVRFilterByExpr.convertVariantExpressions",
            "action": "convertVariantExpressions"
        },
        {
            "eventId": "Pca0LoadSVRFilterByExpr.clearFormulaInSuggester",
            "action": "clearFormulaInSuggester"
        }
    ],
    "conditions": {
        "isGenericFieldSearchCriteriaSelected": {
            "expression": {
                "$and": [ {
                        "$source": "conditions.featureSearchCriteriaSelected",
                        "$query": {
                            "$eq": false
                        }
                    },
                    {
                        "$source": "conditions.expressionSearchCriteriaSelected",
                        "$query": {
                            "$eq": false
                        }
                    },
                    {
                        "$source": "conditions.savedQuerySearchCriteriaSelected",
                        "$query": {
                            "$eq": false
                        }
                    }
                ]
            }
        },
        "featureSearchCriteriaSelected": {
            "expression": "data.searchCriteriaLink.dbValue === data.featurePropLabel.dbValue"
        },
        "expressionSearchCriteriaSelected": {
            "expression": "data.searchCriteriaLink.dbValue === data.expressionPropLabel.dbValue"
        },
        "savedQuerySearchCriteriaSelected": {
            "expression": "data.searchCriteriaLink.isSavedQuery"
        },
        "showFeatureSelectorView": {
            "expression": "props.subPanelContext.searchState.activeView === 'Pca0SelectFeaturesSubPanel'"
        },
        "enableFilterApply": {
            "expression": "props.subPanelContext.searchState.enableApplyFilter"
        }
    },
    "functions": {
        "getPerspectiveForFormulaConversion": {
            "functionName": "getPerspectiveForFormulaConversion",
            "parameters": [ "{{props.configPerspectiveUid}}", "{{data.configPerspectiveUid}}" ]
        },
        "getVariantExpressionsForConversionToTcFormula": {
            "functionName": "getVariantExpressionsForConversionToTcFormula",
            "parameters": [ "fscContext" ]
        }
    },
    "i18n": {
        "name": [ "FullScreenConfigurationMessages" ],
        "feature": [ "FullScreenConfigurationMessages" ],
        "expression": [ "FullScreenConfigurationMessages" ],
        "cancel": [ "FullScreenConfigurationMessages" ],
        "search": [ "FullScreenConfigurationMessages" ],
        "revisionRule": [ "FullScreenConfigurationMessages" ],
        "applyRevisionRule": [ "FullScreenConfigurationMessages" ],
        "advancedFeatureSelector": [ "ConfiguratorExplorerMessages" ],
        "familiesAndFeatures": [ "ConfiguratorExplorerMessages" ],
        "useExpressionFromVCV": [ "FullScreenConfigurationMessages" ]
    },
    "messages": {
        "displayErrorCode": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    }
}
