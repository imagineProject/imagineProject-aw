{
    "schemaVersion": "1.0.0",
    "actions": {
        "setSelectedFeaturesInConstraintsFilterPanel": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                        "name": "Pca0VariabilityPicker.addVariabilityOrLoadFeaturesFromServer"
                    }
                ]
            }
        },
        "addSelectedFeaturesToFilterPanel": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "Pca0VariabilityFilterPanel.updateFeatureFacetsSelections",
                    "eventData": {
                        "selected": "{{props.subPanelContext.selectedVariability.vmoSelected}}"
                    }
                } ]
            }
        }
    },
    "onEvent": [
        {
            "eventId": "Pca0AddVariability.addVariabilityFromPickAndChoosePanel",
            "action": "addSelectedFeaturesToFilterPanel"
        }
    ],
    "ctx": {
        "panelContext": {
            "type": "object"
        }
    },
    "conditions": {
        "showFeatures": {
            "expression": "data.selectedTab.tabKey === 'tc_xrt_Features'"
        },
        "showModels": {
            "expression": "data.selectedTab.tabKey === 'tc_xrt_Models'"
        }
    },
    "selectionModels": {
        "variabilitySelectionModel": {
            "selectionMode": "multiple"
        }
    },
    "data": {
        "tabModels": [
            {
                "name": "{{i18n.featuresTab}}",
                "tabKey": "tc_xrt_Features"
            },
            {
                "name": "{{i18n.modelsTab}}",
                "tabKey": "tc_xrt_Models"
            }
        ]
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "i18n": {
        "featuresTab": [ "ConfiguratorExplorerMessages" ],
        "modelsTab": [ "ConfiguratorExplorerMessages" ],
        "confirmSelections": [ "ConfiguratorExplorerMessages" ]
    }
}
