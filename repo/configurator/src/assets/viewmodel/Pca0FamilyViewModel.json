{
    "schemaVersion": "1.0.0",
    "actions": {
        "render": {
            "method": "pca0FamilyRenderFunction",
            "deps": "js/Pca0FamilyService",
            "options": {
                "elementRefList": [ "Pca0Family" ]
            }
        },
        "initializeComponent": {
            "actionType": "JSFunction",
            "method": "echoInput",
            "inputData": {
                "inputVal": true
            },
            "outputData": {
                "isMounted": true
            },
            "deps": "js/pca0CommonUtils"
        },
        "updateAnyFamilySelection": {
            "actionType": "JSFunction",
            "method": "updateFamilySelection",
            "inputData": {
                "family": "{{props.family}}",
                "famIndex": "{{props.famIndex}}",
                "configUid": "{{props.configuid}}",
                "selectAny": true
            },
            "deps": "js/Pca0FamilyService"
        },
        "updateNoneFamilySelection": {
            "actionType": "JSFunction",
            "method": "updateFamilySelection",
            "inputData": {
                "family": "{{props.family}}",
                "famIndex": "{{props.famIndex}}",
                "configUid": "{{props.configuid}}",
                "selectAny": false
            },
            "deps": "js/Pca0FamilyService"
        },
        "openRangeDialog": {
            "actionType": "JSFunction",
            "method": "openRangeDialog",
            "inputData": {
                "family": "{{props.family}}",
                "famIndex": "{{props.famIndex}}",
                "variantContext": "{{props.variantcontext}}",
                "configUid": "{{props.configuid}}",
                "rangDialogAction": "{{props.actions.rangeDialog}}"
            },
            "deps": "js/Pca0FamilyService"
        },
        "rangeDialog": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                    "global": true,
                    "view": "Pca0AddRangeFeaturePanel",
                    "placement": "right",
                    "parent": ".aw-layout-workarea",
                    "width": "SMALL",
                    "height": "FULL",
                    "isCloseVisible": false,
                    "isPinUnpinEnabled": true,
                    "subPanelContext": {
                        "sourceID": "fscFreeFormRangeExpPanel",
                        "commandContext": "props.value.family",
                        "contextKey": "fscContext",
                        "enumeratedMode": true
                    }
                }
            }
        }
    },
    "lifecycleHooks": {
        "render": "render",
        "onMount": "initializeComponent"
    },
    "props": {
        "famIndex": {
            "type": "integer"
        },
        "family": {
            "type": "object"
        },
        "displayName": {
            "type": "string"
        }
    },
    "conditions": {},
    "data": {
        "selectAny": {
            "action": "updateAnyFamilySelection",
            "iconName": "cmdSelectAny",
            "tooltip": "{{i18n.selectAny}}"
        },
        "selectNone": {
            "action": "updateNoneFamilySelection",
            "iconName": "cmdSelectNone",
            "tooltip": "{{i18n.selectNone}}"
        },
        "addFeature": {
            "action": "openRangeDialog",
            "iconName": "cmdAdd",
            "tooltip": "{{i18n.addFeature}}"
        },
        "unconfiguredFamily": {
            "action": "",
            "iconName": "indicatorConfiguredOut",
            "tooltip": "{{i18n.addFeature}}"
        },
        "multiSelectFamily": {
            "action": "",
            "iconName": "indicatorInfo",
            "tooltip": "{{i18n.aw_multi_select_message}}"
        },
        "isMounted": false
    },
    "i18n": {   },
    "onEvent": []
}
