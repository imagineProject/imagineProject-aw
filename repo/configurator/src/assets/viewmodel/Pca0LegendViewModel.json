{
    "schemaVersion": "1.0.0",
    "data": {},
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "lifecycleHooks": {
        "onUpdate": [ {
            "action": "initLegend",
            "observers": [
                "props.subPanelContext"
            ]
        }
    ]
    },
    "actions": {
        "initLegend": {
            "actionType": "JSFunction",
            "method": "initLegend",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/pca0CommonUtils"
        }
    },
    "conditions": {
        "containsLegendItemsInTooltip": {
            "expression": "subPanelContext.legendType === 'ConstraintsGridHeaderTooltip' || subPanelContext.legendType === 'NonGridableExpressionTooltip' || subPanelContext.legendType === 'SelectionSummarySelectionCountTooltip'"
        }
    }
}
