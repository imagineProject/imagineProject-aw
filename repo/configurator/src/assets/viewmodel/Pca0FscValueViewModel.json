{
    "schemaVersion": "1.0.0",
    "props": {
        "family": {
            "type": "object"
        },
        "value": {
            "type": "object"
        },
        "action": {
            "type": "action"
        },
        "valueaction": {
            "type": "string"
        },
        "variantcontext": {
            "type": "string"
        }
    },
    "actions": {
        "packageDialogAction": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                }
            }
        },
        "handleValueClick": {
            "actionType": "JSFunction",
            "method": "handleValueClick",
            "inputData": {
                "data": "{{data}}",
                "props": "{{props}}"
            },
            "outputData": {
                "featureData": ""
            },
            "deps": "js/pca0FscValueService"
        },
        "handleExcludeIconClick": {
            "actionType": "JSFunction",
            "method": "handleValueClick",
            "inputData": {
                "data": "{{data}}",
                "props": "{{props}}",
                "selectionState": 2
            },
            "outputData": {
                "featureData": ""
            },
            "deps": "js/pca0FscValueService"
        },
        "render": {
            "method": "pca0FscValueRenderFunction",
            "deps": "js/pca0FscValueService"
        },
        "initFeatureComponentData": {
            "actionType": "JSFunction",
            "method": "initFeatureComponentData",
            "inputData": {
                "textValue": "{{data.textValue}}",
                "dateValue": "{{data.dateValue}}",
                "props": "{{props}}"
            },
            "outputData": {
                "textValue": "result.textValue",
                "dateValue": "result.dateValue",
                "featureData": "result.value"
            },
            "deps": "js/pca0FscValueService"
        },
        "dateValueChangeBatch": {
            "actionType": "batchJob",
            "steps": [ 
                {
                    "action": "dateValueChange",
                    "condition": "!conditions.isDateEmpty"
                }
            ]
        },
        "dateValueChange": {
            "actionType": "JSFunction",
            "method": "dateValueChange",
            "inputData": {
                "featureData": "{{data.featureData}}",
                "props":"{{props}}",
                "dateValue": "{{data.dateValue}}"
            },
            "outputData": {
                "featureData": ""
            },
            "deps": "js/pca0FscValueService"
        },
        "textValueChanged": {
            "actionType": "JSFunction",
            "method": "setSelectionState",
            "inputData": {
                "featureData": "{{data.featureData}}",
                "props":"{{props}}",
                "textValue": "{{data.textValue}}"               
            },
              "outputData": {
                 "featureData": "result.newFeatureData",
                "textValue": "result.newTextData"
            },
            "deps": "js/pca0FscValueService"
        }
    },
    "i18n": {},
    "lifecycleHooks": {
        "render": "render",
        "onUpdate": [{
            "action": "initFeatureComponentData",
            "observers": [ "props.value.alternateID",
            "props.value.selectionState",
            "props.value.hasViolation" ]
        },{
            "action": "dateValueChangeBatch",
            "observers": [ "viewModel.data.dateValue.dbValue" ]
        }]
    },
    "conditions": {
        "isDateEmpty": {
            "expression": "data.dateValue.dbValue === '' || data.dateValue.dbValue === null || data.dateValue.dbValue === {}"
        }
    },
    "data": {
        "textValue": {
            "displayName": "",
            "type": "STRING",
            "dbValue": "",
            "isRequired": "false",
            "isEditable": "true",
            "dispValue": ""
        },
        "dateValue": {
            "displayName": "",
            "uiValue": "",
            "type": "DATE",
            "isEditable": "true",
            "dispValue": ""
        },
        "featureData": { }
    }
}
