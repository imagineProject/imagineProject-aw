{
    "schemaVersion": "1.0.0",
    "data": {
        "selectionIconsToTextConversionMessage": {
            "displayName": "{{i18n.selectionIconsToTextConversionMessage}}",
            "type": "STRING"
        },
        "positiveSelection": {
            "dispValue": "{{i18n.positive}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "negativeSelection": {
            "dispValue": "{{i18n.negative}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "defaultPositiveSelection": {
            "dispValue": "{{i18n.defaultPositive}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "defaultNegativeSelection": {
            "dispValue": "{{i18n.defaultNegative}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "systemPositiveSelection": {
            "dispValue": "{{i18n.systemPositive}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "systemNegativeSelection": {
            "dispValue": "{{i18n.systemNegative}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "isUnconfigured": {
            "dispValue": "{{i18n.isUnconfigured}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        }
    },
    "actions": {
        "exportDocBatch": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "exportDoc"
                },
                {
                    "action": "closePanel"
                }
            ]
        },
        "exportDoc": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "Pca0MultiVariantGridEditor.exportToExcelSelections"
                } ]
            }
        },
        "closePanel": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "",
                "popupId": "{{props.subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "i18n": {
        "export": [ "ExcelRoundTripMessages" ],
        "exportCmdTitle": [ "ExcelRoundTripMessages" ],
        "positive": [ "ConfiguratorCommonMessages" ],
        "negative": [ "ConfiguratorCommonMessages" ],
        "defaultPositive": [ "ConfiguratorMessages" ],
        "defaultNegative": [ "ConfiguratorMessages" ],
        "systemPositive": [ "ConfiguratorMessages" ],
        "systemNegative": [ "ConfiguratorMessages" ],
        "isUnconfigured": [ "FullScreenConfigurationMessages" ],
        "selectionIconsToTextConversionMessage": [ "ConfiguratorExplorerMessages" ]
    }
}
