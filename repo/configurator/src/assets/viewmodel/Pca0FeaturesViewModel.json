    "conditions": {
        "groupInfoChangedCondition": {
            "expression": "data.group.families",
            "trackValues": true
        },
        "definedCurrentScope": {
            "expression": "parameters.eventData.currentScopeSelectionUid !== ''"
        },
        "shouldLoadCachedScopeDataCondition": {
            "expression": "conditions.definedCurrentScope && parameters.eventData.soaResponse.ServiceData"
        },
        "shouldLoadScopeDataFromServerCondition": {
            "expression": "conditions.definedCurrentScope && !parameters.eventData.soaResponse.ServiceData"
        },
        "isNotPIP": {
            "expression": "ctx.fscContext.appliedSettings.configSettings.props.pca0ProductHierarchyDepth === undefined"
        }

