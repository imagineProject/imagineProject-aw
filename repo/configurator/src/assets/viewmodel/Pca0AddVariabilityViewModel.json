{
    "schemaVersion": "1.0.0",
    "actions": {
        "addVariabilityOrLoadFeaturesFromServer": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "Pca0VariabilityPicker.addVariabilityOrLoadFeaturesFromServer"
                } ]
            }
        },
        "addVariabilityToConstraintGrid": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "Pca0Constraints.addVariabilityToConstraintTree",
                    "eventData": {
                        "parentNode":"{{subPanelContext.vmo}}",
                        "isTopGrid":"{{subPanelContext.isTopGrid}}",
                        "gridEditorMode":"{{subPanelContext.gridEditorMode}}",
                        "selected": "{{data.atomicData.selectedVariability.vmoSelected}}",
                        "isPanelPinned":"{{subPanelContext.panelPinned}}",
                        "popupId":"{{subPanelContext.popupOptions.popupId}}"
                    }
                } ]
            }
        }
    },
    "onEvent": [ {
        "eventId": "Pca0AddVariability.addVariabilityFromPickAndChoosePanel",
        "action": "addVariabilityToConstraintGrid"
    } ],
    "data": {
        "selectionData": {
            "initialValues": {},
            "meta": {}
        },
        "selectedVariability": {
            "initialValues": {
                "vmoSelected": [],
                "featureSelected": [],
                "modelsSelected": [],
                "familiesNotExpanded": [],
                "userSelectionsPickAndChooseGrid": []
            },
            "meta": {}
        },
        "selectedFamilies": {
            "initialValues": {
                "familiesUid": []
            },
            "meta": {}
        }
    },
    "i18n": {
        "addPanelTitle": [ "ConfiguratorExplorerMessages" ],
        "addButtonTitle": [ "TCUICommandPanelsMessages" ]
    },
    "conditions": {
        "selectedVariabilityChanged": {
            "expression": "data.selectedVariability.selectedVariabilityChanged"
        }
    }
}
