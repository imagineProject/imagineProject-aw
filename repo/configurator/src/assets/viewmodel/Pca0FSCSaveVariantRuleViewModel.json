{
    "schemaVersion": "1.0.0",
    "actions": {
        "closeSaveVariantPanel": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "INFO_PANEL_CONTEXT",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },

            "deps": "js/dialogService"
        },
        "initSaveOrSaveAsPanel": {
            "actionType": "JSFunction",
            "method": "initSaveOrSaveAsPanel",
            "inputData": {
                "data": "{{data.panelTitle}}",
                "i18n": "{{i18n}}",
                "createVariantPreference": "{{props.subPanelContext.createVariantPreference}}"
            },
            "outputData": {
                "panelTitle": "title",
                "type": "type"
            },
            "deps": "js/pca0CommonUtils"
        }
    },
    "functions": {},
    "data": {
        "variantContext": "fscContext",
        "panelTitle": "{{subPanelContext.panelTitle}}",
        "variantRuleData": "{{subPanelContext.variantRuleData}}",
        "configCtx": "{{subPanelContext.configCtx}}",
        "isHostedPCAMode": "{{subPanelContext.isHostedPCAMode}}",
        "showAttachmentChoice": "{{subPanelContext.showAttachmentChoice}}"
    },
    "onEvent": [ {
        "eventId": "Pca0SaveVariant.closePanel",
        "action": "closeSaveVariantPanel"
    } ],
    "i18n": {
        "saveCmd": [
            "ConfiguratorCommonMessages"
        ],
        "saveAsCmd": [
            "ConfiguratorCommonMessages"
        ]
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "lifecycleHooks": {
        "onMount": "initSaveOrSaveAsPanel"
    }
}
