{
    "schemaVersion": "1.0.0",
    "actions": {
        "render": {
            "method": "pcaFeatureDispositionLovEditRenderFunction",
            "deps": "js/Pca0FeatureDispositionLovEditService"
        },
        "loadLOVs": {
            "actionType": "JSFunction",
