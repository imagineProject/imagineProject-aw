            },
            "outputData": {
                "listVals": "",
                "moreValuesExist": false
            },
            "deps": "js/Pca0FeatureDispositionLovEditService"
        }
    },
    "data": {},
    "conditions": {},
    "onEvent": [],
    "dataProviders": {
        "lovsDataProvider": {
            "action": "loadLOVs",
            "response": "{{data.listVals}}",
            "moreValuesExist": "{{data.moreValuesExist}}"
        }
    },
    "functions": {},
    "lifecycleHooks": {
        "render": "render"
    },
    "props": {
        "prop": {
            "type": "field"
        }
    }
}
