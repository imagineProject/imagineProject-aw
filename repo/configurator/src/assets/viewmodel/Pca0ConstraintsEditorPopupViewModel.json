{
    "schemaVersion": "1.0.0",
    "actions": {
        "initialize": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "initializeEditorProps"
                },
                {
                    "action": "initializeEditHandler"
                }
            ]
        },
        "initializeEditorProps": {
            "actionType": "JSFunction",
            "method": "initializeEditorProps",
            "inputData": {
                "popupOptions": "{{props.subPanelContext.popupOptions.popUpContext}}",
                "constraintEditor": "{{data.constraintEditor}}",
                "formula": "{{data.atomicDataRef.formula}}",
                "editorObject":"{{data.atomicDataRef.editorObject}}"
            },
            "outputData": {
                "constraintEditor": ""
            },
            "deps": "js/pca0ConstraintsEditorPopupService"
        },
        "initializeEditHandler": {
            "actionType": "JSFunction",
            "method": "initializeEditHandler",
            "inputData": {
                "declViewModel": "{{data}}"
            },
            "deps": "js/pca0ConstraintsEditorPopupService"
        },
        "saveConstraintFormula": {
            "actionType": "JSFunction",
            "method": "changeFormulaSuggesterEditContext",
            "inputData": {
                "editorObject":"{{data.atomicDataRef.editorObject}}",
                "editContext":"saveInProgress"
            },
            "deps": "js/pca0CommonUtils"
        },
        "saveConstraintExpression": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "setProperties",
                    "condition": "data.editorObject.editContext === 'saveInProgress'"
                }
            ]
        },
        "setProperties": {
            "actionType": "TcSoaService",
            "serviceName": "Core-2010-09-DataManagement",
            "method": "setProperties",
            "inputData": {
                "info": [
                    {
                        "object": "{{props.subPanelContext.popupOptions.popUpContext.vmo}}",
                        "timestamp": "",
                        "vecNameVal": [
                            {
                                "name": "{{props.subPanelContext.popupOptions.popUpContext.prop.propertyName}}",
                                "values": ["{{fields.formula.internal}}"]
                            }
                        ]
                    }
                ]
            },
            "outputData": {
                "saveConstraintResponse": ""
            },
            "events": {
                "success": [{
                        "name": "pca0ConstraintsEditorPopup.saveActionComplete"
                    },
                    {
                        "name": "pca0ConstraintsEditorPopup.postProcessSaveConstraintFormula"
                    }
                ],
                "failure": [
                    {
                        "name": "pca0ConstraintsEditorPopup.handleSaveActionFailure"
                    },{
                        "name": "pca0ConstraintsEditorPopup.saveActionComplete"
                    }
                ]
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "displayErrorCode"
                    }
                ]
            }

        },
        "postProcessSaveConstraintFormula": {
            "actionType": "JSFunction",
            "method": "cancelEdits",
            "deps": "js/editHandlerService"
        },
        "handleSaveActionFailure": {
            "actionType": "JSFunction",
            "method": "changeFormulaSuggesterEditContext",
            "inputData": {
                "editorObject":"{{data.atomicDataRef.editorObject}}",
                "editContext":"editing",
                "ServiceData":"{{data.saveConstraintResponse.ServiceData}}"
            },
            "deps": "js/pca0CommonUtils"
        },
        "closeConstraintsEditorPopup": {
            "actionType": "JSFunction",
            "method": "closeConstraintsEditorPopup",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext.popupApi}}"
            },
            "deps": "js/pca0ConstraintsEditorPopupService"
        },
        "StartEditConstraintFormula": {
            "actionType": "JSFunction",
            "method": "startEditConstraintFormula",
            "inputData": {
                "editorObject":"{{data.atomicDataRef.editorObject}}"
            },
            "deps": "js/pca0ConstraintsEditorPopupService"
        },
        "cancelConstraintFormulaEditing": {
            "actionType": "JSFunction",
            "method": "changeFormulaSuggesterEditContext",
            "inputData": {
                "editorObject":"{{data.atomicDataRef.editorObject}}",
                "editContext":"readOnly"
            },
            "deps": "js/pca0CommonUtils"
        },
        "doEditorUnmount": {
            "actionType":"batchJob",
            "steps": [
                {
                "action": "changeCommandVmoEditState",
                "condition": "props.subPanelContext.popupOptions.popUpContext.vmo.isEditing === true"
                },{
                    "action": "removeEditHandler"
                }
            ]
        },
        "changeCommandVmoEditState": {
            "actionType": "JSFunction",
            "method": "changeCommandVmoEditState",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext.popupOptions.popUpContext.vmo}}"
            },
            "deps": "js/pca0ConstraintsEditorPopupService"
        },
        "removeEditHandler": {
            "actionType": "JSFunction",
            "method": "removeEditHandler",
            "inputData": {
                "type": "CONSTRAINT_FORMULA_EDIT_CONTEXT"
            },
            "deps": "js/editHandlerService"
        }
    },
    "onEvent": [
        {
            "eventId": "pca0ConstraintsEditorPopup.closeConstraintsEditorPopup",
            "action": "closeConstraintsEditorPopup"
        },
        {
            "eventId": "pca0ConstraintsEditorPopup.handleSaveActionFailure",
            "action": "handleSaveActionFailure"
        },
        {
            "eventId": "pca0ConstraintsEditorPopup.postProcessSaveConstraintFormula",
            "action": "postProcessSaveConstraintFormula"
        }
    ],
    "data": {
        "formula":{
            "initialValues":{},
            "meta":{}
        },
        "editorObject":{
            "initialValues":{
                "syntaxValidationInProgress":false,
                "clearFormulaInProgress":false,
                "editContext":"readOnly",
                "sharedCommandBarOverflow":false
            },
            "meta":{}
        },
        "constraintEditor": {},
        "constraintFormulaEditHandler": {
            "context": "CONSTRAINT_FORMULA_EDIT_CONTEXT"
        }
    },
    "messages": {
        "displayErrorCode": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },
    "lifecycleHooks": {
        "onMount": "initialize",
        "onUnmount": "doEditorUnmount",
        "onUpdate": [
            {
                "action": "saveConstraintExpression",
                "observers": [
                    "fields.formula"
                ]
            }
        ]
    },
    "i18n": {
        "saveButtonText": [
            "ConfiguratorExplorerMessages"
        ],
        "cancel": [
            "ConfiguratorExplorerMessages"
        ],
        "edit": [
            "FullScreenConfigurationMessages"
        ],
        "close": [
            "ConfiguratorCommonMessages"
        ]
    }
}
