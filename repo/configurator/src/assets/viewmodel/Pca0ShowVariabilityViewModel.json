{
    "schemaVersion": "1.0.0",
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "selection-data": {
            "type": "object"
        },
        "selected-variability": {
            "type": "object"
        },
        "selected-families":{
            "type": "object"
        },
        "display-properties":{
            "type": "object"
        },
        "feature-client-scope": {
            "type": "string"
        },
        "models-client-scope": {
            "type": "string"
        },
        "config-perspective": {
            "type": "object"
        }
    },
    "actions": {
        "initialize": {
            "actionType": "JSFunction",
            "method": "loadPanelTabs",
            "inputData": {
                "tabModels": "{{data.defaultTabModels}}",
                "displayProperties": "{{props.displayProperties}}"
            },
            "outputData": {
                "tabModels": "visibleTabs"
            },
            "deps": "js/pca0AddVariabilityService"
        }
    },
    "conditions": {
        "showFeatures": {
            "expression": "data.selectedTab.tabKey === 'tc_xrt_Features'"
        },
        "showModels": {
            "expression": "data.selectedTab.tabKey === 'tc_xrt_Models'"
        }
    },
    "selectionModels": {
        "variabilitySelectionModel": {
            "selectionMode": "multiple"
        }
    },
    "data": {
        "defaultTabModels": [
            {
                "name": "{{i18n.featuresTab}}",
                "tabKey": "tc_xrt_Features"
            },
            {
                "name": "{{i18n.modelsTab}}",
                "tabKey": "tc_xrt_Models"
            }
        ]
    },
    "lifecycleHooks": {
        "onMount": "initialize"
    },
    "i18n": {
        "featuresTab": [ "ConfiguratorExplorerMessages" ],
        "modelsTab": [ "ConfiguratorExplorerMessages" ]
    }
}
