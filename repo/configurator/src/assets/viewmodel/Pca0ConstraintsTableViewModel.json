                        "columns": "{{data.dataProviders.pca0ConstraintsDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "attributesToInflate": "{{ctx.search.tableViewProperties}}",
                        "maxToLoad": 99,
                        "maxToReturn": 50,
                        "providerName": "Pca0ConstraintsProvider",
                        "searchCriteria": "{{function:getInputCriteriaForColumnProvider}}",
                        "columnFilters": "{{data.columnProviders.pca0ConstraintsColumnProvider.columnFilters}}",
                        "searchSortCriteria": "{{data.columnProviders.pca0ConstraintsColumnProvider.sortCriteria}}",
                        "cursor": {
                            "startIndex": "{{data.dataProviders.pca0ConstraintsDataProvider.startIndex}}"
                        },
                        "searchFilterMap6": "{{function:getInputSearchFilterMapForColumnProvider}}"
                    },
                    "inflateProperties": true
                },
                "1": {
                    "types": "{{function:getPropertyPolicyForPerformSearch}}",
                    "override":true
                }
            },
            "outputData": {
                "searchResults": "{{json:searchResultsJSON}}",
                "totalFound": "totalFound",
                "dataProviders.pca0ConstraintsDataProvider.columnConfig": "{{function:getColumnConfig}}",
                "lastLoadedConstraintUid": "{{function:getLastUid}}",
                "dataProviders.pca0ConstraintsDataProvider._enableAccScroll": false,
                "serviceData": "ServiceData",
                "ctx.searchResponseInfo.totalFound": "totalFound"
            }
        },
        "resetColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [ {
                        "scope": "LoginUser",
                        "scopeName": "",
                        "clientName": "AWClient",
                        "resetColumnConfig": true,
                        "columnConfigQueryInfos": [ {
                            "clientScopeURI": "Pca0Constraints",
                            "operationType": "union",
                            "typeNames": "{{data.dataProviders.pca0ConstraintsDataProvider.columnConfig.typesForArrange}}",
                            "columnsToExclude": []
                        } ],
                        "businessObjects": [ {} ]
                    } ]
                }
            },
            "outputData": {
                "dataProviders.pca0ConstraintsDataProvider.columnConfig": "{{function:postResetFunction}}"
            },
            "events": {
                "success": [ {
                    "name": "pca0ConstraintsGrid.plTable.reload"
                } ]
            }
        },
        "doArrangeEvent": {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "deleteConstraints": {
            "actionType": "TcSoaService",
            "serviceName": "Core-2019-06-DataManagement",
            "method": "unlinkAndDeleteObjects",
            "inputData": {
                "deleteInput": "{{function:unlinkAndDeleteFunction}}"
            },
            "outputData": {
                "unlinkAndDeleteObjectsResponse": ""
            },
            "events": {
                "failure": [ {
                    "name": "Pca0ConstraintsTableViewModel.processPartialErrors",
                    "eventData": {
                        "ServiceData": "{{data.unlinkAndDeleteObjectsResponse}}"
                    }
                } ],
                "success": [ {
                "name": "pca0ConstraintsGrid.plTable.reload"
                } ]}
            ,
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "processPartialErrors": {
            "actionType": "JSFunction",
            "method": "processPartialErrors",
            "inputData": {
                "eventData": "{{data.eventData.ServiceData}}"
            },
            "deps": "js/pca0CommonUtils"
        },
        "validateAndAddCreatedConstraintsToPWA": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Pca0Constraints"
                    },
                    "saveColumnConfigData": {
                        "clientScopeURI": "Pca0Constraints",
                        "columnConfigId": "{{data.dataProviders.pca0ConstraintsDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.pca0ConstraintsDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "attributesToInflate": "{{ctx.search.tableViewProperties}}",
                        "maxToLoad": 99,
                        "maxToReturn": 50,
                        "providerName": "Pca0ApplyPrecFilterProvider",
                        "searchCriteria": "{{function:getNewlyAddedCriteria}}",
                        "columnFilters": "{{data.columnProviders.pca0ConstraintsColumnProvider.columnFilters}}",
                        "searchSortCriteria": "{{data.columnProviders.pca0ConstraintsColumnProvider.sortCriteria}}",
                        "cursor": {
                            "startIndex": "{{data.dataProviders.pca0ConstraintsDataProvider.startIndex}}"
                        }
                    },
                    "inflateProperties": true
                },
                "1": {
                    "types": "{{function:getPropertyPolicyForPerformSearch}}",
                    "override":true
                }
            },
            "outputData": {
                "searchResults": "{{json:searchResultsJSON}}",
                "objectNames": "{{function:getCreatedObjectsNames}}",
                "serviceData": "ServiceData"
            },
            "events": {
                "success": [ {
                    "name": "Pca0ConstraintsTable.addCreatedConstraintsToPWA",
                    "eventData": {
                        "modelObjects": "{{data.searchResults}}",
                        "isSaveAsAction": "{{parameters.isSaveAsAction}}"
                    },
                    "condition": "data.serviceData.plain.length > 0"
                },
                {
                    "name": "Pca0Constraints.constraintCreated",
                    "eventData": {
                        "constraints": "{{parameters.eventData.constraints}}"
                    },
                    "condition": "parameters.eventData.canLoadInEditor && data.serviceData.plain.length > 0"
                }
            ],
                "failure": [ {
                    "name": "Pca0ConstraintsTableViewModel.processPartialErrors",
                    "eventData": {
                        "searchResults": "{{data.searchResults}}"
                    }
                } ]
            },
            "actionMessages": {
                "success": [ {
                    "condition": "data.serviceData.plain === undefined",
                    "message": "objectFilteredOutMessage"
                } ]
            }
        },
        "validateRevisedObject": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Pca0Constraints"
                    },
                    "saveColumnConfigData": {
                        "clientScopeURI": "Pca0Constraints",
                        "columnConfigId": "{{data.dataProviders.pca0ConstraintsDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.pca0ConstraintsDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "attributesToInflate": "{{ctx.search.tableViewProperties}}",
                        "maxToLoad": 99,
                        "maxToReturn": 50,
                        "providerName": "Pca0ApplyPrecFilterProvider",
                        "searchCriteria": "{{function:getReviseCriteria}}",
                        "columnFilters": "{{data.columnProviders.pca0ConstraintsColumnProvider.columnFilters}}",
                        "searchSortCriteria": "{{data.columnProviders.pca0ConstraintsColumnProvider.sortCriteria}}",
                        "cursor": {
                            "startIndex": "{{data.dataProviders.pca0ConstraintsDataProvider.startIndex}}"
                        }
                    },
                    "inflateProperties": true
                },
                "1": {
                    "types": "{{function:getPropertyPolicyForPerformSearch}}",
                    "override":true
                }
            },
            "outputData": {
                "searchResults": "{{json:searchResultsJSON}}"
            },
            "events": {
                "success": [ {
                    "name": "Pca0Constraints.showReviseObjects",
                    "eventData": {
                        "searchResults": "{{data.searchResults}}"
                    }
                } ],
                "failure": [ {
                    "name": "Pca0ConstraintsTableViewModel.processPartialErrors",
                    "eventData": {
                        "searchResults": "{{data.searchResults}}"
                    }
                } ]
            }
        },
        "updateObjectAfterRevise": {
            "actionType": "JSFunction",
            "method": "updateObjectAfterRevise",
            "inputData": {
                "selectedObject": "{{data.ctx.selected}}",
                "dataProvider": "{{data.dataProviders.pca0ConstraintsDataProvider}}",
                "response": "{{parameters.eventData.searchResults}}"
            },
            "outputData": {
                "searchResults": "{{json:searchResultsJSON}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "validateIsReviseAction": {
            "actionType": "JSFunction",
            "method": "validateIsReviseAction",
            "inputData": {
                "tag" : "{{parameters.tag}}"
            },
            "outputData": {
                "isReviseAction" : ""
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "openAddConstraintDialog": {
            "actionType": "JSFunction",
            "method": "openAddConstraintPanel",
            "inputData": {
                "input": {
                    "commandContext": "{{commandContext}}",
                    "commandId": "Pca0ConstraintsGridEditorAdd",
                    "constraintsTableData": "{{data.atomicDataRef.constraintsTableData}}"
                }
            },
            "deps": "js/pca0ConstraintsGridService"
        },
        "fetchConstraintFilterCategoriesAndFacets": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Pca0Constraints"
                    },
                    "searchInput": {
                        "providerName": "Pca0ConstraintsProvider",
                        "searchCriteria": "{{function:getFilterCategoryAndFacetsInput}}"
                    },
                    "inflateProperties": false
                }
            },
            "outputData": {
                "output": "{{function:cacheFilterCategoriesAndOpenDialog}}"
            }
        },
        "applyConstraintsFilter": {
            "actionType": "JSFunction",
            "method": "updateFilteringInputs",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "events": {
                "success": [
                    {
                        "name": "pca0ConstraintsGrid.plTable.reload"
                    } 
                ]
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "resetStateParams": {
            "actionType": "JSFunction",
            "method": "resetStateParams",
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "constraintsTableRefreshCommandBatchAction": {
            "actionType": "batchJob",
            "steps": [  {
                    "action": "resetStateParams",
                    "condition": "conditions.Pca0IsCfgSelectedItemsOnPage"
                },
                {
                    "action": "resetPrimaryWorkAreaTableBatchAction"
                }
            ]
        }
    },
    "dataProviders": {
        "pca0ConstraintsDataProvider": {
            "action": "loadConstraintsData",
            "editContext": "TABLE_CONTEXT",
            "nextAction": "loadConstraintsData",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "_enableAccScroll":false,
            "commandsAnchor": "aw_splmTableCommandsAnchor",
            "inputData": {
                "accessMode": "table",
                "selectionModel": "{{subPanelContext.selectionModel}}",
                "editSupportParamKeys": [ "s_uid", "d_uids" ]
            }
        }
    },
    "columnProviders": {
        "pca0ConstraintsColumnProvider": {
            "saveColumnAndLoadAction": "saveColumnConfigAndReloadData",
            "resetColumnAction": "resetColumnConfig"
        }
    },
    "grids": {
        "pca0ConstraintsGrid": {
            "dataProvider": "pca0ConstraintsDataProvider",
            "columnProvider": "pca0ConstraintsColumnProvider",
            "enableArrangeMenu": true,
            "gridOptions": {
                "enableSorting": true,
                "enableGridMenu": true,
                "isFilteringEnabled": true,
                "enableExpandAndPaginationInEdit": false
            }
        }
    },
    "messages": {
        "deleteMultipleConstraintsConfirmationMessage": {
            "messageType": "WARNING",
            "messageText": "{{i18n.deleteMultipleConstraintsConfirmationMsg}}",
            "messageTextParams": [
                "{{commandContext.selectionData.selected.length}}"
            ],
            "navigationOptions": [ {
                    "option": "Cancel",
                    "text": "{{i18n.cancel}}"
                },
                {
                    "option": "Delete",
                    "text": "{{i18n.deleteText}}",
                    "action": "deleteConstraints"
                }
            ]
        },
        "deleteSingleConstraintConfirmationMessage": {
            "messageType": "WARNING",
            "messageText": "{{i18n.deleteSingleConstraintsConfirmationMsg}}",
            "messageTextParams": [
                "{{commandContext.selectionData.selected[0].props.object_name.uiValues[0]}}"
            ],
            "navigationOptions": [ {
                    "option": "Cancel",
                    "text": "{{i18n.cancel}}"
                },
                {
                    "option": "Delete",
                    "text": "{{i18n.deleteText}}",
                    "action": "deleteConstraints"
                }
            ]
        },
        "selectedConstraintsMessage": {
            "messageType": "INFO",
            "messageText": "{{i18n.selectedConstraintsMessage}}"
        },
        "objectFilteredOutMessage": {
            "messageType": "INFO",
            "messageText": "{{i18n.objectFilteredOut}}",
            "messageTextParams": [ "{{data.objectNames}}" ]
        }
    },
    "onEvent":
    [
        {
            "eventId": "reviseObject.assignProjects",
            "action": "validateIsReviseAction",
            "inputArgs": {
                "tag": "revise"
            }
        },
        {
            "eventId": "Pca0ConstraintsTable.openAddDialog",
            "action": "openAddConstraintDialog"
        },
        {
            "eventId": "Pca0ConstraintsTable.fetchAvailableConstraintTypes",
            "action": "getApplicableConstraintTypes",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "saveAsObject.assignProjects",
            "action": "validateIsReviseAction",
            "inputArgs": {
                "tag": "saveAs"
            }
        },
        {
            "eventId": "Pca0ReviseObjectPostHandler",
            "condition": "data.isReviseAction === true",
            "action": "validateRevisedObject",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0Constraints.showReviseObjects",
            "action": "updateObjectAfterRevise",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "columnArrange",
            "cacheEventData": true,
            "action": "doArrangeEvent",
            "criteria": {
                "name": "pca0ConstraintsGrid"
            }
        },
        {
            "eventId": "Pca0FilterCriteriaSettings.filterCriteriaUpdated",
            "action": "storageSyncAndFirePWAReset"
        },
        {
            "eventId": "primaryWorkarea.multiSelectAction",
            "action": "refreshPrimaryWorkArea"
        },
        {
            "eventId": "Pca0ConstraintsTable.deleteMultipleConstraints",
            "message": "deleteMultipleConstraintsConfirmationMessage"
        },
        {
            "eventId": "Pca0ConstraintsTable.deleteSingleConstraint",
            "message": "deleteSingleConstraintConfirmationMessage"
        },
        {
            "eventId": "Pca0ConstraintsTableViewModel.processPartialErrors",
            "action": "processPartialErrors",
            "cacheEventData": true
        },
        {
            "eventId": "pca0ConstraintsTable.reloadContent",
            "action": "constraintsTableRefreshCommandBatchAction"
        },
        {
            "eventId": "Pca0ConstraintsFilter.fetchConstraintFilterCategoriesAndFacets",
            "action": "fetchConstraintFilterCategoriesAndFacets",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0ConstraintsGrid.applyConstraintsFilter",
            "action": "applyConstraintsFilter",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0ConstraintsTable.validateAndAddCreatedConstraintsToPWA",
            "action": "validateAndAddCreatedConstraintsToPWA",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0ConstraintsTable.addCreatedConstraintsToPWA",
            "action": "addCreatedConstraintsToPWA",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Awp0ShowSaveAs.saveAsComplete",
            "action": "validateAndAddCreatedConstraintsToPWA",
            "inputArgs": {
                "eventData": "{{eventData}}",
                "isSaveAsAction": true
            },
            "condition": "conditions.isSaveAsAction"
        }
    ],
    "conditions": {
        "showEmptyWorkarea":
        {
            "expression": "data.totalFound === 0 && data.additionalInfoMessages.includes( 'noDataFoundForContext' )"
        },
        "isFormulaSuggesterEnabled": {
            "expression": "ctx.state.urlAttributes.formulaSuggester !== undefined"
        },
        "Pca0IsCfgSelectedItemsOnPage": {
            "expression": "ctx.state.params.cfgSelectedItemsInPage !== undefined"
        },
        "isSaveAsAction": {
            "expression": "ctx.SAVEAS_PANEL_CONTEXT !== undefined"
        }
    },
    "functions": {
        "getCreatedObjectsNames": {
            "functionName": "getCreatedObjectsNames",
            "parameters": [ "{{parameters.eventData}}" ],
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
