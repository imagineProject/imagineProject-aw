                        "cursor": {
                            "startIndex": "{{data.dataProviders.pca0ConstraintsDataProvider.startIndex}}"
                        },
                        "searchFilterMap6": "{{function:getInputSearchFilterMap}}"
                    },
                    "inflateProperties": true
                },
                "1": {
                    "types": "{{function:getPropertyPolicyForPerformSearch}}",
                    "override":true
                }
            },
            "outputData": {
                "searchResults": "{{json:searchResultsJSON}}",
                "totalFound": "totalFound",
                "lastLoadedConstraintUid": "{{function:getLastUid}}",
                "dataProviders.pca0ConstraintsDataProvider._enableAccScroll": false,
                "dataProviders.pca0ConstraintsDataProvider.columnConfig": "{{function:getColumnConfig}}",
                "serviceData": "ServiceData",
                "ctx.searchResponseInfo.columnConfig": "{{function:getColumnConfig}}",
                "ctx.searchResponseInfo.totalFound": "totalFound",
                "additionalInfoMessages": "{{function:updateAdditionalInfoMessages}}"
            }
        },
        "getItemsToSelect": {
