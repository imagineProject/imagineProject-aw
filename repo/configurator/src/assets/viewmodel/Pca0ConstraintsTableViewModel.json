        "refreshPrimaryWorkArea": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "pca0ConstraintsGrid.plTable.clientRefresh"
                } ]
            }
        },
        "loadConstraintsData": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "loadConstraintsDataFromServer"
                },
                {
                    "action": "getItemsToSelect",
                    "condition": "conditions.Pca0IsCfgSelectedItemsOnPage"
                },
                {
                    "action": "selectAndOpenItems",
                    "condition": "conditions.Pca0IsCfgSelectedItemsOnPage"
                },
                {
                    "action": "switchToGridOrMatrixTab",
                    "condition":"conditions.Pca0IsCfgSelectedItemsOnPage"
                }
            ]
        },
        "loadConstraintsDataFromServer": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Pca0Constraints"
                    },
                    "searchInput": {
                        "attributesToInflate": "{{ctx.search.tableViewProperties}}",
                        "maxToLoad": 99,
                        "maxToReturn": 50,
                        "providerName": "Pca0ConstraintsProvider",
                        "searchCriteria": "{{function:getInputCriteria}}",
                        "columnFilters": "{{data.columnProviders.pca0ConstraintsColumnProvider.columnFilters}}",
                        "searchFilterFieldSortType": "Priority",
