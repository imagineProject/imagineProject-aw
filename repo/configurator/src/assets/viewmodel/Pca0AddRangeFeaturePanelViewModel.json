{
    "schemaVersion": "1.0.0",
    "actions": {
        "addFeatureToFamily": {
            "actionType": "JSFunction",
            "method": "addFeatureToFamily",
            "inputData": {
                "fromOp": "{{data.fromOperator.uiValue}}",
                "fromValue": "{{data.fromFeatureComponent.uiValue}}",
                "toOp": "{{data.toOperator.uiValue}}",
                "toValue": "{{data.toFeatureComponent.uiValue}}",
                "fromDateValue": "{{data.fromDateFeatureComponent.uiValue}}",
                "toDateValue": "{{data.toDateFeatureComponent.uiValue}}",
                "fromListValue": "{{data.fromFeatureListComponent.uiValue}}",
                "toListValue": "{{data.toFeatureListComponent.uiValue}}",
                "subPanelContext": "{{data.subPanelContext}}",
                "familyType": "{{data.typeOfFamily}}",
                "isFreeForm": "{{data.isFreeForm}}",
                "featureVMOs": "{{data.featureVMOS}}",
                "selectedObject": "{{data.selectedObject}}"
            },
            "deps": "js/pca0AddRangeFeaturePanelService"
        },
        "initializeData": {
            "actionType": "JSFunction",
            "method": "initComponentData",
            "inputData": {
                "data": "{{data}}",
                "subPanelContext": "{{subPanelContext}}"
            },
            "outputData": {
                "typeOfFamily": "result.typeOfFamily",
                "nameOfFamily": "result.nameOfFamily",
                "fromOperator": "result.fromOperator",
                "fromOperatorListValues": "result.fromOperatorList",
                "fromFeatureComponent": "result.fromComponentData",
                "toOperator": "result.toOperator",
                "toFeatureComponent": "result.toComponentData",
                "fromDateFeatureCompoent": "result.fromDateFeatureValue",
                "toDateFeatureComponent": "result.toDateFeatureValue",
                "fromFeatureListComponent": "result.fromFeatureListComponent",
                "fromEnumListFeatureValues": "result.fromEnumListFeatureValues",
                "toFeatureListComponent": "result.toFeatureListComponent",
                "showRangeTitle": "result.showRangeTitle",
                "isFreeForm": "result.isFreeForm",
                "displayValues": "result.displayValues",
                "idValues": "result.idValues",
                "selectedObject": "result.selectedObject",
                "toFamily": "result.selectedObject"
            },
            "events": {
                "success": [
                    {
                        "name": "Pca0AddRangeFeaturePanel.loadToFamilyInPanel",
                        "eventData": {
                            "data": "{{data}}"
                        }
                    },
                    {
                        "name": "Pca0AddRangeFeaturePanel.loadFeaturesForFamily"
                    }
                ]
            },
            "deps": "js/pca0AddRangeFeaturePanelService"
        },
        "loadToFamilyInPanel": {
            "actionType": "JSFunction",
            "method": "loadFamilyInPanel",
            "inputData": {
                "subPanelContext": "{{subPanelContext}}"
            },
            "outputData": {
                "toFamily": ""
            },
            "deps": "js/pca0AddRangeFeaturePanelService"
        },
        "loadVariabilityFromServer": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-ProductConfiguratorAw-2024-06-ConfiguratorManagement",
            "method": "getVariability3",
            "inputData": {
                "configPerspective": "{{ctx.ConfiguratorCtx.configPerspective}}",
                "configContext": {
                    "uid": "AAAAAAAAAAAAAA",
                    "type": "unknownType"
                },
                "requestType": [],
                "parentUids": [
                    "{{data.selectedObject.uid}}"
                ],
                "level": 0,
                "sortCriteria": [],
                "columnFilters": [],
                "requestInfo": ""
            },
            "outputData": {
                "viewModelObjectMap": "viewModelObjectMap"
            },
            "events": {
                "success": [
                    {
                        "name": "Pca0AddRangeFeaturePanel.updatePanelComponent",
                        "eventData": {
                            "data": "{{data}}"
                        }
                    }
                ]
            },
            "deps": "js/pca0AddRangeFeaturePanelService"
        },
        "updateToEnumList": {
            "actionType": "JSFunction",
            "method": "updateToEnumList",
            "inputData": {
                "fromListValue": "{{data.fromFeatureListComponent.dbValue}}",
                "toFeatureListComponent": "{{data.toFeatureListComponent}}",
                "toEnumList": "{{data.toEnumListFeatureValues}}",
                "toOperatorValue": "{{data.toOperator.dbValue}}",
                "familyType": "{{data.typeOfFamily}}",
                "displayValues": "{{data.displayValues}}",
                "idValues": "{{data.idValues}}",
                "fromFeatureListComponent": "{{data.fromFeatureListComponent}}",
                "fromOperatorValue": "{{data.fromOperator.dbValue}}",
                "isFromOperatorChanged" : "{{parameters.isFromOperatorChanged}}",
                "isFreeForm": "{{data.isFreeForm}}"
            },
            "outputData": {
                "toFeatureListComponent": "result.featureListComponent",
                "toEnumListFeatureValues": "result.toListValues",
                "fromFeatureListComponent": "result.fromFeatureListComponent"
            },
            "deps": "js/pca0AddRangeFeaturePanelService"
        },
        "updatePanelComponent": {
            "actionType": "JSFunction",
            "method": "updatePanelComponent",
            "inputData": {
                "eventData": "{{parameters.eventData}}",
                "selectedObject": "{{data.selectedObject}}"
            },
            "outputData": {
                "fromEnumListFeatureValues": "result.featureListValues",
                "featureVMOS": "result.featureUids",
                "displayValues": "result.displayValues",
                "idValues": "result.idValues"
            },
            "deps": "js/pca0AddRangeFeaturePanelService"
        },
        "closeDialog": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "INFO_PANEL_CONTEXT",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "dataProviders": {
        "fromEnumListProvider": {
            "response": "{{data.fromEnumListFeatureValues}}"
        },
        "toEnumListProvider": {
            "response": "{{data.toEnumListFeatureValues}}"
        },
        "fromOperatorListProvider": {
            "response": "{{data.fromOperatorListValues}}"
        },
        "toOperatorListProvider": {
            "response": "{{data.toOperatorListValues}}"
        }
    },
    "data": {
        "typeOfFamily": "",
        "isFreeForm": false,
        "displayValues": [],
        "idValues": [],
        "fromEnumListFeatureValues": [],
        "toEnumListFeatureValues": [],
        "expressionAndValue": " & ",
        "nameOfFamily": "",
        "fromFeatureComponent": {
            "dbValue": "",
            "uiValue": "",
            "isDisplayable": true,
            "isEditable": true,
            "type": "",
            "renderingHint": "",
            "dateApi": {
                "isDateEnabled": true
            }
        },
        "fromOperator": {
            "displayName": "{{i18n.fromTitle}}",
            "type": "STRING",
            "isRequired": "true",
            "hasLov": "true",
            "dbValue": "",
            "uiValue": "",
            "isSelectOnly": true,
            "dataProvider": "fromOperatorListProvider"
        },
        "fromDateFeatureComponent": {
            "dbValue": "",
            "uiValue": "",
            "isDisplayable": true,
            "isEditable": true,
            "type": "DATE",
            "renderingHint": "date",
            "dateApi": {
                "isDateEnabled": true
            }
        },
        "fromFeatureListComponent": {
            "displayName": "",
            "type": "",
            "isRequired": false,
            "dataProvider": "fromEnumListProvider",
            "uiValue": "",
            "dbValue": "",
            "isSelectOnly": false
        },
        "fromOperatorListValues": [
            {
                "propInternalValue": ">=",
                "propDisplayValue": ">="
            },
            {
                "propInternalValue": ">",
                "propDisplayValue": ">"
            },
            {
                "propInternalValue": "<=",
                "propDisplayValue": "<="
            },
            {
                "propInternalValue": "<",
                "propDisplayValue": "<"
            }
        ],
        "toOperator": {
            "displayName": "{{i18n.toTitle}}",
            "type": "STRING",
            "isRequired": "false",
            "hasLov": "true",
            "uiValue": "--",
            "dbValue": "--",
            "isSelectOnly": true,
            "dataProvider": "toOperatorListProvider"
        },
        "toOperatorListValues": [
            {
                "propInternalValue": "--",
                "propDisplayValue": "--"
            },
            {
                "propInternalValue": "<=",
                "propDisplayValue": "<="
            },
            {
                "propInternalValue": "<",
                "propDisplayValue": "<"
            }
        ],
        "toFeatureListComponent": {
            "displayName": "",
            "type": "",
            "isRequired": true,
            "dataProvider": "toEnumListProvider",
            "uiValue": "",
            "dbValue": "",
            "isSelectOnly": false
        },
        "toFeatureComponent": {
            "dbValue": "",
            "uiValue": "",
            "isDisplayable": true,
            "isEditable": true,
            "type": "",
            "renderingHint": ""
        },
        "toDateFeatureComponent": {
            "dbValue": "",
            "uiValue": "",
            "isDisplayable": true,
            "isEditable": true,
            "type": "DATE",
            "renderingHint": "date",
            "dateApi": {
                "isDateEnabled": true
            }
        },
        "previewTitle": {
            "displayName": "{{i18n.previewTitle}}",
            "type": "STRING",
            "isRequired": "false",
            "isEditable": "false",
            "dbValue": ""
        },
        "textTitle": {
            "displayName": "{{i18n.Text}}",
            "dispValue": "{{i18n.equalText}}",
            "renderingHint": "label",
            "type": "STRING",
            "dbValue": "=",
            "isEditable": false
        },
        "showRangeTitle": {
            "displayName": "{{i18n.allowedRangeText}}",
            "dispValue": "",
            "renderingHint": "label",
            "type": "STRING",
            "dbValue": "",
            "isEditable": false
        }
    },
    "conditions": {
        "isToPartEnable": {
            "expression": "data.fromOperator.uiValue === '>' || data.fromOperator.uiValue === '>='"
        },
        "isEqualFromEnable": {
            "expression": "data.fromOperator.uiValue === '='"
        },
        "toOperatorIsValid": {
            "expression": "data.toOperator.uiValue === '<' || data.toOperator.uiValue === '<='"
        },
        "isDateFamily": {
            "expression": "data.typeOfFamily === 'Date'"
        },
        "isStringFamily": {
            "expression": "data.typeOfFamily === 'String'"
        },
        "isFreeFormFamily": {
            "expression": "data.isFreeForm === true"
        },
        "hasFeaturesToLoad": {
            "expression": "data.selectedObject.uid !== undefined && data.isFreeForm !== true && data.typeOfFamily !== 'String' && data.typeOfFamily !== 'Date'"
        },
        "isRangeInfoAvailable": {
            "expression": "data.showRangeTitle.uiValue !== '' && data.showRangeTitle.uiValue !== undefined"
        }
    },
    "onEvent": [
        {
            "condition": "!conditions.hasFeaturesToLoad",
            "eventId": "Pca0AddRangeFeaturePanel.loadToFamilyInPanel",
            "action": "loadToFamilyInPanel"
        },
        {
            "eventId": "fromFeatureListComponent.lovValueChanged",
            "action": "updateToEnumList"
        },
        {
            "eventId": "toOperator.lovValueChanged",
            "action": "updateToEnumList"
        },
        {
            "eventId": "fromOperator.lovValueChanged",
            "inputArgs": {
                "isFromOperatorChanged" : true
            },
            "action": "updateToEnumList"
        },
        {
            "condition": "conditions.hasFeaturesToLoad",
            "eventId": "Pca0AddRangeFeaturePanel.loadFeaturesForFamily",
            "action": "loadVariabilityFromServer"
        },
        {
            "eventId": "Pca0AddRangeFeaturePanel.updatePanelComponent",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "updatePanelComponent"
        },
        {
            "eventId": "primaryWorkArea.selectionChangeEvent",
            "action": "closeDialog"
        },
        {
            "eventId": "Pca0Configurator.closeDialog",
            "action": "closeDialog"
        },
        {
            "eventId": "scopesListDataProvider.selectionChangeEvent",
            "action": "closeDialog"
        }
    ],
    "i18n": {
        "addButtonTitle": [
            "TCUICommandPanelsMessages"
        ],
        "addPanelTitle": [
            "ConfiguratorMessages"
        ],
        "addFreeFormSectionTitle": [
            "ConfiguratorMessages"
        ],
        "toTitle": [
            "ConfiguratorMessages"
        ],
        "fromTitle": [
            "ConfiguratorMessages"
        ],
        "previewTitle": [
            "ConfiguratorMessages"
        ],
        "Text": [
            "ConfiguratorMessages"
        ],
        "Number": [
            "ConfiguratorMessages"
        ],
        "date": [
            "FullScreenConfigurationMessages"
        ],
        "allowedRangeText": [
            "ConfiguratorCommonMessages"
        ],
        "equalText": [
            "ConfiguratorCommonMessages"
        ]
    },
    "lifecycleHooks": {
        "onMount": "initializeData"
    }
}
