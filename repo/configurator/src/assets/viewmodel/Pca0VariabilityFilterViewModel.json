{
    "schemaVersion": "1.0.0",
    "data": {
        "filterByRadioProp": {
            "displayName": "{{i18n.filterBy}}",
            "type": "STRING",
            "isEditable": "true",
            "labelPosition": "PROPERTY_LABEL_AT_TOP"
        },
        "filterByValues": {
            "type": "STRING",
            "dbValue": [ {
                    "propDisplayValue": "{{i18n.subject}}",
                    "propInternalValue": "search_only_in_subject"
                },
                {
                    "propDisplayValue": "{{i18n.condition}}",
                    "propInternalValue": "search_only_in_condition"
                },
                {
                    "propDisplayValue": "{{i18n.subjectOrCondition}}",
                    "propInternalValue": "search_either_in_subject_or_condition"
                }
            ]
        }
    },
    "actions": {
        "initializeVariabilityFilterComponent": {
            "actionType": "JSFunction",
            "method": "initializeVariabilityFilterComponent",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "outputData": {
                "filterByRadioProp.dbValue" : ""
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "toggleFeaturesFilterCategoryPanelState": {
            "actionType": "JSFunction",
            "method": "updateFeaturePanelCollapsedState",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "isCollapsed": "{{parameters.isCollapsed}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        },
        "handleFeatureSearchTypeSelectionChange": {
            "actionType": "JSFunction",
            "method": "handleFeatureSearchTypeSelectionChange",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}",
                "featureSearchType": "{{data.filterByRadioProp.dbValue}}"
            },
            "deps": "js/pca0ConfiguratorExplorerCommonUtils"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "functions": {},
    "lifecycleHooks": {
        "onMount": "initializeVariabilityFilterComponent"
     },
    "messages": {},
    "conditions": {
        "featureFacetPopulated": {
            "expression": "props.subPanelContext.searchState.featuresFilterCategory.isPopulated"
        },
        "featuresPanelCollapsedState": {
            "expression": "props.subPanelContext.searchState.featuresFilterCategory.panelCollapsedState"
        },
        "searchBySubjectAndCondition": {
            "expression": "props.subPanelContext.searchState.featuresFilterCategory.enableSubjectAndConditionSearch"
        }
    },
    "i18n": {
        "condition": [ "ConfiguratorExplorerMessages" ],
        "familiesAndFeatures": [ "ConfiguratorExplorerMessages" ],
        "filter": [ "ConfiguratorMessages" ],
        "filterBy": [ "ConfiguratorExplorerMessages" ],
        "filters": [ "ConfiguratorExplorerMessages" ],
        "selectFeature": [ "ConfiguratorExplorerMessages" ],
        "subject": [ "ConfiguratorExplorerMessages" ],
        "subjectOrCondition": [ "ConfiguratorExplorerMessages" ]
    }
}
