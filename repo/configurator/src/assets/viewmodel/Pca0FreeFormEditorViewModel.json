{
    "schemaVersion": "1.0.0",
    "data": {
        "templateBox": {
            "displayName": "{{i18n.expressionTemplates}}",
            "name": "templateBox",
            "type": "STRING",
            "hasLov": true,
            "isRequired": false,
            "labelPosition": "NO_PROPERTY_LABEL",
            "dbValue": "",
            "dispValue": ""
        },
        "monacoContent": {
            "dbValue": " "
        },
        "config": {
            "language": "smt2",
            "theme": "vs",
            "options": {
                "automaticLayout": true,
                "readOnly": false,
                "domReadOnly": false,
                "lineNumbers": "on",
                "fixedOverflowWidgets": true,
                "minimap": {
                    "enabled": false
                }
            }
        },
        "freeFormEditorData": {
            "initialValues": {
                "newConstraintCreatedState": "idle",
                "currentConstraintLoaded": null
            },
            "meta": {}
        },
        "monacoGlobalConfig": {
            "initialValues": {
                "globalConfig": null
            },
            "meta": {}
        },
        "monacoEditor": {
            "initialValues": {
            },
            "meta": {}
        },
        "availableConstraintTypes": []
    },
    "actions": {
        "handlePrimarySelectionChangeAndResetCreationState": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "handlePrimarySelectionChangeFreeForm",
                "condition":  "!conditions.isNewConstraintCreatedInCreationState"
                },
                {
                    "action": "resetNewConstraintCreationState",
                    "condition": "conditions.isNewConstraintCreatedInCreationState"
                }
            ]
        },
        "handlePrimarySelectionChangeFreeForm": {
            "actionType": "JSFunction",
            "method": "handlePrimarySelectionChangeFreeForm",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext}}",
                "editorContent": "{{data.monacoContent}}",
                "config": "{{data.config}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "templateBox": "{{data.templateBox}}",
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}"
            },
            "outputData": {
                "monacoContent": "monacoContent",
                "config": "editorConfig"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "resetNewConstraintCreationState": {
            "actionType": "JSFunction",
            "method": "resetNewConstraintCreationState",
            "inputData": {
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "saveFreeFormExpressionOnConstraint": {
            "actionType": "JSFunction",
            "method": "saveFreeFormExpressionOnConstraint",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext}}",
                "commandContext": "{{parameters.eventData.commandContext}}",
                "availableConstraintTypes": "{{data.availableConstraintTypes}}",
                "editorData": "{{data.monacoContent}}",
                "isSavedFromLeaveHandler": "{{parameters.eventData.isSavedFromLeaveHandler}}",
                "constraint": "{{parameters.eventData.constraint}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "monacoGlobalConfig": "{{data.atomicDataRef.monacoGlobalConfig}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "cancelFreeFormExpression": {
            "actionType": "JSFunction",
            "method": "cancelFreeFormExpression",
            "inputData": {
                "editorData": "{{data.monacoContent}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}"
            },
            "outputData": {
                "data.monacoContent": "result.monacoContent",
                "data.config": "result.config"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "cutFreeFormExpression": {
            "actionType": "JSFunction",
            "method": "performActionOnExpression",
            "inputData": {
                "editorData": "{{data.monacoContent}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "action": "cut",
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "copyFreeFormExpression": {
            "actionType": "JSFunction",
            "method": "performActionOnExpression",
            "inputData": {
                "editorData": "{{data.monacoContent}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "action": "copy",
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "clearFreeFormExpression": {
            "actionType": "JSFunction",
            "method": "performActionOnExpression",
            "inputData": {
                "editorData": "{{data.monacoContent}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "action": "clear",
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "pasteFreeFormExpression": {
            "actionType": "JSFunction",
            "method": "pasteFreeFormExpression",
            "inputData": {
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "selectAllFreeFormExpression": {
            "actionType": "JSFunction",
            "method": "selectAllFreeFormExpression",
            "inputData": {
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "freeFormExpressionCommentUncomment": {
            "actionType": "JSFunction",
            "method": "freeFormExpressionCommentUncomment",
            "inputData": {
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}",
                "action": "{{parameters.action}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "findFreeFormExpression": {
            "actionType": "JSFunction",
            "method": "findFreeFormExpression",
            "inputData": {
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "initAction": {
            "actionType": "JSFunction",
            "method": "initAction",
            "inputData": {
                "declVieModel": "{{data}}",
                "monacoEditor": "{{data.atomicDataRef.monacoEditor}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "monacoGlobalConfig": "{{data.atomicDataRef.monacoGlobalConfig}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "disposeMonacoInstance": {
            "actionType": "JSFunction",
            "method": "disposeMonacoInstance",
            "inputData": {
                "completionProviderHandle": "{{data.completionProviderHandle}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "freeFormTemplateSelection": {
            "actionType": "JSFunction",
            "method": "freeFormTemplateSelection",
            "inputData": {
                "templateBox": "{{data.templateBox}}",
                "editorData": "{{data.monacoContent}}",
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        },
        "postProcessFreeFormConstraintCreated": {
            "actionType": "JSFunction",
            "method": "postProcessFreeFormConstraintCreated",
            "inputData": {
                "freeFormEditorData": "{{data.atomicDataRef.freeFormEditorData}}",
                "eventData": "{{parameters.eventData}}",
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/pca0FreeFormEditorService"
        }
    },
    "dataProviders": {
    },
    "conditions": {
        "isNewConstraintCreatedInCreationState": {
            "expression": "data.freeFormEditorData.newConstraintCreatedState === 'creating'"
        },
        "isTextEditorTemplatesInReadOnlyMode": {
            "expression": "data.data.config.options.readOnly"
        }
    },
    "messages":{
        "freeFormEditorReadonlyMessage": {
            "messageType": "INFO",
            "messageText": "{{i18n.freeFormEditorReadonlyMessage}}",
            "messageTextParams": [ "{{data.subPanelContext.selection[0].props.cfg0ProductItems.uiValue}}" ]
        }
    },
    "onEvent": [
        {
            "eventId": "Pca0FreeFormEditor.saveExpression",
            "action": "saveFreeFormExpressionOnConstraint",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0FreeFormEditor.cutExpression",
            "action": "cutFreeFormExpression"
        },
        {
            "eventId": "Pca0FreeFormEditor.copyExpression",
            "action": "copyFreeFormExpression"
        },
        {
            "eventId": "Pca0FreeFormEditor.clearExpression",
            "action": "clearFreeFormExpression"
        },
        {
            "eventId": "Pca0FreeFormEditor.pasteExpression",
            "action": "pasteFreeFormExpression"
        },
        {
            "eventId": "Pca0FreeFormEditor.cancelExpression",
            "action": "cancelFreeFormExpression"
        },
        {
            "eventId": "Pca0FreeFormEditor.selectAllExpression",
            "action": "selectAllFreeFormExpression"
        },
        {
            "eventId": "Pca0FreeFormEditor.commentExpression",
            "action": "freeFormExpressionCommentUncomment",
            "inputArgs": {
                "action": "comment"
            }
        },
        {
            "eventId": "Pca0FreeFormEditor.uncommentExpression",
            "action": "freeFormExpressionCommentUncomment",
            "inputArgs": {
                "action": "uncomment"
            }
        },
        {
            "eventId": "Pca0FreeFormEditor.findExpression",
            "action": "findFreeFormExpression"
        },
        {
            "eventId": "Pca0FreeFormEditor.handlePrimarySelectionChangeFreeForm",
            "action": "handlePrimarySelectionChangeFreeForm"
        },
        {
            "eventId": "Pca0Constraints.constraintCreated",
            "action": "postProcessFreeFormConstraintCreated",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        }
    ],
    "lifecycleHooks": {
        "onUnmount": "disposeMonacoInstance",
        "onUpdate": [
            {
                "action": "handlePrimarySelectionChangeAndResetCreationState",
                "observers": [
                    "props.subPanelContext.selection.uid",
                    "props.subPanelContext.selection[0].uid",
                    "props.subPanelContext.selection.length"
                ]
            },
            {
                "action": "initAction",
                "observers": [
                    "fields.monacoGlobalConfig.editor"
                ]
            }
        ]
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "i18n": {
        "row": [
            "ConfiguratorExplorerMessages"
        ],
        "column": [
            "ConfiguratorExplorerMessages"
        ],
        "totalLines": [
            "ConfiguratorExplorerMessages"
        ],
        "expressionTemplates": [
            "ConfiguratorExplorerMessages"
        ],
        "freeFormEditorReadonlyMessage": [
            "ConfiguratorExplorerMessages"
        ]
    }
}
