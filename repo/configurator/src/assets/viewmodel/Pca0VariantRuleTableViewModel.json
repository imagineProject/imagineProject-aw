    "conditions": {
        "showEmptyWorkarea":
        {
            "expression": "data.totalFound === 0 && data.additionalInfoMessages.includes( 'noDataFoundForContext' )"
        },
        "isPWAVariantsTableNotInEditMode": {
            "expression": "ctx.TABLE_CONTEXT._editing !== true"
        },
        "isPWAVariantsTableInEditMode": {
            "expression": "ctx.TABLE_CONTEXT._editing === true"
        },
        "Pca0IsCfgSelectedItemsOnPage": {
            "expression": "ctx.state.params.cfgSelectedItemsInPage !== undefined"
        },
        "isSaveAsAction": {
            "expression": "ctx.SAVEAS_PANEL_CONTEXT !== undefined"
        },
        "Pca0IsInShowAllRevisionMode": {
            "expression": "ctx.state.params.compareRevisions !== undefined"
        },
        "Pca0IsStateParamResetRequired": {
            "expression": "conditions.Pca0IsCfgSelectedItemsOnPage || conditions.Pca0IsInShowAllRevisionMode"
        },
        "Pca0ShowFilteredListGuidanceMsg": {
            "expression": "conditions.Pca0IsCfgSelectedItemsOnPage && !conditions.Pca0IsInShowAllRevisionMode"
        }
    },
