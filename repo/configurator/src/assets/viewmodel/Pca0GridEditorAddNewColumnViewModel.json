{
    "schemaVersion": "1.0.0",
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "actions": {
        "createNewNamedColumn": {
            "actionType": "JSFunction",
            "method": "createNewNamedColumn",
            "inputData": {
                "type": "{{props.subPanelContext.type}}",
                "xrtVMO": "{{data.xrtState.xrtVMO}}"
            },
            "outputData": {
                "newColumnVmo": ""
            },
            "events": {
                "success": [ 
                    {
                        "name": "Pca0GridEditorAddNewColumnViewModel.newColumnNamed",
                        "eventData": {
                            "newColumnVmo": "{{data.newColumnVmo}}"
                         }
                    },
                    {
                        "name": "Pca0GridEditorAddNewColumnViewModel.closePanel"
                    }
                ]
            },
            "deps": "js/pca0MultipleSVRsDisplayService"
        },
        "closeAddNewColumnPanel": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "INFO_PANEL_CONTEXT",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "ctx": {
        "panelContext": {
            "type": "object"
        }
    },
    "data": {
       "xrtState": {
            "initialValues": {},
            "meta": {
                "xrtVMO": {
                    "field": "true",
                    "type": "viewModelObject"
                }
            }
        }
    },
    "onEvent": [
        {
            "eventId": "Pca0GridEditorAddNewColumnViewModel.closePanel",
            "action": "closeAddNewColumnPanel"
        }
    ],
    "editHandlers": {
        "addPanelEditHandler": {
            "context": "CREATE_PANEL_CONTEXT",
            "dataSource": {
                "xrtVMO": "{{data.xrtState}}"
            }
        }
    },
    "i18n": {
        "addCmd": [ "ConfiguratorExplorerMessages" ]
    }
}
