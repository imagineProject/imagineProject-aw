{
    "schemaVersion": "1.0.0",
    "imports": [],
    "actions": {
        "checkViolations": {
            "actionType": "JSFunction",
            "method": "checkViolations",
            "inputData": {
                "eventData": "{{data.eventData}}",
                "data": "{{props.column}}"
            },
            "outputData": {
                "violationsInColumn": "violationsInColumn",
                "tooltipDetails": "tooltipDetails",
                "errorIconUrl": "errorIconUrl"
            },
            "deps": "js/pca0RendererService"
        },
        "populateHeaderIconAndTooltipInfo": {
            "actionType": "JSFunction",
            "method": "populateHeaderIconAndTooltipInfo",
            "inputData": {
                "data": "{{props.column}}"
            },
            "outputData": {
                "headerIconUrl": "headerIconUrl",
                "tooltipInfo": "nonGridableExpressionTooltipInfo"
            },
            "deps": "js/pca0RendererService"
        }
    },
    "data": {},
    "messages": {},
    "onEvent": [ {
        "eventId": "Pca0VariabilityTree.validationComplete",
        "action": "checkViolations",
        "cacheEventData": true
    } ],
    "lifecycleHooks": {
        "onMount": "populateHeaderIconAndTooltipInfo"
    },
    "i18n": {
        "error": [ "FullScreenConfigurationMessages" ]
    }
}
