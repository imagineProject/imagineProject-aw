{
    "schemaVersion": "1.0.0",
    "actions": {
       "initViewDataSettingsBatch": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "initializeProductHierarchyDepth",
                    "condition": "conditions.showProductHierarchyDepth"
                }
            ]
        },
        "initializeProductHierarchyDepth": {
            "actionType": "JSFunction",
            "method": "initializeProductHierarchyDepth",
            "inputData": {
                 "svrSettingsAtomicData": "{{subPanelContext.svrSettings}}"
            },
            "outputData":{
                "productHierarchyDepth.dbValue": "result.productHierarchyDepthValue.propInternalValue",
                "productHierarchyDepth.uiValue": "result.productHierarchyDepthValue.propDisplayValue",
                "productHierarchyDepthProperties": "result.productHierarchyDepthProperties"
            },
            "deps": "js/pca0SvrFilterCriteriaSettingsService"
        }
    },
    "dataProviders": {
        "productHierarchyDepthDataProvider": {
            "response": "{{data.productHierarchyDepthProperties}}"
        }
    },
    "data": {
        "productHierarchyDepthProperties": [],
        "productHierarchyDepth": {
            "displayName": "{{i18n.productHierarchyDepth}}",
            "name": "productHierarchyDepth",
            "type": "STRING",
            "emptyLOVEntry": false,
            "isRequired": "false",
            "dataProvider": "productHierarchyDepthDataProvider",
            "dbValue": "",
            "uiValue": ""
        },
        "revisionRule": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "displayName": "{{i18n.revisionRule}}"
        },
        "effectivity": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "displayName": "{{i18n.effectivity}}"
        },
        "ruleDate": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "displayName": "{{i18n.ruleDate}}"
        },
        "currentEffectivity": {
            "uiValue": "{{data.currentEffectivity}}",
            "type": "STRING"
        }
    },
    "i18n": {
        "revisionRule": [
            "FullScreenConfigurationMessages"
        ],
        "ruleDate": [
            "FullScreenConfigurationMessages"
        ],
        "effectivity": [
            "FullScreenConfigurationMessages"
        ],
        "intent": [
            "FullScreenConfigurationMessages"
        ],
        "errorInGettingPreferredConfigInfo": [
            "FullScreenConfigurationMessages"
        ],
        "productHierarchyDepth": [
            "FullScreenConfigurationMessages"
        ]
    },
    "messages": {
        "errorInGettingPreferredConfigInfo": {
            "messageType": "ERROR",
            "messageText": "{{i18n.errorInGettingPreferredConfigInfo}}"
        }
    },
    "lifecycleHooks": {
        "onMount": "initViewDataSettingsBatch"
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "conditions": {
        "showProductHierarchyDepth": {
            "expression": "props.subPanelContext.svrSettings && props.subPanelContext.svrSettings.value.appliedSettings.configSettings.props.pca0ProductHierarchyDepth !== undefined"
        },
        "rootModuleHasChildren": {
            "expression": "props.subPanelContext.rootModuleHasChildren"
        }
    },
    "onEvent": [
        {
            "eventId": "Pca0SvrSettings.updateSettingsContent",
            "action": "initViewDataSettingsBatch"
        }
    ]
}
