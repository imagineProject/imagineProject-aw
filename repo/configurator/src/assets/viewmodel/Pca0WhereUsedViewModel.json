{
    "schemaVersion": "1.0.0",
    "lifecycleHooks": {
        "onMount": "handleInitActions",
        "onUpdate": [ {
                "action": "handlePrimarySelectionChange",
                "observers": [
                    "props.subPanelContext.selection.uid",
                    "props.subPanelContext.selection[0].uid",
                    "props.subPanelContext.selection.length"
                ]
            }
        ]
    },
    "data": {
        "objectSetContexts": {
            "initialValues": {
                "pwaSelectionData": {},
                "dpRef": { "current": null },
                "objectSetUri": "Pca0RefContexts",
                "objectSetInfo": {
                    "firstPage": []
                },
                "commandContext": {
                    "tableDataProviderName": "Awp0ObjectSetRowProvider",
                    "clientScopeURI": "Pca0RefContexts",
                    "objectSetSource": "Pca0RefContextsProvider.Cfg0ConfContext",
                    "searchCriteria": {
                        "parentUid": "{{props.subPanelContext.selection[0].nodeUid}}",
                        "allRevisions": "{{atomicData.settings.showAllRevisions}}",
                        "allContexts": "{{atomicData.settings.showDataFromAllContexts}}",
                        "objectSet": "Pca0RefContextsProvider.Cfg0ConfContext"
                    }
                },
                "objsetdata": {
                    "uid": "",
                    "defaultDisplay": "tableDisplay",
                    "elementType": "objectSet",
                    "id": "objectSet_contexts",
                    "sortyBy": "object_string",
                    "sortDirection": "ascending",
                    "source": "Pca0RefContextsProvider.Cfg0ConfContext",
                    "sourceHasDataset": true,
                    "displayModes": {
                        "tableDisplay": {
                            "gridProvider": "Pca0RefContexts"
                        },
                        "thumbnailDisplay": true
                    },
                    "commands": []
                }
            },
            "meta": {}
        },
        "objectSetConstraints": {
            "initialValues": {
                "pwaSelectionData": {},
                "dpRef": { "current": null },
                "objectSetUri": "Pca0RefConstraints",
                "objectSetInfo": {
                    "firstPage": []
                },
                "commandContext": {
                    "tableDataProviderName": "Awp0ObjectSetRowProvider",
                    "clientScopeURI": "Pca0RefConstraints",
                    "objectSetSource": "Pca0RefConstraintsProvider.Cfg0AbsRule",
                    "searchCriteria": {
                        "parentUid": "{{props.subPanelContext.selection[0].nodeUid}}",
                        "allRevisions": "{{atomicData.settings.showAllRevisions}}",
                        "allContexts": "{{atomicData.settings.showDataFromAllContexts}}",
                        "objectSet": "Pca0RefConstraintsProvider.Cfg0AbsRule"
                    }
                },
                "objsetdata": {
                    "uid": "",
                    "defaultDisplay": "tableDisplay",
                    "elementType": "objectSet",
                    "id": "objectSet_constraints",
                    "sortyBy": "object_string",
                    "sortDirection": "ascending",
                    "source": "Pca0RefConstraintsProvider.Cfg0AbsRule",
                    "sourceHasDataset": true,
                    "displayModes": {
                        "tableDisplay": {
                            "gridProvider": "Pca0RefConstraints"
                        },
                        "thumbnailDisplay": true
                    },
                    "commands": []
                }
            },
            "meta": {}
        },
        "objectSetVariants": {
            "initialValues": {
                "pwaSelectionData": {},
                "dpRef": { "current": null },
                "objectSetUri": "Pca0RefVariants",
                "objectSetInfo": {
                    "firstPage": []
                },
                "commandContext": {
                    "tableDataProviderName": "Awp0ObjectSetRowProvider",
                    "clientScopeURI": "Pca0RefVariants",
                    "objectSetSource": "Pca0RefVariantsProvider.VariantRule",
                    "searchCriteria": {
                        "parentUid": "{{props.subPanelContext.selection[0].nodeUid}}",
                        "allRevisions": "{{atomicData.settings.showAllRevisions}}",
                        "allContexts": "{{atomicData.settings.showDataFromAllContexts}}",
                        "objectSet": "Pca0RefVariantsProvider.VariantRule"
                    }
                },
                "objsetdata": {
                    "uid": "",
                    "defaultDisplay": "tableDisplay",
                    "elementType": "objectSet",
                    "id": "objectSet_variants",
                    "sortyBy": "object_string",
                    "sortDirection": "ascending",
                    "source": "Pca0RefVariantsProvider.VariantRule",
                    "sourceHasDataset": true,
                    "displayModes": {
                        "tableDisplay": {
                            "gridProvider": "Pca0RefVariants"
                        },
                        "thumbnailDisplay": true
                    },
                    "commands": []
                }
            },
            "meta": {}
        },
        "xrtContext": {},
        "sectionExpStatusCache": {
            "initialValues": {},
            "meta": {}
        },
        "settings": {
            "initialValues": {},
            "meta": {}
        },
        "reloadObjectSetState": {
            "initialValues": {
                "reloadObjectSet": false
            },
            "meta": {}
        },
        "consumerAppSlots": [
            "occmgmtConfigurator_structures"
        ]
    },
    "actions": {
        "handleInitActions": {
            "actionType": "JSFunction",
            "method": "handleInitActions",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext}}",
                "settings": "{{atomicDataRef.settings}}",
                "listOfConsumerApps": "{{data.consumerAppSlots}}"
            },
            "outputData": {
                "sectionExpStatusCache": "sectionExpStatusCache",
                "pwaSelectionData": "pwaSelectionData",
                "xrtContext": "xrtContext",
                "objectSetContexts.xrtContext": "xrtContext",
                "objectSetConstraints.xrtContext": "xrtContext",
                "objectSetVariants.xrtContext": "xrtContext",
                "objectSetContexts.pwaSelectionData": "pwaSelectionData",
                "objectSetConstraints.pwaSelectionData": "pwaSelectionData",
                "objectSetVariants.pwaSelectionData": "pwaSelectionData"
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "handleLayoutSlotUpdate": {
            "actionType": "JSFunction",
            "method": "handleLayoutSlotUpdate",
            "inputData": {
                "subPanelContextSelection": "{{props.subPanelContext.selection[0]}}",
                "settings": "{{atomicDataRef.settings}}",
                "slotSettings": "{{parameters.slotSettings}}",
                "slotInternalName": "{{parameters.slotInternalName}}"
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "handlePrimarySelectionChange": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "updateSectionsVisibility",
                    "condition": "conditions.isPwaSelectionChanged"
                },
                {
                    "action": "updatePwaSelection",
                    "condition": "conditions.isPwaSelectionChanged"
                }
            ]
        },
        "updateSectionsVisibility": {
            "actionType": "JSFunction",
            "method": "updateSectionsVisibility",
            "inputData": {
                "subPanelContextSelection": "{{props.subPanelContext.selection[0]}}",
                "settings": "{{atomicDataRef.settings}}"
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "updatePwaSelection": {
            "actionType": "JSFunction",
            "method": "echoInput",
            "inputData": {
                "subPanelContextSelection": "{{props.subPanelContext.selection}}"
            },
            "outputData": {
                "pwaSelectionData": "",
                "objectSetContexts.pwaSelectionData": "",
                "objectSetConstraints.pwaSelectionData": "",
                "objectSetVariants.pwaSelectionData": ""
            },
            "deps": "js/pca0CommonUtils"
        },
        "refreshObjectSets": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "refreshContextsObjectSet"
                },
                {
                    "action": "refreshConstraintsObjectSet"
                },
                {
                    "action": "refreshVariantsObjectSet"
                },
                {
                    "action": "refreshLayoutSlots"
                }
            ]
        },
        "refreshContextsObjectSet": {
            "actionType": "JSFunction",
            "method": "refreshObjectSet",
            "inputData": {
                "isSectionExpanded": "{{atomicData.sectionExpStatusCache.contextsExpanded}}",
                "vmObjectSet": "{{atomicDataRef.objectSetContexts}}",
                "xrtContext": "{{data.xrtContext}}",
                "isFullScreen": "{{parameters.eventData.fullScreenState}}"
            },
            "outputData": {
                "contextsOutOfSync": ""
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "refreshConstraintsObjectSet": {
            "actionType": "JSFunction",
            "method": "refreshObjectSet",
            "inputData": {
                "isSectionExpanded": "{{atomicData.sectionExpStatusCache.constraintsExpanded}}",
                "vmObjectSet": "{{atomicDataRef.objectSetConstraints}}",
                "xrtContext": "{{data.xrtContext}}",
                "isFullScreen": "{{parameters.eventData.fullScreenState}}"
            },
            "outputData": {
                "constraintsOutOfSync": ""
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "refreshVariantsObjectSet": {
            "actionType": "JSFunction",
            "method": "refreshObjectSet",
            "inputData": {
                "isSectionExpanded": "{{atomicData.sectionExpStatusCache.variantsExpanded}}",
                "vmObjectSet": "{{atomicDataRef.objectSetVariants}}",
                "xrtContext": "{{data.xrtContext}}",
                "isFullScreen": "{{parameters.eventData.fullScreenState}}"
            },
            "outputData": {
                "variantsOutOfSync": ""
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "refreshLayoutSlots": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "Pca0WhereUsed.refreshLayoutSlots"
                } ]
            }
        },
        "updateSectionExpStatusForContexts": {
            "actionType": "JSFunction",
            "method": "updateSectionExpStatus",
            "inputData": {
                "sectionExpStatusCache": "{{atomicDataRef.sectionExpStatusCache}}",
                "sessionStorageUid": "cfgWhereUsedSectionsExpMap",
                "cacheEntryId": "contextsExpanded",
                "isCollapsed": "{{parameters.eventData.isCollapsed}}",
                "xrtContext": "{{data.xrtContext}}",
                "objectSet": "{{atomicDataRef.objectSetContexts}}",
                "isSectionOutOfSync": "{{data.contextsOutOfSync}}"
            },
            "outputData": {
                "contextsOutOfSync": ""
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "updateSectionExpStatusForConstraints": {
            "actionType": "JSFunction",
            "method": "updateSectionExpStatus",
            "inputData": {
                "sectionExpStatusCache": "{{atomicDataRef.sectionExpStatusCache}}",
                "sessionStorageUid": "cfgWhereUsedSectionsExpMap",
                "cacheEntryId": "constraintsExpanded",
                "isCollapsed": "{{parameters.eventData.isCollapsed}}",
                "xrtContext": "{{data.xrtContext}}",
                "objectSet": "{{atomicDataRef.objectSetConstraints}}",
                "isSectionOutOfSync": "{{data.constraintsOutOfSync}}"
            },
            "outputData": {
                "constraintsOutOfSync": ""
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "updateSectionExpStatusForVariants": {
            "actionType": "JSFunction",
            "method": "updateSectionExpStatus",
            "inputData": {
                "sectionExpStatusCache": "{{atomicDataRef.sectionExpStatusCache}}",
                "sessionStorageUid": "cfgWhereUsedSectionsExpMap",
                "cacheEntryId": "variantsExpanded",
                "isCollapsed": "{{parameters.eventData.isCollapsed}}",
                "xrtContext": "{{data.xrtContext}}",
                "objectSet": "{{atomicDataRef.objectSetVariants}}",
                "isSectionOutOfSync": "{{data.variantsOutOfSync}}"
            },
            "outputData": {
                "variantsOutOfSync": ""
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "applySettings": {
            "actionType": "JSFunction",
            "method": "applySettings",
            "inputData": {
                "settingsFromPanel": "{{parameters.eventData.settingsFromPanel}}",
                "settings": "{{atomicDataRef.settings}}",
                "popupId": "{{parameters.eventData.popupId}}"
            },
            "outputData": {
                "mustTriggerDataReload": "mustTriggerDataReload",
                "xrtContext": "xrtContext"
            },
            "events": {
                "success": [ {
                    "name": "Pca0WhereUsed.triggerDataReload",
                    "condition": "data.mustTriggerDataReload"
                } ]
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "checkIfSelectionIsInSameContextForVariants": {
            "actionType": "JSFunction",
            "method": "checkIfSelectionIsInSameContextForVariants",
            "inputData": {
                "eventData": "{{parameters.eventData}}"
            },
            "deps": "js/Pca0WhereUsedService"
        },
        "checkIfSelectionIsInSameContextForConstraints": {
            "actionType": "JSFunction",
            "method": "checkIfSelectionIsInSameContextForConstraints",
            "inputData": {
                "eventData": "{{parameters.eventData}}"
            },
            "deps": "js/Pca0WhereUsedService"
        }
    },
    "props": {},
    "functions": {},
    "onEvent": [ {
            "eventId": "awPanelSection.collapse",
            "action": "updateSectionExpStatusForContexts",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "criteria": {
                "name": "where_used_in_contexts"
            }
        },
        {
            "eventId": "awPanelSection.collapse",
            "action": "updateSectionExpStatusForConstraints",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "criteria": {
                "name": "where_used_in_constraints"
            }
        },
        {
            "eventId": "awPanelSection.collapse",
            "action": "updateSectionExpStatusForVariants",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "criteria": {
                "name": "where_used_in_variants"
            }
        },
        {
            "eventId": "Pca0WhereUsed.applySettings",
            "action": "applySettings",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0WhereUsed.triggerDataReload",
            "action": "refreshObjectSets",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "objectSet_variants_Provider.selectionChangeEvent",
            "action": "checkIfSelectionIsInSameContextForVariants",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "objectSet_constraints_Provider.selectionChangeEvent",
            "action": "checkIfSelectionIsInSameContextForConstraints",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        }
    ],
    "conditions": {
        "isPwaSelectionChanged": {
            "expression": "data.pwaSelectionData !== undefined && subPanelContext.selection !== data.pwaSelectionData"
        },
        "showContexts": {
            "expression": "data.settings.sectionsVisibility.section_showContexts.isSectionVisibleInUI"
        },
        "showConstraints": {
            "expression": "data.settings.sectionsVisibility.section_showConstraints.isSectionVisibleInUI"
        },
        "showVariants": {
            "expression": "data.settings.sectionsVisibility.section_showVariants.isSectionVisibleInUI"
        }
    },
    "i18n": {
        "section_showContexts": [ "ConfiguratorExplorerMessages" ],
        "section_showConstraints": [ "ConfiguratorExplorerMessages" ],
        "section_showVariants": [ "ConfiguratorExplorerMessages" ]
    }
}
