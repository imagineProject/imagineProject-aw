{
    "schemaVersion": "1.0.0",
    "i18n": {
        "validAndIncompleteTooltip": [ "FullScreenConfigurationMessages" ],
        "validAndInCompleteStatus": [ "FullScreenConfigurationMessages" ],
        "validAndCompleteTooltip": [ "FullScreenConfigurationMessages" ],
        "validAndCompleteStatus": [ "FullScreenConfigurationMessages" ]
    },
    "conditions": {
        "isValidAndCompleteConfiguration": {
            "expression": "subPanelContext.completenessStatus === 'validAndComplete'"
        },
        "isValidAndInCompleteConfiguration": {
            "expression": "subPanelContext.completenessStatus === 'validAndInComplete'"
        }
    }
}
