{
    "data": {
        "showFeatureSideBySide": {
            "displayName": "{{i18n.showFeatureSideBySide}}",
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        },
        "showGroupsAsTab": {
            "displayName": "{{i18n.showGroupsAsTab}}",
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        },
        "showCompressedData": {
            "displayName": "{{i18n.showCompressedData}}",
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        },
        "featureWidth": {
            "displayName": "{{i18n.featureWidth}}",
            "type": "STRING",
            "isEditable": "true",
            "dbValue": "{{featureWidth.dbValue}}"
        },
        "featureWidthValues": {
            "type": "STRING",
            "dbValue": [
                {
                    "propDisplayValue": "{{i18n.smallText}}",
                    "propInternalValue": "small"
                },
                {
                    "propDisplayValue": "{{i18n.mediumText}}",
                    "propInternalValue": "medium"
                },
                {
                    "propDisplayValue": "{{i18n.largeText}}",
                    "propInternalValue": "large"
                }
            ]
        }
    },
    "actions": {
        "changeFeatureStyle": {
            "actionType": "JSFunction",
            "method": "updateTextViewSettings",
            "inputData": {
                "settings": "{{data}}"
            },
            "outputData": {
                "featureWidth.uiValue": "result.nameWidthUIValue",
                "featureWidth.dbValue": "result.nameWidthDBValue"
            },
            "deps": "js/Pca0SettingsService"
        },
        "initViewSettings": {
            "actionType": "JSFunction",
            "method": "initVCVLayoutViewSettings",
            "inputData": {
                "settingsFields": {
                    "showIndicators": "{{fields.showIndicators}}",
                    "showCompressedData": "{{fields.showCompressedData}}",
                    "showGroupsAsTab": "{{fields.showGroupsAsTab}}",
                    "showFeatureSideBySide": "{{fields.showFeatureSideBySide}}"
                }
            },
            "outputData": {
                "featureWidth.uiValue": "result.nameWidthUIValue",
                "featureWidth.dbValue": "result.nameWidthDBValue"
            },
            "deps": "js/Pca0SettingsService"
        }
    },
    "conditions": {
        "isTextMode": {
            "expression": "data.showCompressedData.dbValue === true"
        }
    },
    "lifecycleHooks": {
        "onMount": "initViewSettings"
    },
    "i18n": {
        "featureBorder": [ "FullScreenConfigurationMessages" ],
        "featureWidth": [ "FullScreenConfigurationMessages" ],
        "showSeparatorText": [ "FullScreenConfigurationMessages" ],
        "showViolationText": [ "FullScreenConfigurationMessages" ],
        "showFeatureSideBySide": [ "FullScreenConfigurationMessages" ],
        "showGroupsAsTab": [ "FullScreenConfigurationMessages" ],
        "showCompressedData": [ "FullScreenConfigurationMessages" ],
        "largeText": [ "FullScreenConfigurationMessages" ],
        "smallText": [ "FullScreenConfigurationMessages" ],
        "mediumText": [ "FullScreenConfigurationMessages" ],
        "options": [ "FullScreenConfigurationMessages" ]
    }
}
