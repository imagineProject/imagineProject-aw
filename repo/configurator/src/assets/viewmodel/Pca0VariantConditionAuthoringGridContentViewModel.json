                "{{data.dataProviders.treeDataProvider}}",
                "{{data.atomicDataRef.gridSelectionState}}"
            ],
            "deps": "js/pca0VariabilityExplorerService"
        },
        "postResetFunction": {
            "functionName": "postResetUpdateColumnConfig",
            "parameters": [
                "{{data.dataProviders.treeDataProvider}}",
                "{{data.atomicDataRef.gridSelectionState}}",
                "variantConditionContext"
            ],
            "deps": "js/pca0GridCommonUtils"
        },
        "postArrangeFunction": {
            "functionName": "postArrangeUpdateColumnConfig",
            "parameters": [
                "{{data.dataProviders.treeDataProvider}}",
                "{{data.atomicDataRef.gridSelectionState}}",
                "variantConditionContext"
            ],
            "deps": "js/pca0GridCommonUtils"
        },
        "getColumns": {
            "functionName": "getGridServerColumns",
            "parameters": [ "{{data.dataProviders.treeDataProvider.newColumns}}" ],
            "deps": "js/pca0GridCommonUtils"
        }
    },
    "conditions": {
        "isPwaSelectionChanged": {
            "expression": "data.pwaSelectionData !== undefined && subPanelContext.selection !== data.pwaSelectionData"
        },
        "isOkToLeave": {
            "expression": "!ctx.isVariantTableEditing"
        },
        "isNotOkToLeave": {
            "expression": "ctx.isVariantTableEditing"
        },
        "consumerAppNotLoadingData": {
            "expression": "ctx.variantConditionContext.allowConsumerAppsToLoadData === undefined || ctx.variantConditionContext.allowConsumerAppsToLoadData === false"
        },
        "isFormulaEditorRefreshRequired": {
            "expression": {
                "$and": [
                    {
                        "$source": "ctx.variantConditionContext.formulaEditorProps.isFormulaEditorOpen",
                        "$query": {
                            "$eq": true
                        }
                    },{
                        "$or": [
                            {
                                "$source": "ctx.variantConditionContext.variantFormulaEditInProgress",
                                    "$query": {
                                    "$eq": false
                                }
                            },
                            {
                                "$and": [
                                    {
                                        "$source": "ctx.variantConditionContext.variantFormulaEditInProgress",
                                        "$query": {
                                            "$eq": true
                                        }
                                    },
                                    {
                                        "$source": "props.subPanelContext.selection",
                                        "$query": {
                                            "$all": {
                                                "$source": {
                                                    "$adapt": "uid"
                                                },
                                                "$query": {
                                                    "$notin": [
                                                        "{{ctx.variantConditionContext.formulaEditorProps.selectedObject.uid}}"
                                                    ]
                                                }
                                            }
                                        }
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    },
    "onEvent": [ {
            "eventId": "Pca0VariantConditionAuthoringGrid.loadVariabilityData",
            "action": "reloadVariabilityData",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGrid.refreshTreeDataProvider",
            "action": "refreshTreeDataProvider"
        },
        {
            "eventId": "pca0VariabilityTree.editModeChanged",
            "action": "handleEditModeChanged",
            "cacheEventData": true,
            "criteria": {
                "gridID": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGrid.SaveExpressions",
            "action": "setVariantExpressionData"
        },
        {
            "eventId": "Pca0ConfiguratorGrid.validateProductConfigurations",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "validateProductConfigurations"
        },
        {
            "eventId": "Pca0VariabilityTreeCustomMenuService.performColumnValidate",
            "action": "validateVariantConditions",
            "cacheEventData": true,
            "criteria": {
                "gridID": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0VariabilityTreeDisplayService.performSplitColumn",
            "action": "createSplitColumn",
            "cacheEventData": true,
            "criteria": {
                "gridID": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0VariabilityTreeCustomMenuService.performColumnClearSelections",
            "action": "clearColumnSelections",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "criteria": {
                "gridID": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0VariabilityTreeCustomMenuService.performColumnCopySelections",
            "action": "copyColumnSelections",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "criteria": {
                "gridID": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0VariabilityTreeCustomMenuService.performPasteSelectionsOnColumn",
            "action": "pasteSelectionsOnColumn",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "criteria": {
                "gridID": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0GridAuthoring.populateUserEdits",
            "action": "populateUserEdits",
            "cacheEventData": true,
            "criteria": {
                "gridId": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGrid.postProcessSetVariantExpressionData",
            "action": "postProcessSaveEditsActions"
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGrid.postProcessValidateProductConfigurations",
            "action": "postProcessValidateProductConfigurations"
        },
        {
            "eventId": "Pca0FilterCriteriaSettings.filterCriteriaUpdated",
            "action": "reloadVariabilityData",
            "criteria": {
                "contextKey": "variantConditionContext"
            }
        },
        {
            "eventId": "Pca0AddRangeFeaturePanel.valueCreated",
            "action": "addFreeFormOptionValue",
            "cacheEventData": true,
            "criteria": {
                "sourceID": "variantConditionAuthoringGrid"
            }
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGridViewModel.processPartialErrors",
            "action": "processPartialErrors",
            "cacheEventData": true
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGridViewModel.postProcessSaveEditsWithPartialErrors",
            "action": "processPartialErrorsAfterSave",
            "cacheEventData": true
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGrid.SaveExpressionsInECNContext",
            "action": "saveExpressionsInECNContext",
            "cacheEventData": true
        },
        {
            "eventId": "Pca0VariantConditionAuthoringGrid.updateDirtyVMOs",
            "action": "updateDirtyVMOs",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "Pca0HostedConfigurator.saveCompleteInNonTcApp",
            "action": "saveCompleteInNonTcApp",
            "cacheEventData": true
        },
        {
            "eventId": "pcaGrid.updateSelection",
            "action": "updateColumnSelection"
        },
        {
            "eventId": "columnArrange",
            "action": "doArrangeEvent",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        }
    ],
    "editHandlers": {
        "pca0EditHandler": {
            "context": "VARIANT_TREE_CONTEXT"
        }
    },
    "ctx": {
        "variantConditionContext": {
            "type": "object"
        },
        "isVariantTableEditing": {
            "type": "Boolean"
        }
    }
}
