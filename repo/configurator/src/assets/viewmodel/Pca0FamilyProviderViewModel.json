{
    "schemaVersion": "1.0.0",
    "data": {
        "pageSize": 100,
        "commandsAnchor": "aw_cfgFamilyCommandBar",
        "filterBox": {
            "displayName": "",
            "type": "STRING",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "previousGroup": "",
        "moveToFamilyUid" : "",
        "loadedCount": {
            "displayName": "",
            "type": "STRING",
            "isRequired": "false",
            "isEditable": "false",
            "dbValue": "",
            "dispValue": ""
        },
        "cursor": {
            "startIndex": 0,
            "endIndex": 0,
            "startReached": false,
            "endReached": false,
            "hasMoreData": false,
            "pageNumber": -1
        },
        "userExpandedFamiliesList": [],
        "isLoading": false
    },
    "actions": {
        "startLoading": {
            "actionType": "JSFunction",
            "method": "echoInput",
            "inputData": {
                "loading": true
            },
            "outputData": {
                "isLoading": ""
            },
            "deps": "js/pca0CommonUtils"
        },
        "stopLoading": {
            "actionType": "JSFunction",
            "method": "echoInput",
            "inputData": {
                "loading": false
            },
            "outputData": {
                "isLoading": ""
            },
            "deps": "js/pca0CommonUtils"
        },
        "render": {
            "method": "pca0VariabilityRenderFunction",
            "deps": "js/Pca0FamilyProviderService",
            "options": {
                "elementRefList": [ "Pca0VariabilityPreviousLoader", "Pca0VariabilityMiddleLoader", "Pca0VariabilityNextLoader", "Pca0Variability" ]
            }
        },
        "loadInitialFamilies": {
            "actionType": "JSFunction",
            "method": "loadInitialFamilies",
            "inputData": {
                "filterString": "",
                "cursor": "{{data.cursor}}",
                "pageSize": "{{data.pageSize}}",
                "families": "{{props.families}}",
                "currentGroup": "{{props.groupName}}",
                "previousGroup": "{{data.previousGroup}}",
                "familyUid": "{{props.familyUid}}",
                "moveToFamilyUid": "{{data.moveToFamilyUid}}",
                "elementRefList": "{{parameters.elementRefList}}"
            },
            "outputData": {
                "variabilityList": "result.variabilityList",
                "variabilityToLoad": "result.variabilityToLoad",
                "cursor": "result.cursorObject",
                "previousGroup": "result.groupName",
                "pageSize": "result.pageSize",
                "loadedCount.dispValue": "result.loadedCount",
                "loadedCount.dbValue": "result.loadedCount",
                "loadedCount.uiValue": "result.loadedCount",
                "loadedCount.value": "result.loadedCount",
                "userExpandedFamiliesList": "result.userExpandedFamilies",
                "elementRefList": "result.elementRefList"
            },
            "deps": "js/Pca0FamilyProviderService"
        },
        "loadNextFamilyDataAndSetScroll": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "startLoading"
                },
                {
                    "action": "loadNextFamilyData"
                },
                {
                    "action": "stopLoading"
                },
                {
                    "action": "setCursorAndUpdateObservers"
                }
            ]
        },
        "loadPreviousFamilyDataAndSetScroll": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "startLoading"
                },
                {
                    "action": "loadPreviousFamilyData"
                },
                {
                    "action": "stopLoading"
                },
                {
                    "action": "setCursorAndUpdateObservers"
                }
            ]
        },
        "loadNextFamilyData": {
            "actionType": "JSFunction",
            "method": "getFamilyData",
            "inputData": {
                "cursor": "{{data.cursor}}",
                "pageSize": "{{data.pageSize}}",
                "variabilityList": "{{data.variabilityList}}",
                "direction": "next",
                "currentGroup": "{{props.groupName}}",
                "previousGroup": "{{data.previousGroup}}",
                "familyUid": "{{props.familyUid}}",
                "moveToFamilyUid": "{{data.moveToFamilyUid}}",
                "variabilityLoaded": "{{data.variabilityToLoad}}",
                "filterString": "",
                "userExpandedFamiliesList": "{{data.userExpandedFamiliesList}}",
                "systemExpandedFamilies": "{{props.systemExpandedFamilies}}"
            },
            "outputData": {
                "variabilityList": "result.variabilityList",
                "variabilityToLoad": "result.variabilityToLoad",
                "cursor": "result.cursorObject",
                "familyData.dispValue": "result.familyData",
                "loadedCount.dispValue": "result.loadedCount",
                "loadedCount.dbValue": "result.loadedCount",
                "loadedCount.uiValue": "result.loadedCount",
                "loadedCount.value": "result.loadedCount",
                "userExpandedFamiliesList": "result.userExpandedFamiliesList"
            },
            "deps": "js/Pca0FamilyProviderService"
        },
        "loadPreviousFamilyData": {
            "actionType": "JSFunction",
            "method": "getFamilyData",
            "inputData": {
                "cursor": "{{data.cursor}}",
                "pageSize": "{{data.pageSize}}",
                "variabilityList": "{{data.variabilityList}}",
                "direction": "previous",
                "currentGroup": "{{props.groupName}}",
                "previousGroup": "{{data.previousGroup}}",
                "familyUid": "{{props.familyUid}}",
                "moveToFamilyUid": "{{data.moveToFamilyUid}}",
                "variabilityLoaded": "{{data.variabilityToLoad}}",
                "filterString": "",
                "userExpandedFamiliesList": "{{data.userExpandedFamiliesList}}",
                "systemExpandedFamilies": "{{props.systemExpandedFamilies}}"
            },
            "outputData": {
                "variabilityList": "result.variabilityList",
                "variabilityToLoad": "result.variabilityToLoad",
                "cursor": "result.cursorObject",
                "familyData.dispValue": "result.familyData",
                "loadedCount.dispValue": "result.loadedCount",
                "loadedCount.dbValue": "result.loadedCount",
                "loadedCount.uiValue": "result.loadedCount",
                "loadedCount.value": "result.loadedCount",
                "userExpandedFamiliesList": "result.userExpandedFamiliesList"
            },
            "deps": "js/Pca0FamilyProviderService"
        },
        "updateVariabilityChangeInGroup": {
            "actionType": "JSFunction",
            "method": "getFamilyData",
            "inputData": {
                "cursor": "{{data.cursor}}",
                "pageSize": "{{data.pageSize}}",
                "families": "{{props.families}}",
                "direction": "",
                "currentGroup": "{{props.groupName}}",
                "previousGroup": "{{data.previousGroup}}",
                "familyUid": "{{props.familyUid}}",
                "moveToFamilyUid": "{{data.moveToFamilyUid}}",
                "variabilityLoaded": "{{data.variabilityToLoad}}",
                "filterString": "{{props.filterString}}",
                "userExpandedFamiliesList": "{{data.userExpandedFamiliesList}}",
                "systemExpandedFamilies": "{{props.systemExpandedFamilies}}",
                "elementRefList": "{{parameters.elementRefList}}"
            },
            "outputData": {
                "variabilityList": "result.variabilityList",
                "variabilityToLoad": "result.variabilityToLoad",
                "cursor": "result.cursorObject",
                "moveToFamilyUid": "result.moveToFamilyUid",
                "familyData.dispValue": "result.familyData",
                "loadedCount.dispValue": "result.loadedCount",
                "loadedCount.dbValue": "result.loadedCount",
                "loadedCount.uiValue": "result.loadedCount",
                "loadedCount.value": "result.loadedCount",
                "previousGroup": "result.groupName",
                "elementRef": "result.elementRefList",
                "userExpandedFamiliesList": "result.userExpandedFamilies"
            },
            "deps": "js/Pca0FamilyProviderService"
        },
        "identifyActionAndSetData": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "startLoading"
                },
                {
                    "action": "loadInitialFamilies",
                    "condition": "!conditions.isSameGroup"
                },
                {
                    "action": "updateVariabilityChangeInGroup",
                    "condition": "conditions.isSameGroup"
                },
                {
                    "action": "stopLoading"
                },
                {
                    "action": "setCursorAndUpdateObservers"
                }
            ]
        },
        "loadFilterFamiliesBatch": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "startLoading"
                },
                {
                    "action": "loadFilterFamilies",
                    "condition": "conditions.isSameGroup"
                },
                {
                    "action": "stopLoading"
                },
                {
                    "action": "setCursorAndUpdateObservers"
                }
            ]
        },
        "loadFilterFamilies": {
            "actionType": "JSFunction",
            "method": "loadFilterFamilies",
            "inputData": {
                "filterString": "{{props.filterString}}",
                "cursor": "{{data.cursor}}",
                "pageSize": "{{data.pageSize}}",
                "families": "{{props.families}}",
                "currentGroup": "{{props.groupName}}",
                "previousGroup": "{{data.previousGroup}}"
            },
            "outputData": {
                "variabilityList": "result.variabilityList",
                "variabilityToLoad": "result.variabilityToLoad",
                "cursor": "result.cursorObject",
                "previousGroup": "result.groupName",
                "pageSize": "result.pageSize",
                "loadedCount.dispValue": "result.loadedCount",
                "loadedCount.dbValue": "result.loadedCount",
                "loadedCount.uiValue": "result.loadedCount",
                "loadedCount.value": "result.loadedCount"
            },
            "deps": "js/Pca0FamilyProviderService"
        },
        "setCursorAndUpdateObservers": {
           "actionType": "batchJob",
            "steps": [
                {
                    "action": "setScrollPosition",
                    "condition": "!data.isLoading"
                }
            ]
        },
        "setScrollPosition": {
            "actionType": "JSFunction",
            "method": "setScrollPosition",
            "inputData": {
                "elementRef": "{{data.elementRefList}}",
                "familyUid":"{{props.familyUid}}",
                "cursorObject": "{{data.cursor}}"
            },
            "deps": "js/Pca0FamilyProviderService"
        },
        "removeIntersectionObserver": {
            "actionType": "JSFunction",
            "method": "removeIntersectionObserver",
            "deps": "js/Pca0FamilyProviderService"
        },
        "updateVariabilityWhenCollapseOrExpandBatch": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "startLoading"
                },
                {
                    "action": "updateVariabilityWhenCollapseOrExpand"
                },
                {
                    "action": "stopLoading"
                },
                {
                    "action": "setCursorAndUpdateObservers"
                }
            ]
        },
        "updateVariabilityWhenCollapseOrExpand": {
            "actionType": "JSFunction",
            "method": "updateVariabilityWhenCollapseOrExpand",
            "inputData": {
                "eventData": "{{parameters.eventData}}",
                "variabilityList": "{{data.variabilityList}}",
                "cursor": "{{data.cursor}}",
                "userExpandedFamiliesList": "{{data.userExpandedFamiliesList}}",
                "systemExpandedFamilies": "{{props.systemExpandedFamilies}}",
                "families" : "{{props.families}}",
                "pageSize": "{{data.pageSize}}"
            },
            "outputData": {
                "variabilityToLoad": "result.newVariabilityToLoad",
                "variabilityList": "result.newVariabilityList",
                "cursor": "result.newCursor",
                "userExpandedFamiliesList": "result.userExpandedFamilies"
            },
            "deps": "js/Pca0FamilyProviderService"
        }
    },
    "lifecycleHooks": {
        "render": "render",
        "onUpdate": [ {
            "action": "identifyActionAndSetData",
            "observers": [ "props.variabilityChange", "props.familyUid" ]
        },
        {
            "action": "loadFilterFamiliesBatch",
            "observers": [ "props.filterString" ]
        }],
        "onUnmount": "removeIntersectionObserver"
    },
    "functions": { },
    "conditions": { 
        "isSameGroup": {
            "expression": "data.previousGroup === props.groupName"
        }
    },
    "onEvent": [
        {
            "eventId": "pca0FeaturesScroll.loadPreviousVariability",
            "action": "loadPreviousFamilyDataAndSetScroll",
            "condition": "!data.cursor.startReached && !data.isLoading"
        },
        {
            "eventId": "pca0FeaturesScroll.loadNextVariability",
            "action": "loadNextFamilyDataAndSetScroll",
            "condition": "!data.cursor.endReached && !data.isLoading"
        },
        {
            "eventId": "Pca0Family.toggleFamily",
            "action": "updateVariabilityWhenCollapseOrExpandBatch",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition":"!data.isLoading && props.filterString === ''"
        }
    ],
    "props": {
        "families": {
            "type": "object"
        },
        "group-name": {
            "type": "string"
        },
        "variability-change": {
            "type": "string"
        },
        "family-index": {
            "type": "string"
        },
        "family-uid": {
            "type": "string"
        },
        "parent-ref": {
            "type": "object"
        },
        "filter-string": {
            "type": "string"
        },
        "variability-count": {
            "type": "string"
        },
        "system-expanded-families": {
            "type": "object"
        },
        "view-settings": {
            "type": "object"
        }
    }
}