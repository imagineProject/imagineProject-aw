{
    "schemaVersion": "1.0.0",
    "data": {
        "pca0GridOptions" : {
            "clientScopeURI": "Pca0ConstraintsGridEditor",
            "columnConfigId": "Pca0GridEditorColConfig"
        },
        "gridEditorMode": "Cfg0AbsConstraintRule",
        "refreshFlag": false
    },
    "actions": {
        "toggleRefreshViewFlag": {
            "actionType": "JSFunction",
            "method": "toggleBooleanProperty",
            "inputData": {
                "refreshFlag": "{{data.refreshFlag}}"
            },
            "outputData": {
                "refreshFlag": ""
            },
            "deps": "js/pca0CommonUtils"
        }
    },
    "onEvent": [ {
        "eventId": "Pca0GridEditorWrapper.refresh",
        "action": "toggleRefreshViewFlag"
        }
    ],
    "conditions": {
        "refreshTree": {
            "expression": "data.refreshFlag"
        }
    }
}
