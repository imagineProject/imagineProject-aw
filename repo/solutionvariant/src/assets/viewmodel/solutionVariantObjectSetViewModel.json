{
    "lifecycleHooks": {
        "onUpdate": [
            {
                "action": "updateSelectionEvent",
                "observers": [ "props.subPanelContext.selectionData" ]
            }
        ]
    },
    "data": {
        "gridInfo": {
            "enableArrangeMenu": true,
            "gridOptions": {
                "enableExpandAndPaginationInEdit": true,
                "enableGridMenu": true,
                "enableSorting": true,
                "isFilteringEnabled": true
            }
        },
        "xrtContext": {},
        "_objectSetInfo": {
            "firstPage": []
        }
    },
    "actions": {
        "updateSelectionEvent":{
            "actionType": "JSFunction",
            "method": "updateSVSelectionData",
            "inputData": {
                "selectionData": "{{subPanelContext.selectionData}}",
                "selection": "{{subPanelContext.selectionModel}}"
            },
            "outputData":{
                "props.subPanelContext.selectionData": ""
            },
            "events": {
                "success": [ {
                    "name": "pcaGrid.updateSelection"
                } ]
            },
            "deps": "js/solutionVariantTableService"
        },
        "updateSVTableSelection":{
            "actionType": "JSFunction",
            "method": "updateSVTableSelection",
            "inputData":{
                "dataProvider": "{{data}}",
                "eventData": "{{parameters.eventData}}"
            },
            "deps": "js/solutionVariantTableService"
        }
    },
    "onEvent": [
        {
            "eventId": "solutionVariantTable.updateSVTableSelection",
            "action": "updateSVTableSelection",
            "inputArgs": {
                "eventData": "{{eventData.svrUID}}"
            }
        }
    ]
}
