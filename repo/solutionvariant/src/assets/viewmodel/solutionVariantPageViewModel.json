{
    "schemaVersion": "1.0.0",
    "imports": [
        "js/aw-panel-body.directive",
        "js/aw-sublocation.directive"
    ],
    "data": {
        "provider": {
            "isXrtApplicable": false,
            "tabSetId": "SVContext",
            "viewKey": "SVContext",
            "useAutoBookmark": false,
            "name": "com.siemens.splm.client.SVPreview:solutionVariantPreviewSublocation",
            "clientScopeURI": "Smc1SolutionVariant",
            "selectionMode": "single",
            "nameToken": "com.siemens.splm.client.SVPreview:solutionVariantPreviewSublocation",
            "policy": "/policies/occMgmtPropertyPolicy.json",
            "viewBase": "solutionVariantPreview",
            "selectionQueryParamKey": "c_uid",
            "dataProviderName": "svPreviewDataProvider",
            "gridId": "solutionVariantPreviewTree",
            "contextKey": "SVContext",
            "enableWorkareaToolbarLite":true,
            "supportedLayouts": [ "Awp0SinglePaneLayout", "Awp0TopBottomLayout", "Awp0LeftRightLayout" ],
            "pwaViewModes": [ "tree" ],
            "secondaryWorkarea": true,
            "defaultLayout": {
                "layout": {
                    "row": [
                        { "pwaViewMode": "tree" }
                    ]
                },
                "layoutId": "Awp0SinglePaneLayout"
            },
            "awSubLocationPref": {
                "hideNavigationArea": false,
                "hideToolsAndInfoArea": true,
                "hideFooter": false
            },
            "context": {
                "commandContextParameters": ["filter", "recipe"],
                "search": {
                    "hideInContentSearchBox": true
                }
            },
            "breadcrumbConfig": {
                "noBreadCrumb": true
            },
            "urlParams": {
                "selectionQueryParamKey": "c_uid",
                "openStructureQueryParamKey": "o_uid",
                "rootQueryParamKey": "uid",
                "productContextQueryParamKey": "pci_uid",
                "csidQueryParamKey": "c_csid",
                "secondaryPageIdQueryParamKey": "spageId",
                "topElementQueryParamKey": "t_uid",
                "pageIdQueryParamKey": "pageId",
                "recipeParamKey": "recipe",
                "subsetFilterParamKey": "filter"
            }
        },
        "occContext": {
            "initialValues": {
                "configContext": {},
                "displayToggleOptions": {
                    "PSEShowUnconfigdVarPref": false,
                    "PSEShowSuppressedOccsPref": false
                },
                "supportedFeatures": {},
                "productContextInfo": {},
                "readOnlyFeatures": {},
                "currentState": {},
                "previousState": {},
                "transientRequestPref": {},
                "viewKey": "SVContext",
                "disabledFeatures": [
                    "Awb0SupportsVariantConditionAuthoring",
                    "Awb0SupportsFullScreenVariantConfiguration"
                ]
            },
            "meta": {}
        },
        "clientScopeURI": "Smc1SolutionVariant",
        "modelObject": "ctx.modelObjectsToOpen[0]"
    },
    "actions": {
        "initSolutionVariantPage": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "getData"
                },
                {
                    "action": "initializeSVContext"
                }
            ] 
        },
        "getData": {
            "actionType": "JSFunctionAsync",
            "method": "loadModelObjToOpen",
            "deps": "js/solutionVariantService",
            "outputData": {
                "ctx.modelObjectsToOpen": "result.modelObjs"
            }
        },
        "initializeSVContext": {
            "actionType": "JSFunction",
            "method": "initializeSVContext",
            "inputData": {
                "subPanelContext": "{{data.provider}}",
                "data": "{{data}}"
            },
            "deps": "js/solutionVariantService"
        },
        "cleanupSVContext": {
            "actionType": "JSFunction",
            "method": "cleanupSVContext",
            "deps": "js/solutionVariantService"
        }
    },
    "lifecycleHooks": {
        "onInit": "initSolutionVariantPage",
        "onUnmount": "cleanupSVContext"
    }
}
