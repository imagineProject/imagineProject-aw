              "selectedNode": "{{ctx.awClipBoardProvider}}",
              "newParentNode": "{{commandContext.selectionData.selected[0]}}",
              "actionType": "PASTE",
              "searchState": "{{props.subPanelContext.searchState}}",
              "nodeInfo": "{{commandContext.searchState.nodeInfo}}"
            }
          }
        ]
      }
    }
  },
  "onEvent": [
    {
      "eventId": "postProcessSearchSVRsponse",
      "action": "postProcessSearchSVResults",
      "cacheEventData": true
    },
    {
      "eventId": "invokeSearchSVSoa",
      "condition": "conditions.isValidSVR",
      "action": "searchSolutionVariants"
    },
    {
      "eventId": "removeFilterNotificationEvent",
      "message": "removeFiltersMessage"
    }
  ],
  "conditions": {
    "solutionVariantSupportedPlatformVersion": {
      "expression": "( ctx.tcSessionData.tcMajorVersion === 13 && ctx.tcSessionData.tcMinorVersion >= 2 ) || (ctx.tcSessionData.tcMajorVersion >= 14)"
    },
    "enableOpenSVCreateNotificationCommandCond": {
      "expression": "commandContext.group.groupName==='SOLUTION_VARIANT'"
    },
    "isVariantRuleApplied": {
      "expression": "ctx.aceActiveContext.context.productContextInfo.props.awb0CurrentVariantRule.dbValues[0]!==null"
    },
    "isVariantFeatureEnable": {
      "expression": "commandContext.occContext && commandContext.occContext.supportedFeatures.Awb0VariantFeature"
    },
    "isSolutionVariantCmdActiveOrVisible": {
      "expression": "conditions.isOccurrenceManagementSubLocation && conditions.isTreeOrTreeSummaryView && !ctx.splitView.mode && !conditions.isUpdateSWCCommandVisible && !conditions.isMarkupEnabled && conditions.isVariantFeatureEnable && ctx.preferences.SolutionVariantProviderAvailable[0] === 'true'"
    },
    "enableSolutionVariantPreview": {
      "expression": "conditions.isOccurrenceManagementSubLocation && ctx.mselected.length === 1 && ctx.visibleServerCommands.Smc1SolutionVariantCmd && conditions.isVariantRuleApplied && conditions.isTreeOrTreeSummaryView && !ctx.splitView.mode && !conditions.isUpdateSWCCommandVisible && !conditions.isMarkupEnabled"
    },
    "isSolutionVariantPreviewSubLocation": {
      "expression": "ctx.sublocation.clientScopeURI==='Smc1SolutionVariant'"
    },
    "isValidSVR": {
      "expression": "ctx.aceActiveContext.context.isValidSVR === true"
    },
    "isAuthoringGridInEditMode": {
      "expression": "ctx.isVariantTableEditing === true"
    },
    "isSmc1VariantRuleCommandActive": {
      "expression": "!conditions.isAuthoringGridInEditMode && ctx.variantConditionContext.isVariantContextForSolutionVariant"
    },
    "topSelected": {
      "expression": "ctx.pselected && ctx.pselected.props.awb0Parent && ctx.pselected.props.awb0Parent.dbValues[0] === null"
    },
    "svTableNotSelected": {
      "expression": "ctx.selected.modelType !== 'svTableSelection'"
    },
    "enableBulkSVUpdate": {
      "expression": {
        "$and": [
          {
            "$source": "commandContext.context.occContext.rootElement.props.awb0UnderlyingObjectType.dbValues",
            "$query": {
              "$notin": "Fnd0WorksetRevision"
            }
          },
          {
            "$source": "ctx.splitView.mode",
            "$query": {
              "$ne": true
            }
          },
          {
            "$and": [
              {
                "$source": "commandContext.selectionModel.selected.length",
                "$query": {
                  "$gt": 0
                }
              },
              {
                "$source": "conditions.isNotUpdateStatusList",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "conditions.doesSelectionHaveSV",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "commandContext.selectionData.selected",
                "$query": {
                  "$all": {
                    "$source": "props.smc0SVRValidAndComplete.value",
                    "$query": {
                      "$in": "Valid and Complete"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    },
    "enableBulkSVCreate": {
      "expression": {
        "$and": [
          {
            "$source": "commandContext.context.occContext.rootElement.props.awb0UnderlyingObjectType.dbValues",
            "$query": {
              "$notin": "Fnd0WorksetRevision"
            }
          },
          {
            "$source": "commandContext.context.occContext.supportedFeatures.Awb0SupportsFullScreenVariantConfiguration",
            "$query": {
              "$eq": true
            }
          },
          {
            "$source": "ctx.splitView.mode",
            "$query": {
              "$ne": true
            }
          },
          {
            "$and": [
              {
                "$source": "commandContext.selectionModel.selected.length",
                "$query": {
                  "$gt": 0
                }
              },
              {
                "$source": "commandContext.selectionData.selected",
                "$query": {
                  "$all": {
                    "$source": "props.smc0SVRValidAndComplete.value",
                    "$query": {
                      "$in": "Valid and Complete"
                    }
                  }
                }
              },
              {
                "$or": [
                  {
                    "$source": "conditions.isUpdateStatusList",
                    "$query": {
                      "$eq": true
                    }
                  },
                  {
                    "$source": "conditions.doesSelectionNotHaveSV",
                    "$query": {
                      "$eq": true
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "doesSelectionHaveSV": {
      "expression": "ctx.SVContext.doesSelectionHaveSV === 'true'"
    },
    "isUpdateStatusList": {
      "expression": "ctx.SVContext.isUpdateStatusList === 'true'"
    },
    "doesSelectionNotHaveSV": {
      "expression": "ctx.SVContext.doesSelectionHaveSV === 'false'"
    },
    "isNotUpdateStatusList": {
      "expression": "ctx.SVContext.isUpdateStatusList === 'false'"
    },
    "svIsOpenGroupEnabled": {
      "expression": "ctx.SVContext.doesSelectionHaveSV === 'true' || ctx.SVContext.doesSelectionHaveSV === 'none'"
    },
    "enableOpenCell": {
      "expression": {
        "$source": "commandContext.vmo.props.smc0SVCategory.uiValue",
        "$query": {
          "$notNull": true
        }
      }
    },
    "isExistingSVViewSelected": {
      "expression": "ctx.SVContext.hasSolutionVariant === 'True'"
    },
    "isPendingSVViewSelected": {
      "expression": "ctx.SVContext.hasSolutionVariant === 'False'"
    },
    "isAllSVViewSelected": {
      "expression": "ctx.SVContext.hasSolutionVariant === ''"
    },
    "smc1IsVCA2ValidateVariantConditionActive": {
      "expression": "conditions.isSolutionVariantTabSelected && ctx.variantConditionContext.selectedObjectsFromConsumerApps.length < 1"
    },
    "isStartEditEnabledForVCASV": {
      "expression": "conditions.isSolutionVariantTabSelected && conditions.isStartEditEnabledForVCA2"
    },
    "isSolutionVariantTabSelected": {
      "expression": "ctx.occmgmtContext.currentState.spageId === 'tc_xrt_SolutionVariants' && !ctx.variantConditionContext.isVariantContextForColor"
    },
    "isSolutionVariantSectionAvailable": {
      "expression": "ctx.occmgmtContext.currentState.spageId === 'tc_xrt_SolutionVariants'"
    },
    "svisCutActive": {
      "expression": "conditions.isSolutionVariantSectionAvailable && conditions.removeAttachmentVisibility"
    },
    "solutionVariantStartEditSummaryCondition": {
      "expression": "conditions.isStartEditSummaryAllowed && conditions.isSolutionVariantTabSelected"
    },
    "Pca0VariantConfigurationCommandConditionForSV": {
      "expression": "conditions.isSolutionVariantPreviewSubLocation && conditions.supportsPca0VariantConfigurationView"
    },
    "isFilterAppliedOnWindowSV": {
      "expression": "commandContext.occContext.productContextInfo.props.awb0FilterCount.dbValues[0] > 0 && conditions.isSolutionVariantTabSelected"
    }
  },
  "messages": {
    "svCreateFailureMessage": {
      "messageType": "ERROR",
      "messageText": "{{errorCode}}"
    },
    "invalidOrIncompleteSVRMessage": {
      "messageType": "ERROR",
      "messageText": "{{i18n.invalidOrIncompleteVariantRule}}"
    },
    "solutionVariantExists": {
      "messageType": "INFO",
      "messageText": "{{i18n.existingSVConfirmation}}",
      "messageTextParams": [
        "{{ctx.selected.props.awb0ArchetypeRevName.uiValues[0]}}"
      ],
      "navigationOptions": [
        {
          "option": "Cancel",
          "text": "{{i18n.cancelSVCreation}}"
        },
        {
          "option": "Open",
          "text": "{{i18n.openSV}}",
          "action": "aceShowObjectForSolutionVariant"
        }
      ]
    },
    "createSVUsagesProgressNotification": {
      "messageType": "INFO",
      "messageText": "{{i18n.createSVUsagesProgressNotification}}",
      "messageTextParams": []
    },
    "removeFiltersMessage": {
      "messageType": "ERROR",
      "messageText": "{{i18n.removeFilterMessage}}"
    }
  },
