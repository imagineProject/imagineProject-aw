{
    "schemaVersion": "1.0.0",

    "actions":
    {
        "closePanel":
        {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        },
        "backAction":
        {
            "actionType": "JSFunction",
            "method": "setActiveView",
            "inputData":
            {
                "destinationPanelId":"DisplayAndRemoveEffectivitiesForRelStatus",
                "data": "{{data}}",
                "subPanelContext": "{{props.subPanelContext}}",
                "i18n": "{{data.i18n}}"
            },
            "outputData": {
                "sharedData":""
            },
            "deps": "js/aceEffectivityService"
        },
        "backToPrevious":
        {
            "actionType": "JSFunction",
            "method": "setActiveViewFromEndItem",
            "inputData":
            {
                "destinationPanelId":"{{data.sharedData.previousView}}",
                "sharedData": "{{data.sharedData}}"
            },
            "outputData": {
                "sharedData":""
            },
            "deps": "js/aceEffectivityService"
        },
        "closePanelBatchAction":
        {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "closePanel",
                    "condition": "conditions.isSelectedItemWithNoReleaseStatusOrMultipleItemSelected || (data.previousSelectedUid !== null && data.previousSelectedUid !== props.subPanelContext.occContext.pwaSelection[0].uid) "
            }]
        },
        "setPreviousSelectedUidAndLength":{
            "actionType": "JSFunction",
            "method": "updatePreviousSelectedUid",
            "inputData": {
                    "currentSelectedUid": "{{ctx.selected.uid}}",
                    "data":"{{data}}",
                    "subPanelContext":"{{props.subPanelContext}}"
            },
            "deps": "js/aceEffectivityService"
        }
    },

    "i18n": {
        "effectivityTitle": ["OccurrenceManagementConstants"],
        "endItemMessage":[ "OccurrenceManagementConstants"],
        "addEffectivity":[ "OccurrenceEffectivityConstants"],
        "addDateEffectivity":[ "OccurrenceEffectivityConstants"],
        "addUnitEffectivity":[ "OccurrenceEffectivityConstants"],
        "editEffectivity":[ "OccurrenceEffectivityConstants"],
        "editDateEffectivity":[ "OccurrenceEffectivityConstants"],
        "editUnitEffectivity":[ "OccurrenceEffectivityConstants"],
        "dateEffectivity": [ "OccurrenceManagementConstants"]
    },

    "lifecycleHooks": {
        "onMount": "setPreviousSelectedUidAndLength",
        "onUpdate": [ {
            "action": "closePanelBatchAction",
            "observers": [ "props.subPanelContext.occContext.pwaSelection" ]
        }]
    },

    "data": {
        "sharedData": {
            "initialValues": {
                "activeView": "DisplayAndRemoveEffectivitiesForRelStatus",
                "previousView": "",
                "dateOrUnitEffectivityTypeRadioButton":{
                    "type": "BOOLEAN",
                    "dbValue": true
                },
                "dateEffectivityEnable":{
                    "type":"BOOLEAN",
                    "dbValue":false
                },
                "unitEffectivityEnable":{
                    "type":"BOOLEAN",
                    "dbValue":false
                },
                "endItemVal":{
                    "dbValue": null,
                    "uiValue": null
                },
                "endItemValForDate": {
                    "dbValue": null,
                    "uiValue": null,
                    "endItem":{
                        "uid": null,
                        "type": null
                    }
                },
                "releaseStatus":{
                    "uid": null,
                    "type": null,
                    "uiValue": null,
                    "dbValue": null
                },
                "nameBox" : {
                    "dbValue": null
                },
                "nameBoxForUnit" : {
                    "dbValue": null
                },
                "unitRangeText": {
                    "dbValue": null
                },
                "isShared": {
                    "type": "BOOLEAN",
                    "dbValue": false
                },
                "isSharedForUnit": {
                    "type": "BOOLEAN",
                    "dbValue": false
                },
                "startDate": {
                    "type": "DATE",
                    "dbValue": null
                },
                "endDate": {
                    "type": "DATE",
                    "dbValue": null
                },
                "endDateOptions": {
                    "dbValue": "Date",
                    "uiValue": "{{i18n.dateEffectivity}}"
                },
                "isProtected": {
                    "type": "BOOLEAN",
                    "dbValue": false
                },
                "selectedCell": {
                    "uid": null,
                    "type": null
                },
                "isTimeEnabled": {
                    "type": "BOOLEAN",
                    "value": false
                },
                "isUnitUpdated": {
                    "type": "BOOLEAN",
                    "dbValue": false
                },
                "previousSelectionUid": ""
            },
            "meta": { }
        },
        "previousSelectedUid": null,
        "previousSelectionLength": []
    },

    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },

    "conditions": {
        "isSelectedItemWithNoReleaseStatusOrMultipleItemSelected": {
            "expression": "props.subPanelContext.occContext.pwaSelection.length > 1 || props.subPanelContext.occContext.pwaSelection[0].props.awb0ArchetypeRevRelStatus.dbValues.length === 0 || data.sharedData.activeView === 'EditEffectivities' "
        }
    }
}
