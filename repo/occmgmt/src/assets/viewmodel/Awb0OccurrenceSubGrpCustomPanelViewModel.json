{
    "schemaVersion": "1.0.0",

    "actions": {
         "getPrimaryElementsProvider":
        {
            "actionType": "dataProvider",
            "method": "getPrimaryElements"
        },
        "getPrimaryElementsProviderBatchJob": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "getPrimaryElementsProvider",
                    "condition": "props.subPanelContext.occContext.pwaSelection.length > 1"
                }
            ]
        }

    },
    "lifecycleHooks": {
        "onMount":"getPrimaryElementsProvider",
        "onUpdate": {
            "action": "getPrimaryElementsProviderBatchJob",
            "observers": [
                "props.subPanelContext.occContext.pwaSelection"
            ]
        }
    },
    "dataProviders": {
        "getPrimaryElements": {
            "totalFound" : "{{props.subPanelContext.occContext.pwaSelection.length}}",
            "response": "{{props.subPanelContext.occContext.pwaSelection}}",
            "selectionModelMode": "none"
        }
    },
    "onEvent": [

    ],
    "i18n": {
        "primaryElements": [
            "OccurrenceManagementConstants"
        ],
        "substitutes": [
            "OccurrenceManagementConstants"
        ]
    },
    "conditions": {
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
