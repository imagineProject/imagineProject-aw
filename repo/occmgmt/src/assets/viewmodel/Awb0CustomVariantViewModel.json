{
    "schemaVersion": "1.0.0",
    "imports": [
        "js/aw-command-panel.directive",
        "js/aw-command-sub-panel.directive",
        "js/visible-when.directive",
        "js/aw-init.directive"
    ],
    "actions": {
        "launchConfigurationPanelOnBack": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                    "view": "Awb0ConfigurationFilter",
                    "placement": "left",
                    "parent": ".aw-layout-workarea",
                    "width": "STANDARD",
                    "height": "FULL",
                    "subPanelContext": "{{subPanelContext}}",
                    "push": true,
                    "isCloseVisible": false,
                    "isPinUnpinEnabled": true
                }
            }
        },
        "backToDefineClassicVariantRule": {
            "actionType": "JSFunction",
            "method": "updateValueOnCtxOrState",
            "inputData": {
                "path": "",
                "value": {
                    "activeView": "Awb0DefineClassicVariantRule"
                },
                "target": "{{fields.customVariantState}}"
            },
            "deps": "js/occmgmtUtils"
        }
    },
    "data": {
        "customVariantState": {
            "initialValues": {
                "activeView": "Awb0DefineClassicVariantRule"
            },
            "meta": { }
        }
    },
    "messages": {},
    "conditions": {
    },
    "onEvent": [

    ],
    "i18n": {
        "occmgmtConfigurationFilterTitle": [
            "OccurrenceManagementConstants"
        ],
        "customCVConfigurationTitle": [
            "OccurrenceManagementConstants"
        ],
        "saveButtonText": [
            "OccurrenceManagementConstants"
        ]
    }
}
