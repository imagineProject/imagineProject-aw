{
    "schemaVersion" : "1.0.0",
    "i18n": {
        "addRevisionTitle": [
            "OccmgmtRevOccConstants"
        ]
    },
    "data" : {
        "addElementState":{
            "initialValues":{
                "AddOccurrencePropertiesOnCreate" : false,
                "parentElements" : [],
                "parentToLoadAllowedTypes" : null,
                "siblingElements" : [],
                "elementCreateInput" : null,
                "fetchPagedOccurrences" : null,
                "previousSelectionUid" : "",
                "Awb0ElementCreateSubView" : false,
                "numberOfElements" : 1
            },
            "meta": {
            }
        }
    },
    "actions" : {
        "initialize":
        {
            "actionType": "JSFunction",
            "method": "updateStateForAceAddSiblingPanel",
            "inputData":
            {
                "selectedObjects": "{{subPanelContext.occContext.pwaSelection}}",
                "addElementState": "{{data.addElementState}}"
            },
            "outputData": {
                "addElementState" : ""
            },
            "deps": "js/aceAddElementService"
        }
    },
    "conditions" :{
        "isParentValid" : {
            "expression" : "addElementState.parentElements.length>0"
        }
    },
    "lifecycleHooks": {
        "onUpdate":{
            "action": "initialize",
            "observers": [ "props.subPanelContext.occContext.pwaSelection" ]
        }
    }
}
