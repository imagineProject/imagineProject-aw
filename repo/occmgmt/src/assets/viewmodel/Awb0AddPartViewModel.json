{
    "schemaVersion": "1.0.0",
    "i18n": {
        "addUsageProperties": [
            "OccmgmtRevOccConstants"
        ],
        "addElementBtn": [
            "OccmgmtRevOccConstants"
        ],
        "toTitle": [
            "OccmgmtRevOccConstants"
        ],
        "elementAddSuccessful": [
            "OccurrenceManagementMessages"
        ],
        "multipleElementAddSuccessful": [
            "OccurrenceManagementMessages"
        ],
        "singleElementAddToMultipleSelectionSuccessful":[
            "OccurrenceManagementMessages"
        ],
        "multipleElementAddToMultipleSelectionSuccessful":[
            "OccurrenceManagementMessages"
        ],
        "selectedElementsToHeaderTitle":
        [
            "OccurrenceManagementConstants"
        ],
        "partiallyMultipleElementAddToMultipleSelection":[
            "OccurrenceManagementMessages"
        ],
        "partiallySingleElementAddToMultipleSelection":[
            "OccurrenceManagementMessages"
        ],
         "elementAddSuccessfulWithWarning": [
            "OccurrenceManagementMessages"
        ],
        "multipleElementAddSuccessfulWithWarning": [
            "OccurrenceManagementMessages"
        ],
        "singleElementAddToMultipleSelectionSuccessfulWithWarning":[
            "OccurrenceManagementMessages"
        ],
         "multipleElementAddToMultipleSelectionSuccessfulWithWarning":[
            "OccurrenceManagementMessages"
        ]
    },
    "data": {
        "addElementState":{
            "initialValues":{
                "AddOccurrencePropertiesOnCreate" : false,
                "parentElements" : [],
                "parentToLoadAllowedTypes" : null,
                "siblingElements" : [],
                "elementCreateInput" : null,
                "createData" : null,
                "fetchPagedOccurrences" : null,
                "previousSelectionUid" : "",
                "Awb0ElementCreateSubView" : false,
                "numberOfElements" : 1
            },
            "meta": {
            }
        },
        "activeState": {
            "initialValues": {
                "activeView": "AddObjectPrimarySub",
                "context": {}
            },
            "meta": {}
        },
        "triggerCreate": {
            "dbValue": false,
            "type": "BOOLEAN"
        },
        "addPanelState": {
            "initialValues": {
                "creationType": "",
                "createdObject": "",
                "sourceObjects": "",
                "selectedTab": ""
            },
            "meta": {}
        },
        "xrtState": {
            "initialValues": {},
            "meta": {
                "xrtVMO": {
                    "field": "true",
                    "type": "viewModelObject"
                }
            }
        },
        "projectState": {
            "initialValues": {
                "selectedProjects": [],
                "triggerAssign": false
            },
            "meta": {}
        }
    },
    "editHandlers": {
        "addPanelEditHandler": {
            "context": "CREATE_PANEL_CONTEXT",
            "dataSource": {
                "xrtVMO": "{{data.xrtState}}"
            }
        }
    },
    "actions": {
        "initialize": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "getInfoForAddElementAction"
                },
                {
                    "action": "getAddPanelToWidgetElementName"
                }
            ]
        },
        "getAddPanelToWidgetElementName":{
            "actionType": "JSFunction",
            "method": "getHeaderSectionTitle",
            "inputData": {
                "headerSectionSelectedElementString": "{{data.i18n.selectedElementsToHeaderTitle}}",
                "selectedObjects" : "{{props.subPanelContext.addElementState.parentElements}}"
            },
            "outputData": {
                "headerSectionElement": ""
            },
            "deps": "js/awPanelHeaderSectionService"
        },
        "closeDialog": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "INFO_PANEL_CONTEXT",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        },
        "clearCreatedElementField": {
            "actionType": "JSFunction",
            "method": "clearCreatedElementField",
            "inputData": {},
            "outputData": {
                "addPanelState.createdObject" : "createdObject"
            },
            "events": {
                "success": [ {
                    "name": "addElement.closeDialog"
                } ]
            },
            "deps": "js/aceAddElementService"
        },
        "getInfoForAddElementAction": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-ActiveWorkspaceBom-2021-06-OccurrenceManagement",
            "method": "getInfoForAddElement4",
            "inputData": {
                "getInfoForElementIn": {
                    "parentElement": "{{props.subPanelContext.addElementState.parentToLoadAllowedTypes}}",
                    "fetchAllowedOccRevTypes": false
                }
            },
            "outputData": {
                "allowedPartTypesInfo": "{{function:extractAllowedTypesInfoFromResponse}}"
            },
            "deps": "js/aceAddElementService"
        },
        "createAndAddElement": {
            "actionType": "JSFunction",
            "method": "updateCreateTrigger",
            "inputData": {
                "triggerCreate": "{{data.triggerCreate}}",
                "value": true
            },
            "outputData": {
                "triggerCreate": "triggerCreate"
            },
            "deps": "js/addObjectUtils"
        },
        "addExistingRevision": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "addObject.revisionCreated",
                        "eventData": {
                            "createdObject": "",
                            "sourceObjects": "{{addPanelState.sourceObjects}}"
                        }
                    }
                ]
            }
        },
        "addElementsWithCreateInput": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-ActiveWorkspaceBom-2025-06-OccurrenceManagement",
            "method": "addObject5",
            "inputData": {
                "input": {
                    "addObjectParentChildrenList":"{{function:prepareAddObjectInput}}",
                    "addObjectIntent": "",
                    "numberOfElements": 1,
                    "fetchPagedOccurrences": true,
                    "sortCriteria": {
                        "propertyName": "{{ctx.aceActiveContext.context.sortCriteria[0].fieldName}}",
                        "sortingOrder": "{{ctx.aceActiveContext.context.sortCriteria[0].sortDirection}}"
                    },
                    "requestPrefMap": {
                        "displayMode": [ "{{function:getDisplayMode}}" ]
                    }
                }
            },
            "outputData": {
                "addElementResponse": "{{function:getAddElementResponse}}",
                "totalObjectsAdded": "{{function:getTotalNumberOfChildrenAdded}}"
            },
            "events": {
                "success": [
                    {
                        "name": "addElement.elementsAdded",
                        "eventData": {
                            "objectsToSelect": "{{data.addElementResponse.newlyAddedChildElements}}",
                            "addElementResponse": "{{data.addElementResponse}}",
                            "viewToReact": "{{props.subPanelContext.provider.contextKey}}",
                            "updatedParentElement" : "{{props.subPanelContext.occContext.openedElement}}"
                        },
                        "condition": "conditions.areNewElementsAdded"
                    },
                    {
                        "name": "aceElementsSelectionUpdatedEvent",
                        "eventData": {
                            "objectsToSelect": "{{data.addElementResponse.newlyAddedChildElements}}",
                            "viewToReact": "{{props.subPanelContext.provider.contextKey}}"
                        },
                        "condition": "conditions.isSelectionUpdateEventApplicable"
                    },
                    {
                        "name": "addElement.clearCreatedElementField"
                    },
                    {
                        "name": "addElement.usageCreated",
                        "condition": "conditions.isPanelPinned && conditions.areNewElementsAdded"
                    }
                ],
                "failure": [
                    {
                        "name": "addElement.elementsAdded",
                        "eventData": {
                            "objectsToSelect": "{{data.addElementResponse.newlyAddedChildElements}}",
                            "addElementResponse": "{{data.addElementResponse}}",
                            "viewToReact": "{{props.subPanelContext.provider.contextKey}}",
                            "updatedParentElement" : "{{props.subPanelContext.occContext.openedElement}}"
                        },
                        "condition": "conditions.areNewElementsAdded"
                    },
                    {
                        "name": "aceElementsSelectionUpdatedEvent",
                        "eventData": {
                            "objectsToSelect": "{{data.addElementResponse.newlyAddedChildElements}}",
                            "viewToReact": "{{props.subPanelContext.provider.contextKey}}"
                        },
                        "condition": "conditions.isSelectionUpdateEventApplicable"
                    },
                    {
                        "name": "addElement.usageCreated",
                        "condition": "conditions.isPanelPinned && conditions.areNewElementsAdded"
                    }
                ]
            },
            "actionMessages": {
                "success": [
                    {
                        "message": "newElementAddToSingleSelectionSuccessMessage",
                        "condition": "addPanelState.createdObject && addPanelState.createdObject.props && props.subPanelContext.occContext.pwaSelection.length === 1"
                    },
                    {
                        "message": "oneCopiedElementAddToSingleSelectionSuccessMessage",
                        "condition": "addPanelState.createdObject && addPanelState.createdObject.length === 1 && props.subPanelContext.occContext.pwaSelection.length === 1"
                    },
                    {
                        "message": "existingSingleElementAddToSingleSelectionSuccesMessage",
                        "condition": "addPanelState.sourceObjects.length === 1 && !addPanelState.createdObject && props.subPanelContext.occContext.pwaSelection.length === 1"
                    },
                    {
                        "message":"existingMultipleElementAddToSingleSelectionSuccessMessage",
                        "condition":"addPanelState.sourceObjects.length > 1 && !addPanelState.createdObject && props.subPanelContext.occContext.pwaSelection.length === 1 && conditions.isElementAddedSuccessfully"
                    },
                    {
                        "message": "singleElementAddToMultipleSelectionSuccessMessage",
                        "condition": "addPanelState.createdObject && addPanelState.createdObject.props && props.subPanelContext.occContext.pwaSelection.length > 1 && conditions.isElementAddedSuccessfully"
                    },
                    {
                        "message": "oneCopiedElementAddToMultipleSelectionSuccessMessage",
                        "condition": "addPanelState.createdObject && addPanelState.createdObject.length === 1 && props.subPanelContext.occContext.pwaSelection.length > 1 && conditions.isElementAddedSuccessfully"
                    },
                    {
                        "message": "existingSingleElementAddToMultipleSelectionSuccessMessage",
                        "condition": "addPanelState.sourceObjects.length === 1 && props.subPanelContext.occContext.pwaSelection.length > 1 && conditions.isElementAddedSuccessfully"
                    },
                    {
                        "message": "existingMultipleElementAddToMultipleSelectionSuccessMessage",
                        "condition": "addPanelState.sourceObjects.length > 1 && props.subPanelContext.occContext.pwaSelection.length > 1 && conditions.isElementAddedSuccessfully"
                    },
                    {
                        "message": "partiallySingleElementAddToMultipleSelectionMessage",
                        "condition":"addPanelState.createdObject && addPanelState.createdObject.props && props.subPanelContext.occContext.pwaSelection.length > 1 && !conditions.isElementAddedSuccessfully"
                    },
                    {
                        "message":"partiallyExistingSingleElementAddToMultipleSelectionMessage",
                        "condition":"addPanelState.sourceObjects.length === 1  && props.subPanelContext.occContext.pwaSelection.length > 1 && !conditions.isElementAddedSuccessfully"
                    },
                    {
                        "message": "partiallyExistingMultipleElementAddToMultipleSelectionMessage",
                        "condition":"addPanelState.sourceObjects.length > 1  && props.subPanelContext.occContext.pwaSelection.length > 1 && !conditions.isElementAddedSuccessfully"
                    }
                ],
                "failure":
                [
                    {
                        "message": "newElementAddToSingleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.createdObject && addPanelState.createdObject.props && props.subPanelContext.occContext.pwaSelection.length === 1 && !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "oneCopiedElementAddToSingleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.createdObject && addPanelState.createdObject.length === 1 && props.subPanelContext.occContext.pwaSelection.length === 1 && !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "existingSingleElementAddToSingleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.sourceObjects.length === 1 && !addPanelState.createdObject && props.subPanelContext.occContext.pwaSelection.length === 1 && !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "existingMultipleElementAddToSingleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.sourceObjects.length > 1 && !addPanelState.createdObject && props.subPanelContext.occContext.pwaSelection.length === 1 && !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "singleElementAddToMultipleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.createdObject && addPanelState.createdObject.props && props.subPanelContext.occContext.pwaSelection.length > 1 && !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "oneCopiedElementAddToMultipleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.createdObject && addPanelState.createdObject.length === 1 && props.subPanelContext.occContext.pwaSelection.length > 1 && !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "existingSingleElementAddToMultipleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.sourceObjects.length === 1 && props.subPanelContext.occContext.pwaSelection.length > 1 &&  !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "existingMultipleElementAddToMultipleSelectionSuccessWithWarningMessage",
                        "condition":"addPanelState.sourceObjects.length > 1 && props.subPanelContext.occContext.pwaSelection.length > 1 && !conditions.isErrorPresentInAddResponse"
                    },
                    {
                        "message": "partiallyExistingMultipleElementAddToMultipleSelectionMessage",
                        "condition":"addPanelState.sourceObjects.length > 1  && props.subPanelContext.occContext.pwaSelection.length > 1 && conditions.isErrorPresentInAddResponse && conditions.areNewElementsAdded"
                    },
                    {
                        "message": "partiallyExistingMultipleElementAddToSingleSelectionMessage",
                        "condition":"addPanelState.sourceObjects.length > 1  && props.subPanelContext.occContext.pwaSelection.length ==1 && conditions.isErrorPresentInAddResponse && conditions.areNewElementsAdded"
                    },
                    {
                        "message": "partiallySingleElementAddToMultipleSelectionMessage",
                        "condition":"addPanelState.createdObject && addPanelState.createdObject.props && props.subPanelContext.occContext.pwaSelection.length > 1 && conditions.isErrorPresentInAddResponse && conditions.areNewElementsAdded"
                    },
                    {
                        "message":"partiallyExistingSingleElementAddToMultipleSelectionMessage",
                        "condition":"addPanelState.sourceObjects.length === 1  && props.subPanelContext.occContext.pwaSelection.length > 1 && conditions.isErrorPresentInAddResponse && conditions.areNewElementsAdded"
                    },
                    {
                        "message": "addElementsFailureMessage",
                        "condition": "conditions.areNewElementsAdded === false"
                    }
                ]
            },
            "deps": "js/aceAddElementService"
        },
        "performPostProcessingAfterCreate": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "addRevOccElementProperties",
                    "condition": "addPanelState.createdObject"
                },
                {
                    "action": "newElementCreatedPostProcessing"
                }
            ]
        },
        "newElementCreatedPostProcessing": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "awPanel.loadNextValues",
                        "condition": "conditions.isPanelPinned"
                    }
                ]
            }
        },
        "addRevOccElementProperties": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "awb0Element.addRevOccElementProperties",
                    "excludeLocalDataCtx": true
                    }
                ]
            }
        },
        "setActiveView":{
            "actionType": "JSFunction",
            "method": "resetActiveView",
            "inputData": {
                "stateName": "{{data.activeState}}",
                "destPanelId": "AddObjectPrimarySub"
            },
            "outputData": {
                "activeState": ""
            },
            "deps": "js/addObjectUtils"
        },
        "addUsageProperties": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "awb0Element.addUsageProperties",
                    "eventData": {
                        "createdObject": "",
                        "sourceObjects": "{{addPanelState.sourceObjects}}"
                        }
                    }
                ]
            }
        }
    },
