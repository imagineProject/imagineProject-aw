{
    "schemaVersion": "1.0.0",
    "conditions": {
        "isShowAlignedDesignsOccTree": {
            "expression": "props.subPanelContext.context.contextKey === data.contextKey"
        },
        "isLeftView": {
            "expression": "!conditions.isRightView"
        },
        "isRightView": {
            "expression": "props.subPanelContext.context.contextKey && props.subPanelContext.context.customEditContext==='rightXRTEditContext'"
        }        
    },

    "lifecycleHooks": {
        "onMount": "setViewConfig",
        "onUpdate": [
        {
            "action": "handleFocusChange",
            "observers": [ "props.subPanelContext.focusComponent" ]
        },
        {
            "action": "handleSelectionChange",
            "observers": [ "viewModel.atomicData.selectionData" ]
        },
        {
            "action": "resetAlignedDesignsOccTreeData",
            "observers": [
                "props.subPanelContext.occContext.productContextInfo.props.awb0CurrentRevRule"
            ]
        }
    ]
    },

    "data": {
        "alignedDesignsOccTreeRevisionRuleLabel": {
            "displayName": "{{i18n.alignedDesignsOccTreeRevisionRuleLabel}}",
            "type": "STRING",
            "isEditable": "false",
            "dbValue": "{{props.subPanelContext.occContext.productContextInfo.props.awb0CurrentRevRule.dbValues[0]}}",
            "dispValue": "{{props.subPanelContext.occContext.productContextInfo.props.awb0CurrentRevRule.uiValues[0]}}"
        },
        "configureStructure": {
            "type": "BOOLEAN",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT",
            "isEditable": "true",
            "dbValue": true,
            "displayName": "{{i18n.toggleOn}}"
        },
        "configureStructure2": {
            "type": "BOOLEAN",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT",
            "isEditable": "true",
            "dbValue": true,
            "displayName": "{{i18n.toggleOn}}"
        },
        "configureStructureView": {
            "type": "BOOLEAN",
            "labelPosition": "PROPERTY_LABEL_AT_RIGHT",
            "isEditable": "true",
            "dbValue": true,
            "displayName": "{{i18n.toggleOn}}"
        },
        "gridId": "alignedDesignsOccTreeGrid",
        "selectionData": {
            "initialValues": {},
            "meta": {}
        }
    },
    "actions": {
        "handleSelectionChange": {
            "actionType": "JSFunction",
            "method": "handleHtmlPanelSelectionChange",
            "inputData": {
                "localSelectionData": "{{data.selectionData}}",
                "parentSelectionData": "{{props.subPanelContext.selectionData}}",
                "selectionModel": "{{dataProviders.alignedDesignsOccTreeDataProvider.selectionModel}}"
            },
            "outputData": {},
            "deps": "js/xrtUtilities"
        },
        "handleFocusChange": {
            "actionType": "JSFunction",
            "method": "handleHtmlPanelFocusChange",
            "inputData": {
                "localSelectionData": "{{data.selectionData}}",
                "focusComponent": "{{props.subPanelContext.focusComponent}}",
                "selectionModel": "{{dataProviders.alignedDesignsOccTreeDataProvider.selectionModel}}"
            },
            "deps":"js/xrtUtilities"
        },
        "setViewConfig": {
            "actionType": "JSFunction",
            "method": "setViewConfig",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext}}",
                "data": "{{data}}",
                "topLevel": false
            },
            "outputData":{
                "gridId": "result.gridId",
                "contextKey": "result.contextKey",
                "configureStructureView": "result.configureStructureView"
            },
            "deps": "js/alignedDesignsOccTreeService"
        },
        "loadAlignedDesignsOccTree": {
            "actionType": "JSFunctionAsync",
            "method": "loadAlignedDesignsOccTree",
            "inputData": {
                "treeLoadInput": "request.treeLoadInput",
                "subPanelContext": "{{props.subPanelContext}}",
                "configureParent": "{{data.data.configureStructureView.dbValue}}",
                "level": "IMMEDIATE_PARENTS"
            },
            "outputData": {
                "response": "tableSummaries",
                "isDataLoadDone": true,
                "dataProviders.alignedDesignsOccTreeDataProvider.columnConfig": "result.treeLoadResult.columnConfig",
                "clientScopeURI": "result.clientScopeURI",
                "dataProviders.alignedDesignsOccTreeDataProvider.objectSetUri": "result.objectSetUri"
            },
            "deps": "js/alignedDesignsOccTreeService"
        },
        "loadAlignedDesignsOccTree2": {
            "actionType": "JSFunctionAsync",
            "method": "loadAlignedDesignsOccTree",
            "inputData": {
                "treeLoadInput": "request.treeLoadInput",
                "subPanelContext": "{{props.subPanelContext}}",
                "configureParent": "{{data.data.configureStructureView.dbValue}}",
                "level": "IMMEDIATE_PARENTS"
            },
            "outputData": {
                "response": "tableSummaries",
                "isDataLoadDone": true,
                "dataProviders.alignedDesignsOccTreeDataProvider2.columnConfig": "result.treeLoadResult.columnConfig",
                "clientScopeURI" : "result.clientScopeURI",
                "dataProviders.alignedDesignsOccTreeDataProvider2.objectSetUri": "result.objectSetUri"
            },
            "deps": "js/alignedDesignsOccTreeService"
        },
        "loadNextAlignedDesignsOccTree": {
            "actionType": "JSFunctionAsync",
            "method": "loadNextAlignedDesignsOccTree",
            "inputData": {
                "treeLoadInput": "request.treeLoadInput",
                "subPanelContext": "{{props.subPanelContext}}",
                "configureParent": "{{data.data.configureStructureView.dbValue}}",
                "level": "IMMEDIATE_PARENTS"
            },
            "outputData": {},
            "deps": "js/alignedDesignsOccTreeService"
        },
        "saveColumnConfigLoadData": {
            "actionType": "JSFunctionAsync",
            "method": "baseSaveUiColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigurations": [
                        {
                            "clientScopeURI": "{{data.clientScopeURI}}",
                            "columnConfigId": "{{data.dataProviders.alignedDesignsOccTreeDataProvider.columnConfig.columnConfigId}}",
                            "columns": "{{data.dataProviders.alignedDesignsOccTreeDataProvider.newColumns}}",
                            "scope": "LoginUser",
                            "scopeName": ""
                        }
                    ]
                }
            },
            "outputData": {}
        },
        "saveColumnConfigLoadData2": {
            "actionType": "JSFunctionAsync",
            "method": "baseSaveUiColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigurations": [ {
                        "clientScopeURI": "{{data.clientScopeURI}}",
                        "columnConfigId": "{{data.dataProviders.alignedDesignsOccTreeDataProvider2.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.alignedDesignsOccTreeDataProvider2.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    } ]
                }
            },
            "outputData": {}
        },
        "resetColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [
                        {
                            "scope": "LoginUser",
                            "scopeName": "",
                            "clientName": "AWClient",
                            "resetColumnConfig": true,
                            "columnConfigQueryInfos": [
                                {
                                    "clientScopeURI": "{{data.clientScopeURI}}",
                                    "operationType": "configured",
                                    "columnsToExclude": []
                                }
                            ],
                            "businessObjects": [
                                {}
                            ]
                        }
                    ]
                }
            },
            "outputData": {
                "dataProviders.alignedDesignsOccTreeDataProvider.columnConfig": "columnConfigurations[0].columnConfigurations[0]"
            }
        },
        "resetColumnConfig2": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [ {
                        "scope": "LoginUser",
                        "scopeName": "",
                        "clientName": "AWClient",
                        "resetColumnConfig": true,
                        "columnConfigQueryInfos": [ {
                            "clientScopeURI": "{{data.clientScopeURI}}",
                            "operationType": "configured",
                            "columnsToExclude": []
                        } ],
                        "businessObjects": [ {} ]
                    } ]
                }
            },
            "outputData": {
                "dataProviders.alignedDesignsOccTreeDataProvider2.columnConfig": "columnConfigurations[0].columnConfigurations[0]"
            }
        },
        "doArrangeEvent": {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "updateToggleLabel": {
            "actionType": "JSFunctionAsync",
            "method": "updateToggleLabel",
            "inputData": {
                "configureParent": "{{data.configureStructureView.dbValue}}"
            },
            "outputData": {
                "configureStructureView.propertyDisplayName": ""
            },
            "deps": "js/alignedDesignsOccTreeService"
        },
        "updateToggleLableAndReloadAlignedDesignsOccTreeGrid": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "reloadAlignedDesignsOccTreeGrid",
                    "condition": "conditions.isLeftView"
                },
                {
                    "action": "updateToggleLabel"
                },
                {
                    "action": "reloadAlignedDesignsOccTreeGrid2",
                    "condition":"conditions.isRightView"
                }
            ]
        },
        "resetAlignedDesignsOccTreeData": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "resetAlignedDesignsOccData"
                },
                {
                    "action": "reloadAlignedDesignsOccTreeGrid",
                    "condition": "conditions.isLeftView"
                },
                {
                    "action": "updateToggleLabel"
                }
            ]
        },
        "resetAlignedDesignsOccData": {
            "actionType": "JSFunction",
            "method": "resetAlignedDesignsOccData",
            "inputData": {
                "currentRevisionRule": "{{props.subPanelContext.occContext.productContextInfo.props.awb0CurrentRevRule}}"
            },
            "outputData": {
                "isDataLoadDone": false,
                "configureStructureView.dbValue": true,
                "configureStructureView.propertyDisplayName": "{{i18n.toggleOn}}",
                "alignedDesignsOccTreeRevisionRuleLabel.uiValue": "result.revisionRuleLabelValue"
            },
            "deps": "js/alignedDesignsOccTreeService"
        },
        "reloadAlignedDesignsOccTreeGrid": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "alignedDesignsOccTreeGrid.plTable.reload"
                    }
                ]
            }
        },
        "reloadAlignedDesignsOccTreeGrid2": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [{
                    "name": "alignedDesignsOccTreeGrid2.plTable.reload"
                }]
            }
        }
    },
    "onEvent": [
        {
            "eventId": "columnArrange",
            "cacheEventData": true,
            "action": "doArrangeEvent"
        }
    ],
    "columnProviders": {
        "alignedDesignsOccTreeColumnProvider": {
            "columns": [
                {}
            ],
            "saveColumnAndLoadAction": "saveColumnConfigLoadData",
            "resetColumnAction": "resetColumnConfig",
            "sortCriteria": []
        },
        "alignedDesignsOccTreeColumnProvider2": {
            "columns": [ {} ],
            "saveColumnAndLoadAction": "saveColumnConfigLoadData2",
            "resetColumnAction": "resetColumnConfig2",
            "sortCriteria": []
        }
    },
    "dataProviders": {
        "alignedDesignsOccTreeDataProvider": {
            "initializeAction": "loadAlignedDesignsOccTree",
            "nextAction": "loadNextAlignedDesignsOccTree",
            "previousAction": "loadAlignedDesignsOccTree",
            "treeLoadResult": "action.result.treeLoadResult",
            "editContext": "TABLE_CONTEXT",
            "inputData": {
                "accessMode": "tree",
                "selectionData": "{{fields.selectionData}}"
            },
            "response": "data.response",
            "selectionModelMode": "multiple",
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands",
            "contextMenuCommandsAnchor": "aw_contextMenuWhereUsed"
        },
        "alignedDesignsOccTreeDataProvider2": {
            "initializeAction": "loadAlignedDesignsOccTree2",
            "nextAction": "loadNextAlignedDesignsOccTree",
            "previousAction": "loadAlignedDesignsOccTree2",
            "treeLoadResult": "action.result.treeLoadResult",
            "editContext": "TABLE_CONTEXT",
            "inputData": {
                "accessMode": "tree",
                "selectionData": "{{fields.selectionData}}"
            },
            "response": "data.response",
            "selectionModelMode": "multiple",
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands",
            "contextMenuCommandsAnchor": "aw_contextMenuWhereUsed"
        }
    },
    "grids": {
        "alignedDesignsOccTreeGrid": {
            "dataProvider": "alignedDesignsOccTreeDataProvider",
            "columnProvider": "alignedDesignsOccTreeColumnProvider",
            "enableArrangeMenu": true,
            "addIconColumn": false,
            "gridOptions": {
                "enableSorting": false,
                "useStaticFirstCol": false,
                "enableExpansionStateCaching": false,
                "enableExpandAndPaginationInEdit": true,
                "maxRowsToShow": 10
            },
            "deps": "js/alignedDesignsOccTreeService"
        },
        "alignedDesignsOccTreeGrid2": {
            "dataProvider": "alignedDesignsOccTreeDataProvider2",
            "columnProvider": "alignedDesignsOccTreeColumnProvider2",
            "enableArrangeMenu": true,
            "addIconColumn": false,
            "gridOptions": {
                "enableSorting": false,
                "useStaticFirstCol": false,
                "enableExpansionStateCaching": false,
                "enableExpandAndPaginationInEdit": true,
                "maxRowsToShow": 10
            },
            "deps": "js/alignedDesignsOccTreeService"
        }
    },
    "i18n": {
        "alignedDesignsOccTreeTitle": [
            "CadBomAlignmentConstants"
        ],
        "alignedDesignsOccTreeRevisionRuleLabel": [
            "CadBomAlignmentConstants"
        ],
        "toggleOn": [
            "OccurrenceManagementConstants"
        ]
    }
}
