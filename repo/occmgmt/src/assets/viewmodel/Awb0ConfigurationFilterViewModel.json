{
    "schemaVersion": "1.0.0",
    "actions": {
        "closePanel": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        },
        "unregisterRevisionRuleContextIfRevisionRuleAdminPanelNotlaunched" :{
            "actionType": "JSFunction",
            "method": "unregisterRevisionRuleContext",
            "deps": "js/aceAddElementService",
            "inputData": {
                "isRevisionRuleAdminMainPanel": "{{ctx.sidenavCommandId}}"
            }

        },
        "unRegisterRevisionRuleAdminCtx": {
            "actionType": "JSFunction",
            "method": "unRegisterCtx",
            "deps": "js/appCtxService",
            "inputData": {
                "path": "RevisionRuleAdmin"
            }
        }
    },
    "messages": {},
    "conditions": {
        "isConfigurationFilterNotSupported": {
            "expression": "subPanelContext.occContext.supportedFeatures.Awb0EnableConfigurationPanelFeature === undefined || subPanelContext.occContext.supportedFeatures.Awb0EnableConfigurationPanelFeature === false"
        }
    },
    "onEvent": [
        {
            "eventId": "ace.productChangedEvent",
            "condition": "conditions.isConfigurationFilterNotSupported",
            "action": "closePanel"
        }
    ],
    "i18n": {
        "occmgmtConfigurationFilterTitle": [
            "OccurrenceManagementConstants"
        ]
    },
    "lifecycleHooks": {
        "onUnmount": "unregisterRevisionRuleContextIfRevisionRuleAdminPanelNotlaunched"
    }
}
