        "onUpdate": [
            {
                "action": "updatePopupPosition",
                "observers": [
                    "viewModel.ctx.sidenavCommandId",
                    "viewModel.ctx.workspace"
                ]
            }
        ]
    },
    "i18n": {
        "editTransformTitle": [
