{
    "schemaVersion": "1.0.0",
    "actions": {
        "editTransform": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "composeMatrix"
                },
                {
                    "action": "getBackingObjects"
                },
                {
                    "action": "setPropertyOnBomlines"
                },
                {
                    "action": "closeTransformPopupAction"
                }
            ]
        },
        "composeMatrix": {
            "actionType": "JSFunctionAsync",
            "method": "composeMatrix",
            "inputData":
            {
                "input": "{{data}}"
            },
            "outputData":
            {
                "data": ""
            },
            "deps": "js/aceGenerateTransformPropertyMatrix"
        },
        "deComposeMatrix": {
            "actionType": "JSFunctionAsync",
            "method": "deComposeMatrix",
            "inputData":
            {
                "input": "{{data}}",
                "subPanelContext" : "{{subPanelContext}}"
            },
            "outputData":
            {
                "data": ""
            },
            "deps": "js/aceGenerateTransformPropertyMatrix"
        },
        "getBackingObjects": {
            "actionType": "JSFunctionAsync",
            "method": "getBackingObjects",
            "inputData": {
             "viewModelObjects": "{{ctx.mselected}}"
            },
            "outputData": {
                "inputBomLines": ""
            },
            "deps": "js/aceBackingObjectProviderService"
        },
        "closeTransformPopupAction": {
            "actionType": "JSFunction",
            "method": "unRegisterEventsAndClosePopup",
            "deps": "js/aceGenerateTransformPropertyMatrix"
        },
        "updatePopupPosition": {
            "actionType": "JSFunction",
            "method": "updatePopupPosition",
            "inputData": {},
            "deps": "js/aceGenerateTransformPropertyMatrix"
        },
        "setPropertyOnBomlines": {
            "actionType": "JSFunctionAsync",
            "method": "setPropertyOnBomlines",
            "inputData": {
                "inputBomLines":"{{function:spliceAndGetSelectedObject}}",
                "bomLinePropertyName": "{{subPanelContext.blTransform}}",
                "bomLinePropertyValues": [
                    "{{data.a00.dbValue + ' ' + data.a01.dbValue + ' ' + data.a02.dbValue + ' ' + data.a03.dbValue + ' ' + data.a10.dbValue + ' ' + data.a11.dbValue + ' ' + data.a12.dbValue + ' ' + data.a13.dbValue + ' ' + data.a20.dbValue + ' ' + data.a21.dbValue + ' ' + data.a22.dbValue + ' ' + data.a23.dbValue + ' ' + data.a30.dbValue + ' ' + data.a31.dbValue + ' ' + data.a32.dbValue + ' ' + data.a33.dbValue}}"
                ]
            },
            "events": {
                "success": [
                    {
                        "name": "occDataLoadedEvent"
                    }
                ]
            },
            "actionMessages": {
                "success": [
                    {
                        "message": "transformSaveSuccess"
                    }
                ]
            },
            "deps": "js/aceBomlinePropertyService"
        }
    },
    "messages": {
        "transformSaveSuccess": {
            "messageType": "INFO",
            "messageText": "{{i18n.transformSaveSuccess}}",
            "messageTextParams": [
                "{{subPanelContext.selectedObject.props.object_string.dbValues[0]}}"
            ]
        },
        "transformSaveFailure": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },
    "data": {
        "scaleX": {
            "type": "DOUBLE",
            "dbValue": 1
        },
        "scaleY": {
            "type": "DOUBLE",
            "dbValue": 1
        },
        "scaleZ": {
            "type": "DOUBLE",
            "dbValue": 1
        },
        "rotateX": {
            "displayName": "{{i18n.rotateX}}",
            "type": "DOUBLE",
            "isRequired": "true",
            "isEditable": "true",
            "dbValue": 0,
            "dispValue": 0
        },
        "rotateY": {
            "displayName": "{{i18n.rotateY}}",
            "type": "DOUBLE",
