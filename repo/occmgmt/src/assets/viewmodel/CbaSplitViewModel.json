            },
            "columnsToExclude": [ "Awb0ConditionalElement.awb0PendingAction", "Awb0PositionedElement.pma1UpdateAction", "Awb0DesignElement.pma1LastAlignedPart", "Awb0DesignElement.REF(pma1LastAlignedPart,ItemRevision).release_status_list",
                "Awb0PartElement.pma1LastAlignedDesign", "Awb0PartElement.REF(pma1LastAlignedDesign,ItemRevision).release_status_list", "Awb0ConditionalElement.awb0MarkupType" ],
            "displayLabel": {
                "text":"{{i18n.DBOM}}",
                "separator": "|"
            },
            "awSubLocationPref": {
                "hideFooter": true,
                "orientation": "HORIZONTAL"
            },
            "baseSelection":"{{subPanelContext.cbaContext.srcStructure}}"
        },
        "_cbaTrgSublocation": {
            "customEditContext": "rightXRTEditContext",
            "editContext": "trgOccDataProvider",
            "viewKey": "CBATrgContext",
            "tabSetId": "CBATrgContext",
            "name": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation",
            "label": {
                "source": "/i18n/CadBomAlignmentConstants",
                "key": "CadBomAlignment"
            },
            "clientScopeURI": "Awb0OccurrenceManagement",
            "nameToken": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation",
            "policy": "/policies/EntCBAPropertyPolicy.json",
            "viewBase": "CbaSplitTrg",
            "selectionQueryParamKey": "c_uid2",
            "contextKey": "CBATrgContext",
            "splitterLayout": "HORIZONTAL",
            "useAutoBookmark": false,
            "dataProviderName": "trgOccDataProvider",
            "gridId": "cbaTargetTree",
            "isRedlineModeEnabled": "{{subPanelContext.cbaContext.redLineMode.isChangeEnabled}}",
            "breadcrumbConfig": {
                "type": "navigate",
                "vm": "CbaTrgBreadcrum",
                "chevronDataProvider": "breadCrumbDataProvider2",
                "crumbDataProvider": "aceBreadCrumbDataProvider2",
                "noUpdate": true,
                "popuplist": "/html/AceBreadcrumbListView.html",
                "id": "CBATrgContext",
                "displayProperty": "object_string"
            },
            "editSupportParamKeys": [ "c_uid", "o_uid", "spageId", "pci_uid", "c_uid2", "o_uid2", "spageId2", "pci_uid2", "h_uid", "h_uid2" ],
            "sessionControlsDisable": true,
            "enableWorkareaToolbarLite": true,
            "enableTypeBasedLayouts": true,
            "viewModeId":"CADBOMAlignmentSubLocation_Right",
            "supportedLayouts": [ "Awp0SinglePaneLayout", "Awp0TopBottomLayout"],
            "pwaViewModes": [ "tree" ],
            "secondaryWorkarea": true,
            "defaultLayout": {
                "layout": {
                    "row": [
                        { "column": [{"pwaViewMode": "tree" }]}
                    ]
                },
                "layoutId": "Awp0SinglePaneLayout"
            },
            "context": {
                "commandContextParameters": [ "filter", "recipe", "uid", "uid2", "src_uid", "trg_uid" ],
                "search":{
                    "hideInContentSearchBox":true
                }
            },
            "urlParams": {
                "selectionQueryParamKey": "c_uid2",
                "openStructureQueryParamKey": "o_uid2",
                "rootQueryParamKey": "uid2",
                "productContextQueryParamKey": "pci_uid2",
                "csidQueryParamKey": "c_csid2",
                "secondaryPageIdQueryParamKey": "spageId2",
                "topElementQueryParamKey": "t_uid2",
                "pageIdQueryParamKey": "pageId2",
                "recipeParamKey": "recipe2",
                "subsetFilterParamKey": "filter2",
                "alternatePwaKey": "altPwa2",
                "configBaselineKey": "configbaseline_uid2"
            },
            "data": {
                "searchBox": {
                    "displayName": "",
                    "type": "STRING",
                    "isRequired": "true",
                    "dbValue": "",
                    "isEnabled": "true"
                }
            },
            "columnsToExclude": [ "Awb0ConditionalElement.awb0PendingAction", "Awb0PositionedElement.pma1UpdateAction", "Awb0DesignElement.pma1LastAlignedPart", "Awb0DesignElement.REF(pma1LastAlignedPart,ItemRevision).release_status_list",
                "Awb0PartElement.pma1LastAlignedDesign", "Awb0PartElement.REF(pma1LastAlignedDesign,ItemRevision).release_status_list", "Awb0ConditionalElement.awb0MarkupType" ],
            "displayLabel": {
                "text":"{{i18n.EBOM}}",
                "separator": "|"
            },
            "awSubLocationPref": {
                "hideFooter": true,
                "orientation": "HORIZONTAL"
            },
            "baseSelection":"{{subPanelContext.cbaContext.trgStructure}}"
        },
        "awSubLocationPref": {
            "hideFooter": true,
            "orientation": "HORIZONTAL"
        },
        "view": {
            "keys": [
                "CBASrcContext",
                "CBATrgContext"
            ]
        },
        "sublocationState": {
            "initialValues": {
                "viewModeContext":{
                    "viewTuples": []
                }
            },
            "meta": {
                "viewModeContext": {
                    "viewTuples": [ {
                        "field": "true"
                    } ]
                }
            }
        },
        "sublocationState2": {
            "initialValues": {
                "viewModeContext":{
                    "viewTuples": []
                }
            },
            "meta": {
                "viewModeContext": {
                    "viewTuples": [ {
                        "field": "true"
                    } ]
                }
            }
        },
        "occContext": {
            "initialValues": {
                "configContext": {},
                "displayToggleOptions":{},
                "supportedFeatures": {},
                "productContextInfo":{},
                "readOnlyFeatures":{},
                "currentState": {},
                "previousState": {},
                "transientRequestPref":{},
                "persistentRequestPref": { "defaultClientScopeUri": "Awb0OccurrenceManagement", "splitMode":"true" , "createWindow": "true"},
                "viewKey": "CBASrcContext",
                "disabledFeatures":[],
                "isRowSelected": false
            },
            "meta": {}
        },
        "occContext2": {
            "initialValues": {
                "configContext": {},
                "displayToggleOptions":{},
                "supportedFeatures": {},
                "productContextInfo":{},
                "readOnlyFeatures":{},
                "currentState": {},
                "previousState": {},
                "transientRequestPref":{},
                "persistentRequestPref": { "defaultClientScopeUri": "Awb0OccurrenceManagement", "splitMode":"true" },
                "viewKey": "CBATrgContext",
                "disabledFeatures":[],
                "isRowSelected": false
            },
            "meta": {}
        },
        "hiddenCommands": {
            "isSaveWorkingContextNotSupported": true,
            "Awb0UseSubstitute": true
        },
        "selectionData": {
            "initialValues": {},
            "meta": {}
        },
        "selectionData2": {
            "initialValues": {},
            "meta": {}
        }
    },
    "actions": {
        "customDialogAction": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                    "placement": "right",
                    "width": "SMALL",
                    "height": "FULL",
                    "push": true
                }
            }
        },
        "getNewPciData": {
            "actionType": "JSFunctionAsync",
            "method": "populateConfigContextByPci",
            "inputData":{
                "data": "{{data.subPanelContext.cbaContext.pciData}}"
            },
            "deps": "js/CadBomOccurrenceAlignmentService",
            "outputData": {
                "occContext.configContext" : "ccKeyPciKey"
            }
        },
        "activateLeftView":{
            "actionType": "batchJob",
            "steps": [ {
                    "action": "updatePageContext"
                },
                {
                    "action": "activateLeftViewEvent"
                }
            ]
        },
        "activateRightView":{
            "actionType": "batchJob",
            "steps": [ {
                    "action": "updatePageContext2"
                },
                {
                    "action": "activateRightViewEvent"
                }
            ]
        },
        "activateLeftViewEvent": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "ace.activateWindow",
                    "eventData": {
                        "key": "{{data._cbaSrcSublocation.contextKey}}"
                    }
                } ]
            }
        },
        "activateRightViewEvent": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "ace.activateWindow",
                    "eventData": {
                        "key": "{{data._cbaTrgSublocation.contextKey}}"
                    }
                } ]
            }
        },
        "updatePageContext": {
            "actionType": "JSFunction",
            "method": "updatePageContext",
            "deps": "js/occmgmtSplitViewService",
            "inputData": {
                "localSelectionData": "{{data.selectionData}}",
                "pageContext": "{{props.subPanelContext.pageContext}}",
                "keyOfActivatedView": "{{data._cbaSrcSublocation.contextKey}}"
            }
        },
        "updatePageContext2": {
            "actionType": "JSFunction",
            "method": "updatePageContext",
            "deps": "js/occmgmtSplitViewService",
            "inputData": {
                "localSelectionData": "{{data.selectionData2}}",
                "pageContext": "{{props.subPanelContext.pageContext}}",
                "keyOfActivatedView": "{{data._cbaTrgSublocation.contextKey}}"
            }
        },
        "update": {
            "actionType": "JSFunction",
            "method": "updateContextForTaskbarCmds",
            "deps": "js/cbaTaskbarCommandService",
            "inputData": {
                "srcContext": "{{occContext}}",
                "trgContext": "{{occContext2}}"
            }
        },
        "updateSrcContextInTaskBar": {
            "actionType": "Sync",
            "inputData": {
                "port": "occContextSrc",
                "syncObject":
                {
                    "CBASrcContext": "{{occContext}}"
                }
            }
        },
        "updateTrgContextInTaskBar": {
            "actionType": "Sync",
            "inputData": {
                "port": "occContextTrg",
                "syncObject":
                {
                    "CBATrgContext": "{{occContext2}}"
                }
            }
        },
        "updateCbaContext": {
            "actionType": "JSFunction",
            "method": "updateCadbomalignmentOnCtx",
            "deps": "js/cbaTaskbarCommandService",
            "inputData": {
                "key":"ImpactAnalysis",
                "valueToUpdate": {
                    "sourceTopItem":"{{subPanelContext.cbaContext.ImpactAnalysis.sourceTopItem}}",
                    "ECNForImpactAnalysis":"{{subPanelContext.cbaContext.ImpactAnalysis.ECNForImpactAnalysis}}",
                    "isImpactAnalysisMode":"{{subPanelContext.cbaContext.isImpactAnalysisMode}}",
                    "alignedTargetProviderInECN":"{{subPanelContext.cbaContext.ImpactAnalysis.alignedTargetProviderInECN}}"
                }
            }
        },
        "updateCbaRedlineContext": {
            "actionType": "JSFunction",
            "method": "updateCadbomalignmentOnCtx",
            "deps": "js/cbaTaskbarCommandService",
            "inputData": {
                "key":"redLineMode",
                "valueToUpdate": {
                    "isChangeEnabled": "{{subPanelContext.cbaContext.redLineMode.isChangeEnabled}}"
                }
            }
        },
        "openSingleStructureDialog": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                }
            }
        },
        "openSingleDialog": {
            "actionType": "JSFunction",
            "method": "openSingleDialog",
            "deps": "js/CbaBomPanelService",
            "inputData": {
              "action":"{{actions.openSingleStructureDialog}}",
              "eventData":"{{data.eventData}}",
              "subPanelContext":"{{fields.subPanelContext}}",
              "occContext": "{{fields.occContext}}",
              "occContext2": "{{fields.occContext2}}"
            }
        },
        "updateHiddenCommandContextForCba":
        {
            "actionType": "JSFunction",
            "method": "updatePartialCtx",
            "inputData": {
                "path": "hiddenCommands",
                "value": "{{data.hiddenCommands}}"
            },
            "deps": "js/appCtxService"
        },
        "handleLoadAndSelect":
        {
            "actionType": "JSFunction",
            "method": "handleLoadAndSelect",
            "inputData": {
                "srcContext": "{{occContext}}",
                "trgContext": "{{occContext2}}"
            },
         "deps": "js/CadBomOccAlignmentCheckService"
        },
        "exitAlignmentModeAction": {
            "actionType": "JSFunction",
            "method": "exitAlignmentMode",
            "inputData": {
                "occContext": "{{fields.occContext}}",
                "occContext2": "{{fields.occContext2}}"
            },
            "deps": "js/cbaPageViewService"
        },
        "updateTargetOccContextPostAutomatedUpdate": {
            "actionType": "JSFunction",
            "method": "updateOccContextPostAutomatedUpdate",
            "deps": "js/cbaAutomatedUpdateService",
            "inputData": {
                "occContext": "{{fields.occContext2}}",
                "topNode" : "{{subPanelContext.cbaContext.trgStructure}}"
            }
        },
        "updateSourceOccContextPostAutomatedUpdate": {
            "actionType": "JSFunction",
            "method": "updateOccContextPostAutomatedUpdate",
            "deps": "js/cbaAutomatedUpdateService",
            "inputData": {
                "occContext": "{{fields.occContext}}",
                "topNode" : "{{subPanelContext.cbaContext.srcStructure}}"
            }
        },
        "handleAcePartialSelection":{
            "actionType": "JSFunction",
            "method": "handleAcePartialSelection",
            "inputData": {
                "eventData": "{{parameters.eventData}}",
                "srcContext": "{{fields.occContext}}",
                "trgContext": "{{fields.occContext2}}"
            },
            "deps": "js/cbaTaskbarCommandService"
        },
        "updateViewLoadCounter": {
            "actionType": "JSFunction",
            "method": "updateViewLoadCounter",
            "deps": "js/aceUrlManagementService",
            "inputData": {
                "onPwaLoadCompleteForLeftView": "{{fields.occContext.onPwaLoadComplete}}",
                "onPwaLoadCompleteForRightView": "{{fields.occContext2.onPwaLoadComplete}}"
            }
        },
        "handleSelectionChangeJob":{
            "actionType": "batchJob",
            "steps": [ 
                {
                    "action": "handleSelectionChange"
                },
                {
                    "action": "activateLeftView"
                }
            ]
        },
        "handleSelectionChange": {
            "actionType": "JSFunction",
            "method": "handleSelectionChange",
            "inputData": {
                "localSelectionData": "{{data.selectionData}}",
                "pageContext": "{{props.subPanelContext.pageContext}}",
                "selectionInfos": "{{data.selectionInfos}}"
            },
            "outputData": {
                "selectionInfos": ""
            },
            "deps": "js/occmgmtSplitViewService"
        },
        "handleSelectionChange2Job":{
            "actionType": "batchJob",
            "steps": [ 
                {
                    "action": "handleSelectionChange2"
                },
                {
                    "action": "activateRightView"
                }
            ]
        },
        "handleSelectionChange2": {
            "actionType": "JSFunction",
            "method": "handleSelectionChange",
            "inputData": {
                "localSelectionData": "{{data.selectionData2}}",
                "pageContext": "{{props.subPanelContext.pageContext}}",
                "selectionInfos": "{{data.selectionInfos}}"
            },
            "outputData": {
                "selectionInfos": ""
            },
            "deps": "js/occmgmtSplitViewService"
        }
    },
    "ctx":{
        "cbaContext":null,
        "modelObjectsToOpen":null,
        "splitView":{
            "mode":"null"
        },
        "aceActiveContext": {
            "key": "CBASrcContext"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "model-object": {
            "type": "object"
        }
    },
    "onEvent": [
        {
            "eventId": "cba.executeCommandOpenPanel",
            "action": "openSingleDialog",
            "cacheEventData": true
        },
        {
            "eventId": "exitAlignmentModeEvent",
            "action": "exitAlignmentModeAction"
        },
        {
            "eventId":"appCtx.update",
            "action":"handleAcePartialSelection",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition":"name ==='CBASrcContext.acePartialSelection' || name ==='CBATrgContext.acePartialSelection'"
        }
    ],
    "i18n": {
        "DBOM": [ "CadBomAlignmentConstants" ],
        "EBOM": [ "CadBomAlignmentConstants" ]
    },
    "lifecycleHooks": {
        "onMount": "updateHiddenCommandContextForCba",
        "onUpdate": [
            {
                "action": "update",
                "observers": [ "viewModel.atomicData.occContext", "viewModel.atomicData.occContext2" ]
            },
            {
                "action": "updateSrcContextInTaskBar",
                "observers": [ "viewModel.atomicData.occContext" ]
            },
            {
                "action": "updateTrgContextInTaskBar",
                "observers": [ "viewModel.atomicData.occContext2" ]
            },
            {
                "action": "updateCbaContext",
                "observers": [ "viewModel.subPanelContext.cbaContext" ]
            },
            {
                "action": "getNewPciData",
                "observers": [ "props.subPanelContext.cbaContext.pciData" ]
            },
            {
                "action": "updateCbaRedlineContext",
                "observers": [ "props.subPanelContext.cbaContext.redLineMode" ]
            },
            {
                "action": "handleLoadAndSelect",
                "observers": [ "viewModel.atomicData.occContext.lastDpAction", "viewModel.atomicData.occContext2.lastDpAction" ]
            },
            {
                "action": "updateTargetOccContextPostAutomatedUpdate",
                "observers": [ "props.subPanelContext.cbaContext.trgStructure" ]
            },
            {
                "action": "updateSourceOccContextPostAutomatedUpdate",
                "observers": [ "props.subPanelContext.cbaContext.srcStructure" ]
            },
            {
                "action": "updateViewLoadCounter",
                "observers": [ "viewModel.atomicData.occContext.onPwaLoadComplete" , "viewModel.atomicData.occContext2.onPwaLoadComplete" ]
            },
            {
                "action": "handleSelectionChangeJob",
                "observers": [ "viewModel.atomicData.selectionData" ]
            },
            {
                "action": "handleSelectionChange2Job",
                "observers": [ "viewModel.atomicData.selectionData2" ]
            }
        ]
    }
}
