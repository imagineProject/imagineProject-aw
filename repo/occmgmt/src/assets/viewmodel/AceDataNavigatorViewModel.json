{
    "schemaVersion": "1.0.0",
    "actions": {
        "customDialogAction":{
            "actionType": "dialog",
            "inputData": {
                "options": {}
            }
        },
        "reactToConfigurationChange": {
            "actionType": "JSFunction",
            "method": "updateConfiguration",
            "inputData": {
                "occContext": "{{props.subPanelContext.occContext}}"
            },
            "deps": "js/aceStructureConfigurationService"
        },
        "initializeDataNavigator": {
            "actionType": "JSFunction",
            "method": "initializeDataNavigator",
            "inputData": {
                "subPanelContext": "{{subPanelContext}}",
                "contextKey": "{{props.contextKey}}",
                "aceSearchPolicyOverride":"{{data.aceSearchPolicyOverride}}",
                "useAceDefaultInitializationService":"{{props.useAceDefaultInitializationService}}"
            },
            "outputData": {
                "contextKey": "contextKey",
                "alternateSelection": "alternateSelection"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "destroyDataNavigator": {
            "actionType": "JSFunction",
            "method": "destroyDataNavigator",
            "inputData": {
                "subPanelContext": "{{subPanelContext}}",
                "useAceDefaultInitializationService":"{{props.useAceDefaultInitializationService}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "syncCtxContextWithPWASelection": {
            "actionType": "JSFunction",
            "method": "syncContextWithPWASelection",
            "inputData": {
                "eventData": "{{data.eventData}}",
                "subPanelContext": "{{subPanelContext}}",
                "contextKey": "{{data.contextKey}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "syncContextWithPWASelection": {
            "actionType": "JSFunction",
            "method": "syncContextWithPWASelection",
            "inputData": {
                "eventData": null,
                "subPanelContext": "{{subPanelContext}}",
                "contextKey": "{{data.contextKey}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "resetTreeDataProvider": {
            "actionType": "JSFunction",
            "method": "resetTreeDataProvider",
            "inputData": {
                "value": "{{parameters.eventData.inputOccContext}}",
                "target": "{{props.subPanelContext.occContext}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "resetPwaContents": {
            "actionType": "JSFunction",
            "method": "resetPwaContents",
            "inputData": {
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "editContext": "{{props.subPanelContext.provider.editContext}}"
            },
            "outputData": {
                "alternateSelection": "alternateSelection"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "updatePwaContextInformation": {
            "actionType": "JSFunction",
            "method": "updatePwaContextInformation",
            "inputData": {
                "data": "{{data}}",
                "subPanelContext": "{{subPanelContext}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}"
            },
            "outputData": {
                "alternateSelection": ""
            },
            "deps": "js/aceDataNavigatorService"
        },
        "addUpdatedSelectionToPWA": {
            "actionType": "JSFunction",
            "method": "addUpdatedSelectionToPWA",
            "inputData": {
                "data": "{{data}}",
                "eventData": "{{data.eventData}}",
                "contextKey": "{{data.contextKey}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "removeSelectionFromPWA": {
            "actionType": "JSFunction",
            "method": "removeSelectionFromPWA",
            "inputData": {
                "eventData": "{{data.eventData}}",
                "contextKey": "{{data.contextKey}}",
                "subPanelContext": "{{props.subPanelContext}}",
                "occContext": "{{props.subPanelContext.occContext}}",
                "alternateSelection": "{{data.alternateSelection}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "addSelectionToPWA": {
            "actionType": "JSFunction",
            "method": "addSelectionToPWA",
            "inputData": {
                "eventData": "{{data.eventData}}",
                "contextKey": "{{data.contextKey}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "occContext": "{{props.subPanelContext.occContext}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "modifyPWASelections":{
            "actionType": "JSFunction",
            "method": "modifyPwaSelections",
            "inputData": {
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "occContext": "{{props.subPanelContext.occContext}}",
                "selectionsToModify": "{{props.subPanelContext.occContext.selectionsToModify}}",
                "subPanelContext":"{{props.subPanelContext}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "selectionChangeForPrimary":{
            "actionType": "JSFunction",
            "method": "onSelectionChangeForPrimary",
            "inputData": {
                "data": "{{data}}",
                "subPanelContext": "{{props.subPanelContext}}",
                "contextKey": "{{data.contextKey}}",
                "selectionData": "{{data.selectionData}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "parentSelectionData": "{{props.subPanelContext.selectionData}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "selectionChangeOnSelectionDataUpdate": {
            "actionType": "JSFunction",
            "method": "onSelectionChange",
            "inputData": {
                "data": "{{data}}",
                "subPanelContext": "{{props.subPanelContext}}",
                "contextKey": "{{data.contextKey}}",
                "selectionData": "{{data.selectionData}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "parentSelectionData": "{{props.subPanelContext.selectionData}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "updateActiveWindow": {
            "actionType": "JSFunction",
            "method": "updateActiveWindow",
            "inputData": {
                "eventData": "{{data.eventData}}",
                "data": "{{data}}",
                "subPanelContext": "{{props.subPanelContext}}",
                "selectionData": "{{data.selectionData}}",
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "resetDataNavigator": {
            "actionType": "JSFunction",
            "method": "resetDataNavigator",
            "inputData": {
                "eventData": "{{parameters.eventData}}",
                "contextKey": "{{data.contextKey}}",
                "selectionModel": "{{data.selectionModels.occmgmtSelectionModel}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "applyFSCVariantRuleToProduct": {
            "actionType": "JSFunction",
            "method": "updateValueOnCtxOrState",
            "inputData": {
                "path": "configContext",
                "value": {
                    "r_uid": "{{props.subPanelContext.occContext.productContextInfo.props.awb0CurrentRevRule.dbValues[0]}}",
                    "var_uids": "{{data.eventData.variantRules}}",
                    "iro_uid": "{{props.subPanelContext.occContext.productContextInfo.props.awb0VariantRuleOwningRev.dbValues[0]}}",
                    "de": "{{props.subPanelContext.occContext.productContextInfo.props.awb0EffDate.dbValues[0]}}",
                    "ue": "{{props.subPanelContext.occContext.productContextInfo.props.awb0EffUnitNo.dbValues[0]}}",
                    "ei_uid": "{{props.subPanelContext.occContext.productContextInfo.props.awb0EffEndItem.dbValues[0]}}",
                    "eg_uids": "{{props.subPanelContext.occContext.productContextInfo.props.awb0EffectivityGroups.dbValues}}",
                    "startFreshNavigation": true,
                    "isAppliedFromVCV": true
                },
                "target": "{{props.subPanelContext.occContext}}"
            },
            "deps": "js/occmgmtUtils"
        },
        "multiSelectActionForPWA": {
            "actionType": "JSFunction",
            "method": "multiSelectActionForPWA",
            "inputData": {
                "pwaSelectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "eventData": "{{data.eventData}}"
            },
            "outputData": {
                "showCheckBox": ""
            },
            "deps": "js/aceDataNavigatorService"
        },
        "removeObjectsFromCollection": {
            "actionType": "JSFunction",
            "method": "removeObjectsFromCollection",
            "inputData": {
                "eventData": "{{data.eventData}}",
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "expandNodeForExpandBelow": {
            "actionType": "JSFunction",
            "method": "expandNodeForExpandBelow",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "loadAndSelectProvidedObjectInTree": {
            "actionType": "JSFunctionAsync",
            "method": "loadAndSelectProvidedObjectInTree",
            "inputData": {
                "occContext":"{{props.subPanelContext.occContext}}",
                "selection": "{{parameters.eventData.objectsToSelect}}",
                "productContextInfo":"{{parameters.eventData.productContextInfo}}",
                "nodeToExpandAfterFocus":"{{parameters.eventData.nodeToExpandAfterFocus}}",
                "parentToExpand":"{{parameters.eventData.parentToExpand}}",
                "updateVmosNContextOnPwaReset":"{{parameters.eventData.updateVmosNContextOnPwaReset}}",
                "getOccSoaInput": "{{parameters.eventData.getOccSoaInput}}",
                "retainExpansionState": "{{parameters.eventData.retainExpansionState}}",
                "isRemoveUnderDifferentParents": "{{parameters.eventData.isRemoveUnderDifferentParents}}",
                "parents": "{{parameters.eventData.parents}}"
            },
            "deps": "js/aceStructureEditService"
        },
        "handleHostingSelectionChange": {
            "actionType": "JSFunction",
            "method": "handleHostingOccSelectionChange",
            "inputData": {
                "data": "{{data}}",
                "eventdata": "{{parameters.eventData}}",
                "selectionModel": "{{data.selectionModels.occmgmtSelectionModel}}",
                "contextKey": "{{data.contextKey}}",
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/aceDataNavigatorService"
        },
        "redoUserChanges": {
            "actionType": "JSFunction",
            "method": "redoUserChanges",
            "inputData": {
                "occContext":"{{props.subPanelContext.occContext}}"
            },
            "deps": "js/discoverySubscriptionService"
        },
        "cancelUserChanges": {
            "actionType": "JSFunction",
            "method": "cancelUserChanges",
            "inputData": {
                "occContext":"{{props.subPanelContext.occContext}}"
            },
            "deps": "js/discoverySubscriptionService"
        },
        "deleteExpandedNodeCacheAction": {
            "actionType": "JSFunction",
            "method": "deleteExpandedNodeCache",
            "inputData": {
                "vmc": "{{props.subPanelContext.occContext.vmc}}",
                "eventData": "{{parameters.eventData}}"
            },
            "deps": "js/aceStructureEditService"
        },
        "performPackAction": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-ActiveWorkspaceBom-2019-06-OccurrenceManagement",
            "method": "packSimilarElements",
            "inputData": {
                "input": {
                    "packMode": 0,
                    "elements": "{{parameters.eventData.objectsToSelect}}",
                    "inputCtxt": {
                        "productContext": "{{props.subPanelContext.occContext.productContextInfo}}",
                        "requestPref": {
                            "displayMode": [
                                "{{function:getTreeOrListDisplayMode}}"
                            ]
                        }
                    },
                    "sortCriteria": {
                        "propertyName": "{{ctx.aceActiveContext.context.sortCriteria[0].fieldName}}",
                        "sortingOrder": "{{ctx.aceActiveContext.context.sortCriteria[0].sortDirection}}"
                    }
                }
            },
            "outputData": {
                "parentChildrenInfos": "result.parentChildrenInfos",
                "deletedElements": "result.ServiceData.deleted",
                "elementsToBeSelected": "result.elementsToBeSelected"
            },
            "events": {
                "success": [ {
                        "name": "postProcessPackUnpackAction",
                        "eventData": {
                            "packMode": 0,
                            "parentChildrenInfos": "{{data.parentChildrenInfos}}",
                            "deletedElements": "{{data.deletedElements}}",
                            "occContext": "{{props.subPanelContext.occContext}}",
                            "viewToReset": "{{ctx.aceActiveContext.key}}",
                            "elementsToBeSelected": "{{data.elementsToBeSelected}}"
                       }
                    }
                ]
            },
            "deps": "js/acePackSimilarElementsService"
        },
        "postProcessPackUnpackAction": {
            "actionType": "JSFunction",
            "method": "packSimilarElementsCompletedAction",
            "inputData": {
                "eventData": "{{parameters.eventData}}"
            },
            "events": {
            },
            "deps": "js/acePackSimilarElementsService"
        },
        "performUnPackAction": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-ActiveWorkspaceBom-2019-06-OccurrenceManagement",
            "method": "packSimilarElements",
            "inputData": {
                "input": {
                    "packMode": 1,
                    "elements": "{{parameters.eventData.objectsToHighlight}}",
                    "inputCtxt": {
                        "productContext": "{{props.subPanelContext.occContext.productContextInfo}}",
                        "requestPref": {
                            "displayMode": [
                                "{{function:getTreeOrListDisplayMode}}"
                            ],
                            "selectedElementUids": "{{function:getSelectedUidsForUnpack}}"
                        }
                    },
                    "sortCriteria": {
                        "propertyName": "{{ctx.aceActiveContext.context.sortCriteria[0].fieldName}}",
                        "sortingOrder": "{{ctx.aceActiveContext.context.sortCriteria[0].sortDirection}}"
                    }
                }
            },
            "outputData": {
                "parentChildrenInfos": "result.parentChildrenInfos",
                "deletedElements": "result.ServiceData.deleted"
            },
            "events": {
                "success": [ {
                    "name": "postProcessPackUnpackAction",
                    "eventData": {
                        "packMode": 1,
                        "parentChildrenInfos": "{{data.parentChildrenInfos}}",
                        "deletedElements": "{{data.deletedElements}}",
                        "occContext": "{{props.subPanelContext.occContext}}",
                        "viewToReset": "{{ctx.aceActiveContext.key}}"
                   }
                }
            ]
        },
        "deps": "js/acePackSimilarElementsService"
        },
        "performPackAllAction": {
            "actionType": "JSFunction",
            "method": "updateValueOnCtxOrState",
            "inputData": {
                "path": null,
                "value": {
                    "configContext": {
                        "packSimilarElements": true
                    },
                    "transientRequestPref": {
                        "addUpdatedFocusOccurrence": true,
                        "jitterFreePropLoad": true,
                        "startFreshNavigation": true,
                        "userGesture": "PACKALL"
                    }
                },
                "target": "{{props.subPanelContext.occContext}}"
            },
            "events": {
                "success": [ {
                    "name": "perform.packAllSimilarElements",
                    "eventData": {
                        "packAllMode": 1,
                        "viewToReact": "{{ctx.aceActiveContext.key}}"
                    }
                } ]
            },
            "deps": "js/occmgmtUtils"
        },
        "performUnpackAllAction": {
            "actionType": "JSFunction",
            "method": "updateValueOnCtxOrState",
            "inputData": {
                "path": null,
                "value": {
                    "configContext": {
                        "packSimilarElements": false
                    },
                    "transientRequestPref": {
                        "addUpdatedFocusOccurrence": true,
                        "jitterFreePropLoad": true,
                        "startFreshNavigation": true,
                        "userGesture": "UNPACKALL"
                    }
                },
                "target": "{{props.subPanelContext.occContext}}"
            },
            "events": {
                "success": [ {
                    "name": "perform.packAllSimilarElements",
                    "eventData": {
                        "packAllMode": 0,
                        "viewToReact": "{{ctx.aceActiveContext.key}}"
                    }
                } ]
            },
            "deps": "js/occmgmtUtils"
        },
        "performOpenSnapshotAction": {
            "actionType": "JSFunction",
            "method": "openProductSnapshotInsideACE",
            "inputData": {
                "snapshotObj": "{{parameters.eventData.snapshotObj}}",
                "occContext" : "{{props.subPanelContext.occContext}}"
            },
            "events": {
                "success": [ {
                    "condition": "ctx.sublocation.clientScopeURI==='Awb0OccurrenceManagement'",
                    "name" : "occmgmtsubset.applySnapshot"
                }
            ]
            },
            "deps": "js/discoverySnapshotService"
        },
        "updateState": {
            "actionType": "JSFunction",
            "method": "updateState",
            "inputData": {
                "subPanelContext": "{{subPanelContext}}"
            },
            "deps": "js/aceUrlManagementService"
        },
        "updateGlobalRevisionRule": {
            "actionType": "JSFunction",
            "method": "updateGlobalRevisionRule",
            "inputData": {
                "occContext":"{{props.subPanelContext.occContext}}"
            },
            "outputData":{},
            "deps": "js/aceRevisionRuleConfigurationService"
        }
    },
    "lifecycleHooks": {
        "onMount": "initializeDataNavigator",
        "onUnmount": "destroyDataNavigator",
        "onUpdate": [ {
                "action": "reactToConfigurationChange",
                "observers": [ "props.subPanelContext.occContext.configContext" ]
            },
            {
                "action": "resetPwaContents",
                "observers": [ "props.subPanelContext.occContext.pwaReset" ]
            },
            {
                "action": "updatePwaContextInformation",
                "observers": [ "props.subPanelContext.occContext.onPwaLoadComplete" ]
            },
            {
                "action": "syncContextWithPWASelection",
                "observers": [ "props.subPanelContext.occContext.currentState" ]
            },
            {
                "action": "modifyPWASelections",
                "observers": [ "props.subPanelContext.occContext.selectionsToModify" ]
            },
            {
                "action": "expandNodeForExpandBelow",
                "observers": [ "props.subPanelContext.occContext.transientRequestPref.nodesToExpandPresentForExpandBelow" ]
            },
            {
                "action": "selectionChangeForPrimary",
                "observers": [ "viewModel.selectionModels.occmgmtSelectionModel.selected" ]
            },
            {
                "action": "selectionChangeOnSelectionDataUpdate",
                "observers": [ "viewModel.atomicData.selectionData" ]
            }
        ]
    },
    "functions": {
        "getSelectedUidsForUnpack": {
            "functionName": "getSelectedUidsForUnpack",
            "parameters": [
                "{{data.eventData.objectsToSelect}}"
            ]
        },
        "getTreeOrListDisplayMode": {
            "functionName": "getTreeOrListDisplayMode",
            "parameters": []
        }
    },
    "onEvent": [ {
            "eventId": "syncContextWithPWASelection",
            "action": "syncCtxContextWithPWASelection",
            "cacheEventData": true
        },
        {
            "eventId": "aceElementsSelectionUpdatedEvent",
            "action": "addUpdatedSelectionToPWA",
            "cacheEventData": true

        },
        {
            "eventId": "aceElementsDeSelectedEvent",
            "action": "removeSelectionFromPWA",
            "cacheEventData": true
        },
        {
            "eventId": "aceElementsSelectedEvent",
            "action": "addSelectionToPWA",
            "cacheEventData": true
        },
        {
            "eventId": "ace.activateWindow",
            "action": "updateActiveWindow",
            "cacheEventData": true
        },
        {
            "eventId": "awDataNavigator.reset",
            "action": "resetDataNavigator",
            "condition": "viewToReset ===  data.contextKey",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "aw.revisionRuleChangeEvent",
            "condition": "ctx.aceActiveContext.key ===  data.contextKey",
            "action": "updateGlobalRevisionRule"
        },
        {
            "eventId": "Pca0FullScreenConfiguration.configureContent",
            "cacheEventData": true,
            "action": "applyFSCVariantRuleToProduct",
            "condition": "ctx.aceActiveContext.key ===  data.contextKey"
        },
        {
            "eventId": "ace.elementsMoved",
            "action": "removeObjectsFromCollection",
            "cacheEventData": true
        },
        {
            "eventId": "cdm.deleted",
            "action": "removeObjectsFromCollection",
            "cacheEventData": true
        },
        {
            "eventId": "aceLoadAndSelectProvidedObjectInTree",
            "action": "loadAndSelectProvidedObjectInTree",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition": "ctx.aceActiveContext.key ===  data.contextKey"
        },
        {
            "eventId": "hosting.changeSelection",
            "action": "handleHostingSelectionChange",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition": "viewkey ===  data.contextKey"
        },
        {
            "eventId": "ace.redoUserChanges",
            "action": "redoUserChanges"
        },
        {
            "eventId": "ace.cancelUserChanges",
            "action": "cancelUserChanges"
        },
        {
            "eventId": "cdm.updated",
            "action": "deleteExpandedNodeCacheAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "resetTreeDataProvider",
            "action": "resetTreeDataProvider",
            "condition": "ctx.aceActiveContext.key === data.contextKey",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "packEvent",
            "action": "performPackAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition": "viewToReact === subPanelContext.contextKey"
        },
        {
            "eventId": "unPackEvent",
            "action": "performUnPackAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition": "viewToReact === subPanelContext.contextKey"
        },
        {
            "eventId": "postProcessPackUnpackAction",
            "action": "postProcessPackUnpackAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "packAllEvent",
            "action": "performPackAllAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition": "viewToReact === subPanelContext.contextKey"
        },
        {
            "eventId": "unPackAllEvent",
            "action": "performUnpackAllAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "condition": "viewToReact === subPanelContext.contextKey"
        },
        {
            "eventId": "ace.openSnapshotfromInsideACE",
            "action": "performOpenSnapshotAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "splitViewLocationUpdated",
            "action": "updateState"
        }
    ],
    "i18n": {},
    "selectionModels": {
        "occmgmtSelectionModel": {
            "selectionMode": "multiple",
            "selectionTracker": ["uid"]
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "provider": {
            "type": "object"
        },
        "base-selection": {
            "type": "object"
        },
        "context-key": {
            "type": "string"
        },
        "use-ace-default-initialization-service" : {
            "type" : "boolean"
        },
        "sublocation-state":{
            "type": "object"
        }
    },
    "data": {
        "aceSearchPolicyOverride": {
            "types": [ {
                "name": "Awb0Element",
                "properties": [ {
                        "name": "awp0ThumbnailImageTicket"
                    }, {
                        "name": "object_string"
                    }, {
                        "name": "awp0CellProperties"
                    },
                    {
                        "name": "awb0BreadcrumbAncestor",
                        "modifiers": [ {
                            "name": "withProperties",
                            "Value": "true"
                        } ]
                    },
                    {
                        "name": "awb0UnderlyingObject"
                    },
                    {
                        "name": "awb0TraceLinkFlag"
                    }
                ]
            }, {
                "name": "Fgd0DesignElement",
                "properties": [ {
                    "name": "awb0UnderlyingObject",
                    "modifiers": [ {
                        "name": "withProperties",
                        "Value": "true"
                    } ]
                } ]
            }, {
                "name": "Cpd0DesignElement",
                "properties": [ {
                    "name": "cpd0category"
                } ]
            }, {
                "name": "Wbs0ElementCondElement",
                "properties": [ {
                        "name": "wbs0IsWorkElement"
                    },
                    {
                        "name": "wbs0RevObjectType"
                    }
                ]
            } ]
        },
        "selectionData": {
            "initialValues": {},
            "meta": {}
        }
    }
}
