{
    "schemaVersion": "1.0.0",
    "actions": {
        "initializeAceFullScreenHeader": {
            "actionType": "JSFunction",
            "method": "parseFullScreenHeaderTitle",
            "inputData": {
                "title":"{{props.subPanelContext.headerTitle}}",
                "path":"{{props.subPanelContext.headerPath}}"

            },
            "outputData":            {
                "headerTitle":"headerTitleText",
                "headerPath":"headerPathText"
            },
            "deps": "js/aceConfigHeaderService"
        }
    },
    "lifecycleHooks": {
        "onUpdate": [ {
            "action": "initializeAceFullScreenHeader",
            "observers": [ "props.subPanelContext.headerTitle", "props.subPanelContext.headerPath"]
        }]
    }
}
