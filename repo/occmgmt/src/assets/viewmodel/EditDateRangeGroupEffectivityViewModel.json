{
    "schemaVersion" : "1.0.0",

    "data" :
    {
        "nameBox":{
            "displayName": "{{i18n.name}}",
            "type": "STRING",
            "dbValue": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.nameBox}}",
            "uiValue": "",
            "isRequired": "true",
            "maxLength":128
        },
        "startDateTime":
        {
            "dbValue": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.startDateTime}}",
            "type": "DATETIME",
            "isRequired": "true",
            "displayName": "{{i18n.startDate}}",
            "isEditable": "true"
        },

        "endDateTime":
        {
            "dbValue": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.endDateTime}}",
            "type": "DATE",
            "isRequired": "true",
            "validationCriteria": [ {
                    "condition": "!conditions.isValidStartAndEndDate",
                    "value": "{{i18n.dateRangeInvalidMessage}}"
                } ]
        },
        "effectivity" : "{{props.subPanelContext.nestedNavigationState.editDateRangeState.effectivity}}",
        "groupRevision" : {
            "uid": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.groupRevision}}"},
        "endDateOptions":
        {
            "type": "STRING",
            "isRequired": "true",
            "hasLov":true,
            "displayName": "{{i18n.endDate}}",
            "isEditable": "true",
            "dbValue": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.endDateOptions.dbValue}}",
            "uiValue": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.endDateOptions.uiValue}}"
        },
        "endDateList":{
            "type": "STRING",
            "dbValue":
            [
                {"propDisplayValue" :"{{i18n.dateEffectivity}}", "propInternalValue" : "Date"},
                {"propDisplayValue" :"{{i18n.upText}}", "propInternalValue" : "UP"},
                {"propDisplayValue" :"{{i18n.soText}}", "propInternalValue" : "SO"}
            ]
        },
        "endItemLabel": {
            "displayName": "{{i18n.endItemMessage}}",
            "type": "STRING"
        },
        "endItemValForDateRange": {
            "type": "STRING",
            "dbValue": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.endItemValForDateRange.dbValue}}",
            "uiValue": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.endItemValForDateRange.uiValue}}",
            "isRequired": "true",
            "displayName": "{{i18n.endItemMessage}}"
        },
        "navigateAddCommand": {
            "action": "navigateToAddEndItemPanelBatchJob",
            "iconName": "Add",
            "tooltip": "{{i18n.addEndItem}}"
        },
        "navigateReplaceCommand": {
            "action": "navigateToReplaceEndItemPanelBatchJob",
            "iconName": "Replace",
            "tooltip": "{{i18n.replaceEndItem}}"
        },
        "removeCommand": {
            "action": "removeEndItem",
            "iconName": "Remove",
            "tooltip": "{{i18n.removeEndItem}}"
        },
        "activeState": {
            "initialValues": {
                "activeView": "AuthorDateGroupEffectivity",
                "context": {}
            },
            "meta": { }
        }
    },
    "lifecycleHooks": {
    },
    "actions": {
        "EditEffectivity": {
            "actionType": "TcSoaService",
            "serviceName": "Core-2010-09-DataManagement",
            "method": "setProperties",
            "inputData":
            {
                "info":
                [
                    {
                        "object": {
                            "uid": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.groupRevision}}",
                            "type": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.groupRevisionType}}"
                        },
                        "vecNameVal":
                        [
                            {
                                "name": "object_name",
                                "values":
                                [
                                    "{{data.nameBox.dbValue}}"
                                ]
                            }
                        ]
                    }
                ]
            },
            "outputData": {
                "setPropertiesResponse" : ""
            },
            "events":
            {
                "success":
                [
                    {
                        "name": "editGrp.groupEdited"
                    }
                ]
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "setPropertiesFailureMessage"
                    }
            ]},
            "deps": "js/effectivityGroupTableService"
        },
        "updateEffectivities": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-StructureManagement-2021-12-EffectivitiesManagement",
            "method": "createOrUpdateDateEffectivities",
            "inputData":
            {
                "effectivitiesInfo": [{
                    "clientId" : "editEffectivities",
                    "effectivityComponent": "{{function:getEffComponent}}",
                    "endItemComponent": {
                        "type": "Item",
                        "uid": "{{data.endItemValForDateRange.dbValue}}"
                    },
                    "dateRange": "{{function:getDateRange}}",
                    "openEndedStatus": "{{function:getOpenEndedStatus}}",
                    "decision": 1
                }],
                "effectivityGroupRevision": {
                    "uid": "{{props.subPanelContext.nestedNavigationState.editDateRangeState.groupRevision}}",
                    "type": "ItemRevision"
                }
           },
           "outputData": {
            "editEgoResp" : ""
           },
           "events":
           {
               "success":
               [
                   {
                       "name": "updateDateRangeEffectivities_done",
                        "eventData": {
                            "viewToReact": "{{props.subPanelContext.provider.contextKey}}"
                        }
                   }
               ]
           },
           "actionMessages": {
            "failure": [
                {
                    "message": "editFailureMessage"
                }
            ]},
           "deps": "js/effectivityGroupTableService"
        },
        "applyGroupEffectivity":
        {
            "actionType": "JSFunction",
            "method": "applyConfiguration",
            "inputData":{
                "value": {
                    "configContext": {
                        "r_uid": "{{props.subPanelContext.occContext.productContextInfo.props.awb0CurrentRevRule.dbValues[0]}}",
                        "eg_uids": "{{function:appendAndApplyEditedGroupEffectivity}}",
                        "ue": "{{props.subPanelContext.occContext.productContextInfo.props.awb0EffUnitNo.dbValues[0]}}",
                        "ei_uid": "{{props.subPanelContext.occContext.productContextInfo.props.awb0EffEndItem.dbValues[0]}}",
                        "var_uids": "{{props.subPanelContext.occContext.productContextInfo.props.awb0VariantRules.dbValues}}",
                        "iro_uid": "{{props.subPanelContext.occContext.productContextInfo.props.awb0VariantRuleOwningRev.dbValues[0]}}",
                        "startFreshNavigation": true
                    },
                    "transientRequestPref": {
                        "jitterFreePropLoad" : true,
                        "userGesture": "EFFECTIVITY_CHANGE"
                    }
                },
                "occContext": "{{props.subPanelContext.occContext}}"
            },
            "events": {
                "success": [{
                    "name": "closePanel",
                    "condition": "conditions.shouldClosePanel"
                },{
                    "name": "navigateToConfigPanel",
                    "condition": "conditions.shouldNavigateToConfigPanel"
                }]
            },
            "deps": "js/effectivityGroupTableService"
        },
        "navigateToConfigPanel":{
            "actionType": "JSFunction",
            "method": "goToPrevPanel",
            "inputData": {
                "nestedNavigationState": "{{props.subPanelContext.nestedNavigationState}}",
                "numOfBacks": 2
            },
            "deps": "js/aceNestedNavigationPanelService"
        },
        "navigateToAddEndItemPanelBatchJob": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "updateFieldsOnState"
                },
                {
                    "action": "navigateToAddEndItemPanelAction"
                }
            ]
        },
        "navigateToReplaceEndItemPanelBatchJob": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "updateFieldsOnState"
                },
                {
                    "action": "navigateToReplaceEndItemPanelAction"
                }
            ]
        },
        "updateFieldsOnState":{
            "actionType": "JSFunction",
            "method": "updateSubPanelContextOfView",
            "inputData": {
                "nestedNavigationState": "{{props.subPanelContext.nestedNavigationState}}",
                "key": "editDateRangeState",
                "value":
                {
                    "endItemValForDateRange":{
                        "dbValue":"{{data.endItemValForDateRange.dbValue}}",
                        "uiValue":"{{data.endItemValForDateRange.uiValue}}"
                    },
                    "nameBox":"{{data.nameBox.dbValue}}",
                    "startDateTime":"{{data.startDateTime.dbValue}}",
                    "endDateTime":"{{data.endDateTime.dbValue}}",
                    "endDateOptions":{
                        "dbValue":"{{data.endDateOptions.dbValue}}",
                        "uiValue":"{{data.endDateOptions.uiValue}}"
                    },
                    "groupRevision":"{{props.subPanelContext.nestedNavigationState.editDateRangeState.groupRevision}}",
                    "groupRevisionType":"{{props.subPanelContext.nestedNavigationState.editDateRangeState.groupRevisionType}}",
                    "effectivity" : "{{props.subPanelContext.nestedNavigationState.editDateRangeState.effectivity}}"
                }
            },
            "deps": "js/aceNestedNavigationPanelService"
        },
        "navigateToAddEndItemPanelAction": {
            "actionType": "JSFunction",
            "method": "navigateToView",
            "inputData": {
                "nestedNavigationState": "{{props.subPanelContext.nestedNavigationState}}",
                "view": {
                    "panelId":"AddReferenceSub",
                    "title": "{{data.navigateAddCommand.tooltip}}",
                    "additionalSubPanelContext": {
                        "activeState": "{{fields.activeState}}",
                        "selectionMode": "single",
                        "filterTypes": "ItemRevision"
                    }
                }
            },
            "deps": "js/aceNestedNavigationPanelService"
        },
        "navigateToReplaceEndItemPanelAction": {
            "actionType": "JSFunction",
            "method": "navigateToView",
            "inputData": {
                "nestedNavigationState": "{{props.subPanelContext.nestedNavigationState}}",
                "view": {
                    "panelId":"AddReferenceSub",
                    "title": "{{data.navigateReplaceCommand.tooltip}}",
                    "additionalSubPanelContext": {
                        "activeState": "{{fields.activeState}}",
                        "selectionMode": "single",
                        "filterTypes": "ItemRevision"
                    }
                }
            },
            "deps": "js/aceNestedNavigationPanelService"
        },

        "updateEndItemAndNavigateToAuthorEGOPanel":
        {
            "actionType": "JSFunction",
            "method": "updateEndItemForDateRange",
            "inputData":
            {
                "eventData": "{{parameters.eventData}}",
                "endItemValForDateRange": "{{data.endItemValForDateRange}}"
            },
            "outputData":
            {
                "endItemValForDateRange.dbValue":"endItemValuedbValue",
                "endItemValForDateRange.uiValue":"endItemValueuiValue"
            },
            "deps": "js/effectivityGroupTableService"
        },
        "removeEndItem":
        {
            "actionType": "JSFunction",
            "method": "removeEndItemValue",
            "inputData": {

            },
            "outputData":
            {
                "endItemValForDateRange.dbValue":"endItemValueDbValue",
                "endItemValForDateRange.uiValue":"endItemValueUiValue"
            },
            "deps": "js/effectivityGroupTableService"
        },
        "closePanel": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "onEvent": [
        {
            "eventId": "editGrp.groupEdited",
            "action": "updateEffectivities"
        },
        {
            "eventId": "updateDateRangeEffectivities_done",
            "action": "applyGroupEffectivity"
        },
        {
            "eventId": "navigateToConfigPanel",
            "action": "navigateToConfigPanel"
        },
        {
            "eventId": "updateStateOrCtxBeforeBack",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "updateEndItemAndNavigateToAuthorEGOPanel"
        },
        {
            "eventId": "closePanel",
            "action": "closePanel"
        }
    ],
    "functions": {
        "appendAndApplyEditedGroupEffectivity": {
            "functionName": "applyDateEffectivityGroups",
            "parameters":
            [
                "{{data}}",
                "{{data.groupRevision}}"
            ]
        },
        "getDateRange": {
            "functionName": "getDateRange",
            "parameters":
            [
                "{{data}}"
            ]
        },
        "getOpenEndedStatus": {
            "functionName": "getOpenEndedStatus",
            "parameters": [
                "{{data}}"
            ]
        },
        "getEffComponent": {
            "functionName": "getEffComponent",
            "parameters": [
                "{{data}}"
            ]
        }
    },
    "conditions":
    {
        "isValidStartAndEndDate": {
            "expression": "data.endDateTime.dateApi.dateValue === '' || data.startDateTime.dateApi.dateValue === ''  || data.endDateTime.dbValue > data.startDateTime.dbValue"
        },
        "isEndDateVisible" : {
            "expression": "data.endDateOptions.dbValue !== 'UP' && data.endDateOptions.dbValue !== 'SO'"
        },
        "shouldClosePanel": {
            "expression": "props.subPanelContext.shouldClosePanelOnApply"
        },
        "shouldNavigateToConfigPanel": {
            "expression": "!props.subPanelContext.shouldClosePanelOnApply"
        },
        "isDateRangeValid": {
            "expression": "(data.nameBox.dbValue !== '' && data.nameBox.dbValue !== undefined) && (data.startDateTime.dbValue !== '' && data.startDateTime.dbValue !== undefined ) && (data.endDateOptions.dbValue === 'UP' || data.endDateOptions.dbValue === 'SO' || data.endDateTime.dbValue > data.startDateTime.dbValue)"
        }
    },
    "i18n":
    {
        "upText":["OccurrenceManagementConstants"],
        "soText":["OccurrenceManagementConstants"],
        "dateEffectivity":["OccurrenceManagementConstants"],
        "name":["OccurrenceManagementConstants"],
        "startDate":["OccurrenceManagementConstants"],
        "endDate":["OccurrenceManagementConstants"],
        "dateRangeInvalidMessage":["OccurrenceManagementMessages"],
        "apply":[ "OccurrenceManagementConstants" ],
        "genericServerError":["OccurrenceManagementMessages"],
        "addEndItem":[ "OccurrenceManagementConstants" ],
        "endItemMessage": ["OccurrenceManagementConstants"],
        "replaceEndItem": ["OccurrenceEffectivityConstants"],
        "removeEndItem": ["OccurrenceEffectivityConstants"]
    },
    "messages": {
        "editFailureMessage": {
            "messageType": "ERROR",
            "messageText": "{{i18n.genericServerError}}",
            "messageTextParams": [
                "{{data.editEgoResp.partialErrors[0].errorValues[0].message}}"
            ]
        },
        "setPropertiesFailureMessage": {
            "messageType": "ERROR",
            "messageText": "{{i18n.genericServerError}}",
            "messageTextParams": [
                "{{data.setPropertiesResponse.ServiceData.partialErrors[0].errorValues[0].message}}"
            ]
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
