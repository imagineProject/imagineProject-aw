    "conditions": {
        "isChangeContentImport": {
            "expression": "conditions.isImportBOMContext && ctx.ImportBOMContext.isChangeContentImport"
        },
        "isChangeBomSubLocation": {
            "expression": "ctx.sublocation.nameToken === 'com.siemens.splm.client.occmgmt:OccurrenceManagementSubLocation' && ctx.sublocation.clientScopeURI === 'ChangeBom'"
        },
        "isExcelImportAllowed": {
            "expression": "data.isAwb0ImportButtonIsVisible && conditions.isValidFile "
        },
        "isValidFile": {
            "expression": "data.fileName && data.validFile === true"
        },
        "notCompErrorReport": {
            "expression": "data.fmsTicket && data.fmsTicket !== 'COMPREHENSIVE_ERROR_REPORT'"
        },
        "isExcelUploaded": {
            "expression": "subPanelContext.uploadFileSelectionData.selectedFileInfo !== undefined"
        },
        "isScopeSet": {
            "expression": "data.structureScope.dbValue === true || data.relationsScope.dbValue === true || data.partsScope.dbValue === true"
        },
        "enablePreviewButton": {
            "expression": "conditions.isExcelImportAllowed && ( conditions.isExcelUploaded || conditions.notCompErrorReport )"
        },
        "enableImportButton": {
            "expression": "conditions.isExcelImportAllowed && !ctx.awb0ImportFromExcelProgressing && ( conditions.isExcelUploaded || conditions.notCompErrorReport )"
        },
        "enableAwp0PreviewButton": {
            "expression": "conditions.isExcelImportAllowed && ( conditions.isExcelUploaded || conditions.notCompErrorReport ) && conditions.isScopeSet"
        },
        "enableAwp0ImportButton": {
            "expression": "conditions.isExcelImportAllowed && !ctx.awb0ImportFromExcelProgressing && ( conditions.isExcelUploaded || conditions.notCompErrorReport ) && conditions.isScopeSet"
        },
        "isImportPreviewSublocation": {
            "expression": "ctx.sublocation.clientScopeURI === 'Awb0ImportPreview'"
        },
        "isNewEntry": {
            "expression": "data.mappingGroup.dbValue === ''"
        },
        "isImportBOMContext": {
            "expression": "ctx.ImportBOMContext !== undefined"
        },
        "mappedGroupDataNotUpdated": {
            "expression": "data.mappedGroupData.actionName !== 'UPDATE'"
        },
        "nonPreviewCall": {
            "expression": "subPanelContext.uploadFileSelectionData.selectedFileInfo"
        },
        "isFileImportFromXCShare": {
            "expression" : "subPanelContext.uploadFileSelectionData.selectedFile.projectId"
        },
        "isLocalFileImport": {
            "expression" : "!subPanelContext.uploadFileSelectionData.selectedFile"
        },
        "enableStructureScope": {
            "expression" : "data.mappingGroupResponse.mappingOutputs[0].mappingGroups[0].realName === 'XLS_Structure'"
        },
        "enableRelationsScope": {
            "expression" : "data.mappingGroupResponse.mappingOutputs[0].mappingGroups[0].realName === 'XLS_Relations'"
        },
        "enablePartsScope": {
            "expression" : "data.mappingGroupResponse.mappingOutputs[0].mappingGroups[0].realName === 'XLS_Structure' || data.mappingGroupResponse.mappingOutputs[0].mappingGroups[0].realName === 'XLS_Relations'"
        }
    },
    "messages": {
        "notificationForImportBOMMsg": {
            "messageType": "INFO",
            "messageText": "{{i18n.notificationForImportBOM}}",
            "messageTextParams": [
                "{{data.fileName}}"
            ]
        },
        "successImportBOM": {
            "messageType": "INFO",
            "messageText": "{{i18n.successImportBOM}}"
        },
        "importFailureMessage": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },

