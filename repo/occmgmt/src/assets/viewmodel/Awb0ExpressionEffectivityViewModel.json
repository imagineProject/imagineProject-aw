{
    "schemaVersion": "1.0.0",
    "data": {
        "expEffPanelState": {
            "initialValues": {
                "activeView": "ps0DisplayEffectivities",
                "previousView": "",
                "dateOrUnitEffectivityTypeRadioButton":{
                    "type": "BOOLEAN",
                    "dbValue": true
                },
                "endItemVal":{
                    "dbValue": null,
                    "uiValue": null
                },
                "unitRangeText": {
                    "dbValue": null
                },
                "startDate": {
                    "type": "DATE",
                    "dbValue": null
                },
                "endDate": {
                    "type": "DATETIME",
                    "dbValue": null
                },
                "endDateOptions": {
                    "dbValue": "Date"
                },
                "effectivities":{
                },
                "editEffectivity":{
                }
            },
            "meta": { }
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "actions": {
        "updateUnitEffectivityContext": {
            "actionType": "JSFunction",
            "method": "updatePartialCtx",
            "inputData": {
                "path": "expressionEffectivity.isOnlyUnitEffectivityApplicable",
                "value": true
            },
            "deps": "js/appCtxService"
        },
        "backToPrevious":
        {
            "actionType": "JSFunction",
            "method": "backActionData",
            "inputData":
            {
                "destinationPanelId":"{{data.expEffPanelState.previousView}}",
                "data": "{{data}}"
            },
            "outputData": {
                "expEffPanelState":""
            },
            "deps": "js/expressionEffectivityService"
        },
        "clearUnitEffectivityContextAndResetState": {
            "actionType": "JSFunction",
            "method": "clearUnitEffectivityContextAndResetState",
            "inputData":
            {
                "destinationPanelId":"ps0DisplayEffectivities",
                "data": "{{data}}"
            },
            "deps": "js/expressionEffectivityService"
        },
        "closePanel": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "complete",
                     "condition": "conditions.isPwaSelectionChanged",
                    "eventData": {
                        "source": "toolAndInfoPanel"
                    }
                } ]
            }
        }
    },
    "onEvent": [
        {
            "eventId": "awPanel.reveal",
            "condition": "subPanelContext.occContext.supportedFeatures.Awb0RevisibleOccurrenceFeature === true",
            "action": "updateUnitEffectivityContext"
        }
    ],
    "lifecycleHooks": {
        "onUnmount": "clearUnitEffectivityContextAndResetState",
        "onUpdate": [{
            "action": "closePanel",
            "observers": [ "props.subPanelContext.occContext.pwaSelection" ]
        }]
    },
    "i18n": {
        "elementEffectivityTitle": [
            "OccurrenceManagementConstants"
        ],
        "ps0AddEffectivitiesCmd": [
            "PSConstants"
        ],
        "edit": [
            "OccurrenceManagementConstants"
        ],
        "endItemMessage": [
            "OccurrenceManagementConstants"
        ]
    },
    "conditions": {
        "isPwaSelectionChanged": {
            "expression": "props.subPanelContext.occContext.pwaSelection[0].props.awb0Parent.dbValues[0] === null"
        }
    }
}
