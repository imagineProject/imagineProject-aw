{
    "schemaVersion" : "1.0.0",
    "i18n":
    {
       "addElementBtn": ["OccurrenceManagementConstants"]
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "onEvent": [
        {
            "eventId": "awPattern.newPatternSelected",
            "inputArgs": {
                "prop": "{{eventData.prop}}",
                "pattern": "{{eventData.newPattern}}"
            },
            "action": "autoAssignProperty"
        }
    ],
    "actions": {
        "autoAssignProperty": {
            "actionType": "JSFunction",
            "method": "autoAssignProperty",
            "inputData": {
                "prop": "{{parameters.prop}}",
                "operationType": "CREATE",
                "pattern": "{{parameters.newPattern}}",
                "selectedObj": "{{}}",
                "hasRevRule": "{{data.hasRevRuleAttached}}"
            },

            "deps": "js/autoAssignService"
        }
    }
}
