{
    "schemaVersion": "1.0.0",
    "data": {},
    "ctx": {
        "selected": {
            "type": "object"
        },
        "preferences": {
            "type": "object"
        }
    },
    "actions": {
        "reveal": {
            "actionType": "dataProvider",
            "method": "performSearch"
        },
        "search": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient"
                    },
                    "searchInput": {
                        "maxToLoad": 50,
                        "maxToReturn": 50,
                        "providerName": "Awb0SubstitutesProvider",
                        "searchCriteria": {
                            "selectedElement": "{{props.subPanelContext.occContext.pwaSelection[0].uid}}",
                            "substituteGroup": "{{data.ctx.selected.fnd0SubstituteGroupObj.uid}}",
                            "usecase": "AddElementsToSubstituteGroup"
                        },
                        "searchFilterFieldSortType": "Priority"
                    }
                },
                "1": {
                    "types": [
                        {
                            "name": "BOMLine",
                            "properties": [
                                {
                                    "name": "fnd0bl_substitute_groups"
                                }
                            ]
                        }
                    ]
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}"
            }
        },
        "addElementsToGroup": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "setPropertiesOnBomline"
                },
                {
                    "action": "saveBomWindow"
                }
            ]
        },
        "setPropertiesOnBomline": {
            "actionType": "TcSoaService",
            "serviceName": "Core-2010-09-DataManagement",
            "method": "setProperties",
            "inputData": {
                "info": "{{function:getPropertiesInput}}"
            },
            "policy": {
                "types": [
                    {
                        "name": "BOMLine",
                        "properties": [
                            {
                                "name": "bl_window"
                            }
                        ]
                    },
                    {
                        "name": "Awb0ConditionalElement",
                        "properties": [
                            {
                                "name": "awb0HasSubstitues"
                            }
                        ]
                    }
                ]
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "setPropertiesOnBomlineFailure"
                    }
                ]
            },
            "deps": "js/aceSubstituteGroupService"
        },
        "saveBomWindow": {
            "actionType": "TcSoaService",
            "serviceName": "Cad-2008-06-StructureManagement",
            "method": "saveBOMWindows",
            "inputData": {
                "bomWindows": [
                    {
                        "uid": "{{data.dataProviders.performSearch.selectedObjects[0].props.bl_window.dbValues[0]}}",
                        "type": ""
                    }
                ]
            },
            "events": {
                "success": [
                    {
                        "name": "reloadsubstituteGroupTable"
                    },
                    {
                        "name": "closePanelAfterAddingElementsToGroup"
                    }
                ]
            }
        },
        "closePanel": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "CREATE_PANEL_CONTEXT",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "lifecycleHooks": {},
    "dataProviders": {
        "performSearch": {
            "action": "search",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}"
        }
    },
    "onEvent": [
        {
            "eventId": "primaryWorkArea.selectionChangeEvent",
            "action": "closePanel"
        },
        {
            "eventId": "substituteGroupDataProvider.selectionChangeEvent",
            "action": "closePanel"
        },
        {
            "eventId": "closePanelAfterAddingElementsToGroup",
            "action": "closePanel"
        }
    ],
    "functions": {
        "getPropertiesInput": {
            "functionName": "getPropertiesInput",
            "parameters": [
                "{{ctx.selected.fnd0SubstituteGroupObj.uid}}",
                "{{data.dataProviders.performSearch.selectedObjects}}"
            ]
        }
    },
    "messages": {
        "setPropertiesOnBomlineFailure": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },
    "i18n": {
        "addElementBtn": [
            "OccurrenceManagementConstants"
        ],
        "addElements": [
            "OccurrenceManagementConstants"
        ],
        "toTitle": [
            "OccurrenceManagementConstants"
        ],
        "Elements": [
            "OccurrenceManagementConstants"
        ]
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
