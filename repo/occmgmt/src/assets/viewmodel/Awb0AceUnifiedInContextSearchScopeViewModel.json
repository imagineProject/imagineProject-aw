{
    "schemaVersion": "1.0.0",
    "data": {
        "resultScope":{
            "displayName": "{{i18n.resultScopeLabel}}",
            "type": "STRING",
            "labelPosition": "PROPERTY_LABEL_AT_LEFT"
        }
    },
    "actions": {
        "getScopeForCurrentSearch":{
            "actionType": "JSFunction",
            "method": "getScopeForCurrentSearch",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "outputData": {
                "resultScope.uiValue": ""
            },
            "deps": "js/navigateSearchService"
        }
    },
    "i18n": {
        "resultScopeLabel": [ "OccmgmtFindConstants" ]
    },
    "lifecycleHooks": {
        "onUpdate": [{
            "action": "getScopeForCurrentSearch",
            "observers": [ "props.subPanelContext.searchState.criteria", "props.subPanelContext.searchState.advancedSearchCriteria" ]
        }
    ]
    },
    "props": {
        "sub-panel-context":{
            "type":"object"
        }
    },
    "conditions": {
        "showScope": {
            "expression": "props.subPanelContext.searchState.totalLoaded !== undefined"
        }
    }
}
