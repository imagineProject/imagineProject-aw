{
    "schemaVersion": "1.0.0",
    "actions": {
        "getSubstituteIndicatorValue": {
            "actionType": "JSFunction",
            "method": "getSubstituteIndicatorValue",
            "inputData": {
                "vmoHovered": "{{props.subPanelContextForTooltipWithProperty.vmoHovered}}"
            },
            "outputData": {
                "substituteIndicatorValue": ""
            },
            "deps": "js/aceOccurrenceSubstituteGroupService"
        }
    },
    "data": {
        "tooltipForSubstituteComponent" : {
            "view": "AceTooltipForSubstituteComponents"
        },
        "tooltipForPrimaryComponent": {
            "view": "AceTooltipForPrimaryComponents"
        }

    },
    "lifecycleHooks": {
        "onMount": "getSubstituteIndicatorValue"
    },
    "conditions": {
        "isSubstituteElement": {
            "expression": "data.isOneToOneSubstituteGroup === '1'"
        }
    }
}
