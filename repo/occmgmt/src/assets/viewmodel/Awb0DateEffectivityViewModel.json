{
    "schemaVersion": "1.0.0",
    "actions": {
        "initializeDateEffectivityInfo": {
            "actionType": "JSFunction",
            "method": "getInitialDateEffectivityConfigurationData",
            "inputData": {
                "data": "{{data}}",
                "occContext":"{{props.subPanelContext.occContext}}"
            },
            "outputData": {
                "currentEffectiveDate": "currentEffectiveDate",
                "isTimeEnabled": "isTimeEnabled",
                "dateTimeFormat": "dateTimeFormat",
                "isEffectiveDateFeatureSupported":"isEffectiveDateFeatureSupported",
                "isEffectiveDateFeatureReadOnly.dbValue":"isEffectiveDateFeatureReadOnly",
                "viewKey":"props.subPanelContext.contextKey"
            },
            "deps": "js/dateEffectivityConfigurationService"
        },
        "updateCurrentDateEffectivity": {
            "actionType": "JSFunction",
            "method": "updateCurrentDateEffectivity",
            "inputData": {
                "data":"{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "outputData": {
                "currentEffectiveDate": "currentEffectiveDate"
            },
            "deps": "js/dateEffectivityConfigurationService"
        },
        "reconfigureProductAfterActiveEcnChangedOutsideACEBatchAction": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "getShowEcnHeaderWarningVal",
                    "outputArg": [
                        "showEcnHeaderWarning"
                      ],
                    "condition": "conditions.isRevisibleOccurrenceFeatureSupported && conditions.isChangeContextChangedOutsideACE"
                },
                {
                    "action": "reconfigureProductAfterActiveEcnChanged",
                    "inputArg": {
                        "showEcnHeaderWarning": "{{actionData.showEcnHeaderWarning}}"
                    },
                    "condition": "conditions.isRevisibleOccurrenceFeatureSupported && conditions.isChangeContextChangedOutsideACE"
                },
                {
                    "action": "unregisterIsChangeContextChangedFromCtx",
                    "condition": "conditions.isChangeContextChangedOutsideACE"
                }
            ]
        },
        "reconfigureProductAfterActiveEcnChangedBatchAction": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "getShowEcnHeaderWarningVal",
                    "outputArg": [
                        "showEcnHeaderWarning"
                      ],
                    "condition": "conditions.isRevisibleOccurrenceFeatureSupported"
                },
                {
                    "action": "reconfigureProductAfterActiveEcnChanged",
                    "inputArg": {
                        "showEcnHeaderWarning": "{{actionData.showEcnHeaderWarning}}"
                    },
                    "condition": "conditions.isRevisibleOccurrenceFeatureSupported"
                }
            ]
        },
        "getShowEcnHeaderWarningVal":{
            "actionType": "JSFunction",
            "method": "getShowEcnHeaderWarningVal",
            "inputData": {
                "eventData":"{{data.eventData}}"
            },
            "outputData": {
                "showEcnHeaderWarning": ""
            },
            "deps": "js/effectivityGroupTableService"
        },
        "reconfigureProductAfterActiveEcnChanged":{
            "actionType": "JSFunction",
            "method": "updateValueOnCtxOrState",
            "inputData": {
                "path": null,
                "value": {
                    "showECNHeaderWarning":"{{parameters.showEcnHeaderWarning}}",
                    "transientRequestPref": {
                        "useActiveECNEff": true
                    },
                    "configContext": {
                        "r_uid": "{{props.subPanelContext.occContext.productContextInfo.props.awb0CurrentRevRule.dbValues[0]}}",
                        "startFreshNavigation": true
                    }
                },
                "target": "{{props.subPanelContext.occContext}}"
            },
            "deps": "js/occmgmtUtils"
        },
        "unregisterIsChangeContextChangedFromCtx":{
            "actionType": "JSFunction",
            "method": "unRegisterCtx",
            "inputData": {
                "path": "isChangeContextChanged"
            },
            "deps": "js/appCtxService"
        }
    },
    "conditions": {
        "isUpdateApplicable": {
            "expression": "subPanelContext.contextKey === viewKey"
        },
        "isRevisibleOccurrenceFeatureSupported":{
            "expression": "props.subPanelContext.occContext.supportedFeatures.Awb0RevisibleOccurrenceFeature || ctx.CBATrgContext.supportedFeatures.Awb0RevisibleOccurrenceFeature"
        },
        "isChangeContextChangedOutsideACE":{
            "expression": "ctx.isChangeContextChanged && ctx.isChangeContextChanged === true"
        }
    },
    "lifecycleHooks": {
        "onMount":"reconfigureProductAfterActiveEcnChangedOutsideACEBatchAction",
        "onUpdate":[
        {
            "action": "initializeDateEffectivityInfo",
            "observers": [ "props.subPanelContext.occContext.productContextInfo.props.awb0EffDate", "props.subPanelContext.occContext.productContextInfo.props.awb0EffectivityGroups"]
        }]
    },
    "onEvent": [
        {
            "eventId": "awConfigPanel.effectivityDateChanged",
            "cacheEventData": true,
            "condition": "conditions.isUpdateApplicable",
            "action": "updateCurrentDateEffectivity"
        },
        {
            "eventId":"aw.updateOccContextValueAfterActiveEcnChanged",
            "cacheEventData": true,
            "action":"reconfigureProductAfterActiveEcnChangedBatchAction"
        }
    ],
    "data": {
        "currentEffectiveDate": {
            "uiValue": "{{data.currentEffectiveDate}}",
            "type": "DATE"
        },
        "occurrenceManagementTodayTitle": {
            "dbValue": "{{i18n.occurrenceManagementTodayTitle}}",
            "uiValue": "{{i18n.occurrenceManagementTodayTitle}}",
            "displayName": "{{i18n.occurrenceManagementTodayTitle}}",
            "type": "STRING"
        },
        "isEffectiveDateFeatureReadOnly": {
            "dbValue": false,
            "type": "BOOLEAN"
        },
        "multipleGroups": {
            "uiValue": "{{i18n.multipleGroups}}",
            "type": "STRING"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "location":{
            "type": "string"
        }
    },
    "i18n": {
        "occurrenceManagementTodayTitle": [ "OccurrenceManagementConstants" ],
        "multipleGroups": ["OccurrenceManagementConstants"]
    }
}
