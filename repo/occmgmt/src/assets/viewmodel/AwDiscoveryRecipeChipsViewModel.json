{
    "schemaVersion": "1.0.0",
    "actions": {
        "render": {
            "method": "awDiscoveryRecipeChipsRenderFunction",
            "deps": "js/AwDiscoveryRecipeChipsService",
            "options": {
                "elementRefList": [
                    "chiplist"
                ]
            }
        },
        "buildRecipeGroupChips":{
            "actionType": "JSFunction",
            "method": "buildRecipeGroupChips",
            "inputData": {
                "recipeGroup": "{{props.recipeObject.recipeGroup}}"
            },
            "outputData": {
                "displayRecipeGroupChips": ""
            },
            "deps": "js/AwDiscoveryRecipeChipsUtils"
        },
        "removeFilterAction": {
            "actionType": "JSFunction",
            "method": "removeSelectedChip",
            "inputData": {
                "recipeObject": "{{props.recipeObject}}",
                "chipToRemove": "{{parameters.chip}}",
                "sharedData": "{{props.sharedData}}"
            },
            "deps": "js/AwDiscoveryRecipeChipsUtils"
        }
    },
    "data": {
        "displayRecipeGroupChips": []

    },
    "conditions": {
        "shouldShowFilterChips": {
            "expression": "data.recipeChips && data.recipeChips.length > 0"
        },
        "shouldEnableChips":{
            "expression": "props.enableChips"
        },
        "shouldDisableChips":{
            "expression": "props.enableChips && !ctx.advanced_filter_candidates"
        }
    },
    "onEvent": [
    ],
    "i18n": {
        "OrGroup": ["OccurrenceManagementSubsetConstants"],
        "NotGroup": ["OccurrenceManagementSubsetConstants"]
    },
    "lifecycleHooks": {
        "render": "render",
        "onUpdate": [
            {
                "action": "buildRecipeGroupChips",
                "observers": [ "props.recipeObject.recipeGroup" ]
            }
        ]
    },
    "props": {
        "recipe-object":{
            "type": "object"
        },
        "enable-chips" :{
            "type": "object"
        },
        "shared-data":{
            "type": "object"
        }
    }
}
