{
    "schemaVersion": "1.0.0",
    "data": {},
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "conditions": {
        "isToggleWorkAreaHeaderPrefDefined": {
            "expression":"props.subPanelContext.provider.awSubLocationPref.showToggleWorkAreaHeader"
        },
        "isExpandedWorkAreaHeader": {
            "expression":"conditions.isToggleWorkAreaHeaderPrefDefined && props.subPanelContext.expandedWorkAreaHeaderState.expandedWorkAreaHeader === 'true' "
        },
        "isCollapsedWorkAreaHeader": {
            "expression":"conditions.isToggleWorkAreaHeaderPrefDefined && props.subPanelContext.expandedWorkAreaHeaderState.expandedWorkAreaHeader === 'false' "
        },
        "isToggleWorkAreaHeaderMerged": {
            "expression":"ctx.preferences.AW_SubLocation_OccurrenceManagementSubLocation_showToggleWorkAreaHeader && ctx.preferences.AW_SubLocation_OccurrenceManagementSubLocation_showToggleWorkAreaHeader[0] === 'false' "
        },
        "isToggleWorkAreaHeaderNotVisible": {
            "expression":"!conditions.isToggleWorkAreaHeaderPrefDefined || conditions.isToggleWorkAreaHeaderMerged"
        }
    }
}
