                      "$typeOf": "Awb0PositionedElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PositionedElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Awb0PositionedElement"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Fgf0PartitionElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Awb0Element"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "ItemRevision"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "PartRevision"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Ase0LogicalElement"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Fnd0LogicalBlockRevision"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Ase0FunctionalElement"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Arm0RequirementSpecElement"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
                  {
                    "$source": "pasteContext.targetObject",
                    "$query": {
                      "$typeOf": "Awb0PartElement"
                    }
                  },
                  {
                    "$source": "pasteContext.sourceObject",
                    "$query": {
                      "$typeOf": "Arm0RequirementElement"
                    }
                  },
                  {
                    "$source": "ctx.sublocation.nameToken",
                    "$query": {
                      "$eq": "com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation"
                    }
                  }
                ]
              },
              {
                "$and": [
