  "messages": {
    "aceDefaultPasteAttachmentOverrideFailure": {
      "messageType": "ERROR",
      "messageText": "{{errorCode}}"
    },
    "addElementsToBookmarkFailureMessage": {
      "messageType": "ERROR",
      "messageText": "{{errorCode}}"
    }
  }
