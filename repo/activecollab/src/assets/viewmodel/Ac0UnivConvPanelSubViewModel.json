{
    "schemaVersion" : "1.0.0",

    "actions":
    {
        "onMountsetSelectedTab": {
            "actionType": "JSFunction",
            "method": "onMountsetSelectedTab",
            "inputData":
            {
                "data": "{{data}}",
                "selection":"{{ctx.Ac0ConvCtx.selectedTab}}"
            },
            "deps": "js/Ac0ConversationUtils"
        },

        "setSelectedTab": {
            "actionType": "JSFunction",
            "method": "setSelectedTab",
            "inputData":
            {
                "selection":"{{ctx.Ac0ConvCtx.selectedTab}}"
            },
            "deps": "js/Ac0ConversationUtils"
        }
    },

    "data": {
        "mainPanelId": "conversationTabs",
        "tabsModel":
        {
            "isArray": "true",
            "dbValue":
            [
                {
                    "tabKey": "Ac0PanelOnObjectTab",
                    "name": "{{i18n.onObject}}",
                    "selectedTab": false
                },
                {
                    "tabKey": "feedList",
                    "name": "{{i18n.feed}}",
                    "selectedTab": false
                }
            ]
        }
    },

    "functions":
    {

    },

    "dataProviders":
    {

    },

    "ctx": {
        "Ac0ConvCtx": {
            "type": "object"
        },
        "sublocation": {
            "type": "object"
        }
    },

    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },

    "onEvent": [
        {
        "eventId": "awTab.selected",
        "action": "setSelectedTab"
        }
    ],

    "lifecycleHooks": {
        "onMount": "onMountsetSelectedTab"
    },

    "i18n":
    {
        "conversation": [ "ActiveCollabDeclarativeMessages" ],
        "onObject": [ "ActiveCollabDeclarativeMessages" ],
        "feed": [ "ActiveCollabDeclarativeMessages" ]
    }

}
