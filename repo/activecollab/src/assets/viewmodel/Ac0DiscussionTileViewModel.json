{
    "schemaVersion": "1.0.0",
    "data": {
        "replyDiscussion": {
            "initialValues": {
                "discussionIsExpanded": false,
                "repliesString": "",
                "showFollowConv": "{{props.convItem.discussionItem.showFollowConv}}"
            },
            "meta": {
                "discussionIsExpanded": {
                    "field": "true",
                    "type": "BOOLEAN"
                },
                "repliesString": {
                    "field": "true",
                    "type": "STRING"
                },
                "showFollowConv": {
                    "field": "true",
                    "type": "BOOLEAN"
                }
            }
        },
        "updateReplyDiscussion": {
            "initialValues": {
                "loadedCommentsObject": {}
            },
            "meta": {
                "loadedCommentsObject": {
                    "field": "true",
                    "type": "OBJECT"
                }
            }
        }
    },
    "ports": {
    },
    "actions": {
        "updateRepliesString": {
            "actionType": "JSFunction",
            "method": "initDiscussionTile",
            "inputData":
            {
                "data": "{{data.replyDiscussion}}",
                "convItem": "{{props.convItem.discussionItem}}",
                "i18n": "{{i18n}}",
                "sharedData": "{{props.sharedDataObj.sharedData}}"
            },
            "events": {
                "success": [
                {
                    "name": "Ac0DiscussionTile.expandCommentsEvent"
                }
             ]
            },
            "outputData": {
                "replyDiscussion": ""
            },
            "deps": "js/Ac0DiscussionTileService"
        },
        "commentsRefreshBtnAction": {
            "actionType": "Event",
            "method": "Event",
            "inputData":
            {
                "events":
                [
                    {
                        "name": "Ac0CommentList.getLatestComments"
                    }
                ]
            }
        }
    },
    "lifecycleHooks": {
        "onMount": "updateRepliesString",
        "onUpdate": {
            "action": "updateRepliesString",
            "observers": [ "props.convItem.discussionItem.props.uid", "props.convItem.discussionItem.props.numReplies.dbValue" ]
        }
    },
    "props": {
        "conv-item": {
            "type": "object"
        },
        "contents": {
            "type": "object"
        },
        "search-state": {
            "type": "object"
        },
        "selected-obj": {
            "type": "object"
        },
        "shared-data-obj": {
            "type": "object"
        },
        "open-dialog": {
            "type": "object"
        },
        "occmgmt-context":{
            "type": "object"
        }
    },

    "ctx": {
        "preferences": {
            "type": "object"
        },
        "sublocation": {
            "type": "object"
        },
        "shared-data-obj": {
            "type": "object"
        }
    },

    "messages": {
        "discussPanelNewCommentRefreshMsg": {
            "messageType": "INFO",
            "messageText": "{{i18n.discussPanelNewCommentRefreshMsg}}"
        }
    },

    "i18n": {
        "replies": [ "ActiveCollabDeclarativeMessages" ],
        "reply": [ "ActiveCollabDeclarativeMessages" ],
        "discussPanelNewCommentRefreshMsg": ["ActiveCollabDeclarativeMessages"],
        "discussPanelNewCommentRefreshCmd": ["ActiveCollabDeclarativeMessages"]
    }
}
