{
  "commands": {
    "Awp0DdsExportToExcel": {
      "iconId": "cmdExport",
      "title": "{{i18n.Awp0ExportToExcelTitle}}",
      "description": "{{i18n.Awp0ExportToExcelDesc}}"
    }
  },
  "commandHandlers": {
    "Awp0PasteDdsHandler": {
      "id": "Awp0Paste",
      "activeWhen": {
        "condition": "conditions.isIndexerAdminLocation"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "Awp0MoreGroupDdsCommandHandler": {
      "id": "Awp0MoreGroup",
      "activeWhen": {
        "condition": "conditions.isIndexerAdminLocation"
      },
      "visibleWhen": true,
      "enableWhen": false
    },
    "Awp0ExportToExcelForIndexingStatusCommandHandler": {
      "id": "Awp0DdsExportToExcel",
      "action": "showExportToExcelPanel",
      "activeWhen": {
        "condition": "conditions.isIndexerAdminLocation"
      },
      "visibleWhen": true
    }
  },
  "commandPlacements": {
    "CopyCommandForDdsTables": {
      "id": "Awp0CopyContextMenu",
      "uiAnchor": "aw_dataDiscoveryTableContextMenu",
      "priority": 0
    },
    "TraceLinkCommandForDdsTables": {
      "id": "Arm0CreateTraceLinkCtx",
      "uiAnchor": "aw_dataDiscoveryTableContextMenu",
      "priority": 1
    },
    "ExistingTraceLinkCommandForDdsTables": {
      "id": "Arm0ExistingTraceLink",
      "uiAnchor": "aw_dataDiscoveryTableContextMenu",
      "priority": 2
    },
    "Awp0ExportToExcelForIndexingStatusCommandPlacement": {
      "id": "Awp0DdsExportToExcel",
      "uiAnchor": "indexingStatusExportToExcel",
      "priority": 7
    }
  },
  "actions": {
    "showExportToExcelPanel": {
      "actionType": "dialog",
      "inputData": {
        "options": {
          "view": "Awp0DdsObjdataExportToExcel",
          "parent": ".aw-layout-workareaMain",
          "width": "SMALL",
          "height": "FULL",
          "context": "{{commandContext}}",
          "isCloseVisible": false
        }
      }
    }
  },
  "conditions": {
    "isIndexerAdminLocation": {
      "expression": "ctx.sublocation.nameToken === 'com_siemens_splm_indexerAdminLocation:showIndexerAdmin'"
    }
  },
  "i18n": {
    "Awp0ExportToExcelTitle": [
      "ZeroCompileCommandMessages"
    ],
    "Awp0ExportToExcelDesc": [
      "ZeroCompileCommandMessages"
    ]
  }
}
