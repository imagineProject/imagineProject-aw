{
    "schemaVersion": "1.0.0",
    "data": {
        "searchState": {
            "initialValues": {
                "provider" : "Awp0SavedQuerySearchProvider",
                "advancedSearchCriteria": "",
                "savedQuery":{
                    "name": "",
                    "value": ""
                }
            },
            "meta": {
            }
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "lifecycleHooks": {
        "onMount": "initializeDiagnosticTab"
    },
    "actions": {
        "initializeDiagnosticTab": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "initializeAdvancedSearchState"
                },
                {
                    "action": "setAdvancedSearchState"
                }
            ]
        },
        "initializeAdvancedSearchState": {
            "actionType": "JSFunction",
            "method": "createStateFromUrl",
            "inputData": {
                "searchState": "{{data.searchState}}",
                "searchStateUpdater": "{{data.searchState.updateAtomicData}}"
            },
            "deps": "js/advancedSearchService"
        },
        "setAdvancedSearchState":{
            "actionType": "JSFunction",
            "method": "setAdvancedSearchState",
            "inputData": {
                "searchState": "{{props.subPanelContext.context.searchState}}"
            },
            "deps": "js/indexerDiagnosticService"
        }
    },
    "dataProviders": {
    },
    "conditions": {
    },
    "onEvent": [
    ],
    "i18n": {
    }
}
