{
    "schemaVersion": "1.0.0",
    "actions": {
        "changeReferenceSetAction": {
            "actionType": "popup",
            "inputData": {
                "options": {
                    "preset": "modal",
                    "isModal": false,
                    "clickOutsideToClose": true,
                    "draggable": true,
                    "placement": "right",
                    "height": "230",
                    "width": "300",
                    "caption": "{{i18n.referenceSets}}",
                    "view": "Awv0ChangeReferenceSet",
                    "resizable": true,
                    "subPanelContext": {
                        "referenceSet": "{{fields.referenceSet}}",
                        "viewerContextData":"{{props.viewerContextData}}"
                    }
                }
            }
        },
        "onUpdateRefSet":{
            "actionType": "JSFunction",
            "method": "onUpdateRefSet",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "data": "{{data.activeReferenceSet}}",
                "referenceSet": "{{fields.referenceSet}}"
            },
            "outputData": {
                "activeReferenceSet": ""
            },
            "deps": "js/PmiToolService"
        },
        "onUpdateTargetCsids":{
            "actionType": "JSFunction",
            "method": "onUpdateTargetCsids",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "deps": "js/PmiToolService"
        },
        "pmiPanelRevealedAction": {
            "actionType": "JSFunctionAsync",
            "method": "initialize",
            "inputData": {
                "pmiToolState": "{{fields.pmiToolState}}",
                "viewerContextData":"{{props.viewerContextData}}",
                "popupId": "{{props.subPanelContext.popupOptions.popupId}}"

            },
            "deps": "js/PmiToolService"
        },
        "initializeRefSetAction": {
            "actionType": "JSFunction",
            "method": "initializeRefSet",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "referenceSet": "{{fields.referenceSet}}"
            },
            "deps": "js/PmiToolService"
        },
        "pmiPanelRevealed": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "pmiPanelRevealedAction"
                },
                {
                    "action": "initializeRefSetAction",
                    "condition": "conditions.isLeafStructureEnabled "
                }
            ]
        },
        "updateSelectionAction": {
            "actionType": "dataProvider",
            "method": "selectionProvider"
        },
        "turnOnVisibility": {
            "actionType": "JSFunction",
            "method": "turnOnVisibility",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "outputData": {

            },
            "deps": "js/PmiToolService"
        },
        "updateSelectionWithDisplayStrings": {
            "actionType": "JSFunction",
            "method": "updateSelectionWithDisplayStrings",
            "inputData": {
                "declViewModel": "{{data}}",
                "modelName": "{{data.modelName}}",
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "outputData": {
                "allTargets": "allTargets",
                "totalFound": "totalFound",
                "selectionDisplayName": "selectionDisplayName",
                "notCurrentlyVisibleText": "notCurrentlyVisibleText",
                "hasNoPmiText": "hasNoPmiText",
                "selectedModelName": "selectedModelName",
                "modelName": "modelName"
            },
            "deps": "js/PmiToolService"
        },

        "modelViewDataFetchedAction": {
            "actionType": "JSFunction",
            "method": "updateMVTabViewModel",
            "inputData": {
                "modelViewDetails": "{{data.modelViewDetails}}",
                "modelViewState": "{{fields.mvData}}",
                "pmiRawEntityState": "{{fields.pmiRawEntityState}}"
            },
            "deps": "js/PmiToolService"
        },
        "pmiEntityDataFetchedAction": {
            "actionType": "JSFunction",
            "method": "updateTypesTabViewModel",
            "inputData": {
                "entitiesState": "{{fields.pmiData}}",
                "pmiRawEntityState": "{{fields.pmiRawEntityState}}"
            },
            "deps": "js/PmiToolService"
        },
        "pmiEntityModelViewNodeClickedAction": {
            "actionType": "JSFunction",
            "method": "pmiEntityModelViewNodeClicked",
            "inputData": {
                "eventData": "{{parameters.eventData}}",
                "modelViewState": "{{fields.mvData}}",
                "entitiesState": "{{fields.pmiData}}",
                "pmiRawEntityState": "{{fields.pmiRawEntityState}}",
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "outputData": {

            },
            "deps": "js/PmiToolService"
        },

        "reorientTextAction": {
            "actionType": "JSFunction",
            "method": "reorientText",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "deps": "js/PmiToolService"
        },
        "handleTabSelectionChangeAction": {
            "actionType": "JSFunction",
            "method": "handleTabSelectionChange",
            "inputData": {
                "data": "{{data}}",
                "modelViewState": "{{fields.mvData}}",
                "entitiesState": "{{fields.pmiData}}",
                "pmiRawEntityState": "{{fields.pmiRawEntityState}}",
                "viewerContextData": "{{props.viewerContextData}}",
                "leafStructureDataState": "{{fields.leafStructureDataState}}"
            },
            "deps": "js/PmiToolService"
        },
        "updatePMITreeFromViewer": {
            "actionType": "JSFunction",
            "method": "updateSelectionPmiTree",
            "inputData": {
                "modelViewState": "{{fields.mvData}}",
                "entitiesState": "{{fields.pmiData}}",
                "pmiRawEntityState": "{{fields.pmiRawEntityState}}",
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "deps": "js/PmiToolService"
        },
        "updatePmiTreeFromContextMenu": {
            "actionType": "JSFunction",
            "method": "updatePmiEntityFromContextMenu",
            "inputData": {
                "modelViewState": "{{fields.mvData}}",
                "entitiesState": "{{fields.pmiData}}",
                "pmiRawEntityState": "{{fields.pmiRawEntityState}}",
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "deps": "js/PmiToolService"
        },
        "pmiDataLoad": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "getPmiDataAction"
                },
                {
                    "action": "modelViewDataFetchedAction",
                    "condition": "data.selectedTab.tabIndex === 0"
                },
                {
                    "action": "pmiEntityDataFetchedAction",
                    "condition": "data.selectedTab.tabIndex === 1"
                }
            ]
        },
        "selectInLeafStructTree": {
            "actionType": "JSFunction",
            "method": "selectInLeafStructTree",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "leafStructDataProvider": "{{data.dataProviders.LeafStructDataProvider}}"
            },
            "deps": "js/PmiToolService"
        },
        "clearPmiCtxAction": {
            "actionType": "JSFunction",
            "method": "clearPmiCtx",
            "deps": "js/PmiToolService"
        },
        "getPmiDataAction": {
            "actionType": "JSFunctionAsync",
            "method": "fetchPmiData",
            "inputData": {
                "pmiRawEntityState": "{{fields.pmiRawEntityState}}",
                "modelViewState": "{{fields.mvData}}",
                "data": "{{data}}",
                "viewerContextData": "{{props.viewerContextData}}"
            },
            "outputData": {
                "modelViewDetails": "modelViewDetails"
            },
            "deps": "js/PmiToolService"
        },
        "loadLeafStructureData": {
            "actionType": "JSFunctionAsync",
            "method": "fetchLeafStructureData",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "parentNode": "{{data.treeLoadInput.parentNode}}"
            },
            "outputData": {
                "treeData": "{{function:processLeafNodeData}}"
            },
            "deps": "js/PmiToolService"
        },
        "onUpdateDataObserver": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "pmiDataLoad",
                "condition": "data.pmiToolState.fetchPmiDataObserver !== null"
            } ]
        },
        "onUpdateTargetList": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "updateSelectionAction",
                "condition": "data.pmiToolState.targetList.length > 0"
            } ]
        },
        "onUpdatePmiFromViewer": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "updatePMITreeFromViewer",
                "condition": "data.pmiToolState.selectedPMIFromViewer !== null"
            } ]
        },
        "onHidePmiFromContextMenu": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "updatePmiTreeFromContextMenu",
                "condition": "data.pmiToolState.pvwIdsForHiddenPmiFromContextMenu !== null"
            } ]
        },
        "selectLeafStructureTab":{
            "actionType": "JSFunction",
            "method": "selectLeafStructureTab",
            "inputData": {
                "data": "{{data.tabModels}}"
            },
            "deps": "js/PmiToolService"
        },
        "clearLeafStructDataProvider": {
            "actionType": "JSFunction",
            "method": "clearLeafStructDataProvider",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "leafStructDataProvider": "{{data.dataProviders.LeafStructDataProvider}}"
            },
            "deps": "js/PmiToolService",
            "events": {
                "success": [ {
                    "name": "LeafStructDataProvider.reload"
                } ]
            }
        },
        "initLeafStructDataProvider": {
            "actionType": "dataProvider",
            "method": "LeafStructDataProvider"
        },
        "updateLeafNodeSelectionIn3D": {
            "actionType": "JSFunction",
            "method": "updateLeafNodeSelectionIn3D",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "leafStructDataProvider": "{{data.dataProviders.LeafStructDataProvider}}",
                "eventData": "{{parameters.eventData}}"
            },
            "deps": "js/PmiToolService"
        },
        "updateLeafStructTreeData": {
            "actionType": "JSFunction",
            "method": "updateLeafTreeDataFromCachedMap",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "leafStructDataProvider": "{{data.dataProviders.LeafStructDataProvider}}"
            },
            "deps": "js/PmiToolService"
        },
        "selectFromNewlyLoadedNodesInLeafStructTree": {
            "actionType": "JSFunction",
            "method": "selectFromNewlyLoadedNodesInLeafStructTree",
            "inputData": {
                "viewerContextData": "{{props.viewerContextData}}",
                "leafStructDataProvider": "{{data.dataProviders.LeafStructDataProvider}}",
                "eventData": "{{parameters.eventData}}"
            },
            "deps": "js/PmiToolService"
        }
    },
    "lifecycleHooks": {
        "onMount": "pmiPanelRevealed",
        "onUnmount": "clearPmiCtxAction",
        "onUpdate": [ {
                "action": "onUpdateRefSet",
                "observers": [ "viewModel.atomicData.referenceSet.activeReferenceSet" ]
            },
            {
                "action": "onUpdateTargetCsids",
                "observers": [ "viewModel.atomicData.pmiToolState.targetCSIDs" ]
            },
            {
                "action": "onUpdateDataObserver",
                "observers": [ "viewModel.atomicData.pmiToolState.fetchPmiDataObserver" ]
            },
            {
                "action": "onUpdateTargetList",
                "observers": [ "viewModel.atomicData.pmiToolState.targetList" ]
            },
            {
                "action": "onUpdatePmiFromViewer",
                "observers": [ "viewModel.atomicData.pmiToolState.selectedPMIFromViewer" ]
            },
            {
                "action": "onHidePmiFromContextMenu",
                "observers": [ "viewModel.atomicData.pmiToolState.pvwIdsForHiddenPmiFromContextMenu" ]
            },
            {
                "action": "selectInLeafStructTree",
                "observers": [ "viewModel.atomicData.leafStructureDataState.leafStructSelectionData" ]
            }
        ]
    },
    "onEvent": [ {
            "eventId": "awTab.selected",
            "action": "handleTabSelectionChangeAction"
        },
        {
            "eventId": "awTab.selectLeafStructureTab",
            "action": "selectLeafStructureTab"
        },
        {
            "eventId": "treePmiModelView.treeNodeSelected",
            "action": "pmiEntityModelViewNodeClickedAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "treePmiTypes.treeNodeSelected",
            "action": "pmiEntityModelViewNodeClickedAction",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "commandBarResized",
            "action": "clearPmiCtxAction"
        },
        {
            "eventId": "LeafStructDataProvider.clearAndReload",
            "action": "clearLeafStructDataProvider"
        },
        {
            "eventId": "LeafStructDataProvider.reload",
            "action": "initLeafStructDataProvider"
        },
        {
            "eventId": "LeafStructDataProvider.reloadAndExpand",
            "action": "initLeafStructDataProvider"
        },
        {
            "eventId": "LeafStructDataProvider.updatevmos",
            "action": "updateLeafStructTreeData"
        },
        {
            "eventId": "LeafStructDataProvider.selectionChangeEvent",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "updateLeafNodeSelectionIn3D"
        },
        {
            "eventId": "LeafStructDataProvider.treeNodesLoaded",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "selectFromNewlyLoadedNodesInLeafStructTree"
        }
    ],
    "columnProviders": {
        "leafStructColumnProvider": {
            "columns": [ {
                "name": "leafStructNodeIcon",
                "displayName": "",
                "minWidth": 50,
                "width": 50
            }, {
                "name": "leafStructColName",
                "displayName": "{{i18n.leafStructColName}}",
                "minWidth": 150,
                "width": 300,
                "isTreeNavigation": true
            } ]
        }
    },
    "grids": {
        "leafStructureGrid": {
            "dataProvider": "LeafStructDataProvider",
            "columnProvider": "leafStructColumnProvider",
            "addIconColumn": false,
            "gridOptions": {
                "enableGridMenu": false,
                "enablePinning": false,
                "enableSorting": false,
                "enableExpansionStateCaching": false
            }
        }
    },
    "data": {
        "pmiToolState": {
            "initialValues": {
                "targetList": [],
                "dataFetchComplete": false,
                "fetchPmiDataObserver": null,
                "isTargetInVisible": false,
                "targetCSIDs": [],
                "activeTabIndex": 0,
                "visibilityProcessing": false,
                "selectionHasTypesData": false,
                "selectionHasMVData": false,
                "selectedPMIFromViewer": null,
                "pvwIdsForHiddenPmiFromContextMenu": null
            },
            "meta": {

            }
        },
        "leafStructureDataState": {
            "initialValues": {
                "targetmo": null,
                "targetCSID": null,
                "isTargetInVisible": false,
                "leafStructureData": null,
                "hasLeafStructdata": true
            },
            "meta": {}
        },
        "mvData": {
            "initialValues": {},
            "meta": {
                "modelViewData": [ {
                    "checkbox": {
                        "field": "true",
                        "type": "ViewModelProperty"
                    },
                    "children": [ {
                        "checkbox": {
                            "field": "true",
                            "type": "ViewModelProperty"
                        }
                    } ]
                } ]
            }
        },
        "pmiData": {
            "initialValues": {
                "lastCheckedTypeViewModel": [],
                "pmiEntityNextPrevStateIndex": -1
            },
            "meta": {
                "entities": [ {
                    "checkbox": {
                        "field": "true",
                        "type": "ViewModelProperty"
                    },
                    "children": [ {
                        "checkbox": {
                            "field": "true",
                            "type": "ViewModelProperty"
                        }
                    } ]
                } ]
            }
        },
        "referenceSet": {
            "initialValues": {
                "activeReferenceSet": " "
            },
            "meta": {}
        },
        "pmiRawEntityState": {
            "initialValues": {
                "previousSelectedPmiEntity": {
                    "position": -1,
                    "child": false
                }
            },
            "meta": {
                "pmiEntityRawData": []
            }
        },
        "tabModels": [ {
                "name": "{{i18n.modelViewsTabTitle}}",
                "tabkey": "modelViewesTab",
                "visibleWhen": {
                    "condition": "conditions.selectionHasPmi"
                }
            },
            {
                "name": "{{i18n.pmiEntitiesTabTitle}}",
                "tabkey": "entitiesTab",
                "visibleWhen": {
                    "condition": "conditions.selectionHasPmi"
                }
            },
            {
                "name": "{{i18n.pmiLeafStructureTabTitle}}",
                "tabkey": "leafStructureTab",
                "visibleWhen": {
                    "condition": "conditions.isLeafStructureEnabled"
                }
            }
        ],

        "stepOverCommands": "pmiStepCmdsAnchor",
        "modelName": {
            "displayName": "",
            "type": "STRING",
            "dbValue": "",
            "isEditable": "true"
        },
        "activeReferenceSet": {
            "displayName": "{{i18n.activeReferenceSet}}", 
            "type": "STRING",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "",
            "dispValue": ""
        }
    },

    "dataProviders": {
        "selectionProvider": {
            "action": "updateSelectionWithDisplayStrings",
            "response": "{{data.allTargets}}",
            "totalFound": "{{data.totalFound}}"
        },
        "LeafStructDataProvider": {
            "action": "loadLeafStructureData",
            "initializeAction": "loadLeafStructureData",
            "treeLoadResult": "{{data.treeData}}",
            "inputData": {
                "accessMode": "tree",
                "topNodeUid": "leafStructTop"
            },
            "selectionModelMode": "multiple"
        }
    },
    "conditions": {
        "dataFetchComplete": {
            "expression": "data.pmiToolState.dataFetchComplete"
        },
        "selectionHasNoPmi": {
            "expression": "conditions.dataFetchComplete && !conditions.targetHasMVData && !conditions.targetHasTypeGroupsData"
        },
        "selectionHasPmi": {
            "expression": "!conditions.selectionHasNoPmi"
        },
        "targetHasMVData": {
            "expression": "data.pmiToolState.selectionHasMVData"
        },
        "targetHasTypeGroupsData": {
            "expression": "data.pmiToolState.selectionHasTypesData"
        },
        "selectionIsNotVisible": {
            "expression": "data.pmiToolState.isTargetInVisible===true"
        },
        "targetHasLeafStructData": {
            "expression": "data.leafStructureDataState.hasLeafStructdata"
        },
        "isInACESublocation": {
            "expression": "(ctx.sublocation.nameToken==='com.siemens.splm.client.occmgmt:OccurrenceManagementSubLocation' ||  conditions.isInMBMSublocation || ctx.sublocation.nameToken==='com.siemens.splm.client.cba.CADBOMAlignment:CBASublocation') && ctx.sublocation.label !== 'Disclosure'"
        },
        "isInMBMSublocation": {
            "expression": "(ctx.sublocation.nameToken==='multiBOMManager:mbomContextSublocation' || ctx.sublocation.nameToken==='multiBOMManager:ebomContextSublocation') && ctx.sublocation.label !== 'Disclosure'"
        },
        "isLeafStructureEnabled": {
            "expression": "ctx.preferences.AWC_visExposedBetaFeatures && ctx.preferences.AWC_visExposedBetaFeatures.indexOf('enableLeafStructurePanel') > -1"
        }
    },
    "i18n": {
        "PmiPanelTitle": [ "PmiToolMessages" ],
        "operationName": [ "PmiToolMessages" ],
        "modelViewsTabTitle": [ "PmiToolMessages" ],
        "pmiEntitiesTabTitle": [ "PmiToolMessages" ],
        "pmiLeafStructureTabTitle": [ "PmiToolMessages" ],
        "stepThroughLabel": [ "PmiToolMessages" ],
        "reorientText": [ "PmiToolMessages" ],
        "stepThroughNext": [ "PmiToolMessages" ],
        "stepThroughPrev": [ "PmiToolMessages" ],
        "toolPanelTitle": [ "PmiToolMessages" ],
        "showingPmiFor": [ "PmiToolMessages" ],
        "notCurrentlyVisible": [ "PmiToolMessages" ],
        "hasNoPmi": [ "PmiToolMessages" ],
        "hasNoLeafStruct": [ "PmiToolMessages" ],
        "show": [ "PmiToolMessages" ],
        "leafStructColName": [ "PmiToolMessages" ],
        "activeReferenceSet":[ "PmiToolMessages" ],
        "referenceSets":[ "PmiToolMessages" ],
        "showingPmiAndLeafStrFor": [ "PmiToolMessages" ],
        "notCurrentlyVisibleForPmiAndLeaf": [ "PmiToolMessages" ],
        "changeRefSet": [ "PmiToolMessages" ]
    },

    "functions": {
        "processLeafNodeData": {
            "functionName": "processLeafNodeData",
            "parameters": [
                "{{data.treeLoadInput.parentNode}}",
                 "{{props.viewerContextData}}"
            ]
        }
    },

    "messages": {
        "VisibilityMessageWarning": {
            "messageType": "WARNING",
            "messageText":  "{{i18n.notCurrentlyVisible}}"
        },
        "VisibilityMessageWarningForPmiAndLeafStr": {
            "messageType": "WARNING",
            "messageText":  "{{i18n.notCurrentlyVisibleForPmiAndLeaf}}"
        },
        "NoPmiMessageWarning": {
            "messageType": "WARNING",
            "messageText": "{{i18n.hasNoPmi}}"
        },
        "NoLeafStructMessageWarning": {
            "messageType": "WARNING",
            "messageText": "{{i18n.hasNoLeafStruct}}"
        }
    }
}
