{
  "slots": {
    "volumeSelectSlot": {
      "name": "viewerSubCommandToolbar",
      "view": "Awv0VolumeSelectComponent",
      "activeWhen": {
        "condition": "conditions.displayVolumeSelectViewSubCommandToolbar"
      }
    }
  },
  "conditions": {
    "displayVolumeSelectViewSubCommandToolbar": {
      "expression": "context.viewerAtomicData.volumeSelect === true"
    }
  }
}
