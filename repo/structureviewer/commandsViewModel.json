{
  "commands": {
    "Awb0ShowInViewerCommand": {
      "iconId": "cmd3DView",
      "isGroup": false,
      "title": "{{i18n.showResultsInViewer}}",
      "description": "{{i18n.Awb0ShowInViewerCommandDesc}}"
    },
    "Awv0ShowModelViewPalette": {
      "iconId": "cmdShowInfoPanel",
      "isGroup": false,
      "title": "{{i18n.ShowModelViewPalette}}",
      "description": "{{i18n.ShowModelViewPalette}}"
    },
    "Awv0Explode": {
      "iconId": "cmdExplode",
      "isGroup": false,
      "title": "{{i18n.explodeText}}",
      "description": "{{i18n.explodeDesc}}"
    },
    "Awv0StructureViewerPageContainer": {
      "iconId": "cmd3DView24",
      "title": "{{i18n.display3DTitle}}",
      "description": "{{i18n.display3DDescription}}"
    },
    "Awv0CloseExplodeViewToolbar": {
      "iconId": "cmdClose",
      "isGroup": false,
      "title": "{{i18n.Close}}",
      "description": "{{i18n.Awv0Close3DSubCommandsToolbarDesc}}"
    },
    "applyProductSnapshotCommand": {
      "iconId": "cmdApply",
      "title": "{{i18n.applyButtonTitle}}",
      "description": "{{i18n.applyProductSnapshotCommandDesc}}"
    }
  },
  "commandHandlers": {
    "Awv0SignOutCommandHandler": {
      "id": "cmdSignOut",
      "action": "closeViewerAndSaveUserWorkingContextStateAndSignOut",
      "activeWhen": {
        "condition": "conditions.isSignOutVisibleForVis"
      },
      "visibleWhen": {
        "condition": "conditions.isSignOutVisibleForVis"
      }
    },
    "Awb0ShowInViewerCommandHandler": {
      "id": "Awb0ShowInViewerCommand",
      "activeWhen": true,
      "visibleWhen": {
        "condition": "conditions.isViewerVisibleWithSearchCriteria"
      },
      "action": "applySearchCiteriaInViewerAction"
    },
    "Awb0SaveSession3DCommandHandler": {
      "id": "Awb0SaveSession",
      "action": "saveSessionPendingChanges3DBatch",
      "visibleWhen": true,
      "activeWhen": {
        "condition": "conditions.isSaveSessionActiveFor3D"
      },
      "enableWhen": {
        "condition": "conditions.isSaveSessionActiveFor3D"
      }
    },
    "Awb0ResetSession3DHandler": {
      "id": "Awb0ResetSession",
      "action": "showConfirmationMessageForReset",
      "visibleWhen": {
        "condition": "conditions.isResetApplicable3D"
      },
      "activeWhen": {
        "condition": "conditions.isResetApplicable3D"
      }
    },
    "Awv0ShowModelViewPaletteHandler": {
      "id": "Awv0ShowModelViewPalette",
      "action": "showModelViewPalettePanel",
      "visibleWhen": {
        "condition": "conditions.showModelViewPaletteCommand"
      },
      "activeWhen": {
        "condition": "conditions.showModelViewPaletteCommand"
      }
    },
    "Awv0ExplodeCommandHandler": {
      "id": "Awv0Explode",
      "action": "setupExplodeSubToolbar",
      "activeWhen": {
        "condition": "conditions.isExplodeViewVisible"
      },
      "selectWhen": {
        "condition": "conditions.isExplodeToolbarLaunched"
      },
      "visibleWhen": {
        "condition": "conditions.isExplodeViewVisible"
      },
      "enableWhen": {
        "condition": "conditions.isExplodedViewEnabled"
      }
    },
    "Awv0StructureViewerPageContainerCommandHandler": {
      "id": "Awv0StructureViewerPageContainer",
      "action": "setAwv03DView",
      "activeWhen": {
        "condition": "conditions.supportsAwv03DView"
      },
      "selectWhen": {
        "condition": "conditions.isAwv03DView"
      },
      "visibleWhen": {
        "condition": "conditions.supportsAwv03DView"
      }
    },
    "Awv0CloseExplodeViewToolbarCommandHandler": {
      "id": "Awv0CloseExplodeViewToolbar",
      "activeWhen": true,
      "visibleWhen": true,
      "action": "closeExplodeViewSubCommandToolbar"
    },
    "applyProductSnapshotCommandHandler": {
      "id": "applyProductSnapshotCommand",
      "action": "applyProductSnapshotBatch",
      "visibleWhen": true,
      "activeWhen": {
        "condition": "conditions.isSnapshotSelectedOrInDiscussion3DInsideACE"
      }
    }
  },
  "commandPlacements": {
    "Awb0ShowInViewerCommandPlacement": {
      "id": "Awb0ShowInViewerCommand",
      "uiAnchor": "aw_search_objects",
      "priority": 100
    },
    "Awv0ShowModelViewPaletteOneStep": {
      "id": "Awv0ShowModelViewPalette",
      "uiAnchor": "aw_3dViewer",
      "priority": 300
    },
    "Awv0ExplodeToolsAndInfo": {
      "id": "Awv0Explode",
      "uiAnchor": "aw_3dViewer",
      "priority": 71,
      "showGroupSelected": true
    },
    "Awv0StructureViewerPageContainerPlacement": {
      "id": "Awv0StructureViewerPageContainer",
      "parentGroupId": "Awp0DisplayToggles",
      "priority": -1
    },
    "Awv03DSummaryCmdPlacement": {
      "id": "Awv0StructureViewerPageContainer",
      "parentGroupId": "Awp0DisplayTogglesSummary",
      "priority": -1
    },
    "Awv0CloseExplodeViewToolbar": {
      "id": "Awv0CloseExplodeViewToolbar",
      "uiAnchor": "aw_3dViewerExplodeViewAnchor",
      "priority": 9
    },
    "applyProductSnapshotCellCommandPlacement": {
      "id": "applyProductSnapshotCommand",
      "parentGroupId": "Awv0ProductSnapshotListCommand",
      "priority": 1
    },
    "applyProductSnapshotThumbnailPlacement": {
      "id": "applyProductSnapshotCommand",
      "uiAnchor": "aw_3dSnapshotThumbnailViewCommands",
      "priority": 1
    }
  },
  "actions": {
    "applyProductSnapshotBatch": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "resetCachedSnapshotData"
        },
        {
          "action": "registerPartialErrorOverride",
          "condition": "conditions.isOccurrenceManagementSubLocation"
        },
        {
          "action": "openSnapshotActionInsideACE",
          "condition": "commandContext && commandContext.occmgmtContext && !commandContext.itemOptions"
        },
        {
          "action": "openSnapshotActionInsideACEListView",
          "condition": "commandContext && commandContext.itemOptions && !commandContext.occmgmtContext"
        }
      ]
    },
    "resetCachedSnapshotData": {
      "actionType": "Event",
      "method": "Event",
      "inputData": {
        "events": [
          {
            "name": "viewer.snapshotApplyActionStarted"
          }
        ]
      }
    },
    "applySearchCiteriaInViewerAction": {
      "actionType": "JSFunction",
      "deps": "js/structureSearchService",
      "method": "applySearchCiteriaInViewer",
      "inputData": {
        "context": "{{commandContext}}"
      }
    },
    "Awb0SaveAsAppSessionCommandPanelAction": {
      "actionType": "JSFunction",
      "method": "activateCommandPanel",
      "deps": "js/commandPanel.service",
      "inputData": {
        "commandId": "Awb0SaveAsSession",
        "location": "aw_toolsAndInfo"
      }
    },
    "saveSessionPendingChanges3D": {
      "actionType": "TcSoaService",
      "serviceName": "Internal-ActiveWorkspaceBom-2020-05-OccurrenceManagement",
      "method": "updateWorkingContext",
      "inputData": {
        "input": [
          {
            "productInfo": "{{commandContext.occContext.productContextInfo}}",
            "workingContext": "{{function:getWorkContextObject}}",
            "saveResult": true,
            "operation": "Save"
          }
        ]
      },
      "outputData": {
        "partialErrors": "partialErrors",
        "errorMessages": "{{partialErrors[0].errorValues[0].message}}"
      },
      "actionMessages": {
        "failure": [
          {
            "condition": "partialErrors && partialErrors[0].errorValues[0].code === 126262",
            "message": "saveAppSessionConfirmPopup"
          }
        ]
      },
      "deps": "soa/kernel/clientDataModel"
    },
    "aceSaveSessionSuccessEvent": {
      "actionType": "Event",
      "method": "Event",
      "inputData": {
        "events": [
          {
            "name": "ace.saveSessionSuccess"
          }
        ]
      }
    },
    "closeViewerAndSaveUserWorkingContextStateAndSignOut": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "closeViewer"
        },
        {
          "action": "saveUserWorkingContextState"
        },
        {
          "action": "signOut"
        }
      ]
    },
    "closeViewer": {
      "actionType": "JSFunctionAsync",
      "method": "closeViewer",
      "deps": "js/structureViewerService"
    },
    "saveSessionPendingChanges3DBatch": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "saveSessionPendingChanges3D",
          "condition": "!conditions.isSessionWithWorksetOpen3D"
        },
        {
          "action": "aceSaveSessionSuccessEvent"
        }
      ]
    },
    "overwriteAppSessionPendingChangesAction": {
      "actionType": "TcSoaService",
      "serviceName": "Internal-ActiveWorkspaceBom-2020-05-OccurrenceManagement",
      "method": "updateWorkingContext",
      "inputData": {
        "input": [
          {
            "productInfo": "{{commandContext.occContext.productContextInfo}}",
            "workingContext": "{{function:getWorkContextObject}}",
            "saveResult": true,
            "operation": "Overwrite"
          }
        ]
      },
      "events": {
        "success": [
          {
            "name": "ace.saveSessionSuccess"
          }
        ]
      },
      "deps": "soa/kernel/clientDataModel"
    },
    "showModelViewPalettePanel": {
      "actionType": "Event",
      "method": "Event",
      "inputData": {
        "events": [
          {
            "name": "awsidenav.openClose",
            "eventData": {
              "id": "globalNavigationSideNav",
              "includeView": "disclosure",
              "keepOthersOpen": true,
              "closeWhenCommandHidden": true,
              "config": {
                "width": "500",
                "height": "FULL"
              }
            }
          }
        ]
      }
    },
    "setupExplodeSubToolbar": {
      "actionType": "JSFunction",
      "method": "toggleExplodeSubCommandsToolbar",
      "inputData": {
        "viewerContextData": "{{commandContext.viewerContextData}}"
      },
      "deps": "js/explodeViewService"
    },
    "setAwv03DView": {
      "actionType": "JSFunction",
      "method": "changeViewMode",
      "deps": "js/pageLayoutService",
      "inputData": {
        "viewTupleState": "{{commandContext.viewTuple}}",
        "viewTuple": {
          "alternatePWA": "Awv0StructureViewerPageContainer"
        },
        "sublocationState": "{{commandContext.pageContext.sublocationState}}",
        "title": {
          "source": "/i18n/StructureViewerMessages",
          "key": "display3DTitle"
        }
      }
    },
    "closeExplodeViewSubCommandToolbar": {
      "actionType": "JSFunction",
      "method": "closeExplodeViewSubCommandToolbar",
      "inputData": {
        "viewerContextData": "{{commandContext.viewerContextData}}"
      },
      "deps": "js/explodeViewService"
    }
  },
  "conditions": {
    "isSignOutVisibleForVis": {
      "expression": "ctx.sublocation.clientScopeURI === 'Awb0OccurrenceManagement' && !ctx.signOutDisabled && ctx.occmgmtContext.currentState.altPwa === 'Awv0StructureViewerPageContainer'"
    },
    "isViewerVisibleWithSearchCriteria": {
      "expression": "commandContext.preFilterContext && commandContext.preFilterContext.occContext && ( commandContext.preFilterContext.occContext.currentState.spageId === 'Awv0StructureViewerPageContainer' || commandContext.preFilterContext.occContext.currentState.altPwa === 'Awv0StructureViewerPageContainer' || commandContext.preFilterContext.occContext.currentState.altPwa_2 === 'Awv0StructureViewerPageContainer' ) && commandContext.searchState && commandContext.searchState.totalFound > 0"
    },
    "isSessionSaveDisabledIn3D": {
      "expression": "commandContext.occContext.disableSaveSessionButtonForViewer"
    },
    "isTypeFnd0AppSession3D": {
      "expression": "ctx.aceActiveContext.context.topElement.modelType.typeHierarchyArray.indexOf( 'Fnd0AppSession' ) > -1"
    },
    "isFnd0SnapshotOpened3D": {
      "expression": "ctx.aceActiveContext.context.topElement.modelType.typeHierarchyArray.indexOf( 'Fnd0Snapshot' ) > -1"
    },
    "isWriteAccessProvided3D": {
      "expression": "ctx.aceActiveContext.context.modelObject.props.is_modifiable.dbValues[0]==='1'"
    },
    "isSaveSessionActive3D": {
      "expression": "conditions.isTypeFnd0AppSession3D && !conditions.isFnd0SnapshotOpened3D && conditions.isWriteAccessProvided3D"
    },
    "isSaveSessionActiveFor3D": {
      "expression": "conditions.isSaveSessionActive3D && conditions.is3DViewerPageEnabled && !conditions.isSessionSaveDisabledIn3D && conditions.isSaveAsSessionPanelNotOpened"
    },
    "is3DViewerPageEnabled": {
      "expression": "commandContext.occContext.currentState.spageId === 'Awv0StructureViewerPageContainer' || commandContext.occContext.currentState.altPwa === 'Awv0StructureViewerPageContainer' || commandContext.occContext.currentState.altPwa_2 === 'Awv0StructureViewerPageContainer' "
    },
    "isResetApplicable3D": {
      "expression": "(conditions.isResetForSessionWithProductApplicable || !conditions.isResetForSessionWithProductApplicable) && conditions.isResetGroupCommandVisible && conditions.is3DViewerPageEnabled"
    },
    "showModelViewPaletteCommand": {
      "expression": "ctx.awDefaultViewer.hasDisclosedMVData && conditions.is3DViewerLoaded"
    },
    "isExplodeToolbarLaunched": {
      "expression": "commandContext.viewerAtomicData.isExplodeViewVisible === true"
    },
    "isExplodedViewEnabled": {
      "expression": "!commandContext.viewerAtomicData.isLogicalSelected && commandContext.viewerAtomicData.activeManagers.indexOf('motionMgr')>-1 && conditions.is3DViewerLoaded"
    },
    "isExplodeViewVisible": {
      "expression": "( ( commandContext.context.occContext && commandContext.context.occContext.currentState.spageId === 'Awv0StructureViewerPageContainer' ) || ( commandContext.viewTuple && commandContext.viewTuple.alternatePWA === 'Awv0StructureViewerPageContainer' ) ) && commandContext.viewerAtomicData.renderLocation === 'CSR' && !commandContext.viewerAtomicData.displayImageCapture"
    },
    "isSessionWithWorksetOpen3D": {
      "expression": "conditions.isTypeFnd0AppSession3D && commandContext.occContext.openedObjectType === 'AppSessionWorkset'"
    },
    "supportsAwv03DView": {
      "expression": "( !conditions.isArchitectureActiveInAnotherAlternatePWAView || conditions.isAwv03DView ) && ( commandContext.occContext.supportedFeatures.Awb0ViewerFeature || commandContext.context.occContext.supportedFeatures.Awb0ViewerFeature) && ( commandContext.selection.length > 0 || commandContext.selectionData.selected.length > 0 ) && ( (!commandContext.occContext.supportedFeatures.Awb0PlantCadFeature || !commandContext.context.occContext.supportedFeatures.Awb0PlantCadFeature ) || ( commandContext.occContext.supportedFeatures.Awb0PlantCadFeature || commandContext.context.occContext.supportedFeatures.Awb0PlantCadFeature ) && ( ( commandContext.occContext.elementToPCIMap && commandContext.occContext.topElement.modelType.typeHierarchyArray.indexOf( 'Fnd0AppSession' ) === -1) || ( commandContext.context.occContext.elementToPCIMap && commandContext.context.occContext.topElement.modelType.typeHierarchyArray.indexOf( 'Fnd0AppSession' ) === -1 ) ) ) && !commandContext.fullScreenState.value"
    },
    "isAwv03DView": {
      "expression": "commandContext.viewTuple.alternatePWA === 'Awv0StructureViewerPageContainer'"
    },
    "isArchitectureActiveInAnotherAlternatePWAView": {
      "expression": "commandContext.pageContext.sublocationState.viewModeContext.displayedViewModes.altPwaViews.indexOf( 'Ase0ArchitecturePage' ) > -1 && ( commandContext.viewTuple.alternatePWA !== 'Ase0ArchitecturePage' ) "
    },
    "isSnapshotSelectedOrInDiscussion3DInsideACE": {
      "expression": "conditions.isTypeFnd0SnapshotSelected && conditions.is3DViewerLoaded"
    },
    "is3DViewerLoaded": {
      "expression": "commandContext.viewerAtomicData.isViewerRevealed && commandContext.viewerAtomicData.viewerViewMode === 'VIEWER3D'"
    }
  },
  "functions": {
    "getWorkContextObject": {
      "functionName": "getObject",
      "parameters": [
        "{{commandContext.occContext.workingContextObj.uid}}"
      ]
    }
  },
  "messages": {
    "saveAppSessionConfirmPopup": {
      "messageType": "WARNING",
      "messageText": "{{i18n.saveSessionConfirmPopupMsg}}",
      "messageTextParams": [
        "{{data.partialErrors[0].errorValues[0].message}}"
      ],
      "navigationOptions": [
        {
          "option": "cancel",
          "text": "{{i18n.CancelText}}",
          "action": ""
        },
        {
          "option": "overwrite",
          "text": "{{i18n.OverwriteText}}",
          "action": "overwriteAppSessionPendingChangesAction"
        },
        {
          "option": "saveas",
          "text": "{{i18n.SaveAsAppSessionCmd}}",
          "action": "Awb0SaveAsAppSessionCommandPanelAction"
        }
      ]
    }
  },
  "onEvent": [
    {
      "eventId": "confirmSaveSessionEvent",
      "message": "saveAppSessionConfirmPopup"
    }
  ],
  "i18n": {
    "structureViewerPageTitle": [
      "StructureViewerConstants"
    ],
    "showResultsInViewer": [
      "StructureViewerConstants"
    ],
    "Awb0ShowInViewerCommandDesc": [
      "StructureViewerConstants"
    ],
    "SaveAsAppSessionCmd": [
      "StructureViewerConstants"
    ],
    "saveSessionConfirmPopupMsg": [
      "StructureViewerConstants"
    ],
    "CancelText": [
      "StructureViewerConstants"
    ],
    "OverwriteText": [
      "StructureViewerConstants"
    ],
    "ShowModelViewPalette": [
      "StructureViewerConstants"
    ],
    "explodeText": [
      "StructureViewerMessages"
    ],
    "explodeDesc": [
      "StructureViewerMessages"
    ],
    "display3DTitle": [
      "StructureViewerMessages"
    ],
    "display3DDescription": [
      "StructureViewerMessages"
    ],
    "applyProductSnapshotCommandDesc": [
      "StructureViewerMessages"
    ],
    "applyButtonTitle": [
      "StructureViewerMessages"
    ]
  }
}
