{
    "schemaVersion": "1.0.0",
    "data": {},
    "props": {
        "product-snapshot": {
            "type": "object"
        }
    },
    "actions": {
        "getProductSnapshotViewerContext": {
            "actionType": "JSFunctionAsync",
            "method": "getProductSnapshotViewerContext",
            "inputData": {
                "inputProductSnapshot": "{{props.productSnapshot}}"
            },
            "outputData": {
                "productSnapshotViewerContext": "productSnapshotViewerContext",
                "enableStructureViewer": "enableStructureViewer"
            },
            "deps": "js/structureViewerProductSnapshotService"
        }
    },
    "messages": {
    },
    "lifecycleHooks": {
        "onMount": "getProductSnapshotViewerContext",
        "onUpdate": {
            "action": "getProductSnapshotViewerContext",
            "observers": [
                "props.productSnapshot"
            ]
        }
    },
    "functions": {
    },
    "i18n": {},
    "conditions": {
        "renderStructureViewer": {
            "expression": "data.enableStructureViewer === true"
        }
    }
}
