{
  "$schema": "declarativeSecondaryWorkareaTabsSchema-1.0.0.json",
  "tabs": {
    "SearchChartAwSearchChart": {
      "name": "SearchChart",
      "priority": 50,
      "view": "AwSearchChart",
      "visibleWhen": "context.searchState.categories.length > 0 && context.searchState.totalFound > 0 && selection.length === 0 && context.searchState && context.searchState.chartTitle && context.searchState.forceChart && !(context.searchState.thresholdExceeded==='true')"
    },
    "SearchResultsEmptyWorkareaAwp0AdvancedSearchSWAEmptyState": {
      "name": "SearchResultsEmptyWorkarea",
      "view": "Awp0AdvancedSearchSWAEmptyState",
      "visibleWhen": "context.searchState.totalFound === 0 && selection.length === 0  && context.nameToken === 'com.siemens.splm.client.search:SearchResultsSubLocation' && !context.searchState.chartProvider"
    },
    "AdvancedResultsEmptyWorkareaAwp0AdvancedSearchSWAEmptyState": {
      "name": "AdvancedResultsEmptyWorkarea",
      "view": "Awp0AdvancedSearchSWAEmptyState",
      "visibleWhen": "selection.length === 0  && context.clientScopeURI === 'Awp0AdvancedSearch' && !context.searchState.chartProvider"
    },
    "SavedEmptyWorkareaAwp0AdvancedSearchSWAEmptyState": {
      "name": "SavedEmptyWorkarea",
      "view": "Awp0AdvancedSearchSWAEmptyState",
      "visibleWhen": "context.searchState && context.searchState.totalFound > 0 && selection.length === 0  && context.clientScopeURI === 'Awp0SavedSearch' && !context.searchState.chartProvider"
    },
    "QueryBuilderEmptyWorkareaAwp0AdvancedSearchSWAEmptyState": {
      "name": "QueryBuilderEmptyWorkarea",
      "view": "Awp0AdvancedSearchSWAEmptyState",
      "visibleWhen": "selection.length === 0  && context.nameToken === 'com_siemens_splm_client_queryBuilder:AwSearchQueryBuilder'"
    },
    "IdenticalObjectsAndDataTab": {
      "name": {
        "source": "/i18n/ClusterSearchMessages",
        "key": "SS1ClusterDetailsTabName"
      },
      "pageId": "IdentityReportIdenticalObjectsAndDataTab",
      "priority": 50,
      "view": "AwShapeClusterDetails",
      "visibleWhen": "ctx.workspace.workspaceId === 'PricingCompanionWorkspace' && ctx.preferences.SS1_DASS_enable[0] ==='true' && ctx.preferences.TC_Enable_Identity_Search && ctx.preferences.TC_Enable_Identity_Search[0] === 'true' && ctx.sublocation.nameToken === 'com.siemens.splm.client.search:ShapeClusterResultsSubLocation' && context.searchState.totalFound > 0 && selection.length === 1"
    }
  }
}
