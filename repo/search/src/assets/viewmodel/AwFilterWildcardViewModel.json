{
    "data": {
        "operation": {
            "type": "STRING",
            "isRequired": "false",
            "isEditable": "true",
            "displayName": ""
        },
        "_linkOptions_operationsLink": {
            "hasPopup": true,
            "iconOptions": {
                "title": "textOnly",
                "cell": "textOnly"
            }
        }
    },
    "actions": {
        "getDataProvider": {
            "actionType": "JSFunction",
            "method": "getWildcardList",
            "inputData":
            {
                "operation": "{{data.operation}}",
                "props": "{{props}}",
                "i18n": "{{i18n}}"
            },
            "outputData":
            {
                "response": "response",
                "totalFound": "totalFound",
                "operation": "operation"
            },
            "deps": "js/AwFilterWildcardService"
        },
        "wildcardSelectionChanged": {
            "actionType": "JSFunction",
            "method": "wildcardSelectionChanged",
            "inputData":
            {
                "props": "{{props}}",
                "eventData": "{{parameters.eventData}}"
            },
            "deps": "js/AwFilterWildcardService"
        }
    },
   "lifecycleHooks": {
        "onMount": "getDataProvider",
        "onUpdate": {
            "action": "getDataProvider",
            "observers": [ "props.wildcardOperators" ]
        }
    },
    "dataProviders": {
        "operationsDataProvider": {
            "response": "{{data.response}}",
            "totalFound": "{{data.totalFound}}"
        }
    },
    "onEvent": [ {
        "eventId": "awlinkPopup.selected",
        "action": "wildcardSelectionChanged",
        "inputArgs": {
            "eventData": "{{eventData}}"
        }
    } ],
    "i18n": {
        "equalsOperation": [
            "SearchMessages"
        ],
        "notequalsOperation": [
            "SearchMessages"
        ],
        "containsOperation": [
            "SearchMessages"
        ],
        "notcontainsOperation": [
            "SearchMessages"
        ],
        "startswithOperation": [
            "SearchMessages"
        ],
        "endswithOperation": [
            "SearchMessages"
        ],
        "likeOperation": [
            "SearchMessages"
        ],
        "gtOperation": [
            "SearchMessages"
        ],
        "gteOperation": [
            "SearchMessages"
        ],
        "ltOperation": [
            "SearchMessages"
        ],
        "lteOperation": [
            "SearchMessages"
        ],
        "rangeinclusiveOperation": [
            "SearchMessages"
        ],
        "rangeexclusiveOperation": [
            "SearchMessages"
        ]
    }
}
