{
    "schemaVersion": "1.0.0",
    "lifecycleHooks": {
        "onMount": "buildClusterBreadCrumbTitle",
        "onUpdate": {
            "action": "buildClusterBreadCrumbTitle",
            "observers": [ "props.subPanelContext.searchState" ]
        }
    },
    "data": {
        "crumbTitle": null
    },
    "actions": {
        "buildClusterBreadCrumbTitle": {
            "actionType": "JSFunctionAsync",
            "method": "buildClusterBreadCrumbTitle",
            "inputData": {
                "searchObject": "{{props.subPanelContext.searchState}}"
            },
            "outputData": {
                "crumbTitle": ""
            },
            "deps": "js/SS1ClusterSearchService"
        }
    },
    "onEvent": [],
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
