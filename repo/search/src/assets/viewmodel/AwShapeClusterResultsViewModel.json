{
    "schemaVersion" : "1.0.0",
    "lifecycleHooks": {
        "onMount": "initializeClusterSearch"
    },
    "data":{
        "_provider": {
            "breadcrumbConfig": {
                "type" : "search",
                "vm" : "AwShapeClusterBreadcrumb",
                "noUpdate": true,
                "popuplist": "/html/defaultbreadcrumblist.html" ,
                "overflowIndex": 0
            },
            "clientScopeURI": "Awp0SearchResults",
            "nameToken": "com.siemens.splm.client.search:ShapeClusterResultsSubLocation",
            "context": {
                "search": {
                    "provider": "SS1IdentityReportProvider",
                    "criteria": {
                        "forceThreshold": "false",
                        "searchFromLocation": "global",
                        "dcpSortByDataProvider": "true"
                    },
                    "showLoadingText": true,
                    "selectFirstObjectPreference": "AWC_select_firstobject_inSearchLocation",
                    "showNoCriteriaMessage": true,
                    "hideInContentSearchBox": true
                }
            },
            "pwaViewModes": ["table", "image"],
            "defaultLayout":{
                "layout":{
                    "column":[
                        {"row":[{"pwaViewMode":"table"}]}
                    ]
                },
                "layoutId":"Awp0SinglePaneLayout"
            },
            "secondaryWorkarea": true,
            "viewBase": "AwShapeClusterResults"
        },
        "searchState": {
            "initialValues": {
                "pwaSelection": []
            },
            "meta": {
                "categories": [ {
                    "filterValues": [ {
                        "selected": {
                            "field": "true",
                            "type": "ViewModelProperty"
                        }
                    } ]
                } ]
            }
        }

    },
    "actions":
    {
        "initializeClusterSearch":{
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "validateCriteriaAndInitiateSearch"
                },
                {
                    "action": "activateClustersAction"
                }
            ]
        },
        "validateCriteriaAndInitiateSearch":{
            "actionType": "JSFunction",
            "method": "validateCriteriaAndInitiateSearch",
            "inputData": {
            },
            "outputData": {
            },
            "deps": "js/SS1ClusterSearchService"
        },
        "activateClustersAction": {
            "actionType": "JSFunctionAsync",
            "method": "activateShapeClustersAction",
            "inputData": {
                "searchState": "{{fields.searchState}}",
                "subPanelContext":"{{subPanelContext}}",
                "searchClusterDialogAction": "{{actions.ShapeSearchForClusterDialogAction}}"
            },
            "deps": "js/SS1ClusterSearchService"

        },
        "ShapeSearchForClusterDialogAction": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                    "view":"SS1ShapeSearchForClusterLocation",
                    "placement": "left",
                    "push": true,
                    "parent": ".aw-layout-workarea",
                    "width": "SMALL",
                    "height": "FULL",
                    "isCloseVisible": false
                }
            }
        }
    },
    "conditions": {}
}
