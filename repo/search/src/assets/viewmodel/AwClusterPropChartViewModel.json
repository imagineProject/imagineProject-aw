{
    "schemaVersion": "1.0.0",
    "actions": {
        "getChartDataActionForMultipleSeries": {
            "actionType": "JSFunction",
            "method": "createPieChart",
            "inputData": {
                "currentPropToRender": "{{props.prop}}",
                "searchResults": "{{props.objects}}"
            },
            "outputData": {
                "chartProviders.pieChartProvider.chartPoints": ""
            },
            "deps": "js/SS1ClusterDetailsChartUtils"
        },
        "loadCurrentGraph": {
            "actionType": "JSFunction",
            "method": "createPieChart",
            "inputData": {
                "currentPropToRender": "{{props.prop}}",
                "searchResults": "{{props.objects}}"
            },
            "outputData": {
                "clusterDetailsChartProvider_chartPoints": ""
            },
            "deps": "js/SS1ClusterDetailsChartUtils"
        },
        "buildChartTitle": {
            "actionType": "JSFunction",
            "method": "buildChartTitle",
            "inputData": {
                "currentPropToRender": "{{props.prop}}",
                "searchResults": "{{props.objects}}"
            },
            "outputData": {
                "chartTitle": ""
            },
            "deps": "js/SS1ClusterDetailsChartUtils"
        },
        "loadGraphAndBuildTitleBatchAction": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "loadCurrentGraph"
                },
                {
                    "action": "buildChartTitle"
                }
            ]
        }
    },
    "data": {
        "chartTitle": "",
        "clusterDetailsChartProvider_chartPoints": []
    },
    "conditions": {},
    "onEvent": [],
    "chartProviders": {
        "clusterDetailsChartProvider": {
            "chartType": "pie",
            "loadDataAction": "getChartDataActionForMultipleSeries",
            "chartConfig": {
                "isChartZoomable": true,
                "isYAxisLinearOrLogarithmic": "logarithmic",
                "xAxisLabel": "",
                "yAxisLabel": "",
                "isDataLabelOnChartEnabled": true
            }
        }
    },
    "lifecycleHooks": {
        "onMount": "loadGraphAndBuildTitleBatchAction",
        "onUpdate": {
            "action": "loadGraphAndBuildTitleBatchAction",
            "observers": [ "props.objects" ]
        }
    },
    "props": {
        "prop": {
            "type": "string"
        },
        "objects": {
            "type": "array"
        }
    }
}
