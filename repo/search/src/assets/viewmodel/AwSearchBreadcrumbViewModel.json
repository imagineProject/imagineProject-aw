{
    "schemaVersion": "1.0.0",
    "imports": [],
    "lifecycleHooks": {
        "onMount": "buildTitle",
        "onUpdate": [
            {
                "action": "buildTitle",
                "observers": [
                    "props.subPanelContext.searchState"
                ]
            }
        ]
    },
    "data": {
        "crumbTitle": null
    },
    "actions": {
        "selectSeedItem": {
            "actionType": "JSFunction",
            "method": "setSelection",
            "inputData": {
                "selectionModel": "",
                "newSelection": "{{ctx.shapeSearch.geolusCriteria}}"
            },
            "deps": "js/selectionModelFactory"
        },
        "buildTitle": {
            "actionType": "JSFunctionAsync",
            "method": "buildTitle",
            "inputData": {
                "searchObject": "{{props.subPanelContext.searchState}}"
            },
            "outputData": {
                "crumbTitle": ""
            },
            "deps": "js/AwSearchBreadcrumbUtils"
        }
    },
    "onEvent": [],
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "conditions": {
        "showTooltipForNLP": {
            "expression": "ctx.preferences.TC_AI_natural_language_search[0].toString().toLowerCase() === 'true'"
        },
        "summaryIntentExists": {
            "expression": "props.subPanelContext && props.subPanelContext.searchState && props.subPanelContext.searchState.additionalSearchInfoMap && props.subPanelContext.searchState.additionalSearchInfoMap.summaryIntent && props.subPanelContext.searchState.additionalSearchInfoMap.summaryIntent.length > 0"
        },
        "summaryIntentDoesNotExist": {
            "expression": "props.subPanelContext && props.subPanelContext.searchState && props.subPanelContext.searchState.additionalSearchInfoMap && props.subPanelContext.searchState.additionalSearchInfoMap.summaryIntent && props.subPanelContext.searchState.additionalSearchInfoMap.summaryIntent.length === 0 || props.subPanelContext && props.subPanelContext.searchState && !props.subPanelContext.searchState.additionalSearchInfoMap || props.subPanelContext && props.subPanelContext.searchState && props.subPanelContext.searchState.additionalSearchInfoMap && !props.subPanelContext.searchState.additionalSearchInfoMap.summaryIntent"
        }
    }
}
