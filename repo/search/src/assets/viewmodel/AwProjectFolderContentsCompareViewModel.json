{
    "schemaVersion": "1.0.0",
    "actions": {
        "updateSelectAll": {
            "actionType": "JSFunction",
            "method": "updateSelectAll",
            "inputData": {
                "searchFolder": "{{subPanelContext.searchFolder}}"
            },
            "deps": "js/Awp0SearchFolderOverviewService"
        },
        "updateMultiSelectEnabled": {
            "actionType": "JSFunction",
            "method": "updateMultiSelectEnabled",
            "inputData": {
                "searchFolder": "{{subPanelContext.searchFolder}}"
            },
            "deps": "js/Awp0SearchFolderOverviewService"
        },
        "updateMultiSelect": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "plTableClientRefresh"
                },
                {
                    "action": "updateMultiSelectEnabled"
                }
            ]
        },
        "doArrangeEvent": {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "doGridDataProvider": {
            "actionType": "dataProvider",
            "method": "gridDataProvider"
        },
        "resetColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [ {
                        "scope": "LoginUser",
                        "scopeName": "",
                        "clientName": "AWClient",
                        "resetColumnConfig": true,
                        "columnConfigQueryInfos": [ {
                            "clientScopeURI": "Awp0MyActiveFolders",
                            "operationType": "union",
                            "typeNames": "{{function:getTypeNames}}",
                            "columnsToExclude": []
                        } ],
                        "businessObjects": [
                            {}
                        ]
                    } ]
                }
            },
            "outputData": {
                "dataProviders.gridDataProvider.columnConfig": "columnConfigurations[0].columnConfigurations[0]",
                "dataProviders.gridDataProvider.columnConfig.typesForArrange": "{{function:getTypeNames}}"
            },
            "events": {
                "success": [ {
                    "name": "gridView.plTable.reload"
                } ]
            }
        },
        "saveColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseSaveUiColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigurations": [ {
                        "clientScopeURI": "Awp0MyActiveFolders",
                        "columnConfigId": "{{data.dataProviders.gridDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.gridDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    } ]
                }
            },
            "outputData": {}
        },
        "saveColumnConfigLoadData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Awp0MyActiveFolders",
                        "operationType": "union"
                    },
                    "saveColumnConfigData": {
                        "clientScopeURI": "Awp0MyActiveFolders",
                        "columnConfigId": "{{data.dataProviders.gridDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.gridDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "attributesToInflate": "{{ctx.search.tableViewProperties}}",
                        "maxToLoad": "{{function:getDefaultPageSize}}",
                        "maxToReturn": "{{function:getDefaultPageSize}}",
                        "providerName": "Awp0ProjectFolderProvider",
                        "searchCriteria": {
                            "parentUid": "{{data.uid}}"
                        },
                        "searchFilterFieldSortType": "Alphabetical",
                        "searchSortCriteria": [],
                        "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}",
                        "cursor": {
                            "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}",
                            "endIndex": "{{data.dataProviders.gridDataProvider.endIndex}}",
                            "startReached": "{{data.dataProviders.gridDataProvider.startReached}}",
                            "endReached": "{{data.dataProviders.gridDataProvider.endReached}}"
                        }
                    },
                    "inflateProperties": true
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "output": "{{function:processOutput}}"
            }
        },
        "loadTableData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Awp0MyActiveFolders",
                        "operationType": "union"
                    },
                    "searchInput": {
                        "attributesToInflate": "{{ctx.search.tableViewProperties}}",
                        "maxToLoad": "{{function:getDefaultPageSize}}",
                        "maxToReturn": "{{function:getDefaultPageSize}}",
                        "providerName": "Awp0ProjectFolderProvider",
                        "searchCriteria": {
                            "parentUid": "{{data.uid}}"
                        },
                        "searchFilterFieldSortType": "Alphabetical",
                        "searchSortCriteria": [],
                        "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}",
                        "cursor": {
                            "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}",
                            "endIndex": "{{data.dataProviders.gridDataProvider.endIndex}}",
                            "startReached": "{{data.dataProviders.gridDataProvider.startReached}}",
                            "endReached": "{{data.dataProviders.gridDataProvider.endReached}}"
                        }
                    },
                    "inflateProperties": true
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "output": "{{function:processOutput}}"
            },
            "events": {
                "success": [ {
                    "name": "aw.tableDataLoaded"
                } ]
            }
        },
        "plTableClientRefresh": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "gridView.plTable.clientRefresh"
                } ]
            }
        },
        "loadProjectSubFolderProperties": {
            "actionType": "TcSoaService",
            "serviceName": "Core-2006-03-DataManagement",
            "method": "getProperties",
            "inputData": {
                "objects": [ {
                    "uid": "{{ctx.xrtSummaryContextObject.uid}}",
                    "type": "Awp0ProjectSubFolder"
                } ],
                "attributes": [
                    "awp0SearchFolder"
                ]
            },
            "outputData": {
                "callDataProvider": "{{function:setSearchFolderObjectinState}}"
            },
            "policy": {
                "types": [ {
                    "name": "Awp0SearchFolder",
                    "properties": [ {
                            "name": "awp0Rule"
                        },
                        {
                            "name": "awp0SearchType"
                        },
                        {
                            "name": "awp0CanExecuteSearch"
                        }
                    ]
                } ]
            },
            "deps": "js/projectFolderUtils"
        },
        "refreshDataProvider": {
            "actionType": "JSFunction",
            "method": "refreshDataProvider",
            "inputData": {
                "dataProvider": "{{dataProviders.gridDataProvider}}"
            },
            "deps": "js/projectFolderUtils"
        }
    },
    "onEvent": [ {
            "eventId": "gridDataProvider.selectAll",
            "action": "updateSelectAll"
        },
        {
            "eventId": "gridDataProvider.selectNone",
            "action": "updateSelectAll"
        },
        {
            "eventId": "primaryWorkarea.multiSelectAction",
            "action": "plTableClientRefresh"
        },
        {
            "eventId": "columnArrange",
            "cacheEventData": true,
            "action": "doArrangeEvent"
        },
        {
            "eventId": "Awp0SearchFolderContentsTable.refreshTable",
            "action": "plTableClientRefresh"
        },
        {
            "eventId": "cdm.relatedModified",
            "action": "refreshDataProvider",
            "cacheEventData": true
        }
    ],

    "dataProviders": {
        "gridDataProvider": {
            "action": "loadTableData",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "selectionModelMode": "multiple",
            "inputData": {
                "selectionModel": "{{subPanelContext.selectionModel}}",
                "selectionData": "{{subPanelContext.selectionData}}"
            },
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands"
        }
    },
    "columnProviders": {
        "clientScopeUI": {
            "saveColumnAndLoadAction": "saveColumnConfigLoadData",
            "saveColumnAction": "saveColumnConfig",
            "resetColumnAction": "resetColumnConfig",
            "sortCriteria": "{{ctx.sublocation.sortCriteria}}"
        }
    },
    "grids": {
        "gridView": {
            "dataProvider": "gridDataProvider",
            "columnProvider": "clientScopeUI",
            "enableArrangeMenu": true,
            "gridOptions": {
                "enableGridMenu": true,
                "enableExpandAndPaginationInEdit": true,
                "isFilteringEnabled": false,
                "enableSaveSortCriteria": false
            }
        }
    },
    "data": {
        "uid": "{{subPanelContext.selected.uid}}"
    },
    "lifecycleHooks": {
        "onMount": "loadProjectSubFolderProperties"
    },
    "functions": {
        "setSearchFolderObjectinState": {
            "functionName": "setSearchFolderObjectinState",
            "parameters": [
                "{{subPanelContext.searchFolder}}"
            ]
        },
        "processOutput": {
            "functionName": "processOutput1",
            "parameters": [
                "{{data}}",
                "{{subPanelContext.searchFolder}}"
            ],
            "deps": "js/Awp0SearchFolderOverviewService"
        },
        "getDefaultPageSize": {
            "functionName": "getDefaultPageSize",
            "parameters": [
                "{{ctx.preferences.AWC_DefaultPageSize}}"
            ],
            "deps": "js/Awp0SearchFolderOverviewService"
        },
        "getValidColumnConfig": {
            "functionName": "getValidColumnConfig",
            "parameters": [
                "{{data.dataProviders.gridDataProvider.columnConfig}}"
            ]
        },
        "getTypeNames": {
            "functionName": "getTypeNames",
            "parameters": [
                "{{ctx.searchResponseInfo.searchFilterMap}}"
            ],
            "deps": "js/tcarrange.service"
        },
        "getSearchFolderContentsSortCriteria": {
            "functionName": "getSearchFolderContentsSortCriteria",
            "parameters": [
                "{{data.columnProviders.clientScopeUI.sortCriteria}}",
                "{{subPanelContext.searchFolder.clientScopeURI}}",
                "{{subPanelContext.searchFolder.columnConfig}}"
            ]
        },
        "setExportPanelContextForSearchFolder1": {
            "functionName": "setExportPanelContextForSearchFolder1",
            "parameters": [
                "{{data}}",
                "{{dataProviders}}"
            ]
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
