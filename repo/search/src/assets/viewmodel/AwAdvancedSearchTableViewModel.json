{
    "schemaVersion": "1.0.0",
    "actions": {
        "initDataProvider": {
            "actionType": "dataProvider",
            "method": "gridDataProvider"
        },
        "initSearch": {
            "actionType": "JSFunction",
            "method": "initSearch",
            "inputData": {
                "data": "{{data.actions}}",
                "actionName": "initDataProvider",
                "tableLoaded": "{{data.tableLoaded}}"
            },
            "deps": "js/awSearchService"
        },
        "doArrangeEvent": {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "resetColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [
                        {
                            "scope": "LoginUser",
                            "scopeName": "",
                            "clientName": "AWClient",
                            "resetColumnConfig": true,
                            "columnConfigQueryInfos": [
                                {
                                    "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}",
                                    "operationType": "intersection",
                                    "typeNames": "{{function:getTypeNames}}",
                                    "columnsToExclude": []
                                }
                            ],
                            "businessObjects": [
                                {}
                            ]
                        }
                    ]
                }
            },
            "outputData": {
                "dataProviders.gridDataProvider.columnConfig": "columnConfigurations[0].columnConfigurations[0]",
                "dataProviders.gridDataProvider.columnConfig.typesForArrange": "{{function:getTypeNames}}"
            }
        },
        "saveColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseSaveUiColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigurations": [
                        {
                            "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}",
                            "columnConfigId": "{{data.dataProviders.gridDataProvider.columnConfig.columnConfigId}}",
                            "columns": "{{data.dataProviders.gridDataProvider.newColumns}}",
                            "scope": "LoginUser",
                            "scopeName": ""
                        }
                    ]
                }
            },
            "outputData": {}
        },
        "saveColumnConfigLoadData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "operationType": "{{data.eventMap['columnArrange'].operationType}}",
                        "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}"
                    },
                    "saveColumnConfigData": {
                        "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}",
                        "columnConfigId": "{{data.dataProviders.gridDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.gridDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "maxToLoad": 50,
                        "maxToReturn": 50,
                        "providerName": "Awp0SavedQuerySearchProvider",
                        "searchCriteria": "{{function:getSearchCriteria}}",
                        "searchFilterFieldSortType": "{{subPanelContext.searchState.sortType}}",
                        "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                        "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}",
                        "startIndex": "{{function:getAdvancedSearchStartIndex}}"
                    },
                    "inflateProperties": true
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "{{function:processAdvancedSearchColumns}}",
                "tableLoaded": true,
                "output": "{{function:processOutput}}"
            }
        },
        "loadAdvancedSearchDataBatchJob": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "loadAdvancedSearchData"
                },
                {
                    "action": "selectFirstItem",
                    "condition": "data.selectFirstObject"
                }
            ]
        },
        "loadAdvancedSearchData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}",
                        "operationType": "{{data.dataProviders.gridDataProvider.columnConfig.operationType}}"
                    },
                    "saveColumnConfigData": {
                        "columnConfigId": "",
                        "clientScopeURI": "",
                        "columns": [],
                        "scope": "",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "maxToLoad": "{{function:getDefaultPageSize}}",
                        "maxToReturn": "{{function:getDefaultPageSize}}",
                        "providerName": "Awp0SavedQuerySearchProvider",
                        "searchCriteria": "{{function:getSearchCriteria}}",
                        "searchFilterFieldSortType": "Priority",
                        "startIndex": "{{function:getAdvancedSearchStartIndex}}",
                        "searchFilterMap6": "",
                        "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}"
                    },
                    "inflateProperties": true
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "{{function:processAdvancedSearchColumns}}",
                "tableLoaded": true,
                "selectFirstObject": "{{function:processSelectionOfFirstObject}}",
                "output": "{{function:processOutput}}"
            },
            "events": {
                "success": [
                    {
                        "name": "aw.tableDataLoaded"
                    }
                ]
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "loadAdvancedSearchDataFailure"
                    }
                ]
            }
        },
        "selectFirstItem": {
            "actionType": "JSFunction",
            "method": "setSelection",
            "inputData": {
                "selectionModel": "{{data.dataProviders.gridDataProvider.selectionModel}}",
                "newSelection": "{{data.searchResults.objects[0].uid}}"
            },
            "deps": "js/selectionModelFactory"
        },
        "plTableClientRefresh": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "gridView.plTable.clientRefresh"
                    }
                ]
            }
        },
        "startEditForNewVmos": {
            "actionType": "JSFunction",
            "method": "startEditForNewVmos",
            "inputData": {
                "editContext": "{{data.dataProviders.gridDataProvider.json.editContext}}"
            },
            "deps": "js/editEventsService"
        },
        "invokeSaveEditsCommand": {
            "actionType": "Command",
            "inputData": {
                "commandId": "Awp0SaveEditsPWA"
            }
        },
        "advancedSearchLinkCommand": {
            "actionType": "JSFunctionAsync",
            "deps": "js/command.service",
            "method": "executeCommand",
            "inputData": {
                "0": "Awp0AdvancedSearch",
                "1": "",
                "2": "",
                "3": "{{subPanelContext}}",
                "4": "{{parameters.commandActionExecutor.runActionWithViewModel}}"
            }
        }
    },
    "functions": {
        "processSelectionOfFirstObject": {
            "functionName": "processSelectionOfFirstObject",
            "parameters": [
                "AWC_select_firstobject_inSearchLocation"
            ],
            "deps": "js/advancedSearchService"
        },
        "getDefaultPageSize": {
            "functionName": "getDefaultPageSize",
            "parameters": [
                "{{ctx.preferences.AWC_DefaultPageSize}}"
            ],
            "deps": "js/advancedSearchService"
        },
        "getSearchCriteria": {
            "functionName": "getSearchCriteria",
            "parameters": [
                "{{data.dataProviders.gridDataProvider.startIndex}}",
                "{{subPanelContext.searchState}}"
            ],
            "deps": "js/advancedSearchService"
        },
        "getTypeNames": {
            "functionName": "getTypeNames",
            "parameters": [
                "{{subPanelContext.searchState.searchFilterMap}}"
            ],
            "deps": "js/tcarrange.service"
        },
        "processOutput": {
            "functionName": "processOutput",
            "parameters": [
                "{{subPanelContext.searchState}}"
            ],
            "deps": "js/advancedSearchService"
        },
        "getAdvancedSearchStartIndex": {
            "functionName": "getAdvancedSearchStartIndex",
            "parameters": [
                "{{subPanelContext.searchState.advancedSearchCriteria.lastEndIndex}}"
            ],
            "deps": "js/advancedSearchService"
        },
        "processAdvancedSearchColumns": {
            "functionName": "processAdvancedSearchColumns",
            "parameters": [],
            "deps": "js/advancedSearchService"
        }
    },
    "dataProviders": {
        "gridDataProvider": {
            "action": "loadAdvancedSearchDataBatchJob",
            "editContext": "TABLE_CONTEXT",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "selectionModelMode": "multiple",
            "inputData": {
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands"
        }
    },
    "columnProviders": {
        "clientScopeUI": {
            "saveColumnAndLoadAction": "saveColumnConfigLoadData",
            "saveColumnAction": "saveColumnConfig",
            "resetColumnAction": "resetColumnConfig",
            "sortCriteria": "{{ctx.sublocation.sortCriteria}}"
        }
    },
    "grids": {
        "gridView": {
            "dataProvider": "gridDataProvider",
            "columnProvider": "clientScopeUI",
            "enableArrangeMenu": true,
            "gridOptions": {
                "enableGridMenu": true,
                "enableExpandAndPaginationInEdit": true,
                "isFilteringEnabled": false
            }
        }
    },
    "conditions": {
        "showTable": {
            "expression": "subPanelContext.searchState.criteria !== undefined"
        }
    },
    "onEvent": [
        {
            "eventId": "columnArrange",
            "cacheEventData": true,
            "action": "doArrangeEvent"
        },
        {
            "eventId": "primaryWorkarea.multiSelectAction",
            "action": "plTableClientRefresh"
        },
        {
            "eventId": "gridDataProvider.startEditForNewVmosRequested",
            "action": "startEditForNewVmos"
        },
        {
            "eventId": "saveEditsRequested",
            "action": "invokeSaveEditsCommand"
        }
    ],
    "i18n": {
        "noFiltersFound": [
            "SearchMessages"
        ],
        "advancedSearch": [
            "SearchMessages"
        ],
        "nothingFound": [
            "SearchMessages"
        ],
        "noResultsFound": [
            "SearchMessages"
        ],
        "emptySearchAreaHint": [
            "SearchMessages"
        ],
        "noResultsSearchAreaHint": [
            "SearchMessages"
        ]
    },
    "messages": {
        "loadAdvancedSearchDataFailure": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },
    "data": {
        "tableLoaded": false
    },
    "lifecycleHooks": {
        "onUpdate": {
            "action": "initSearch",
            "observers": [
                "props.subPanelContext.searchState.advancedSearchJSONString"
            ]
        }
    }
}
