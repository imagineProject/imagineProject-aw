{
    "schemaVersion": "1.0.0",
    "imports": [],
    "actions": {
        "initialize" : {
            "actionType": "JSFunction",
            "method": "updateAtomicDataValue",

            "inputData": {
                "AtomicObj": "{{props.subPanelContext.searchState}}",
                "value": {
                    "searchFilterPopupId": "{{subPanelContext.popupOptions.popupId}}"
                }
            },
            "deps": "js/addObjectUtils"
        },
        "reInitialize": {
            "actionType": "JSFunction",
            "method": "updateAtomicDataValue",

            "inputData": {
                "AtomicObj": "{{props.subPanelContext.searchState}}",
                "value": {
                    "searchFilterPopupId": null
                }
            },
            "deps": "js/addObjectUtils"
        }
    },
    "data": {
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "hide-title": {
            "type": "object"
        }
    },
    "functions": {
    },
    "lifecycleHooks": {
        "onMount": "initialize",
        "onUnmount":"reInitialize"
    },
    "onEvent": [
    ],
    "messages": {
    },
    "conditions": {
    },
    "i18n": {
        "filterString": [ "SearchMessages" ]
    }
}
