{
    "schemaVersion": "1.0.0",
    "actions": {
        "loadClusterDetails": {
            "actionType": "JSFunctionAsync",
            "method": "loadClusterDetails",
            "inputData": {
                "columnConfigInput": {
                    "clientName": "AWClient",
                    "clientScopeURI": "Awp0ShapeSearchResults",
                    "operationType": "",
                    "columnsToExclude":[]
                },
                "saveColumnConfigData": {
                    "columnConfigId": "",
                    "clientScopeURI": "",
                    "columns": [],
                    "scope": "",
                    "scopeName": ""
                },
                "searchInput": {
                    "internalPropertyName": "",
                    "maxToLoad": "{{function:getClusterDetailsDefaultPageSize}}",
                    "maxToReturn": "{{function:getClusterDetailsDefaultPageSize}}",
                    "providerName": "SS1IdentityReportProvider",
                    "searchCriteria": "{{function:getClusterDetailsSearchCriteria}}",
                    "searchFilterFieldSortType": "{{ctx.search.sortType}}",
                    "searchFilterMap6": "",
                    "searchSortCriteria": "{{function:getClusterDetailsSortCriteria}}",
                    "startIndex": 0
                }
            },
            "outputData": {
                "totalFound": "{{function:getActualTotalFoundForClusterDetails}}",
                "totalLoaded": "totalLoaded",
                "tableLoaded": true,
                "searchResults": "{{function:updateClusterDetailsTableWithSortedResults}}",
                "dataProviders.clusterDetailsGridDataProvider.columnConfig": "columnConfig"
            },
            "deps": "js/SS1ClusterSearchService"
        },
        "doArrangeEvent": {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "resetColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [ {
                        "scope": "LoginUser",
                        "scopeName": "",
                        "clientName": "AWClient",
                        "resetColumnConfig": true,
                        "columnConfigQueryInfos": [ {
                            "clientScopeURI": "Awp0SearchResults",
                            "operationType": "intersection",
                            "typeNames": "{{function:getTypeNames}}",
                            "columnsToExclude": []
                        } ],
                        "businessObjects": [
                            {}
                        ]
                    } ]
                }
            },
            "outputData": {
                "dataProviders.clusterDetailsGridDataProvider.columnConfig": "columnConfigurations[0].columnConfigurations[0]",
                "dataProviders.clusterDetailsGridDataProvider.columnConfig.typesForArrange": "{{function:getTypeNames}}"
            }
        },
        "saveColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseSaveUiColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigurations": [ {
                        "clientScopeURI": "Awp0SearchResults",
                        "columnConfigId": "{{data.dataProviders.clusterDetailsGridDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.clusterDetailsGridDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    } ]
                }
            },
            "outputData": {}
        },
        "saveColumnConfigLoadData": {
            "actionType": "JSFunctionAsync",
            "method": "loadData",
            "inputData": {
                "columnConfigInput": {
                    "clientName": "AWClient",
                    "operationType": "{{data.eventMap['columnArrange'].operationType}}",
                    "clientScopeURI": "Awp0SearchResults"
                },
                "saveColumnConfigData": {
                    "clientScopeURI": "Awp0SearchResults",
                    "columnConfigId": "{{data.dataProviders.clusterDetailsGridDataProvider.columnConfig.columnConfigId}}",
                    "columns": "{{data.dataProviders.clusterDetailsGridDataProvider.newColumns}}",
                    "scope": "LoginUser",
                    "scopeName": ""
                },
                "searchInput": {
                    "internalPropertyName": "{{function:getInternalPropertyName}}",
                    "maxToLoad": "{{function:getDefaultPageSize}}",
                    "maxToReturn": "{{function:getDefaultPageSize}}",
                    "providerName": "{{subPanelContext.searchState.provider}}",
                    "searchCriteria": "{{subPanelContext.searchState.criteria}}",
                    "searchFilterFieldSortType": "Priority",
                    "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                    "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}",
                    "cursor": {
                        "startIndex": "{{data.dataProviders.clusterDetailsGridDataProvider.startIndex}}"
                    }
                }
            },
            "outputData": {
                "totalFound": "{{function:getActualTotalFound}}",
                "totalLoaded": "totalLoaded",
                "tableLoaded": true,
                "searchResults": "{{function:getVMOsWithColoring}}",
                "dataProviders.clusterDetailsGridDataProvider.columnConfig": "columnConfig",
                "highlighter": "{{function:getHighlightKeywords}}",
                "selectFirstObject": "{{function:processSelectionOfFirstObject}}",
                "output": "{{function:processShapeClusterSearchOutput}}"
            },
            "deps": "js/awSearchService"
        },
        "refreshClusterDetailsTable": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "clusterDetailsGridView.plTable.reload"
                    }
                ]
            }
        },
        "loadGraphs": {
            "actionType": "JSFunctionAsync",
            "method": "loadGraphs",
            "outputData": {
                "allGraphProps": ""
            },
            "deps": "js/SS1ClusterDetailsChartUtils"
        }
    },
    "functions": {
        "processClusterDetailsOutput": {
            "functionName": "processClusterDetailsOutput",
            "parameters": [
                "{{data}}",
                "{{subPanelContext.searchState}}"
            ]
        },
        "getClusterDetailsDefaultPageSize": {
            "functionName": "getClusterDetailsDefaultPageSize",
            "parameters": [
                "{{ctx.preferences.AWC_DefaultPageSize}}"
            ]
        },
        "getClusterDetailsSearchCriteria": {
            "functionName": "getClusterDetailsSearchCriteria",
            "parameters": [
                "{{data.eventData}}"
            ]
        },
        "getClusterDetailsSortCriteria": {
            "functionName": "getClusterDetailsSortCriteria",
            "parameters": [
                "{{data.columnProviders.clientScopeUI.sortCriteria}}"
            ]
        },
        "getActualTotalFoundForClusterDetails": {
            "functionName": "getActualTotalFoundForClusterDetails",
            "parameters": [
                "{{data}}"
            ]
        },
        "getVMOsWithClusterDetailsColoring": {
            "functionName": "getVMOsWithClusterDetailsColoring",
            "parameters": [
                "{{subPanelContext.searchState.showChartColorBars}}"
            ]
        },
        "updateClusterDetailsTableWithSortedResults": {
            "functionName": "updateClusterDetailsTableWithSortedResults",
            "parameters": [
                "{{ctx.sublocation.sortCriteria}}"
            ]
        },
        "getTypeNames": {
            "functionName": "getTypeNames",
            "parameters": [],
            "deps": "js/tcarrange.service"
        }
    },
    "columnProviders": {
        "clientScopeUI": {
            "saveColumnAndLoadAction": "saveColumnConfigLoadData",
            "saveColumnAction": "saveColumnConfig",
            "resetColumnAction": "resetColumnConfig",
            "sortCriteria": "{{ctx.sublocation.sortCriteria}}"
        }
    },
    "grids": {
        "clusterDetailsGridView": {
            "dataProvider": "clusterDetailsGridDataProvider",
            "columnProvider": "clientScopeUI",
            "enableArrangeMenu": true,
            "gridOptions": {
                "enableGridMenu": true,
                "enableExpandAndPaginationInEdit": true,
                "enableSorting": true
            }
        }
    },
    "dataProviders": {
        "clusterDetailsGridDataProvider": {
            "action": "loadClusterDetails",
            "editContext": "TABLE_CONTEXT",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "selectionModelMode": "Single",
            "inputData": {
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands"
        }
    },
    "onEvent": [
        {
            "eventId": "primaryWorkArea.selectionChangeEvent",
            "cacheEventData": true,
            "action": "refreshClusterDetailsTable"
        },
        {
            "eventId": "columnArrange",
            "cacheEventData": true,
            "action": "refreshClusterDetailsTable",
            "condition": "name === 'clusterDetailsGridView'"
        }
    ],
    "lifecycleHooks": {
        "onMount": "loadGraphs"
    },
    "messages": {
    },
    "i18n": {
        "clusterSearchGraphPropertiesLabel": ["ClusterSearchMessages"],
        "clusterSearchReplacementsLabel": ["ClusterSearchMessages"]
    },
    "data": {
        "tableLoaded": false,
        "searchResults": [],
        "allGraphProps": ""
    }
}
