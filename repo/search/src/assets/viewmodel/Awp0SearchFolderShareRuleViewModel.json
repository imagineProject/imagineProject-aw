{
    "schemaVersion": "1.0.0",
    "actions": {
        "performWriteAccessPrivilegeCheck": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-AWS2-2020-05-FullTextSearch",
            "method": "getSearchSettings",
            "inputData": {
                "searchSettingInput": {
                    "inputSettings": {
                        "performAccessCheckOnActiveFolder": [
                            "{{ctx.xrtSummaryContextObject.uid}}"
                        ]
                    }
                }
            },
            "outputData": {
                "showAddRemoveButtons": "{{function:hasWriteAccessPrivilege}}"
            },
            "deps": "js/Awp0SearchFolderShareRuleService"
        },
        "handleProjectTableSelection": {
            "actionType": "JSFunction",
            "method": "disableButton2",
            "inputData": {
                "buttonName": "remove",
                "selectionData": "{{data.projectTableSelectionData}}",
                "searchFolderShareRuleState": "{{data.searchFolderShareRuleState}}",
                "selectionDataUpdater": "{{data.updateAtomicData}}"
            },
            "deps": "js/Awp0SearchFolderShareRuleService"
        },
        "handleOrgTreeSelection": {
            "actionType": "JSFunction",
            "method": "disableButton2",
            "inputData": {
                "buttonName": "remove",
                "selectionData": "{{data.orgTreeSelectionData}}",
                "searchFolderShareRuleState": "{{data.searchFolderShareRuleState}}",
                "selectionDataUpdater": "{{data.updateAtomicData}}"
            },
            "deps": "js/Awp0SearchFolderShareRuleService"
        },
        "updateOrgTreeSelectionAfterSearchFolderShareRuleStateUpdate": {
            "actionType": "JSFunction",
            "method": "updateOrgTreeSelectionAfterSearchFolderShareRuleStateUpdate",
            "inputData": {
                "selectionData": "{{data.orgTreeSelectionData}}",
                "searchFolderShareRuleState": "{{data.searchFolderShareRuleState}}",
                "selectionDataUpdater": "{{data.updateAtomicData}}"
            },
            "deps": "js/Awp0SearchFolderShareRuleService"
        },
        "disableAddButton": {
            "actionType": "JSFunction",
            "method": "disableButton2",
            "inputData": {
                "buttonName": "add",
                "selectionData": "{{data.accessorTableSelectionData}}",
                "searchFolderShareRuleState": "{{data.searchFolderShareRuleState}}",
                "selectionDataUpdater": "{{data.updateAtomicData}}"
            },
            "deps": "js/Awp0SearchFolderShareRuleService"
        }
    },
    "onEvent": [],
    "data": {
        "searchFolderShareRuleOption": {
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": true,
            "propertyRadioTrueText": "{{i18n.organization}}",
            "propertyRadioFalseText": "{{i18n.projects}}",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "searchFolderShareRuleState": {
            "initialValues": {
                "disableAddButton": true,
                "disableRemoveButton": true
            },
            "meta": {
            }
        },
        "projectTableSelectionData": {
            "initialValues": {},
            "meta": {}
        },
        "orgTreeSelectionData": {
            "initialValues": {},
            "meta": {}
        },
        "accessorTableSelectionData": {
            "initialValues": {},
            "meta": {}
        }
    },
    "functions": {
        "hasWriteAccessPrivilege": {
            "functionName": "hasWriteAccessPrivilege",
            "parameters": []
        }
    },
    "dataProviders": {},
    "columnProviders": {},
    "grids": {},
    "dataParseDefinitions": {},
    "lifecycleHooks": {
        "onMount": "performWriteAccessPrivilegeCheck",
        "onUpdate": [
            {
                "action": "handleOrgTreeSelection",
                "observers": [ "viewModel.orgTreeSelectionData.selected" ]
            },
            {
                "action": "handleProjectTableSelection",
                "observers": [ "viewModel.projectTableSelectionData.selected" ]
            },
            {
                "action": "updateOrgTreeSelectionAfterSearchFolderShareRuleStateUpdate",
                "observers": [
                    "props.searchFolderShareRuleState"
                ]
            },
            {
                "action": "disableAddButton",
                "observers": [ "props.searchFolderShareRuleState.accessorsString", "viewModel.accessorTableSelectionData.selected" ]
            }
        ]
    },
    "messages": {},
    "conditions": {},
    "i18n": {
        "organization": [
            "SearchMessages"
        ],
        "projects": [
            "SearchMessages"
        ],
        "availableTable": [
            "SearchMessages"
        ],
        "sharedWithTable": [
            "SearchMessages"
        ]
    }
}
