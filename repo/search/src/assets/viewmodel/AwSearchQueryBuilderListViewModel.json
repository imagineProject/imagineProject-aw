{
    "schemaVersion": "1.0.0",
    "actions": {
        "initSearchListView": {
            "actionType": "JSFunction",
            "method": "initSearchListView",
            "inputData": {
                "subPanelContext": "{{subPanelContext}}",
                "provider": "{{data.dataProviders.queryBuildListProvider}}"
            },
            "outputData": {
                "queryBuildListProvider": ""
            },
            "deps": "js/awSearchService"
        },
        "initDataProvider": {
            "actionType": "dataProvider",
            "method": "queryBuildListProvider"
        },
        "selectFirstItemWithoutSaveAs": {
            "actionType": "JSFunction",
            "method": "setSelection",
            "inputData": {
                "selectionModel": "{{data.queryBuildListProvider.selectionModel}}",
                "newSelection": "{{data.searchResults.objects[0].uid}}"
            },
            "deps": "js/selectionModelFactory"
        },
        "selectFirstItemWithSaveAs": {
            "actionType": "JSFunctionAsync",
            "method": "setSelection",
            "inputData": {
                "selectionModel": "{{data.queryBuildListProvider.selectionModel}}",
                "newSelection": "{{props.subPanelContext.searchState.saveAsUid}}"
            },
            "deps": "js/selectionModelFactory"
        },
        "selectFirstItemWithSaveAsBatchJob": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "selectFirstItemWithSaveAs"
                },
                {
                    "action": "updateStateWithIsEditingXrt"
                }
               ]
        },
        "updateStateWithIsEditingXrt" : {
            "actionType": "JSFunction",
            "method": "updateAtomicDataValue",
            "inputData": {
                "AtomicObj": "{{props.subPanelContext.searchState}}",
                "value": {
                    "isEditingXrt": true
                }
            },
            "deps": "js/addObjectUtils"
        },
        "searchListViewLoadBatchJob": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "loadQueryData"
                },
                {
                    "action": "selectFirstItemWithSaveAsBatchJob",
                    "condition": "conditions.isValidToCreateQuery"
                },
                {
                    "action": "selectFirstItemWithoutSaveAs"
                }
            ]
        },
        "loadQueryData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "maxToLoad": "{{function:getDefaultPageSize}}",
                        "maxToReturn": "{{function:getDefaultPageSize}}",
                        "providerName": "{{subPanelContext.searchState.provider}}",
                        "searchCriteria": {
                            "searchString":"{{subPanelContext.searchState.criteria.searchString}}",
                            "newSavedQueryUid": "{{subPanelContext.searchState.saveAsUid}}",
                            "context": "queryBuilder"

                        },
                        "searchFilterMap6": "{{function:getQueryBuilderSearchFilterMap}}",
                        "cursor": {
                            "startIndex": "{{data.queryBuildListProvider.startIndex}}",
                            "endIndex": "{{data.queryBuildListProvider.endIndex}}",
                            "startReached": "{{data.queryBuildListProvider.startReached}}",
                            "endReached": "{{data.queryBuildListProvider.endReached}}"
                        }
                    },
                    "inflateProperties": false,
                    "noServiceData": false
                },
                "1": {
                    "types": [
                        {
                            "name": "BusinessObject",
                            "properties": [
                                {
                                    "name": "is_modifiable"
                                },
                                {
                                    "name": "query_class"
                                }
                            ]
                        }
                    ]
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "totalLoaded": "totalLoaded",
                "searchResults": "{{json:searchResultsJSON}}",
                "cursor": "cursor",
                "output": "{{function:processOutput}}"
            }
        },
        "updateSelectedQueryTypeValue": {
            "actionType": "JSFunctionAsync",
            "method": "updateSelectedQueryTypeValue",
            "inputData": {
                "searchState": "{{props.subPanelContext.searchState}}"
            },
            "outputData": {
                "selectedQueryType": ""
            },
            "deps": "js/AwSearchQueryBuilderService"
        },
        "activateCreateQueryDialog": {
            "actionType": "JSFunctionAsync",
            "deps": "js/command.service",
            "method": "executeCommand",
            "inputData": {
                "0": "Awp0CreateQueryCmd",
                "1": "",
                "2": "",
                "3": "{{subPanelContext}}",
                "4": "{{parameters.commandActionExecutor.runActionWithViewModel}}"
            }
        }
    },
    "functions": {
        "processOutput": {
            "functionName": "processOutput",
            "parameters": [
                "{{data}}",
                "{{subPanelContext.searchState}}"
            ],
            "deps": "js/AwSearchQueryBuilderService"
        },
        "getDefaultPageSize": {
            "functionName": "getDefaultPageSize",
            "parameters": [
                "{{ctx.preferences.AWC_DefaultPageSize}}"
            ],
            "deps": "js/AwSearchQueryBuilderService"
        },
        "getQueryBuilderSearchFilterMap": {
            "functionName": "getQueryBuilderSearchFilterMap",
            "parameters": [
                "{{data.selectedQueryType}}"
            ],
            "deps": "js/AwSearchQueryBuilderService"
        }
    },
    "dataProviders": {
        "queryBuildListProvider":{
            "action": "searchListViewLoadBatchJob",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "inputData": {
                "selectionModel": "{{subPanelContext.selectionModel}}",
                "selectionData": "{{subPanelContext.selectionData}}"
            },
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands"
        }
    },
    "conditions": {
        "isValidToCreateQuery":
        {
            "expression": "data.queryBuildListProvider.startIndex === 0 && props.subPanelContext.searchState.saveAsUid"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "data": {
        "selectedQueryType": ""
    },
    "lifecycleHooks": {
        "onMount": "initSearchListView",
        "onUpdate": [
            {
                "action": "initDataProvider",
                "observers": [
                    "props.subPanelContext.searchState.criteriaJSONString",
                    "props.subPanelContext.searchState.filterString",
                    "viewModel.data.selectedQueryType"
                ]
            },
            {
                "action": "updateSelectedQueryTypeValue",
                "observers": [
                    "props.subPanelContext.searchState.selectedQueryType"
                ]
            }
        ]
    },
    "i18n": {
        "noSavedSearch": [
            "SearchMessages"
        ],
        "noSavedSearchHint": [
            "SearchMessages"
        ],
        "NoQueriesText": [
            "SearchMessages"
        ],
        "NoQueriesHintText": [
            "SearchMessages"
        ],
        "Awp0CreateQuery": [
            "SearchMessages"
        ]
    }
}
