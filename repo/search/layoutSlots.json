{
  "slots": {
    "selectionSummaryHeaderPropertiesForProjectDesc": {
      "name": "aw_summaryHeaderProperties",
      "view": "ProjectSelectionSummaryHeader",
      "activeWhen": {
        "condition": "conditions.showSelectionSummaryHeadeProjectContents"
      }
    },
    "shapeSearchChangeContextChipSlot": {
      "name": "aw_changeContext",
      "view": "",
      "activeWhen": {
        "condition": "conditions.isChangeContextSlotInPricingCompanion"
      }
    },
    "shapeSearchSeparatorSlot": {
      "name": "aw_infoSite",
      "view": "",
      "activeWhen": {
        "condition": "conditions.isChangeContextSlotInPricingCompanion"
      }
    }
  },
  "conditions": {
    "showSelectionSummaryHeadeProjectContents": {
      "expression": "ctx.mselected && ctx.mselected.length === 1 && ctx.mselected[0].modelType.typeHierarchyArray.indexOf( 'Awp0ProjectDataFolder' ) > -1"
    },
    "isChangeContextSlotInPricingCompanion": {
      "expression": "ctx.workspace.workspaceId === 'PricingCompanionWorkspace' && ctx.preferences.CM_enable_global_change_context && ctx.preferences.CM_enable_global_change_context[0] === 'true'"
    }
  }
}
