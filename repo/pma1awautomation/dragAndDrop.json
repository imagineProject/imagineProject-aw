{
  "dragHandlers": {
    "dragHandlerForBOMGeneration": {
      "activeWhen": true,
      "views": [
        "CbaSplitTrgTree",
        "CbaSplitSrcTree"
      ],
      "dragActions": {
        "dragStart": "pmaDragStartFunc"
      }
    }
  },
  "dropHandlers": {
    "dropHandlerForBOMGeneration": {
      "activeWhen": true,
      "views": [
        "CbaSplitTrgTree",
        "CbaSplitSrcTree"
      ],
      "dropActions": {
        "dragOver": "pmaDragOverFunc",
        "drop": "pmaDropFunc"
      }
    }
  },
  "actions": {
    "pmaDragStartFunc": {
      "actionType": "syncFunction",
      "method": "handleDragStart",
      "inputData": {},
      "deps": "js/Pma1PasteHandlerService"
    },
    "pmaDragOverFunc": {
      "actionType": "syncFunction",
      "method": "handleDropEffectBasedOnSrcSelection",
      "inputData": {},
      "deps": "js/Pma1PasteHandlerService"
    },
    "pmaDropFunc": {
      "actionType": "syncFunction",
      "method": "prepareSourceAndTargetObjsAndInvokePaste",
      "inputData": {},
      "deps": "js/Pma1PasteHandlerService"
    }
  }
}
