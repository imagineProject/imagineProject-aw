  "data": {},
  "conditions": {
    "enableOpenNotificationForBOM": {
      "expression": "commandContext.group.groupName==='BOM'"
    },
    "isDesignStructure": {
      "expression": "commandContext.occContext.supportedFeatures.Awb0DesignStructureFeature === true"
    },
    "isPartStructure": {
      "expression": "commandContext.occContext.supportedFeatures.Awb0PartStructureFeature === true"
    },
    "isPrimarySelectionChangeRev": {
      "expression": "ctx.pselected && ctx.pselected.modelType.typeHierarchyArray.includes('ChangeItemRevision')"
    },
    "isAssyOrSubassyItemSelected": {
      "expression": "ctx.mselected[0].props.action.dbValues[0] === 'Modify' || ctx.mselected[0].props.action.dbValues[0] === 'New' || ( ctx.mselected[0].props.action.dbValues[0] === ' ' && ctx.mselected[0].children.length !==0 )"
    },
    "Pma1CBALaunchAlignTaskFromChangeCondition": {
      "expression": "conditions.EntCBALaunchAlignTaskCommandCondition && conditions.isPrimarySelectionChangeRev"
    },
    "isCBAPageInImpactAnalysisMode": {
      "expression": "conditions.isEntCBASubLocation && ctx.cadbomalignment.ImpactAnalysis.isImpactAnalysisMode && ctx.cadbomalignment.ImpactAnalysis && ctx.cadbomalignment.ImpactAnalysis.sourceTopItem"
    },
    "isCBAOrACEInImpactAnalysisMode": {
      "expression": "conditions.isCBAPageInImpactAnalysisMode && conditions.isOccurrenceManagementSubLocation"
    },
    "isUpdateChangesWithAlignmentCmdVisible": {
      "expression": "!(conditions.areMultipleObjectsSelected) && conditions.isTopSelected && !(conditions.isAlignedOrLinkedTargetSelected) && ((conditions.isPrimarySelectionChangeRev ) || !conditions.isPrimarySelectionChangeRev) && !conditions.isOccurrenceManagementSubLocation"
    },
    "areMultipleObjectsSelected": {
      "expression": "ctx.mselected && ctx.mselected.length > 1"
    },
    "isAlignedOrLinkedTargetSelected": {
      "expression": "ctx.relationContext && (ctx.relationContext.relationInfo[0].relationType === 'Fnd0AlignedPartsProvider' || ctx.relationContext.relationInfo[0].relationType === 'Fnd0AlignedDesignsProvider' || ctx.relationContext.relationInfo[0].relationType === 'Pma0DesignToBomLinkProvider')"
    },
    "isTopSelected": {
      "expression": "commandContext.occContext.topElement.uid === ctx.selected.uid || !commandContext.occContext"
    },
    "isProductBOMSelectedInACE": {
      "expression": "ctx.aceActiveContext.context.supportedFeatures.ProductEBOMFeature===true"
    },
    "isAlignmentExist": {
      "expression": "ctx.visibleServerCommands.Pma1AlignmentExists"
    },
    "isCreateAndUpdateBOMCommandVisible": {
      "expression": "conditions.EntCBALaunchAlignTaskCommandCondition && !(conditions.areMultipleObjectsSelected) && conditions.isTopSelected && !(conditions.isAlignedOrLinkedTargetSelected) && ((conditions.isPrimarySelectionChangeRev && conditions.isAssyOrSubassyItemSelected ) || !conditions.isPrimarySelectionChangeRev) && conditions.isAlignGroupCmdVisible"
    },
    "isCreateEBOMCommandVisible": {
      "expression": "conditions.isDesignStructure && conditions.isCreateAndUpdateBOMCommandVisible && !conditions.isAlignmentExist"
    },
    "isCreatePartEBOMCommandVisible": {
      "expression": "conditions.isCreateEBOMCommandVisible && !conditions.isEBOMFeatureInstalled"
    },
    "isCreateDesignBOMCommandVisible": {
      "expression": "(conditions.isPartStructure || conditions.isProductBOMSelectedInACE) && conditions.isCreateAndUpdateBOMCommandVisible && !conditions.isAlignmentExist"
    },
    "isActionableAssyOrSubAssySelected": {
      "expression": "ctx.mselected[0].props.action.dbValues[0] === 'Modify' || ctx.mselected[0].props.action.dbValues[0] === 'New' || ( ctx.mselected[0].props.action.dbValues[0] === ' ' && ctx.mselected[0].children.length !==0 )"
    },
    "isPma1AutomatedAndGuidedUpdateCmdVisible": {
      "expression": {
        "$or": [
          {
            "$and": [
              {
                "$source": "conditions.isOccurrenceManagementSubLocation",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "conditions.isAutomatedAndGuidedUpdateSupported",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "conditions.isEBOMFeatureInstalled",
                "$query": {
                  "$isNull": true
                }
              }
            ]
          },
          {
            "$and": [
              {
                "$source": "conditions.isOccurrenceManagementSubLocation",
                "$query": {
                  "$eq": false
                }
              },
              {
                "$source": "conditions.isPrimarySelectionChangeRev",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "conditions.isSingleSelection",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "conditions.isActionableAssyOrSubAssySelected",
                "$query": {
                  "$eq": true
                }
              }
            ]
          }
        ]
      }
    },
    "isEBOMFeatureInstalled": {
      "expression": "ctx.preferences.EnterpriseBOM_feature_installed && ctx.preferences.EnterpriseBOM_feature_installed[0]==='true'"
    },
    "isCBAImpactAnalysisCloseCommandVisible": {
      "expression": "commandContext.panelId ==='PmaUpdateSummary'"
    },
    "isRemovePartDesignCommandVisible": {
      "expression": "commandContext.vmo"
    },
    "isAlignSupportedOnSelectedObject": {
      "expression": {
        "$or": [
          {
            "$source": "ctx.selected.type",
            "$query": {
              "$in": "{{ctx.preferences.FND0_DESIGNREVISION_TYPES}}"
            }
          },
          {
            "$source": "ctx.selected.type",
            "$query": {
              "$in": "{{ctx.preferences.FND0_PARTREVISION_TYPES}}"
            }
          },
          {
            "$source": "ctx.selected.type",
            "$query": {
              "$in": "{{ctx.preferences.FND0_PRODUCTEBOMREVISION_TYPES}}"
            }
          }
        ]
      }
    },
    "Pma1UpdateAlignmentGroupChangeSummaryCmdCondition": {
      "expression": "conditions.isAlignSupportedOnSelectedObject && conditions.isUpdateChangesWithAlignmentCmdVisible"
    },
    "isTopSkipNode": {
      "expression": "(commandContext.occContext.topElement.props.pma1IsDesignRequired.dbValues[0] === '0' || commandContext.occContext.topElement.props.pma1IsDesignRequired.dbValues[0] === 'false' || commandContext.occContext.topElement.props.pma1IsPartRequired.dbValues[0] === '0' || commandContext.occContext.topElement.props.pma1IsPartRequired.dbValues[0] === 'false')"
    },
    "isSkipNode": {
      "expression": "(commandContext.occContext.topElement.uid !== ctx.selected.uid) && ( commandContext.occContext.pwaSelection[0].props.pma1IsDesignRequired.dbValues[0] === '0' || commandContext.occContext.pwaSelection[0].props.pma1IsDesignRequired.dbValues[0] === 'false' || commandContext.occContext.pwaSelection[0].props.pma1IsPartRequired.dbValues[0] === '0' || commandContext.occContext.pwaSelection[0].props.pma1IsPartRequired.dbValues[0] === 'false')"
    },
    "isBrokenAlignment": {
      "expression": "!conditions.isAlignmentExist && (commandContext.occContext.topElement.uid !== ctx.selected.uid) && (commandContext.occContext.pwaSelection[0].props.pma1IsDesignRequired.dbValues[0] === '1'  || commandContext.occContext.pwaSelection[0].props.pma1IsDesignRequired.dbValues[0] === 'true' || commandContext.occContext.pwaSelection[0].props.pma1IsPartRequired.dbValues[0] === '1' || commandContext.occContext.pwaSelection[0].props.pma1IsPartRequired.dbValues[0] === 'true')"
    },
    "isCallGuidedUpdate2": {
      "expression": "ctx.preferences.CBA_CALL_GUIDED_UPDATE_2 && ctx.preferences.CBA_CALL_GUIDED_UPDATE_2[0] === 'true'"
    },
    "isCallGuidedUpdate2ForUsage": {
      "expression": "ctx.preferences.CBA_CALL_GUIDED_UPDATE_2_USAGE && ctx.preferences.CBA_CALL_GUIDED_UPDATE_2_USAGE[0] === 'true'"
    },
    "isUsageBom": {
      "expression": "ctx.CBATrgContext.supportedFeatures.ProductEBOMFeature===true"
    },
    "isInvokeNewGuidedUpdate": {
      "expression": {
        "$or": [
          {
            "$and": [
              {
                "$source": "conditions.isUsageBom",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "conditions.isCallGuidedUpdate2",
                "$query": {
                  "$eq": true
                }
              },
              {
                "$source": "conditions.isCallGuidedUpdate2ForUsage",
                "$query": {
                  "$eq": true
                }
              }
            ]
          },
          {
            "$and": [
              {
                "$source": "conditions.isUsageBom",
                "$query": {
                  "$eq": false
                }
              },
              {
                "$source": "conditions.isCallGuidedUpdate2",
                "$query": {
                  "$eq": true
                }
              }
            ]
          }
        ]
      }
    },
    "pma1IsDisassociateProductsCommandVisible": {
      "expression": "commandContext.objectSetSource==='Pma0DesignToBomLinkProvider.ItemRevision' && ctx.mselected && ctx.mselected.length > 0 && ctx.mselected[0].uid!=ctx.xrtSummaryContextObject.uid && ctx.relationContext && ctx.relationContext.relationInfo[0].relationType==='Pma0DesignToBomLinkProvider'"
    },
    "pma1IsAssociateProductsCommandVisible": {
      "expression": "commandContext.objectSetSource==='Pma0DesignToBomLinkProvider.ItemRevision'"
    },
    "pma1PasteCommandConditionForAssociateProducts": {
      "expression": {
        "$and": [
          {
            "$source": "commandContext.objectSetSource",
            "$query": {
              "$eq": "Pma0DesignToBomLinkProvider.ItemRevision"
            }
          },
          {
            "$source": "ctx.awClipBoardProvider.length",
            "$query": {
              "$gte": 1
            }
          }
        ]
      }
    },
    "pma1IsValidSelectionInRelatedStrucutreSection": {
      "expression": "ctx.relationContext.relationInfo[0].relationType==='Pma0DesignToBomLinkProvider' || ( conditions.removeAttachmentVisibility && ctx.relationContext.relationInfo[0].relationType==='Pma0DesignToBomLinkProvider')"
    }
  },
