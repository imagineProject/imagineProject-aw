        "input": "{{function:disassociateProducts}}"
      },
      "outputData": {},
      "events": {
        "success": [
          {
            "name": "cdm.relatedModified",
            "eventData": {
              "refreshLocationFlag": true,
              "relations": "",
              "relatedModified": [
                "{{ctx.pselected}}"
              ]
            }
          }
        ],
        "failure": [
          {
            "name": "cdm.relatedModified",
            "eventData": {
              "refreshLocationFlag": false,
              "relations": "",
              "relatedModified": [
                "{{data.primarySelection}}"
              ]
            }
          }
        ]
      },
      "actionMessages": {
        "failure": [
          {
            "message": "manageAlignmentsFailure"
          }
        ]
      },
      "deps": "js/Pma1AssociateProductsService"
    },
    "Pma1PasteObjectsInAssociateProducts": {
      "actionType": "TcSoaService",
      "serviceName": "Internal-Bom-2024-06-StructureManagement",
      "method": "manageAlignments",
      "inputData": {
        "input": "{{function:getCreateInputForAssociateProducts}}"
      },
      "events": {
        "success": [
          {
            "name": "cdm.relatedModified",
            "eventData": {
              "refreshLocationFlag": true,
              "relations": "",
              "relatedModified": [
                "{{ctx.xrtSummaryContextObject}}"
              ]
            }
          }
        ],
        "failure": [
          {
            "name": "cdm.relatedModified",
            "eventData": {
              "refreshLocationFlag": true,
              "relations": "",
              "relatedModified": [
                "{{ctx.xrtSummaryContextObject}}"
              ]
            }
          }
        ]
      },
      "actionMessages": {
        "failure": [
          {
            "message": "manageAlignmentsFailure"
          }
        ]
      },
      "deps": "js/Pma1AssociateProductsService"
    }
