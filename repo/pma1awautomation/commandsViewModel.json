  "actions": {
    "openBOMNotification": {
      "actionType": "JSFunction",
      "method": "openBOMNotification",
      "inputData": {
        "notificationObject": "{{commandContext}}"
      },
      "events": {
        "success": [
          {
            "name": "NotificationMessage.markRead"
          }
        ]
      },
      "deps": "js/Pma1ImpactAnalysisService"
    },
    "getAdaptedObject": {
      "actionType": "JSFunctionAsync",
      "method": "getAdaptedObjects",
      "inputData": {
        "sourceObjects": "{{ctx.mselected}}"
      },
      "outputData": {
        "adaptedSourceTopItem": ""
      },
      "deps": "js/adapterService"
    },
    "updateImpactAnalysisWithECNFromPrimarySelection": {
      "actionType": "JSFunction",
      "method": "getObject",
      "inputData": {
        "sourceObjects": "{{ctx.pselected.uid}}"
      },
      "outputData": {
        "authoringChange": ""
      },
      "deps": "soa/kernel/clientDataModel"
    },
    "updateChangesWithAlignment": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "performGuidedUpdateInIAMode",
          "condition": "conditions.isCBAPageInImpactAnalysisMode"
        },
        {
          "action": "performGuidedUpdateInNonIAMode",
          "condition": "!conditions.isCBAPageInImpactAnalysisMode"
        }
      ]
    },
    "performGuidedUpdateInNonIAMode": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "setRedLineMode"
        },
        {
          "action": "updateImpactAnalysisWithECNFromPrimarySelection",
          "outputArg": [
            "authoringChange"
          ],
          "condition": "conditions.isPrimarySelectionChangeRev"
        },
        {
          "inputArg": {
            "authoringChange": "{{actionData.authoringChange}}"
          },
          "action": "launchCbaInImpactAnalysisMode"
        },
        {
          "action": "setImpactAnalysisMode",
          "condition": "conditions.isEntCBASubLocation"
        }
      ]
    },
    "performGuidedUpdateInIAMode": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "updateSelectedNodeOnCbaContext"
        },
        {
          "action": "setSrcAndTrgOccForImpactAnalysis"
        }
      ]
    },
    "updateSelectedNodeOnCbaContext": {
      "actionType": "Event",
      "method": "Event",
      "inputData": {
        "events": [
          {
            "name": "Pma1ImpactAnalysis.updateSelectedNodeOnCbaContext",
            "eventData": {
              "commandContext": "{{commandContext}}"
            }
          }
        ]
      }
    },
    "setSrcAndTrgOccForImpactAnalysis": {
      "actionType": "Event",
      "method": "Event",
      "inputData": {
        "events": [
          {
            "name": "Pma1ImpactAnalysis.onUpdateCBAFirstLaunch"
          }
        ]
      }
    },
    "launchCbaInImpactAnalysisMode": {
      "actionType": "JSFunction",
      "method": "launchCBA",
      "inputData": {
        "commandContext": "{{commandContext}}",
        "optionalParamsToLaunchCBA": {
          "isIA_mode": true,
          "adaptObj_uid": "{{data.adaptedSourceTopItem[0].uid}}",
          "ecn_uid": "{{parameters.authoringChange.uid}}",
          "isRL_mode": "{{ctx.cadbomalignment.redLineMode.isChangeEnabled.toString()}}"
        }
      },
      "deps": "js/CadBomOccurrenceAlignmentService"
    },
    "setImpactAnalysisMode": {
      "actionType": "JSFunction",
      "method": "setImpactAnalysisMode",
      "inputData": {
        "commandContext": "{{commandContext}}",
        "ecn_uid": "{{data.authoringChange.uid}}"
      },
      "deps": "js/CadBomOccurrenceAlignmentService"
    },
    "getUpdateBOMWorkflowDetails": {
      "actionType": "JSFunction",
      "method": "getWorkflowDetails",
      "inputData": {
        "value": "{{data.adaptedSourceTopItem[0].uid}}"
      },
      "outputData": {
        "wfDetails": ""
      },
      "deps": "js/Pma1UpdateAlignmentService"
    },
    "refreshCBAStructureForAutomatedUpdate": {
      "actionType": "JSFunction",
      "method": "resetStructureForAutomatedUpdate",
      "inputData": {
        "commandContext": "{{commandContext}}"
      },
      "deps": "js/CadBomOccurrenceAlignmentUtil"
    },
    "getCreatePartEBOMWorkflowDetails": {
      "actionType": "JSFunction",
      "method": "getWorkflowDetails",
      "inputData": {
        "value": "{{data.adaptedSourceTopItem[0].uid}}",
        "targetBOMTypeToCreate": "Part"
      },
      "outputData": {
        "wfDetails": ""
      },
      "deps": "js/Pma1UpdateAlignmentService"
    },
    "getCreateProductEBOMWorkflowDetails": {
      "actionType": "JSFunction",
      "method": "getWorkflowDetails",
      "inputData": {
        "value": "{{data.adaptedSourceTopItem[0].uid}}",
        "targetBOMTypeToCreate": "ProductEBOM"
      },
      "outputData": {
        "wfDetails": ""
      },
      "deps": "js/Pma1UpdateAlignmentService"
    },
    "getCreateDesignBOMWorkflowDetails": {
      "actionType": "JSFunction",
      "method": "getWorkflowDetails",
      "inputData": {
        "value": "{{data.adaptedSourceTopItem[0].uid}}",
        "targetBOMTypeToCreate": "Design"
      },
      "outputData": {
        "wfDetails": ""
      },
      "deps": "js/Pma1UpdateAlignmentService"
    },
    "refreshAssembly": {
      "actionType": "TcSoaService",
      "serviceName": "Core-2007-01-DataManagement",
      "method": "refreshObjects",
      "inputData": {
        "objects": "{{function:getObjectsToRefresh}}"
      },
      "outputData": {},
      "deps": "js/Pma1UpdateAlignmentService"
    },
    "executeWorkflow": {
      "actionType": "TcSoaService",
      "serviceName": "Workflow-2008-06-Workflow",
      "method": "createInstance",
      "inputData": {
        "startImmediately": true,
        "observerKey": "",
        "name": "{{data.wfDetails.name}}",
        "subject": "",
        "description": "{{data.wfDetails.description}}",
        "contextData": {
          "processTemplate": "{{data.wfDetails.wfProcessTemplate}}",
          "attachments": "{{data.wfDetails.wfAttachments}}",
          "attachmentCount": 1,
          "attachmentTypes": [
            1
          ]
        }
      },
      "outputData": {
        "workflowOutput": ""
      },
      "events": {
        "success": [
          {
            "name": "cdm.relatedModified",
            "eventData": {
              "refreshLocationFlag": true,
              "relations": "",
              "relatedModified": [
                "{{ctx.pselected}}"
              ]
            },
            "condition": "ctx.pselected && ctx.pselected.modelType.typeHierarchyArray.includes('ChangeItemRevision')"
          },
          {
            "name": "cdm.relatedModified",
            "eventData": {
              "refreshLocationFlag": true,
              "relations": "",
              "relatedModified": [
                "{{ctx.selected}}"
              ]
            },
            "condition": "ctx.pselected && !ctx.pselected.modelType.typeHierarchyArray.includes('ChangeItemRevision')"
          },
          {
            "name": "pma1.refreshAssembly",
            "eventData": {
              "selectedObject": "{{ctx.selected}}"
            },
            "condition": "ctx.pselected && !ctx.pselected.modelType.typeHierarchyArray.includes('ChangeItemRevision')"
          },
          {
            "name": "aceElementsSelectionUpdatedEvent",
            "eventData": {
              "objectsToSelect": [
                "{{commandContext.occContext.topElement}}"
              ],
              "viewToReact": "{{commandContext.provider.contextKey}}"
            },
            "condition": "!conditions.isAlignmentExist"
          }
        ]
      },
      "actionMessages": {
        "success": [
          {
            "message": "automatedUpdateCompleteNotification",
            "condition": "data.wfDetails.isUpdateBOMWorkflow"
          },
          {
            "message": "createPartEBOMCompleteNotification",
            "condition": "data.wfDetails.isCreatePartEBOMWorkflow"
          },
          {
            "message": "createProductEBOMCompleteNotification",
            "condition": "data.wfDetails.isCreateProductEBOMWorkflow"
          },
          {
            "message": "createDesignBOMCompleteNotification",
            "condition": "data.wfDetails.isCreateDesignBOMWorkflow"
          }
        ],
        "failure": [
          {
            "message": "soaOperationFailure"
          }
        ]
      }
    },
    "autoUpdateChangesWithAlignment": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "getAdaptedObject"
        },
        {
          "action": "getUpdateBOMWorkflowDetails"
        },
        {
          "action": "executeWorkflow"
        },
        {
          "action": "refreshCBAStructureForAutomatedUpdate",
          "condition": "conditions.isEntCBASubLocation"
        }
      ]
    },
    "createPartEBOMAction": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "getAdaptedObject"
        },
        {
          "action": "getCreatePartEBOMWorkflowDetails"
        },
        {
          "action": "executeWorkflow"
        }
      ]
    },
    "createDesignBOMAction": {
      "actionType": "batchJob",
      "steps": [
        {
          "action": "getAdaptedObject"
        },
        {
          "action": "getCreateDesignBOMWorkflowDetails"
        },
        {
          "action": "executeWorkflow"
        }
      ]
    },
    "Pma1AddAlignPartCommandAction": {
      "actionType": "JSFunction",
      "method": "updateAtomicDataValue",
      "inputData": {
        "AtomicObj": "{{commandContext}}",
        "value": {
          "activeView": "PmaCreatePartPanel",
          "dynamicPanelTitle": "{{i18n.addPart}}",
          "dynamicPanelId": "PmaCreatePartPanel",
          "prevPanelId": "{{commandContext.value.activeView}}",
          "primaryXrtTypeLoaded": "{{commandContext.primaryXrtTypeLoaded}}"
        }
      },
      "deps": "js/addObjectUtils"
    },
    "Pma1RemoveAlignPartCommandAction": {
      "actionType": "JSFunction",
