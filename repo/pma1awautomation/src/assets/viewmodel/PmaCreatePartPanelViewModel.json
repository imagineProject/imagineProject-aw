{
    "schemaVersion" : "1.0.0",
    "data":
    {
        "createOrUseExisting": {
            "displayName": "",
            "labelPosition": "NO_PROPERTY_LABEL",
            "type": "BOOLEAN",
            "isEditable": "true",
            "dbValue": true,
            "vertical": false,
            "propertyRadioTrueText": "{{i18n.createNewPart}}",
            "propertyRadioFalseText": "{{i18n.useExistingPart}}"
        },
        "allowedTypeInfo":
        {
            "includeTypes":"{{ctx.preferences.FND0_PART_TYPES.toString()}}",
            "searchTypeName":"{{ctx.preferences.FND0_PARTREVISION_TYPES.toString()}}",
            "creationType":"{{ctx.preferences.FND0_PART_TYPES[0]}}"
        },
        "typeListProp": {
            "type": "STRING",
            "hasLov": true,
            "isEditable": true,
            "propertyLabelDisplay": "NO_PROPERTY_LABEL"
        },
        "typeListSelectionData": {
            "initialValues": {},
            "meta": {}
        },
        "addPanelState": {
            "initialValues": {
                "creationType": "",
                "sourceObjects": "",
                "selectedTab": ""
            },
            "meta": {}
        },
        "activeState": {
            "initialValues": {
                "activeView": "AddObjectPrimarySub",
                "context": {}
            },
            "meta": {}
        },
        "triggerCreate": {
            "dbValue": false,
            "type": "BOOLEAN"
        },
        "xrtState": {
            "initialValues": {},
            "meta": {
                "xrtVMO": {
                    "field": "true",
                    "type": "viewModelObject"
                }
            }
        }
    },
    "actions":
    {
        "loadCreateXRT": {
            "actionType": "JSFunctionAsync",
            "method": "loadCreateXrt",
            "inputData": {
                "type": "CREATE",
                "activePageTitle": "",
                "selectedObject": "",
                "objectType": "{{data.allowedTypeInfo.creationType}}"
            },
            "outputData": {
                "xrtData": ""
            },
            "deps": "js/addObjectUtils"
        },
        "createAndAddObject": {
            "actionType": "TcSoaService",
            "serviceName": "Core-2016-09-DataManagement",
            "method": "createAttachAndSubmitObjects",
            "inputData": {
                "inputs": "{{function:getCreateInput}}"
            },
            "outputData": {
                "createdMainObject": "output[0].objects[0]",
                "createdObject": "{{function:getCreatedObject}}"
            },
            "events": {
                "success": [ {
                    "name": "pma1.navigateToDesignPanel",
                    "eventData": {
                        "createdObject": "{{data.createdObject}}",
                        "sourceObjects": ""
                        }
                    }
                ],
                "failure": [
                    {
                        "name": "addObject.addOprfailed"
                    }
                ]
            },
            "actionMessages": {
                "failure": [ 
                    {
                        "message": "genericAddObjectFailure"
                    }
                ]
            },
            "deps": "js/addObjectUtils"
        },
        "navigateToPrimaryPanelAction": {
            "actionType": "JSFunction",
            "method": "updateAtomicDataValue",
            "inputData": {
                "AtomicObj": "{{props.activeState}}",
                "value": {
                    "activeView": "{{props.activeState.prevPanelId}}"
                }
            },
            "deps": "js/addObjectUtils"
        },
        "updateCreationType": {
            "actionType": "JSFunctionAsync",
            "method": "onTypeSelected",
            "inputData": {
                "data": "{{data.typeListSelectionData}}",
                "addPanelState": "{{subPanelContext.addPanelState}}",
                "datasetState": "{{fields.datasetState}}"
            },
            "outputData": {
                "allowedTypeInfo.creationType": "creationType.props.type_name.dbValues[0]",
                "isDatasetCreate": "isDatasetCreate",
                "isProjectAssignable": "isProjectAssignable"
            },
            "deps": "js/addObjectUtils"
        },
        "onTypeSelected": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "updateCreationType"
                },
                {
                    "action": "loadCreateXRT",
                    "condition": "!data.isDatasetCreate"
                }
            ]
        },
        "addExistingRevision": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ 
                    {
                        "name": "pma1.navigateToDesignPanel",
                        "eventData": {
                            "createdObject": "",
                            "sourceObjects": "{{addPanelState.sourceObjects}}"
                        }
                    }
                ]
            }
        },
        "getPrefferedType": {
            "actionType": "JSFunctionAsync",
            "method": "getPrefferedType",
            "inputData": {
                "prefferedType": "{{ctx.preferences.FND0_PART_TYPES[0]}}",
                "inputType": "{{props.activeState.value.primaryXrtTypeLoaded}}"
            },
            "outputData": {
                "primaryXrtTypeLoaded": ""                
            },
            "deps": "js/Pma1Utils"
        }
    },
    "functions": {
        "getCreateInput": {
            "functionName": "getCreateInput",
            "parameters": [
                "{{data}}",
                "",
                "{{data.allowedTypeInfo.creationType}}",
                "{{editHandlers.addSubPanelEditHandler}}"
            ]
        },
        "getCreatedObject": {
            "functionName": "getCreatedObject",
            "parameters": [
                "{{data.allowedTypeInfo.includeTypes}"
            ]
        }
    },
    "editHandlers": {
        "addSubPanelEditHandler": {
            "context": "CREATE_PART_OR_DESIGN_SUB_PANEL_CONTEXT",
            "dataSource": {
                "xrtVMO": "{{data.xrtState}}"
            }
        }       
    },
    "onEvent":
    [
        {
            "eventId":"pma1.navigateToDesignPanel",
            "action":"navigateToPrimaryPanelAction"
        }
    ],
    "conditions":
    {
        "isPaletteTabVisible": {
            "expression": "addPanelState.selectedTab.view==='PaletteTabPageSub'"
        },
        "isSearchTabVisible": {
            "expression": "addPanelState.selectedTab.view==='SearchTabPageSub'"
        },
        "hasAnySelection" : {
            "expression": "addPanelState.sourceObjects && addPanelState.sourceObjects.length > 0"
        }
    },
    "messages": {
        "genericAddObjectFailure": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },
    "lifecycleHooks": {
        "onMount":"getPrefferedType",
        "onUpdate": [
            {
                "action": "onTypeSelected",
                "observers":[ "viewModel.atomicData.typeListSelectionData.selected[0].propInternalValue" ]
            }          
        ]
    },
    "i18n":
    {
        "createNewPart": [
            "PMA1AutomationConstants"
        ],
        "useExistingPart": [
            "PMA1AutomationConstants"
        ],
        "add": [
            "PMA1AutomationConstants"
        ],
        "objectType": [
            "awAddDirectiveMessages"
        ]
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
