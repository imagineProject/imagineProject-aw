{
    "schemaVersion": "1.0.0",
       "actions": {
        "updateSrcSelectionsInSummaryPanel": {
            "actionType":"JSFunction",
            "method":"updateSelectionsInSummaryPanel",
            "inputData":{
                "data":"{{data}}",
                "viewKey":"CBASrcContext"
            },
            "deps":"js/Pma1ImpactAnalysisService"
        },
        "updateTrgSelectionsInSummaryPanel": {
            "actionType":"JSFunction",
            "method":"updateSelectionsInSummaryPanel",
            "inputData":{
                "data":"{{data}}",
                "viewKey":"CBATrgContext"
            },
            "deps":"js/Pma1ImpactAnalysisService"
        },
        "tileSelected": {
            "actionType":"JSFunction",
            "method":"headerTileSelected",
            "inputData":{
                "subPanelContext":"{{props.subPanelContext}}"
            },
            "deps":"js/Pma1ImpactAnalysisService"
        }
    },
    "data": {},
    "conditions": {},
    "onEvent": [
        {
            "eventId": "srcOccDataProvider.selectionChangeEvent",
            "action": "updateSrcSelectionsInSummaryPanel",
            "cacheEventData": true
        },
        {
            "eventId": "trgOccDataProvider.selectionChangeEvent",
            "action": "updateTrgSelectionsInSummaryPanel",
            "cacheEventData": true
        }
    ],
    "props":{
        "sub-panel-context":{
            "type":"object"
        }
    },
    "lifecycleHooks": {
        "onMount": "tileSelected"
    },
    "i18n": {
        "EBOM": [
            "CadBomAlignmentConstants"
        ],
        "DBOM": [
            "CadBomAlignmentConstants"
        ],
        "fromTitle": [
            "OccurrenceManagementConstants"
        ]
    }
}