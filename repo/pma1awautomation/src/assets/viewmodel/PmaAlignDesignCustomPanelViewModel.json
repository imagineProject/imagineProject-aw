{
    "schemaVersion": "1.0.0",
    "data": {
        "activeState": {
            "initialValues": {
                "activeView": "AddObjectPrimarySub",
                "context": {}
            },
            "meta": {}
        }
    },
    "actions":{
        "setActiveView":{
            "actionType": "JSFunction",
            "method": "resetActiveView",
            "inputData": {
                "stateName": "{{data.activeState}}",
                "destPanelId": "AddObjectPrimarySub"
            },
            "outputData": {
                "activeState": ""
            },
            "deps": "js/addObjectUtils"
        },
        "getDesignRevision": {
            "actionType": "dataProvider",
            "method": "getDesignRevisionDataProvider"
        },
        "getDesignRevisionData": {
            "actionType": "JSFunction",
            "method": "getRevisionData",
            "inputData": {
                "data": "{{data.dataProviders.getDesignRevisionDataProvider}}",
                "createdObject": "{{parameters.eventData.createdObject}}",
                "sourceObjects": "{{parameters.eventData.sourceObjects}}"
            },
            "deps": "js/Pma1Utils"
        },
        "getDesignRequiredProperty": {
            "actionType": "JSFunction",
            "method": "getPanelProperty",
            "inputData": {
                "xrtState": "{{props.subPanelContext.xrtState}}",
                "suffixes": ["is_designRequired","isDesignRequired"]
            },
            "outputData": {
                "isDesignRequired": ""
            },
            "deps": "js/Pma1Utils"
        },
        "getCreateAlignedDesignProperty": {
            "actionType": "JSFunction",
            "method": "getPanelProperty",
            "inputData": {
                "xrtState": "{{props.subPanelContext.xrtState}}",
                "suffixes": ["createAlignedDesign"]
            },
            "outputData": {
                "createAlignedDesign": ""
            },
            "deps": "js/Pma1Utils"
        },
        "initPartPanel": {
            "actionType": "JSFunction",
            "method": "updateSubPanel",
            "inputData": {
                "props":"{{props.subPanelContext}}"
            },
            "deps": "js/Pma1Utils"
        },
        "init": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "getDesignRequiredProperty",
                    "condition": "conditions.isAlignDesignCustomPanelExists"
                },
                {
                    "action": "getCreateAlignedDesignProperty",
                    "condition": "conditions.isAlignDesignCustomPanelExists"
                },
                {
                    "action": "initPartPanel",
                    "condition": "!conditions.isAlignDesignCustomPanelExists"
                }              
            ]
        }
    },
    "dataProviders": {
        "getDesignRevisionDataProvider": {
            "response": "",
            "totalFound": "",
            "preSelection": false,
            "selectionModelMode": "single",
            "commandsAnchor": "aw_removeDesignCellCommandAction"
        }
    },  
    "onEvent":[
        {
            "eventId": "addObject.revisionCreated",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "getDesignRevisionData"
        },
        {
            "eventId": "pma1.navigateToPartPanel",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "getDesignRevisionData"
        }
    ],
    "conditions": {
        "isValidCommandSource":{
            "expression":"ctx.activeNavigationCommand_dialog.commandId !== 'CbaAlignPart' && ctx.activeNavigationCommand_dialog.commandId !== 'CbaAlignDesign'"
        },
        "isCreatePanel":{
            "expression":"conditions.isValidCommandSource && props.subPanelContext.activeState.value.activeView === 'AddObjectPrimarySub'"
        },
        "isRevisePanel":{
            "expression":"conditions.isValidCommandSource && props.subPanelContext.activeState.value.activeView === 'Awp0ShowRevision'"
        },
        "isAlignDesignCustomPanelExists":{
            "expression":"conditions.isCreatePanel || conditions.isRevisePanel"
        },
        "isAlignDesignCustomPanelVisible":{
            "expression":"(props.subPanelContext.xrtState.xrtVMO.props[data.isDesignRequired].value && !props.subPanelContext.xrtState.xrtVMO.props[data.createAlignedDesign].value && conditions.isCreatePanel) || conditions.isRevisePanel"
        },
        "isAddDesignWarningMessageVisible":{
            "expression":"props.subPanelContext.xrtState.xrtVMO.props[data.createAlignedDesign].value && conditions.isCreatePanel&& data.dataProviders.getDesignRevisionDataProvider.viewModelCollection.loadedVMObjects.length>0"
        }
    },
    "lifecycleHooks": {
        "onMount":"init"
    },
    "i18n": {
        "addDesignInfoMessage": [
            "PMA1AutomationMessages"
        ]
    }
}
