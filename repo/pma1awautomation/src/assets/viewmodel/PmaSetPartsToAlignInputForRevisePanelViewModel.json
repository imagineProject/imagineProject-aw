{
    "schemaVersion": "1.0.0",
    "data": {
        "pma0PartsToAlign": {
            "type": "STRINGARRAY",
            "isEditable": true,
            "dbValues": [],
            "dbValue": "",
            "isArray":true
        }
    },
    "actions":{
        "updatePartsToAlignProperty": {
            "actionType": "JSFunction",
            "method": "updateAlignProperty",
            "inputData": {
                "data": "{{data}}",
                "subPanelContext": "{{props.subPanelContext}}",
                "property":"{{data.pma0PartsToAlign}}"
            },
            "deps": "js/Pma1Utils",
            "outputData": {
                "pma0PartsToAlign": ""
            }
        },
        "updatePartCustomPanel": {
            "actionType": "JSFunction",
            "method": "updateCustomPanel",
            "inputData": {
                "subPanelContext": "{{props.subPanelContext}}",
                "keepExistingProperty": "{{props.subPanelContext.subPanelContext.xrtState.xrtVMO.props.pma0KeepExistingPart}}",
                "requiredProperty": {
                    "value":true
                },
                "propertyToUpdate": "{{data.pma0PartsToAlign}}"
            },
            "deps": "js/Pma1Utils"
        },
        "disabelRevisePanelFields": {
            "actionType": "JSFunction",
            "method": "disabelRevisePanelFields",
            "inputData": {
                "selectedObject":"{{ctx.selected}}"
            },
            "deps": "js/Pma1Utils"
        }
    },
   
    "onEvent":[
        {
            "eventId": "getPartRevisionDataProvider.modelObjectsUpdated",
            "action": "updatePartsToAlignProperty"
        }
    ],
    "conditions": {
    },
    "lifecycleHooks": {
        "onMount":"disabelRevisePanelFields",
        "onUpdate": [ 
        {
            "action": "updatePartCustomPanel",
            "observers": [ "props.subPanelContext.subPanelContext.xrtState.xrtVMO.props.pma0KeepExistingPart.value"]
        }]
    },
    "props":{
        "sub-panel-context":{
            "type":"object"
        }
    }
}
