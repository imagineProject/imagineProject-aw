{
  "commands": {
    "GoToCommandBuilder": {
      "iconId": "cmdCommandBuilder",
      "title": "{{i18n.commandBuilderCommandTitle}}",
      "description": "{{i18n.GoToCommandBuilderDesc}}"
    },
    "GoToPanelBuilder": {
      "iconId": "cmdPanelBuilder",
      "title": "{{i18n.PanelBuilderCommandTitle}}",
      "description": "{{i18n.GoToPanelBuilderDesc}}"
    },
    "GoToConfigBuilder": {
      "iconId": "cmdConfigurationBuilder",
      "title": "{{i18n.ConfigBuilderCommandTitle}}",
      "description": "{{i18n.ConfigBuilderCommandDesc}}"
    }
  },
  "commandHandlers": {
    "GoToPanelBuilder": {
      "id": "GoToPanelBuilder",
      "action": "showPanelBuilder",
      "activeWhen": {
        "condition": "conditions.isPanelBuilderValid"
      },
      "visibleWhen": {
        "condition": "conditions.isPanelBuilderValid"
      }
    },
    "GoToCommandBuilder": {
      "id": "GoToCommandBuilder",
      "action": "showCommandBuilder",
      "activeWhen": {
        "condition": "conditions.isCommandBuilderValid"
      },
      "visibleWhen": {
        "condition": "conditions.isCommandBuilderValid"
      }
    },
    "GoToCommandBuilderCommandHandler": {
      "id": "GoToCommandBuilder",
      "action": "showCommandBuilder",
      "activeWhen": true,
      "visibleWhen": true
    },
    "GoToPanelBuilderCommandHandler": {
      "id": "GoToPanelBuilder",
      "action": "showPanelBuilder",
      "activeWhen": true,
      "visibleWhen": true
    },
    "GoToConfigBuilderCommandHandler": {
      "id": "GoToConfigBuilder",
      "action": "showConfigBuilder",
      "activeWhen": true,
      "visibleWhen": true
    },
    "DisableQuickAccessInPanelBuilder": {
      "id": "cmdQuickAccess",
      "action": "",
      "activeWhen": {
        "condition": "conditions.isPanelBuilderLocation"
      },
      "visibleWhen": false
    }
  },
  "commandPlacements": {
    "GoToCommandBuilderPlacement": {
      "id": "GoToCommandBuilder",
      "uiAnchor": "aw_globalNavigationbar",
      "priority": 120
    },
    "GoToPanelBuilderPlacement": {
      "id": "GoToPanelBuilder",
      "uiAnchor": "aw_globalNavigationbar",
      "priority": 130
    },
    "GoToConfigBuilderPlacement": {
      "id": "GoToConfigBuilder",
      "uiAnchor": "aw_globalNavigationbar",
      "priority": 125
    },
    "XrtEditorToggleDevModePlacement": {
      "id": "cmdToggleDevMode",
      "priority": 1,
      "uiAnchor": "aw_xrteditor"
    }
  },
  "actions": {
    "showCommandBuilder": {
      "actionType": "Navigate",
      "navigateTo": "#/uibuilder/commands",
      "navigationParams": {}
    },
    "showPanelBuilder": {
      "actionType": "Navigate",
      "navigateTo": "#/canvas",
      "navigationParams": {}
    },
    "showConfigBuilder": {
      "actionType": "Navigate",
      "navigateTo": "#/configbuilder/states",
      "navigationParams": {}
    }
  },
  "conditions": {
    "isPanelBuilderLocation": {
      "expression": "ctx.locationContext['ActiveWorkspace:Location'] === 'wysiwygMainPage'"
    },
    "isCommandBuilderLocation": {
      "expression": "ctx.sublocation && ( ctx.sublocation.clientScopeURI === 'Awp0Toolbars'||ctx.sublocation.clientScopeURI === 'Awp0CommandBuilder' )"
    },
    "isPanelBuilderValid": {
      "expression": "conditions.isPanelBuilderLocation||conditions.isCommandBuilderLocation"
    },
    "isCommandBuilderValid": {
      "expression": "conditions.isCommandBuilderLocation||conditions.isPanelBuilderLocation"
    }
  },
  "messages": {},
  "onEvent": [],
  "i18n": {
    "PanelBuilderCommandTitle": [
      "uiBuilderMessages"
    ],
    "commandBuilderCommandTitle": [
      "uiBuilderMessages"
    ],
    "ConfigBuilderCommandTitle": [
      "uiBuilderMessages"
    ],
    "ConfigBuilderCommandDesc": [
      "uiBuilderMessages"
    ],
    "GoToCommandBuilderDesc": [
      "uiBuilderMessages"
    ],
    "GoToPanelBuilderDesc": [
      "uiBuilderMessages"
    ]
  }
}
