{
    "schemaVersion" : "1.0.0",
    "imports": [],
    "data":{
        "additionalContext":
        {
            "type": "STRING",
            "hasLov": true,
            "displayName": "",
            "dbValue": ""
        },
        "tableLoaded": false
    },
    "actions": {
        "initSearch": {
            "actionType": "JSFunction",
            "method": "initSearch",
            "inputData": {
                "data": "{{data.actions}}",
                "actionName": "doGridDataProvider",
                "tableLoaded": "{{data.tableLoaded}}"
            },
            "deps": "js/awSearchService"
        },
        "setSelectedContext":
        {
            "actionType": "JSFunction",
            "method": "setSelectedContext",
            "inputData":
            {
                "data": "{{data}}"
            },
            "deps": "js/Saw1SearchFilterService"
        },
        "doArrangeEvent" : {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "resetColumnConfig" : {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [{
                        "scope": "LoginUser",
                        "scopeName": "",
                        "clientName": "AWClient",
                        "resetColumnConfig": true,
                        "columnConfigQueryInfos":
                            [{
                                "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}",
                                "operationType": "configured",
                                "typeNames": ["WorkspaceObject"],
                                "columnsToExclude": []
                            }],
                        "businessObjects": [{}]
                    }]
                }
            },
            "outputData": {
                "dataProviders.gridDataProvider.columnConfig": "columnConfigurations[0].columnConfigurations[0]"
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "schTaskSearchTableErrorMsg"
                    }
                ]
            }
        },
        "doGridDataProvider": {
            "actionType": "dataProvider",
            "method": "gridDataProvider"
        },
        "saveColumnConfigLoadData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "operationType": "as_arranged",
                        "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}"
                    },
                    "saveColumnConfigData": {
                        "clientScopeURI" : "{{subPanelContext.provider.clientScopeURI}}",
                        "columnConfigId" : "{{data.dataProviders.gridDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.gridDataProvider.newColumns}}",
                        "scope" : "LoginUser",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "attributesToInflate": "{{subPanelContext.searchState.tableViewProperties}}",
                        "maxToLoad": "{{subPanelContext.searchState.maxToLoad}}",
                        "maxToReturn": "{{subPanelContext.searchState.maxToReturn}}",
                        "providerName": "{{subPanelContext.searchState.provider}}",
                        "searchCriteria": "{{function:getSchedulesSearchCriteria}}",
                        "searchFilterFieldSortType": "{{subPanelContext.searchState.sortType}}",
                        "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                        "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}",
                        "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}",
                        "columnFilters": "{{data.columnProviders.clientScopeUI.columnFilters}}"
                    },
                    "inflateProperties": true
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "tableLoaded": true,
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "output": "{{function:processOutput}}"
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "schTaskSearchTableErrorMsg"
                    }
                ]
            }
        },
        "loadData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}"
                    },
                    "searchInput": {
                        "attributesToInflate": "{{subPanelContext.searchState.tableViewProperties}}",
                        "maxToLoad": "{{subPanelContext.searchState.maxToLoad}}",
                        "maxToReturn": "{{subPanelContext.searchState.maxToReturn}}",
                        "providerName": "{{subPanelContext.searchState.provider}}",
                        "searchCriteria": "{{function:getSchedulesSearchCriteria}}",
                        "searchFilterFieldSortType": "{{subPanelContext.searchState.sortType}}",
                        "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                        "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}",
                        "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}",
                        "columnFilters": "{{data.columnProviders.clientScopeUI.columnFilters}}"
                    },
                    "inflateProperties": true
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "tableLoaded": true,
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "output": "{{function:processOutput}}"
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "schTaskSearchTableErrorMsg"
                    }
                ]
            }
        },
        "loadSubscribedResourcePools":
        {
            "actionType": "TcSoaService",
            "serviceName": "Query-2014-11-Finder",
            "method": "performSearch",
            "inputData":
            {
                "searchInput": {
                    "maxToLoad": 1000,
                    "maxToReturn": 1000,
                    "providerName": "Saw1TaskSearchProvider",
                    "searchCriteria":
                    {
                        "searchContentType": "SubscribedResourcePools"
                    },
                    "startIndex": 0
                }
            },
            "policy":
            {
                "types":
                [
                    {
                        "name": "ResourcePool",
                        "properties":
                        [
                            {
                                "name": "object_string"
                            }
                        ]
                    }
                ]
            },
            "outputData": {
                "totalResourcePools": "totalFound",
                "resourcePoolSearchResults": "searchResults",
                "resourcePoolModelObjects": "ServiceData.modelObjects"
            },
            "events":
            {
                "success":
                [
                    {
                        "name": "scheduleTasksSearchTable.processSubscribedResourcePoolSearchResponse"
                    }
                ]
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "schTaskSearchTableErrorMsg"
                    }
                ]
            }
        },
        "prepareAdditionalContextList":
        {
            "actionType": "JSFunction",
            "method": "prepareAdditionalContextList",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData": {
                "additionalContextList" : "additionalContextList",
                "additionalContext" : "additionalContext"
            },
            "deps": "js/Saw1SearchFilterService"
        }
    },
    "dataProviders": {
        "gridDataProvider": {
            "action": "loadData",
            "editContext": "TABLE_CONTEXT",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "inputData": {
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands"
        }
    },
    "columnProviders": {
        "clientScopeUI": {
            "saveColumnAndLoadAction" : "saveColumnConfigLoadData",
            "resetColumnAction" : "resetColumnConfig",
            "sortCriteria": []
        }
    },
    "grids": {
        "gridView": {
            "dataProvider": "gridDataProvider",
            "columnProvider": "clientScopeUI",
            "enableArrangeMenu": true,
            "gridOptions": {
                "enableGridMenu": true,
                "enableSorting": false
            }
        }
    },
    "onEvent": [
        {
            "eventId": "columnArrange",
            "cacheEventData": true,
            "action": "doArrangeEvent"
        },
        {
            "eventId": "scheduleTasksSearchTable.contentLoaded",
            "action": "loadSubscribedResourcePools"
        },
        {
            "eventId": "scheduleTasksSearchTable.processSubscribedResourcePoolSearchResponse",
            "action": "prepareAdditionalContextList"
        }
    ],
    "functions": {
        "getSchedulesSearchCriteria": {
            "functionName": "getSchedulesSearchCriteria",
            "parameters": [
                "{{data.additionalContext.dbValue}}",
                "{{subPanelContext.searchState.criteria}}"
            ],
            "deps": "js/Saw1SearchFilterService"
        },
        "processOutput": {
            "functionName": "processOutput",
            "parameters": [
                "{{data}}",
                "{{subPanelContext.searchState}}"
            ],
            "deps": "js/Saw1SearchFilterService"
        }
    },
    "messages": {
        "schTaskSearchTableErrorMsg": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },
    "lifecycleHooks": {
        "onUpdate": {
            "action": "initSearch",
            "observers": [
                "props.subPanelContext.searchState.criteria.searchString",
                "props.subPanelContext.searchState.filterString"
            ]
        }
    },
    "i18n": {
        "allTeams": [ "ScheduleManagerMessages" ]
    }
}
