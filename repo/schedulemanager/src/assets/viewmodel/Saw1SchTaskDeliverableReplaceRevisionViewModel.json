{
    "schemaVersion": "1.0.0",
    "actions": {
        "reveal": {
            "actionType": "dataProvider",
            "method": "getRevisionsProvider"
        },
        "getRevisionList": {
            "actionType": "TcSoaService",
            "serviceName": "Core-2006-03-DataManagement",
            "method": "getProperties",
            "inputData": {
                "objects": [
                    {
                        "uid": "{{subPanelContext.selectionModel.selectionData.selected[0].uid}}"
                    },
                    {
                        "uid": "{{subPanelContext.selectionModel.selectionData.selected[0].props.fnd0DeliverableInstance.dbValue}}"
                    }
                ],
                "attributes": [
                    "revision_list",
                    "sch_task_deliverable_list",
                    "fnd0DeliverableInstance",
                    "SchTaskDeliverable"
                ]
            },
            "outputData": {
                "searchResult": "{{function:loadSchTaskDelRevisions}}"
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "soaFailureMessage"
                    }
                ]
            },
            "deps": "js/Saw1SchTaskDeliverableReplaceRevision"
        },
        "replaceSchTaskDelRevision": {
            "actionType": "JSFunction",
            "method": "replaceSchTaskDelRevision",
            "inputData": {
               "ctx": "{{ctx}}",
               "data": "{{data}}"
            },
            "events": {
                "success": [
                    {
                        "name": "cdm.relatedModified",
                        "eventData": {
                            "relatedModified": [
                                "{{subPanelContext.vmo}}"
                            ]
                        }
                    },
                    {
                        "name": "closeDialog"
                    }
                ]
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "soaFailureMessage"
                    }
                ]
            },
            "deps": "js/Saw1SchTaskDeliverableReplaceRevision"
        },
        "closePanel": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "condition": "subPanelContext.selectionModel.selectionData.selected[0].uid !== props.subPanelContext.selectionData.selected[0].uid",
                    "name": "closeDialog"
                } ]
            }
        },
        "closePanelDialog": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "INFO_PANEL_CONTEXT",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        }
    },
    "functions": {
        "loadSchTaskDelRevisions": {
            "functionName": "loadSchTaskDelRevisions",
            "parameters": [
                "{{subPanelContext.selectionModel.selectionData.selected[0]}}"
            ]
        }
    },
    "conditions": {
        "isRevisionSelected": {
            "expression": "data.dataProviders.getRevisionsProvider.selectedObjects.length > 0"
        }
    },
    "onEvent": [  {
            "eventId": "Saw1SchTaskDeliverableReplaceRevision.contentUnloaded",
            "action": "unSubscribeEvent"
        },
        {
            "eventId": "closeDialog",
            "action": "closePanelDialog"
        }
    ],
    "data": {
        "outputData": {}
    },
    "dataProviders": {
        "getRevisionsProvider": {
            "action": "getRevisionList",
            "response": "{{data.searchResult.revisions}}",
            "totalFound": "{{data.searchResult.length}}",
            "noResultsFound": "",
            "selectionModelMode": "single"
        }
    },
    "messages": {
        "soaFailureMessage": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    },
    "lifecycleHooks": {
        "onUpdate": {
            "action": "closePanel",
            "observers": ["props.subPanelContext.selectionData.selected[0].uid"]
        }
    },
    "i18n": {
        "saw1ReplaceRevisionCommandTitle": [
            "ScheduleManagerMessages"
        ],
        "saw1Revisions": [
            "ScheduleManagerMessages"
        ],
        "saw1Replace": [
            "ScheduleManagerMessages"
        ],
        "zeroSearchResults": [
            "ScheduleManagerMessages"
        ]
    }
}
