{
    "schemaVersion": "1.0.0",
    "actions": {
        "schGoToDateApply": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "scrollToDateInGantt",
                    "eventData": {
                        "dateString": "{{data.enterDate.dbValue}}",
                        "isToday": false
                    }
                } ]
            },
            "events": {
                "success": [ {
                    "name": "hideGoToOptionsPopup"
                } ]
            }
        },
        "hideGoToOptionsPopup": {
            "actionType": "JSFunction",
            "method": "hide",
            "inputData": {
                "popupId": "{{data.popupId}}"
            },
            "deps": "js/popupService"
        }
    },
    "data": {
        "enterDate": {
            "displayName": "{{i18n.Saw1Date}}",
            "type": "DATE",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "",
            "labelPosition": "PROPERTY_LABEL_AT_TOP"
        }
    },
    "onEvent": [ {
        "eventId": "hideGoToOptionsPopup",
        "action": "hideGoToOptionsPopup"
    } ],
    "conditions": {
        "buttonEnable": {
            "expression": "data.enterDate.dbValue"
        }
    },
    "i18n": {
        "Saw1Date": [
            "ScheduleManagerMessages"
        ],
        "Saw1Go": [
            "ScheduleManagerMessages"
        ]
    }
}
