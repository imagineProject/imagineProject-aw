{
    "schemaVersion": "1.0.0",
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "obj-nav-state": {
            "type": "object"
        },
        "vmo": {
            "type": "viewModelObject"
        },
        "selections": {
            "type": "object"
        }
    },
    "actions": {
        "buildCrumbs": {
            "actionType": "JSFunction",
            "method": "createCrumbs",
            "inputData": {
                "selectedObjects": "{{props.selections}}",
                "baseSelection": "{{subPanelContext.baseSelection}}",
                "objNavState": "{{props.objNavState}}"
            },
            "outputData": {
                "crumbs": ""
            },
            "deps": "js/scheduleNavigationBreadcrumbService"
        }
    },
    "lifecycleHooks": {
        "onUpdate": [
            {
                "action": "buildCrumbs",
                "observers": [
                    "props.subPanelContext.baseSelection",
                    "props.selections.length",
                    "props.selections[0].uid",
                    "props.vmo.props.object_string.dbValue"
                ]
            }
        ]
    }
}
