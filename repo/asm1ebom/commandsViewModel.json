  "conditions": {
    "asm1IsCommandVisibleForSublocation": {
      "expression": "ctx.mselected && ctx.mselected.length>0 && conditions.asm1IsValidSublocationForCommandVisibility"
    },
    "asm1IsValidSublocationForCommandVisibility": {
      "expression": "(ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomPartsLocation' || ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomProductsLocation' || ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomDesignsLocation') && !conditions.asm1IsWorksetSubLocation && !conditions.asm1IsSessionSubLocation"
    },
    "asm1IsPartSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomPartsLocation'"
    },
    "asm1IsProductSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomProductsLocation'"
    },
    "asm1IsWorksetAndSessionSubLocation": {
      "expression": "conditions.asm1IsWorksetSubLocation || conditions.asm1IsSessionSubLocation"
    },
    "asm1IsWorksetSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomWorksetsLocation'"
    },
    "asm1IsSessionSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomSessionsLocation'"
    },
    "asm1IsDesignSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com_siemens_splm_client_ebom:ebomDesignsLocation'"
    },
    "asm1LaunchAlignCommandCondition": {
      "expression": "conditions.asm1IsValidSublocationForCommandVisibility && conditions.asm1IsSingleSelection"
    },
    "asm1IsSingleSelection": {
      "expression": "ctx.mselected && ctx.mselected.length === 1 "
    },
    "asm1EditTableCommandCondition": {
      "expression": "conditions.isStartEditTableAllowed"
    },
    "asm1IsTableOrTableSummaryView": {
      "expression": "(ctx.ViewModeContext.ViewModeContext === 'TableView' || ctx.ViewModeContext.ViewModeContext === 'TableSummaryView' )"
    },
    "asm1CancelEditsPWACommandActive": {
      "expression": "!conditions.asm1IsEditInProgressInTableWithSummary && conditions.asm1IsTableContextNotActive"
    },
    "asm1IsEditInProgressInTableWithSummary": {
      "expression": "!ctx.NONE._editing && !conditions.asm1IsTableContextNotActive"
    },
    "asm1IsTableContextNotActive": {
      "expression": "ctx.TABLE_CONTEXT && ctx.TABLE_CONTEXT._editing"
    },
    "asm1IsEbomWorkspacePagesSubLocation": {
      "expression": "conditions.asm1IsPartSubLocation || conditions.asm1IsProductSubLocation || conditions.asm1IsDesignSubLocation || conditions.asm1IsSessionSubLocation || conditions.asm1IsWorksetSubLocation"
    },
    "asm1IsAwp0StartEditTableCommandVisible": {
      "expression": "conditions.asm1IsEbomWorkspacePagesSubLocation && conditions.asm1EditTableCommandCondition"
    },
    "asm1IsAddPartCommandCondition": {
      "expression": "conditions.asm1IsPartSubLocation && ctx.mselected && ctx.mselected.length === 0"
    },
    "isAddProductCommandCondition": {
      "expression": "conditions.asm1IsProductSubLocation && ctx.mselected && ctx.mselected.length === 0"
    },
    "isAddDesignCommandCondition": {
      "expression": "conditions.asm1IsDesignSubLocation && ctx.mselected && ctx.mselected.length === 0"
    }
  },
