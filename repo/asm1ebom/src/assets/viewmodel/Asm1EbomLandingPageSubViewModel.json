    "actions": {
        "getTiles": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-AWS2-2022-12-DataManagement",
            "method": "getCurrentUserGateway3",
            "inputData": {},
            "outputData": {
                "tileGroups": "tileGroups"
            },
            "actionMessages": {
                "failure": [ {
                    "message": "accessingGatewayFailed"
                } ]
            }
        },
        "getInboxData": {
            "actionType": "dataProvider",
            "method": "inboxDataProvider"
        },
        "navigationInboxAction": {
            "actionType": "Navigate",
            "navigateTo": "myTasks",
            "navigationParams": {}
        },
        "loadInboxData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "maxToLoad": 10,
                        "maxToReturn": 10,
                        "providerName": "Awp0InboxProvider",
                        "searchCriteria": {
                            "searchInboxContentType": "myTasks",
                            "searchString": ""
                        },
                        "searchFilterFieldSortType": "Priority",
                        "searchFilterMap6": {},
                        "searchSortCriteria": "{{ctx.sublocation.sortCriteria}}",
                        "startIndex": "{{data.dataProviders.inboxDataProvider.startIndex}}"
                    },
                    "inflateProperties": false
                },
                "1": {
                    "types": [ {
                        "name": "BusinessObject",
                        "properties": [ {
                            "name": "awp0CellProperties"
                        } ]
                    } ]
                }
            },
            "outputData": {
                "inboxTotalCount": "totalFound",
                "inboxSearchResults": "{{json:searchResultsJSON}}"
            }
        },
        "getRecentObjects": {
            "actionType": "dataProvider",
            "method": "recentObjDataProvider"
        },
        "navigationRecentAction": {
            "actionType": "Navigate",
            "navigateTo": "myRecentViewedObjects",
            "navigationParams": {}
        },
        "loadRecentObjects": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "maxToLoad": 10,
                        "maxToReturn": 10,
                        "providerName": "Awp0RecentObjectsProvider",
                        "attributesToInflate": [
                            "awp0CellProperties",
                            "awp0ThumbnailImageTicket"
                        ],
                        "searchCriteria": {
                            "search": ""
                        },
                        "startIndex": "{{data.dataProviders.recentObjDataProvider.startIndex}}"
                    }
                }
            },
            "outputData": {
                "recentTotalCount": "totalFound",
                "recentSearchResults": "{{json:searchResultsJSON}}"
            }
        },
        "getSubscriptionData": {
            "actionType": "dataProvider",
            "method": "subscriptionDataProvider"
        },
        "navigationSubscriptionAction": {
            "actionType": "Navigate",
            "navigateTo": "com_siemens_splm_client_subscription_follow_NewsFeedSubscriptions",
            "navigationParams": {}
        },
        "loadSubscriptionData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "maxToLoad": 10,
                        "maxToReturn": 10,
                        "providerName": "Sub0NotificationProvider",
                        "searchCriteria": {
                            "Fnd0Message": "*",
                            "searchFromLocation": "global",
                            "searchString": ""
                        },
                        "searchFilterFieldSortType": "Alphabetical",
                        "searchFilterMap6": {},
                        "searchSortCriteria": [ {
                            "fieldName": "fnd0SentDate",
                            "sortDirection": "DESC"
                        } ],
                        "startIndex": "{{data.dataProviders.subscriptionDataProvider.startIndex}}"
                    },
                    "inflateProperties": false
                },
                "1": {
                    "types": [ {
                        "name": "BusinessObject",
                        "properties": [ {
                            "name": "awp0CellProperties"
                        } ]
                    } ]
                }
            },
            "outputData": {
                "subscriptionTotalCount": "totalFound",
                "subscriptionSearchResults": "{{json:searchResultsJSON}}"
            }
        },
        "getMyChanges": {
            "actionType": "dataProvider",
            "method": "myChangesDataProvider"
        },
        "loadMyChanges": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "maxToLoad": 10,
                        "maxToReturn": 10,
                        "providerName": "Cm1MyChangesProvider",
                        "searchCriteria": {
                            "changesProviderContentType": "All",
                            "typeToDisplay": ""
                        },
                        "startIndex": "{{data.dataProviders.myChangesDataProvider.startIndex}}"
                    }
                }
            },
            "outputData": {
                "changeResult": "{{json:searchResultsJSON}}",
                "changeTotalFound": "totalFound",
                "changeTotalLoaded": "totalLoaded"
            }
        },
        "navigationChangeAction": {
            "actionType": "Navigate",
            "navigateTo": "showChanges",
            "navigationParams": {}
        },
        "init": {
            "actionType": "batchJob",
            "steps": [ {
                    "action": "getTiles"
                },
                {
                    "action": "getInboxData"
                },
                {
                    "action": "getRecentObjects"
                },
                {
                    "action": "getSubscriptionData",
                    "condition": "conditions.isSubscriptionLoaded"
                },
                {
                    "action": "getMyChanges"
                }
            ]
        }
    },
