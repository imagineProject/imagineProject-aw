{
    "schemaVersion" : "1.0.0",
    "conditions": {
        "checkIfOnlySWAIsEmpty": {
            "expression": "subPanelContext.context.searchState.totalFound > 0 && props.subPanelContext.selection.length === 0"
        },
        "checkIfPWAIsEmpty": {
            "expression": "!subPanelContext.context.searchState.totalFound && !subPanelContext.context.searchState.totalLoaded && props.subPanelContext.selection.length === 0"
        }
    }
}
