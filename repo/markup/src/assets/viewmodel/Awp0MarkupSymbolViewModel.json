{
    "schemaVersion" : "1.0.0",
    "imports":
    [
        "js/aw-panel-body.directive"
    ],
    "actions":
    {
        "showSymbolPanel":
        {
            "actionType": "JSFunction",
            "method": "showSymbolPanel",
            "deps": "js/Awp0MarkupService"
        },
        "hideSymbolPanel":
        {
            "actionType": "JSFunction",
            "method": "hideSymbolPanel",
            "deps": "js/Awp0MarkupService"
        },
        "symbolTabChanged":
        {
            "actionType": "JSFunctionAsync",
            "method": "symbolTabChanged",
            "inputData": {
                "selectedTab": "{{data.selectedTab}}"
            },
            "outputData": {
                "symbolList": "symbolList",
                "uploadable": "uploadable",
                "deletable": "deletable",
                "modifiable": "modifiable"
            },
            "deps": "js/Awp0MarkupService"
        },
        "fileChanged":
        {
            "actionType": "JSFunctionAsync",
            "method": "fileChanged",
            "inputData": {
                "parameters": "{{parameters}}"
            },
            "outputData": {
                "symbolList": "symbolList",
                "uploadable": "uploadable"
            },
            "deps": "js/Awp0MarkupService"
        },
        "uploadSymbols":
        {
            "actionType": "JSFunction",
            "method": "uploadSymbols",
            "inputData": {
                "symbolList": "{{data.symbolList}}",
                "tabsSymbolModel": "{{data.tabsSymbolModel}}",
                "data":"{{data.symbolGroupList}}"
            },
            "outputData": {
                "tabsSymbolModel": "tabsSymbolModel",
                "selectedTab": "selectedTab"
            },
            "deps": "js/Awp0MarkupService"
        },
        "modifySymbols": {
            "actionType": "JSFunctionAsync",
            "method": "modifySymbols",
            "inputData": {
                "selectedSymbols": "{{data.selectedSymbols}}",
                "symbolGroup": "{{data.symbolGroup.dbValue}}",
                "symbolName": "{{data.symbolName.dbValue}}"
            },
            "outputData": {
                "symbolList": "symbolList",
                "groupNameList.dbValue": "groupNameList",
                "selectedSymbols": "selectedSymbols",
                "modifiable": "modifiable",
                "deletable": "deletable"
            },
            "deps": "js/Awp0MarkupService"
        },
        "deleteSymbols": {
            "actionType": "JSFunctionAsync",
            "method": "deleteSymbols",
            "inputData": {
                "selectedSymbols": "{{data.selectedSymbols}}"
            },
            "outputData": {
                "symbolList": "symbolList",
                "groupNameList.dbValue": "groupNameList",
                "selectedSymbols": "selectedSymbols",
                "modifiable": "modifiable",
                "deletable": "deletable"
            },
            "deps": "js/Awp0MarkupService"
        },
        "manageSymbolSelected":
        {
            "actionType": "JSFunction",
            "method": "manageSymbolSelected",
            "inputData": {
                "list": "{{data.symbolList}}"
            },
            "outputData": {
                "selectedSymbols": "selectedSymbols",
                "symbolGroup.dbValue": "symbolGroup",
                "symbolGroup.uiValue": "symbolGroup",
                "symbolName.dbValue": "symbolName",
                "deletable": "deletable",
                "modifiable": "modifiable"
            },
            "deps": "js/Awp0MarkupService"
        },
        "symbolSizeChanged":
        {
            "actionType": "JSFunction",
            "method": "setSymbolSize",
            "inputData": {
                "list": "{{data.sizeValue.dbValue}}"
            },
            "deps": "js/Awp0MarkupService"
        },
        "symbolGroupOrNameChanged":
        {
            "actionType": "JSFunction",
            "method": "symbolGroupOrNameChanged",
            "inputData": {
                "symbolGroup": "{{data.symbolGroup.dbValue}}",
                "symbolName": "{{data.symbolName.dbValue}}",
                "selectedSymbols": "{{data.selectedSymbols}}"
            },
            "outputData": {
                "modifiable": "modifiable",
                "deletable": "deletable"
            },
            "deps": "js/Awp0MarkupService"
        },
        "getGroupNameList":
        {
            "actionType": "JSFunction",
            "method": "getGroupNameList",
            "inputData": {
                "list": "{{data.symbolList}}"
            },
            "outputData": {
                "groupNameList.dbValue": "groupNameList"
            },
            "deps": "js/Awp0MarkupService"
        },
        "getAddedNewSymbolGrouplist":
        {
            "actionType": "JSFunction",
            "method": "getAddedNewSymbolGrouplist",
            "inputData": {
                "ctx": "{{ctx}}"
            },
            "outputData": {
                "groupNameList.dbValue": "groupNameList"
          },
            "deps": "js/Awp0MarkupService"
        },
        "symbolFilterChanged":
        {
            "actionType": "JSFunction",
            "method": "symbolFilterChanged",
            "inputData": {
                "text": "{{data.symbolFilter.dbValue}}"
            },
            "outputData": {
                "symbolList": "symbolList"
            },
            "deps": "js/Awp0MarkupService"
        },
        "addNewGroupAction": {
          "actionType": "JSFunction",
          "method": "addNewGroupAction",
          "inputData": {
              "data":"{{data}}",
              "tabsSymbolModel": "{{data.tabsSymbolModel}}"
          },
         "outputData": {
                "tabsSymbolModel": "tabsSymbolModel",
                "selectedTab": "selectedTab"
            },
        "deps": "js/Awp0MarkupService"
      }
    },

    "data":
    {
        "tabsSymbolModel":
        {
            "isArray": "true",
            "dbValue":
            [
                {
                    "name": "{{i18n.apply}}",
                    "tabKey": "apply",
                    "selectedTab": true
                },
                {
                    "name": "{{i18n.manage}}",
                    "tabKey": "manage"
                },
                {
                    "name": "{{i18n.upload}}",
                    "tabKey": "upload"
                },
                {
                    "name": "{{i18n.newGroup}}",
                    "tabKey": "newGroup"
                }
            ]
        },
        "symbolGroup": {
            "displayName": "{{i18n.symbolGroup}}",
            "type": "STRING",
            "dataProvider": "listProviderGroupName",
            "dbValue": "",
            "uiValue": "",
            "isSelectOnly": false
        },
        "symbolGroupList": {
            "displayName": "{{i18n.symbolGroup}}",
            "type": "STRING",
            "dataProvider": "providerSymbolGrouplist",
            "dbValue": "",
            "uiValue": ""
        },
        "symbolName":
        {
            "displayName": "{{i18n.symbolName}}",
            "type": "STRING",
            "dbValue": "",
            "uiValue": "",
            "requiredText": "{{i18n.enterSymbolName}}"
        },
        "newGroupName":
        {
            "displayName": "{{i18n.groupName}}",
            "isRequired": "true",
            "type": "STRING",
            "dbValue": "",
            "uiValue": ""
        },
        "sizeValue":
        {
            "displayName": "{{i18n.symbolSize}}",
            "type": "STRING",
            "hasLov": "true",
            "dbValue": "32",
            "uiValue": "{{i18n.medium}}"
        },
        "sizeList":
        {
            "type": "STRING",
            "dbValue": [
                {
                    "propDisplayValue": "{{i18n.extraSmall}}",
                    "propInternalValue": "16"
                },
                {
                    "propDisplayValue": "{{i18n.small}}",
                    "propInternalValue": "24"
                },
                {
                    "propDisplayValue": "{{i18n.medium}}",
                    "propInternalValue": "32"
                },
                {
                    "propDisplayValue": "{{i18n.large}}",
                    "propInternalValue": "48"
                },
                {
                    "propDisplayValue": "{{i18n.extraLarge}}",
                    "propInternalValue": "64"
                }
            ]
        },
        "symbolFilter": {
            "type": "STRING",
            "dbValue": "",
            "uiValue": "",
            "requiredText": "{{i18n.filterSymbolGroupOrName}}"
        },
        "symbolList": [],
        "selectedTab": { "tabKey": "apply" },
        "selectedSymbols": []
    },
    "dataProviders": {
        "listProviderGroupName": {
            "action": "getGroupNameList",
            "response": "{{data.groupNameList.dbValue}}",
            "totalFound": "{{data.groupNameList.dbValue.length}}"
        },
        "providerSymbolGrouplist": {
            "action": "getAddedNewSymbolGrouplist",
            "response": "{{data.groupNameList.dbValue}}",
            "totalFound": "{{data.groupNameList.dbValue.length}}"
        }
    },
    "i18n":
    {
        "symbol": [ "MarkupMessages" ],
        "apply": [ "MarkupMessages" ],
        "manage": [ "MarkupMessages" ],
        "upload": [ "MarkupMessages" ],
        "newGroup": [ "MarkupMessages" ],
        "mySymbols": [ "MarkupMessages" ],
        "sharedSymbols": [ "MarkupMessages" ],
        "symbolGroup": [ "MarkupMessages" ],
        "enterGroupName": [ "MarkupMessages" ],
        "groupName": [ "MarkupMessages" ],
        "symbolName": [ "MarkupMessages" ],
        "enterSymbolName": [ "MarkupMessages" ],
        "symbolSize": [ "MarkupMessages" ],
        "extraSmall": [ "MarkupMessages" ],
        "small": [ "MarkupMessages" ],
        "medium": [ "MarkupMessages" ],
        "large": [ "MarkupMessages" ],
        "extraLarge": [ "MarkupMessages" ],
        "modify": [ "MarkupMessages" ],
        "del": [ "MarkupMessages" ],
        "confirmDeleteSymbols": [ "MarkupMessages" ],
        "filterSymbolGroupOrName": [ "MarkupMessages" ],
        "ADD_BUTTON_TITLE": [
            "BaseMessages"
        ]
    },

    "lifecycleHooks": {
        "onMount": "showSymbolPanel",
        "onUnmount": "hideSymbolPanel",
        "onUpdate": {
            "action": "symbolTabChanged",
            "observers": [ "viewModel.data.selectedTab" ]
        }
    },

    "onEvent":
    [
        {
            "eventId": "awPanel.navigate",
            "action": "hideSymbolPanel",
            "criteria": { "destPanelId": "Awp0MarkupList" }
        },
        {
            "eventId": "condition.expressionValueChanged",
            "action": "symbolGroupOrNameChanged",
            "criteria": {
                "condition": "conditions.symbolGroupCondition"
            }
        },
        {
            "eventId": "condition.expressionValueChanged",
            "action": "symbolGroupOrNameChanged",
            "criteria": {
                "condition": "conditions.symbolNameCondition"
            }
        },
        {
            "eventId": "condition.expressionValueChanged",
            "action": "symbolFilterChanged",
            "criteria": {
                "condition": "conditions.symbolFilterCondition"
            }
        }
    ],
    "conditions": {
        "symbolGroupCondition": {
            "expression": "data.symbolGroup.dbValue",
            "trackValues": true
        },
        "symbolNameCondition": {
            "expression": "data.symbolName.dbValue",
            "trackValues": true
        },
        "symbolFilterCondition": {
            "expression": "data.symbolFilter.dbValue",
            "trackValues": true
        }
    }
}
