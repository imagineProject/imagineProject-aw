{
    "schemaVersion": "1.0.0",
    "data": {
        "symbolName":
        {
            "displayName": "{{i18n.symbolName}}",
            "type": "STRING",
            "dbValue": "",
            "uiValue": ""
        }
    },
    "conditions": {
        "isSVGEditEnabled": {
            "expression": "data.isSVGEditEnabled === true"
        }
    },
    "onEvent": [
    ],
    "actions": {
        "getSymbolName":
        {
            "actionType": "JSFunction",
            "method": "getSymbolName",
            "outputData": {
                "symbolName.uiValue": "symbolName",
                "symbolName.dbValue": "symbolName",
                "isSVGEditEnabled":"isSVGEditEnabled"
            },
            "deps": "js/Awp0MarkupService"
        }
    },
    "lifecycleHooks": {
        "onMount": "getSymbolName"
    },
    "i18n": {
        "editSymbol": [ "MarkupMessages" ],
        "createSymbol": [ "MarkupMessages" ],
        "symbolName": [ "MarkupMessages" ]
    }
}
