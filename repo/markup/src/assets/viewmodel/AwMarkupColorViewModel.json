{
    "schemaVersion": "1.0.0",
    "actions": {
        "render": {
            "method": "awMarkupColorRenderFunction",
            "deps": "js/AwMarkupColorService",
            "options": {
                "elementRefList": [ "markupSelectedColorPatch" ]
            }
        },
        "updateColors": {
            "actionType": "JSFunction",
            "method": "awMarkupColorUpdateFunction",
            "deps": "js/AwMarkupColorService",
            "inputData": {
                "elementRefList": "{{parameters.elementRefList}}",
                "props": "{{props}}"
            }
        }
    },
    "data": {
        "lov": {
            "expanded": false,
            "styles": {}
        }
    },
    "conditions": {},
    "onEvent": [],
    "lifecycleHooks": {
        "render": "render",
        "onMount": "updateColors",
        "onUpdate": [
            {
                "action": "updateColors",
                "observers": [
                    "viewModel.data.popupOpened"
                ]
            }
        ]
    },
    "props": {
        "prop": { "type": "object" },
        "list": { "type": "object" },
        "action": { "type": "action" }
    }
}
