{
    "schemaVersion": "1.0.0",
    "data": {
        "symbolSvgContent":""
    },
    "actions": {
        "saveSVGContent":
        {
            "actionType": "JSFunction",
            "method": "getSVGContent",
            "outputData": {
                "symbolSvgContent": ""
            },
            "events": {
                "success": [
                    {
                        "name": "saveSvgContentFromEditor"
                    }
                ]
            },
            "deps": "js/Awp0SvgEditService"
        },
        "saveSVG":
        {
            "actionType": "JSFunction",
            "method": "saveSVGSymbol",
            "inputData": {
                "ctx": "{{ctx}}",
                "symbolSvgContent": "{{symbolSvgContent}}"
            },
            "deps": "js/Awp0SvgEditService"
        },
        "showWarningOnCancelSvgEdit":
        {
            "actionType": "JSFunction",
            "method": "checkContentChanged",
            "inputData": {
                "ctx": "{{ctx}}"
            },
            "deps": "js/Awp0SvgEditService"
        },
        "setLocationChangeListener": {
            "actionType": "JSFunction",
            "method": "setLocationChangeListener",
            "inputData": {
                "ctx": "{{ctx}}"
            },
            "deps": "js/Awp0SvgEditService"
        },
        "unRegisterLeaveHandler": {
            "actionType": "JSFunction",
            "method": "unRegisterLeaveHandler",
            "deps": "js/Awp0SvgEditService"
        }
    },
    "lifecycleHooks": {
        "onMount": "setLocationChangeListener",
        "onUnmount": "unRegisterLeaveHandler"
    },
    "onEvent": [
        {
            "eventId": "saveSvgContentFromEditor",
            "action": "saveSVG"
        }
     ],
    "messages": {
    },
    "ctx": {
        "saveSvgButtonState": {
            "type": "boolean"
        }
    },
    "i18n": {
        "save": [ "MarkupMessages" ],
        "cancel": [ "MarkupMessages" ]
    }
}
