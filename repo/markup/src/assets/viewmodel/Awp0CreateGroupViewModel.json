{
    "schemaVersion" : "1.0.0",
    "data":{
        "groupName":
        {
            "displayName": "{{i18n.groupName}}",
            "isRequired": "true",
            "type": "STRING",
            "dbValue": "",
            "uiValue": ""
        },
        "fileSymbolList": [],
        "uploadFileSelectionData": {
            "modelInfo": {},
            "files": [],
            "selectedFileInfo": {},
            "selectedFile": {}
        },
        "symbolList": []
    },
    "actions":{
        "fileChanged":
        {
            "actionType": "JSFunctionAsync",
            "method": "fileChanged",
            "inputData": {
                "parameters": "{{parameters}}"
            },
            "outputData": {
                "fileSymbolList": "symbolList",
                "uploadable": "uploadable"
            },
            "deps": "js/Awp0MarkupService"
        },
        "createSymbolGroup":{
            "actionType": "JSFunctionAsync",
            "method": "createSymbolGroup",
            "inputData":{
                "data": "{{data}}"
            },
            "events": {
                "success": [
                    {
                        "name": "markupCreateSymbolGroup.updateSymbols"
                    }
                ]
            },
            "deps": "js/Awp0MarkupService"
        },
        "showSymbolList":
        {
            "actionType": "JSFunctionAsync",
            "method": "showSymbolList",
            "inputData": {},
            "outputData": {
                "symbolList": "symbolList"
            },
            "deps": "js/Awp0MarkupService"
        },
        "manageSymbolSelected":
        {
            "actionType": "JSFunction",
            "method": "manageSymbolSelected",
            "inputData": {
                "list": "{{data.symbolList}}"
            },
            "outputData": {
                "selectedSymbols": "selectedSymbols",
                 "symbolGroup.dbValue": "symbolGroup",
                "symbolGroup.uiValue": "symbolGroup",
                "symbolName.dbValue": "symbolName",
                "deletable": "deletable",
                "modifiable": "modifiable"
            },
            "deps": "js/Awp0MarkupService"
        }
    },
    "functions": {},
    "lifecycleHooks": {
        "onMount": "showSymbolList"
    },
    "onEvent": [
        {
            "eventId": "markupCreateSymbolGroup.updateSymbols",
            "action": "showSymbolList"
        }
    ],
    "i18n":{
        "groupName": [ "MarkupMessages" ],
        "properties": [ "MarkupMessages" ],
        "upload": [ "MarkupMessages" ],
        "create": [ "MarkupMessages" ],
        "existingSymbol": [ "MarkupMessages" ]
    }
}
