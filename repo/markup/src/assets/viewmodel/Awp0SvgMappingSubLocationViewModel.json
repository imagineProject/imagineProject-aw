{
    "schemaVersion": "1.0.0",
    "data": {
    },
    "conditions": {
    },
    "onEvent": [
        {
            "eventId": "loadSVGData",
            "action": "loadSVGData"
        },
        {
            "eventId": "monitorCanvas",
            "action": "monitorCanvas"
        }
    ],
    "actions": {
        "getViewerData":
        {
            "actionType": "JSFunction",
            "method": "getViewerData",
            "inputData": {
                "selectedSymbol": "{{ctx.symbolContentCtx}}"
            },
            "outputData": {
                "toLoadContent": ""
            },
            "events": {
                "success": [
                    {
                        "name": "loadSVGData",
                       "condition": "data.toLoadContent === true"
                    },
                    {
                        "name": "monitorCanvas"
                    }
                ]
            },
            "deps": "js/Awp0SvgEditService"
        },
        "loadSVGData":
        {
            "actionType": "JSFunction",
            "method": "loadSVGContent",
            "inputData": {
                "selectedSymbol": "{{ctx.symbolContentCtx}}"
            },
            "deps": "js/Awp0SvgEditService"
        },
        "monitorCanvas":
        {
            "actionType": "JSFunction",
            "method": "monitorCanvas",
            "deps": "js/Awp0SvgEditService"
        }
    },
    "lifecycleHooks": {
        "onMount": "getViewerData"
    },
    "i18n": {
    }
}
