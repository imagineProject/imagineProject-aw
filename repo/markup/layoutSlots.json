{
  "slots": {
    "svgContentHeaderTitle": {
      "name": "aw_headerTitle",
      "view": "Awp0SvgContentHeader",
      "activeWhen": {
        "condition": "conditions.isSvgEditTaskBarView"
      }
    },
    "svgContentTaskBar": {
      "name": "aw_taskBar",
      "view": "Awp0SvgContentTaskBar",
      "activeWhen": {
        "condition": "conditions.isSvgEditTaskBarView"
      }
    }
  },
  "conditions": {
    "isSvgEditTaskBarView": {
      "expression": "context.subLocationTabCond.currentTab === 'SvgEdit'"
    }
  }
}
