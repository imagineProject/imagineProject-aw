{
    "schemaVersion": "1.0.0",
    "actions": {
        "setActiveTab":{
            "actionType":"JSFunction",
            "method":"setActiveTab",
            "inputData":{
                "selectedTab":"{{data.selectedTab}}",
                "tabsModel":"{{data.tabsModel}}",
                "setDefaultTab":"{{data.setDefaultTab}}",
                "viewerContextData":"{{props.viewerContextData}}"
            },
            "outputData":{
                "defaultSelectedTab":"defaultSelectedTab",
                "selectedTab":"selectedTab",
                "setDefaultTab":"setDefaultTab"
            },
            "deps": "js/Awv0ImageCaptureService"
        }
    },
    "data": {
        "tabsModel": [ {
                "name": "{{i18n.snapshotTab}}",
                "tabKey": "InputSnapshot",
                "visibleWhen": {
                    "condition": "conditions.showSnapshottab"
                },
                "selectWhen":{
                    "condition": "conditions.renderSnapshottab"
                }
            },
            {
                "name": "{{i18n.imagesTab}}",
                "tabKey": "InputImageCapture",
                "selectWhen":{
                    "condition": "conditions.renderImageCaptureTab"
                },
                "visibleWhen":{
                    "condition":"conditions.showImageCaptureTab"
                }
            }
        ],
        "setDefaultTab":true
    },
    "conditions": {
        "renderSnapshottab": {
            "expression": "data.defaultSelectedTab === 'InputSnapshot' && conditions.showSnapshottab"
        },
        "renderImageCaptureTab":{
            "expression":"props.viewerAtomicData.activeManagers.indexOf('imageCaptureMgr')>-1 && (data.defaultSelectedTab === 'InputImageCapture' || !conditions.showSnapshottab)"
        },
        "showSnapshottab": {
            "expression": "conditions.isSnapshotModuleInstalled && ctx.sublocation.nameToken === 'com.siemens.splm.client.occmgmt:OccurrenceManagementSubLocation' && !ctx.splitView.mode && ((props.context.occContext.topElement.modelType.typeHierarchyArray.indexOf('Fnd0AppSession') === -1) || ctx.aceActiveContext.context.topElement.modelType.typeHierarchyArray.indexOf('Fnd0AppSession') !== -1) && !(ctx.aceActiveContext.context.topElement.modelType.typeHierarchyArray.indexOf('Cae1ModelDesignElement') > -1) && !(ctx.aceActiveContext.context.workingContextObj && (ctx.aceActiveContext.context.workingContextObj.modelType.typeHierarchyArray.indexOf( 'Awb0SavedBookmark' ) > -1)) && props.viewerAtomicData.activeManagers.indexOf('snapshotMgr')>-1"
        },
        "isSnapshotModuleInstalled": {
            "expression": "props && props.viewerAtomicData.snapshotModuleInstalled"
        },
        "showImageCaptureTab":{
            "expression": "props.viewerAtomicData.activeManagers.indexOf('imageCaptureMgr')>-1"
        }
    },
    "preferences": [],
    "dataProviders": {},
    "lifecycleHooks": {},
    "i18n": {
        "captureToolPanelTitle": [
            "ImageCaptureToolMessages"
        ],
        "createCapture": [
            "ImageCaptureToolMessages"
        ],
        "captureGallery": [
            "ImageCaptureToolMessages"
        ],
        "snapshotTab": [
            "ImageCaptureToolMessages"
        ],
        "imagesTab": [
            "ImageCaptureToolMessages"
        ]
    }
}
