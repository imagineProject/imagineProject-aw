{
  "slots": {
    "AWP0SublocationHeaderTitleSlot": {
      "name": "aw_headerTitle",
      "view": "Awp0ImpactedWorkflowTasksHeader",
      "activeWhen": {
        "condition": "conditions.isImpactedWorkflowTasksTaskbar"
      }
    },
    "ImpactedWorkflowTasksTaskbar": {
      "name": "aw_taskBar",
      "view": "Awp0ImpactedWorkflowTasksTaskbar",
      "activeWhen": {
        "condition": "conditions.isImpactedWorkflowTasksTaskbar"
      }
    }
  },
  "conditions": {
    "isImpactedWorkflowTasksTaskbar": {
      "expression": "ctx.locationContext['ActiveWorkspace:Location'] === 'impactedWorkflowTasksRoot'"
    }
  }
}
