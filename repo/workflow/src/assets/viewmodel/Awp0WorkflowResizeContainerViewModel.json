{
    "schemaVersion": "1.0.0",
    "actions": {
        "render": {
            "method": "renderFunction",
            "deps": "js/Awp0WorkflowResizeContainerService"
        },
        "onResize": {
            "actionType": "JSFunction",
            "method": "handleResizeEvent",
            "inputData": {
                "data": "{{data.data}}",
                "dispatch": "{{data.dispatch}}"
            },
            "deps": "js/Awp0WorkflowResizeContainerService"
        }
    },
    "onEvent": [
        {
            "eventId": "aw.windowResize",
            "action": "onResize"
        }
    ],
    "lifecycleHooks": {
        "render": "render"
    },
    "data": {},
    "props": {
        "view-id": {
            "type": "string",
            "doc": {
                "type": "string",
                "required": true,
                "description": "Represents the Id which is used to uniquely identify the rendered view.",
                "access": "public"
            }
        }
    }
}
