{
    "schemaVersion" : "1.0.0",
    "imports":
    [
        "js/aw-panel-body.directive",
        "js/aw-panel-section.directive",
        "js/visible-when.directive"
    ],

    "actions":
    {
        "search":
        {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "maxToLoad": 50,
                        "maxToReturn": 50,
                        "providerName": "Awp0SignoffsProvider",
                        "searchCriteria": {
                            "processUid": "{{props.subPanelContext.selectionData.value.selected[0].uid}}",
                            "signoffContentType": "StartedPSSignoffContentType"
                        },
                        "searchFilterFieldSortType": "Priority",
                        "searchFilterMap6": {},
                        "searchSortCriteria": [],
                        "startIndex": 0
                    },
                    "inflateProperties": false
                },
                "1": {
                    "types":
                    [
                        {
                            "name": "Signoff",
                            "properties": [
                                {
                                    "name": "fnd0Performer"
                                },
                                {
                                    "name": "decision"
                                },
                                {
                                    "name":"resource_pool"
                                }
                            ]
                        }
                    ]
                }
            },
            "outputData": {
                "signoffProviderSearchResults": "{{function:getSignoffTableData}}",
                "totalFound": "totalFound"
            }
        }
    },

    "columnProviders": {
        "tableColumnProvider" : {
            "soaEnabled": false,
            "sortCriteria": [],
            "columns": [
                {
                    "name": "Performer",
                    "displayName": "{{i18n.performer}}",
                    "width": 185,
                    "isTreeNavigation": false,
                    "isTableCommand" : false,
                    "minWidth" : 100,
                    "enableColumnHiding": false
                },
                {
                    "name": "decision",
                    "displayName": "{{i18n.decision}}",
                    "width": 80,
                    "isTreeNavigation": false,
                    "isTableCommand" : false,
                    "minWidth" : 75,
                    "enableColumnHiding": false
                }
            ]
        }
    },
    "dataProviders": {
        "signoffDataProvider": {
            "action": "search",
            "response": "{{data.signoffProviderSearchResults}}",
            "totalFound": "{{data.totalFound}}"
        }
    },

    "functions":
    { "getSignoffTableData": {
        "functionName": "populateSignoffTableData",
        "parameters": [],
        "deps": "js/Awp0SignoffService"
        }
    },

    "grids": {
        "signoffTable": {
            "columnProvider": "tableColumnProvider",
            "dataProvider": "signoffDataProvider",
            "enableArrangeMenu": false,
            "addIconColumn": false,
            "gridOptions": {
                "enableGridMenu": false,
                "enablePinning": false,
                "enableSorting": false
            }
        }
    },

    "data":
    {

    },

    "i18n":
    {
         "currentSignoffs": ["InboxMessages"],
         "decision":["InboxMessages"],
         "performer":["InboxMessages"]
    }
}
