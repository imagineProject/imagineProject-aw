{
  "actions": {
    "dragUserAssignmentAction": {
      "actionType": "syncFunction",
      "method": "dragUserAssignmentAction",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/Awp0WorkflowAssignmentDragDropService"
    },
    "dragOverAssignmentAction": {
      "actionType": "syncFunction",
      "method": "dragOverAssignmentAction",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/Awp0WorkflowAssignmentDragDropService"
    },
    "dropOnAssignmentAction": {
      "actionType": "syncFunction",
      "method": "dropOnAssignmentAction",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/Awp0WorkflowAssignmentDragDropService"
    },
    "dragOverParticipantAction": {
      "actionType": "syncFunction",
      "method": "dragOverParticipantAction",
      "inputData": {},
      "deps": "js/Awp0WorkflowAssignmentDragDropService"
    },
    "dragTaskListStartAction": {
      "actionType": "syncFunction",
      "method": "dragUserListStartAction",
      "deps": "js/taskListArragementsDragDrop"
    },
    "dragOverTaskAction": {
      "actionType": "syncFunction",
      "method": "dragOverTreeTable",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/taskListArragementsDragDrop"
    },
    "dropOnTaskTableAction": {
      "actionType": "syncFunction",
      "method": "dropOnTreeTable",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/taskListArragementsDragDrop"
    }
  },
  "dragHandlers": {
    "dragHandlerForList": {
      "views": [
        "AwSearchResultsList",
        "AwPeoplePicker",
        "Awa0PeoplePickerPredictions"
      ],
      "dragActions": {
        "dragStart": "dragUserAssignmentAction"
      },
      "activeWhen": {
        "condition": "conditions.allowDragFromAssignmentsToSubmitToWorkflow"
      }
    },
    "dragHandlerForTaskTab": {
      "views": [
        "Awp0TasksTab"
      ],
      "dragActions": {
        "dragStart": "dragTaskListStartAction"
      }
    }
  },
  "dropHandlers": {
    "dropHandlerForTreeTable": {
      "views": [
        "Awp0TemplateAssignmentPanelSub",
        "Awp0WorkflowAssignment",
        "Awp0WorkflowAssignmentCategory",
        "Awp0WorkflowAssignmentParticipantCategory",
        "AwSearchResultsList",
        "AwPeoplePicker",
        "Awa0PeoplePickerPredictions"
      ],
      "dropActions": {
        "dragOver": "dragOverAssignmentAction",
        "drop": "dropOnAssignmentAction"
      },
      "activeWhen": {
        "condition": "conditions.allowDragFromAssignmentsToSubmitToWorkflow"
      }
    },
    "participantDropHandler": {
      "views": [
        "AwObjectSetList"
      ],
      "dropActions": {
        "dragOver": "dragOverParticipantAction"
      },
      "activeWhen": {
        "condition": "conditions.checkIfOnParticipantsTab"
      }
    },
    "dropHandlerForTaskTab": {
      "activeWhen": true,
      "views": [
        "Awp0TasksTab"
      ],
      "dropActions": {
        "dragOver": "dragOverTaskAction",
        "drop": "dropOnTaskTableAction"
      }
    }
  },
  "conditions": {
    "allowDragFromAssignmentsToSubmitToWorkflow": {
      "expression": "props.subPanelContext.addUserPanelState.provider === 'Awp0PeoplePickerProvider'"
    },
    "checkIfOnParticipantsTab": {
      "expression": "props.subPanelContext.pageContext.primaryActiveTabId === 'tc_xrt_Participants' || props.subPanelContext.pageContext.secondaryActiveTabId === 'tc_xrt_Participants'"
    }
  }
}
