{
  "contexts": {
    "projectContext": {
      "view": "projectContext"
    },
    "locationContext": {
      "view": "locationContext"
    }
  },
  "placements": {
    "projectPlacement": {
      "anchor": "headerContextPosition",
      "contextId": "projectContext",
      "priority": 20
    },
    "locationPlacement": {
      "anchor": "headerContextPosition",
      "contextId": "locationContext",
      "priority": 75,
      "visibleWhen": {
        "condition": "ctx.userSession.props.fnd0LocationCode && ctx.userSession.props.fnd0LocationCode.uiValues[0]!=''"
      }
    }
  }
}
