{
    "schemaVersion" : "1.0.0",
    "actions":{

        "getProjectObject":{
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "getProjectUID"
                },
                {
                    "action": "getProjectVMO",
                    "condition":"data.projectIDs.length>0"
                }
            ]
        },
        "getProjectUID":{
            "actionType": "JSFunction",
            "method": "getProjectIDs",
            "outputData":{
                "projectIDs":""
            },
            "deps": "js/projectFolderUtils"
        },
        "getProjectVMO":{
            "actionType": "JSFunction",
            "method": "createViewModelObjectById",
            "inputData": {
                "uid": "{{data.projectIDs[0].uid}}",
                "operationName": "CREATE"
            },
            "outputData":{
                "project":""
            },
            "deps": "js/tcViewModelObjectService"
        }

    },
    "lifecycleHooks": {
        "onMount":"getProjectObject"
    }

}
