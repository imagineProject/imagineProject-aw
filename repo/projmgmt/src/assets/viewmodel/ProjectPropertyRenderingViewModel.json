{
    "schemaVersion" : "1.0.0",
    "imports": [
    ],
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "actions":{
        "bindProperties":{
            "actionType": "JSFunction",
            "method": "bindProperties",
            "inputData": {
                "context": "{{props.subPanelContext}}"
            },
            "deps": "js/projMgmtService"
        },
        "useProgramSecurityChange":{
            "actionType": "JSFunction",
            "method": "changeUseProgramSecurityDisplay",
            "inputData": {
                "xrtState": "{{props.subPanelContext.xrtState}}"
            },
            "deps": "js/projMgmtService"
        },
        "isActiveChange":{
            "actionType": "JSFunction",
            "method": "changeActiveVisible",
            "inputData": {
                "xrtState": "{{subPanelContext.xrtState}}"
            },
            "deps": "js/projMgmtService"
        }
    },
    "lifecycleHooks": {
        "onUpdate":[{
            "action":"bindProperties",
            "observers":["props.subPanelContext.selected.uid"]
        },
        {
            "action":"useProgramSecurityChange",
            "observers":["props.subPanelContext.xrtState.xrtVMO.props.useProgramSecurity.fielddata.uiValue"]
        }]
    }
}
