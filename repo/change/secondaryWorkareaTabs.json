{
  "$schema": "declarativeSecondaryWorkareaTabsSchema-1.0.0.json",
  "tabs": {
    "Cm1ChangeDashboardPieChart": {
      "name": "",
      "priority": 1000,
      "view": "Cm1ChangeDashboardPieChart",
      "visibleWhen": "ctx.sublocation.nameToken === 'com.siemens.splm.client.change:changeDashboardSubLocation'"
    },
    "ChangePageEmptyState": {
      "name": "",
      "priority": 10,
      "view": "ChangePageEmptyState",
