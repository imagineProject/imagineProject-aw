{
  "slots": {
    "ChangeContextChipSlot": {
      "name": "aw_changeContext",
      "view": "AwChangeContextChip",
      "activeWhen": {
        "condition": "conditions.IsChangeMgmtInstalled"
      }
    },
    "Cm1MergeChangesHeaderTitleSlot": {
      "name": "aw_headerTitle",
      "view": "Cm1MergeChangesHeaderTitle",
      "activeWhen": {
        "condition": "conditions.IsMergeChangesSubLocation"
      }
    },
    "Cm1MergeChangesTaskBarSlot": {
      "name": "aw_taskBar",
      "view": "Cm1MergeChangesTaskbar",
      "activeWhen": {
        "condition": "conditions.IsMergeChangesSubLocation"
      }
    },
    "Cm1ChangeBomCommandBarSlot": {
      "name": "aw_pwaCommandBar",
      "view": "Cm1ChangeBomCommandBar",
      "activeWhen": {
        "condition": "conditions.IsChangeBOMSubLocation"
      }
    },
    "Cm1ChangeBomContextBarSlot": {
      "name": "aw_workareaHeader",
      "view": "AceContextBar",
      "activeWhen": {
        "condition": "conditions.IsChangeBOMSubLocation"
      }
    }
  },
  "conditions": {
    "IsMergeChangesSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com.siemens.splm.client.change:mergeChangesSubLocation' || ctx.state.params.srcPartUsgRevUID !== undefined"
    },
    "IsChangeMgmtInstalled": {
      "expression": "ctx.preferences.CM_enable_global_change_context && ctx.preferences.CM_enable_global_change_context[0] === 'true'"
    },
    "IsChangeBOMSubLocation": {
      "expression": "context.provider.name === 'com.siemens.splm.client.occmgmt:OccurrenceManagementSubLocation' && context.provider.viewModeId === 'ChangeBOMSubLocation'"
    }
  }
}
