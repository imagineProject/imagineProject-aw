{
    "schemaVersion": "1.0.0",
    "data": {
        "clickableChipNormal": {
            "chipType": "BUTTON",
            "iconId": "indicatorChipNotTrackingChanges24",
            "buttonType": "base"
        },
        "clickableChipActivate" : {
            "chipType": "BUTTON",
            "iconId": "indicatorChipTrackingChanges24",
            "buttonType": "base"
        },
        "showTooltip": {
            "view": "Cm1ChangeContextExtendedTooltip"
        }
     },
    "actions": {
        "render":{
            "method": "awChangeContextChipRenderFunction",
            "deps": "js/AwChangeContextChipService"
        },
        "displayPopup": {
            "actionType": "popup",
            "inputData": {
                "options": {
                    "view": "AwChangeContextChipPopUp",
                    "placement": "bottom",
                    "hasArrow": true,
                    "autoFocus": true
                }
            },
            "outputData": {
                "popupId": "id"
            }
        }
    },
    "dataProviders": {},
    "functions": {},
    "onEvent": [],
    "i18n": {
        "noChangeTitle": [ "ChangeMessages" ]
    },
    "messages": {},
    "conditions": {
        "normalContext": {
            "expression": "ctx.userSession.props.cm0GlobalChangeContext && ctx.userSession.props.cm0GlobalChangeContext.displayValues[0] === '' && ctx.preferences.CM_enable_global_change_context && ctx.preferences.CM_enable_global_change_context[0] === 'true'"
        },
        "highlightContext": {
            "expression": "!ctx.ecnForOpenedElement && ctx.userSession.props.cm0GlobalChangeContext && ctx.userSession.props.cm0GlobalChangeContext.displayValues[0] !== '' && ctx.preferences.CM_enable_global_change_context && ctx.preferences.CM_enable_global_change_context[0] === 'true'"
        }
    },
    "ctx": {
         "userSession.props.cm0GlobalChangeContext.dbValue": {
                "type": "string"
        },
        "userSession.props.cm0GlobalChangeContext.displayValues[0]":{
                "type": "string"
        }
    },
    "lifecycleHooks": {
        "render": "render",
        "onUpdate": [{
            "action": "render",
            "observers": [ "viewModel.ctx.userSession.props.cm0GlobalChangeContext.dbValue" ]
        }]
    }
}
