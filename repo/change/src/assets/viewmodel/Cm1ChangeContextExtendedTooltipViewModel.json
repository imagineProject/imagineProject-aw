{
    "schemaVersion": "1.0.0",
    "actions":{
        "tootlipContent": {
            "actionType": "JSFunction",
            "method":"toolTipContent",
            "inputData": {
                "contextDisplayValue": "{{ctx.userSession.props.cm0GlobalChangeContext.displayValues[0]}}",
                "contextDisplayMessage": "{{i18n.activeChange}}"
            },
            "outputData":{
                "activeChangeDisplayString":""
            },
            "deps": "js/Cm1ChangeContextExtendedToolTipService"
        }
    },
    "data": {
        "commandTitle": {
            "dispValue": "{{ctx.userSession.props.cm0GlobalChangeContext.displayValues[0]}}"
        }
    },
    "i18n": {
        "noActiveChange": ["ChangeMessages"],
        "noActiveChangeDesc": ["ChangeMessages"],
        "activeChange": ["ChangeMessages"],
        "activeChangeDesc": ["ChangeMessages"],
        "activeChangeTitle": ["ChangeMessages"],
        "noActiveChangeTitle": ["ChangeMessages"]
    },
    "conditions": {
        "activeChange": {
            "expression": "!ctx.ecnForOpenedElement && ctx.userSession.props.cm0GlobalChangeContext && ctx.userSession.props.cm0GlobalChangeContext.displayValues[0] !== '' && ctx.preferences.CM_enable_global_change_context && ctx.preferences.CM_enable_global_change_context[0] === 'true'"
        },
        "noActiveChange": {
            "expression": "ctx.userSession.props.cm0GlobalChangeContext && ctx.userSession.props.cm0GlobalChangeContext.displayValues[0] === '' && ctx.preferences.CM_enable_global_change_context && ctx.preferences.CM_enable_global_change_context[0] === 'true'"
        }
    },
    "lifecycleHooks": {
            "onMount": "tootlipContent"
        }
}
