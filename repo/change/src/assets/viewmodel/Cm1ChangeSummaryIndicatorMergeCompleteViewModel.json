{
    "schemaVersion": "1.0.0",
    "imports": [],
    "actions": {
        "initialize": {
            "actionType":"batchJob",
            "steps": [ {
                "action": "loadSourceObject"
            },
            {
                "action": "loadTooltipText"
            } ]
        },
        "loadSourceObject":{
            "actionType": "JSFunctionAsync",
            "method": "loadObjects",
            "inputData": {
                "data": [
                    "{{props.sourceUid}}"
                ]
            },
            "deps": "soa/dataManagementService"
        },
        "loadTooltipText": {
            "actionType": "JSFunction",
            "method": "getTooltipDetails",
            "inputData": {
                "tooltipTitle": "{{i18n.mergeCompleteTooltipTitle}}",
                "tooltipDesc": "{{i18n.mergeCompleteTooltipDesc}}",
                "replaceStr": "{{props.tooltipDetails.prop}}",
                "mergeContext": {
                    "isMergeIndicator": true,
                    "sourceUid": "{{props.sourceUid}}"
                }
            },
            "outputData": {
                "tooltipDetails": ""
            },
            "deps": "js/Cm1ChangeSummary2Service"
        }
    },
    "data": {},
    "messages": {},
    "conditions": {},
    "props": {},
    "lifecycleHooks": {
        "onMount": "initialize"
    },
    "i18n": {
        "mergeCompleteTooltipTitle": [ "ChangeMessages" ],
        "mergeCompleteTooltipDesc": [ "ChangeMessages" ]
    }
}
