{
    "schemaVersion": "1.0.0", 
    "imports":[],
    "dataProviders": {},
    "i18n": {
        "detailsOfChangesTitle": [
            "ChangeMessages"
        ]
    },
    "actions": {
        "initPanel": { 
            "actionType":"batchJob", 
            "steps": [ 
                {
                    "action": "registerMockupContext"
                },
                {
                    "action": "loadXrtForChangeDetails"
                }
            ]
        },
        "registerMockupContext": {
            "actionType": "JSFunction",
            "method": "registerCtx",
            "inputData": {
                "name": "isCm1DOCSubstituteMarkupEnabled",
                "value": true
            },
            "deps": "js/appCtxService"
        },
        "unregisterMockupContext": {
            "actionType": "JSFunction",
            "method": "unRegisterCtx",
            "deps": "js/appCtxService",
            "inputData": {
                "name": "isCm1DOCSubstituteMarkupEnabled"
            }
        }
    },
    "onEvent": [],
    "props": {},
    "data": {
        "panelContext": {
            "initialValues": {
                "selectedObject": ""
            },
            "meta": {}
        },
        "xrtState": {
            "initialValues": {},
            "meta": {
                "xrtVMO": {
                    "field": "true",
                    "type": "viewModelObject"
                }
            }
        },
        "subPanelContext": {
            "context": {
                "xrtContext": {
                    "changeSummaryStylesheet": "visible"
                }
            }
        }
    },
    "editHandlers": {
        "summaryPanelEditHandler": {
            "context": "NONE",
            "dataSource": {
                "xrtVMO": "{{data.xrtState}}"
            }
        }
    },
    "messages": {},
    "conditions": {},
    "grids": {},
    "dataParseDefinitions": {},
    "functions": {},
    "columnProviders": {},
    "lifecycleHooks":{
        "onMount":"initPanel",
        "onUnmount": "unregisterMockupContext"
    }
}