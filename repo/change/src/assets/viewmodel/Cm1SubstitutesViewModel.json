{
    "schemaVersion": "1.0.0",
    "data":{
        "selectionData": {
            "initialValues": {},
            "meta": {}
        },
        "context":{
            "initialValues": {},
            "meta": {}
        },
        "selectedDesignElement": {
            "initialValues": {},
            "meta": {}
        }
    },
    "lifecycleHooks": {
        "onMount": "initializeData"
    },
    "actions":{
        "initializeData":{
            "actionType": "JSFunction",
            "method": "initializeDataForSubstitutes",
            "deps": "js/Cm1ChangeSummary2Service",
            "inputData": {
                "selectionData": "{{fields.selectionData}}",
                "context": "{{fields.context}}",
                "selectedDesignElement": "{{fields.selectedDesignElement}}",
                "subPanelContext": "{{props.subPanelContext}}"
            }
        }
    }
}
