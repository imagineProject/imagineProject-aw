{
    "schemaVersion": "1.0.0",
    "data": {
        "_sublocation": {
            "name": "com.siemens.splm.client.occmgmt:OccurrenceManagementSubLocation",
            "label": {
                "source": "/i18n/changeMultiBomMessages",
                "key": "changeBomTitle"
            },
            "awSubLocationPref":{
                "showToggleWorkAreaHeader":true,
                "expandedWorkAreaHeader":false
            },
            "clientScopeURI": "ChangeBom",
            "enableOccMgmtCommands": true,
            "pageIdForContent": "tc_xrt_ChangeContent",
            "locationSupportsExpansionStateCaching": false,
            "nameToken": "com.siemens.splm.client.occmgmt:OccurrenceManagementSubLocation",
            "policy": "/policies/occMgmtPropertyPolicy.json",
            "viewBase": "occMgmt",
            "editContext": "occDataProvider",
            "contextKey": "occmgmtContext",
            "tabSetId": "occmgmtContext",
            "supportedLayouts": [ "Awp0SinglePaneLayout", "Awp0LeftRightLayout", "Awp0TopBottomLayout", "Awp0TwoLeftOneRightLayout", "Awp0OneLeftTwoRightLayout", "Awp0OneTopTwoBottomLayout", "Awp0ThreeVerticalLayout"  ],
            "AceHeaderForApplication":"Cm1ChangeBomEmptyTab",
            "supportedLayoutsForEmptyBOMTab":["Awp0SinglePaneLayout"],
            "viewModeId":"ChangeBOMSubLocation",
            "useAutoBookmark": false,
            "dataProviderName": "occDataProvider",
            "requestPref": {},
            "locationSupportsJitterFreePropLoad": true,
            "gridId": "occTreeTable",
            "isFilteringEnabled": true,
            "selectionQueryParamKey": "c_uid",
            "editSupportParamKeys": [ "c_uid", "o_uid", "spageId", "pci_uid", "h_uid" ],
            "urlParams": {
                "selectionQueryParamKey": "c_uid",
                "openStructureQueryParamKey": "o_uid",
                "rootQueryParamKey": "uid",
                "productContextQueryParamKey": "pci_uid",
                "csidQueryParamKey": "c_csid",
                "secondaryPageIdQueryParamKey": "spageId",
                "topElementQueryParamKey": "t_uid",
                "pageIdQueryParamKey": "pageId",
                "recipeParamKey": "recipe",
                "subsetFilterParamKey": "filter",
                "alternatePwaKey": "altPwa",
                "alternatePwa2Key" : "altPwa_2"
            },
            "context": {
                "commandContextParameters": [ "filter", "recipe" ],
                "search": {
                    "hideInContentSearchBox": true
                }
            },
            "viewModes": {
                "TreeSummaryView": {
                    "primaryWorkArea": "tree",
                    "secondaryWorkArea": true
                },
                "TreeView": {
                    "primaryWorkArea": "tree",
                    "secondaryWorkArea": false
                }
            },
            "defaultDisplayMode": "TreeView"
        },
        "occContext": {
            "initialValues": {
                "configContext": {},
                "displayToggleOptions": {},
                "supportedFeatures": {},
                "productContextInfo": {},
                "enableSorting": true,
                "currentState": {},
                "previousState": {},
                "transientRequestPref": {},
                "persistentRequestPref": { "defaultClientScopeUri": "ChangeBom" },
                "disabledFeatures": ["Awb0VariantFeature", "Awb0ClosureRuleFeature","Fgf0OrganizationSchemeFeature","Awb0EnableSmartDiscoveryFeature",
                                        "AceArrangementFeature", "AceContextFeature","AceViewTypeFeature","AceToggleIndexConfigurationFeature"],
                "viewKey": "occmgmtContext",
                "isRestoreOptionApplicableForProduct": false,
                "delayLoadSublocation":true
            },
            "meta": {}
        }
    },
    "actions":{

        "initialize":{
            "actionType": "batchJob",
            "steps": [
                {
                    "action":"registerPreGetOccOpenNavigateEcnExtPoints"
                },
                {
                    "action": "initializeECNBomView"
                },
                {
                    "action": "isColumnFilterEnabled"
                }
            ]
        },
        "registerPreGetOccOpenNavigateEcnExtPoints": {
            "actionType": "JSFunction",
            "method": "registerPreGetOccOpenNavigateEcnExtPoints",
            "deps": "js/Cm1ChangeBomUtils"
        },
        "initializeECNBomView": {
            "actionType": "JSFunction",
            "method": "markECNInteracted",
            "inputData":{
                "subPanelContext":"{{props.subPanelContext}}"
            },
            "outputData": {
                "isInitialized": ""
            },
            "deps": "js/Cm1ChangeBomUtils"
        },
        "isColumnFilterEnabled": {
            "actionType": "JSFunction",
            "method": "isColumnFilterEnabled",
            "inputData":{
                "dispatch":"{{data.dispatch}}"
            },
            "deps": "js/Cm1ChangeBomUtils"
        },
        "destroy": {
            "actionType": "JSFunction",
            "method": "unregisterHandlerPreGetOccOpenNavigateParamExtPoints",
            "deps": "js/Cm1ChangeBomUtils"
        }
    },
    "lifecycleHooks": {
        "onMount": "initialize",
        "onUnmount": "destroy"
    },
    "conditions": {},
    "ctx": {
        "splitView": {
            "mode": "null"
        }
    },
    "i18n": {
        "nothingHere": [
            "changeMultiBomMessages"
        ],
        "emptySearchAreaLink": [
            "changeMultiBomMessages"
        ]
    }
}
