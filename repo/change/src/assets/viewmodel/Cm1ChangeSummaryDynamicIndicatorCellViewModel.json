{
    "schemaVersion": "1.0.0",
    "imports": [],
    "actions": {
        "openDetailsOfChangePanel": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "Cm1ChangeSummary.openDetailsOfChangesPanel",
                        "eventData": {
                            "tabToOpen": "{{props.tabName}}"
                        }
                    }
                ]
            }
        },
        "loadTooltipText": {
            "actionType": "JSFunction",
            "method": "getTooltipDetails",
            "inputData": {
                "tooltipTitle": "{{i18n.cm1IndicatorTooltipText}}",
                "tooltipDesc": "{{i18n.cm1IndicatorTooltipDesc}}",
                "param": "{{props.tooltipDetails.prop}}"
            },  
            "outputData": {
                "tooltipDetails": ""
            },
            "deps": "js/Cm1ChangeSummary2Service"
        }
    },
    "data": {},
    "ports": {},
    "messages": {},
    "props": {},

    "conditions": {},

    "ctx": {},
    "lifecycleHooks": {
        "onMount": "loadTooltipText"
    },
    "onEvent": [],
    "i18n": {
        "cm1IndicatorTooltipText": [ "ChangeMessages" ],
        "cm1IndicatorTooltipDesc": [ "ChangeMessages" ]
    }
}