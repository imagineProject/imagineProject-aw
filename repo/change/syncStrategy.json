{
  "schemaVersion": "1.0.0",
  "syncStrategies": {
    "changeSummarySyncStrategy": {
      "source": {
        "view": "Cm1ChangeSummaryInternal",
        "port": "showMergeIndicator"
      },
      "target": {
        "view": "Cm1ChangeSummaryIndicatorWarning",
        "port": "isMergeCandidateVisible"
      }
    },
    "changeSummary2SyncStrategy": {
      "source": {
        "view": "Cm1ChangeSummaryInternal2",
        "port": "showMergeIndicator"
      },
      "target": {
        "view": "Cm1ChangeSummaryIndicatorWarning",
        "port": "isMergeCandidateVisible"
      }
    }
  },
  "syncStrategyHandlers": {
    "changeSummaryHandler": {
      "id": "changeSummarySyncStrategy",
      "activeWhen": true
    },
    "changeSummary2Handler": {
      "id": "changeSummary2SyncStrategy",
      "activeWhen": true
    }
  }
}
