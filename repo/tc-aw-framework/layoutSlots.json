{
  "slots": {
    "awInfoSiteChipSlot": {
      "name": "aw_infoSite",
      "view": "AwInfoSiteChip",
      "activeWhen": true
    },
    "awAppLogoSlot": {
      "name": "aw_appLogo",
      "view": "AwAppLogo",
      "activeWhen": true
    },
    "tableConfigsSwaHeaderPropertiesSlot": {
      "name": "aw_summaryHeaderProperties",
      "view": "tableConfigsSummaryHeaderProperties",
      "activeWhen": {
        "condition": "conditions.isTableConfigsLocation"
      }
    },
    "relationsTreeBreadcrumbSlot": {
      "name": "aw_workareaBreadcrumb",
      "view": "RelationsTreeBreadcrumb",
      "activeWhen": {
        "condition": "conditions.shouldShowRelationsTreeBreadcrumb"
      }
    },
    "performanceMonitoringPanelVisSlot": {
      "name": "aw_plstats_widgets_slot",
      "view": "Awv0PLStatsPanel",
      "activeWhen": true
    },
    "loggingPanelVisSlot": {
      "name": "otherModuleLoggingViewSlot",
      "view": "Awv0VisLoggingPanel",
      "activeWhen": {
        "condition": "conditions.visLoggingEnabled"
      }
    }
  },
  "conditions": {
    "isTableConfigsLocation": {
      "expression": "ctx.sublocation.nameToken === 'tableConfigsSubLocation'"
    },
    "shouldShowRelationsTreeBreadcrumb": {
      "expression": "context.searchState.intermediarySelection.length > 0 && context.sublocationState.viewModeContext.displayedViewModes.intermediaryViews.includes('AwRelationsTreeContainer')"
    },
    "visLoggingEnabled": {
      "expression": "context === 'VISLOGS'"
    }
  }
}
