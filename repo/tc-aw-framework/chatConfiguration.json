{
  "agents": {
    "Summarization": {
      "title": "{{i18n.currentlyOpenDocument}}",
      "subTitle": "ctx.chatContext.Summarization.description",
      "emptyChatTitle": "{{i18n.copilot}}",
      "emptyChatDescription": "{{i18n.docSummarizationEmptyChatDescription}}",
      "iconId": "ctx.chatContext.Summarization.iconName",
      "suggestedQuestions": [
        "{{i18n.docSummarizationSuggestedQuestion1}}",
        "{{i18n.docSummarizationSuggestedQuestion2}}",
        "{{i18n.docSummarizationSuggestedQuestion3}}"
      ],
      "priority": 100,
      "visibleWhen": {
        "condition": "conditions.summarizationVisibility"
      },
      "onQuery": {
        "method": "summarizeDocument",
        "deps": "js/documentSummarization"
      }
    }
  },
  "conditions": {
    "summarizationVisibility": {
      "expression": "ctx.chatContext.Summarization.enabled === true"
    }
  },
  "i18n": {
    "currentlyOpenDocument": [
      "Awp0ViewerGalleryMessages"
    ],
    "docSummarizationSuggestedQuestion1": [
      "Awp0ViewerGalleryMessages"
    ],
    "docSummarizationSuggestedQuestion2": [
      "Awp0ViewerGalleryMessages"
    ],
    "docSummarizationSuggestedQuestion3": [
      "Awp0ViewerGalleryMessages"
    ],
    "docSummarizationEmptyChatDescription": [
      "Awp0ViewerGalleryMessages"
    ],
    "copilot": [
      "tcCopilotMessages"
    ]
  }
}
