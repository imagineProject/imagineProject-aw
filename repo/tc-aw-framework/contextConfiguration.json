{
  "contexts": {
    "groupContext": {
      "view": "group"
    },
    "roleContext": {
      "view": "role"
    },
    "workSpaceContext": {
      "view": "workSpaceContext"
    },
    "idDisplayRuleContext": {
      "view": "idDisplayRule"
    }
  },
  "placements": {
    "groupRolePlacement": {
      "anchor": "headerContextPosition",
      "contextId": "groupContext",
      "priority": 30,
      "visibleWhen": {
        "condition": "ctx.userSession.props.group.uiValue[0]!=''"
      }
    },
    "rolePlacement": {
      "anchor": "headerContextPosition",
      "contextId": "roleContext",
      "priority": 35,
      "visibleWhen": {
        "condition": "ctx.userSession.props.role.uiValues[0]!=''"
      }
    },
    "workSpacePlacement": {
      "anchor": "headerContextPosition",
      "contextId": "workSpaceContext",
      "priority": 40,
      "visibleWhen": {
        "condition": "ctx.workspace.workspaceId != '' && ctx.totalWorkspaceCount > 1"
      }
    },
    "idDisplayRulePlacement": {
      "anchor": "headerContextPosition",
      "contextId": "idDisplayRuleContext",
      "priority": 70
    }
  }
}
