{
  "$schema": "declarativeLayoutsViewModelSchema-1.0.0.json",
  "cards": {
    "Recents": {
      "view": "AwHistory",
      "anchor": "awRecentsCard,awCardViewSwitcher",
      "props": {
        "subPanelContext": {
          "adaptive": true,
          "emptyAreaIcon": "graEmptyGeneric128",
          "emptyAreaTitle": "{{i18n.noRecentFound}}",
          "emptyAreaHint": "{{i18n.emptyRecentAreaHint}}"
        }
      },
      "title": "{{i18n.recentsTitle}}"
    },
    "Favorites": {
      "view": "AwFavorite",
      "anchor": "awFavoriteCard,awCardViewSwitcher",
      "props": {
        "subPanelContext": {
          "adaptive": true,
          "emptyAreaIcon": "graEmptyFavorites128",
          "emptyAreaTitle": "{{i18n.noFavoritesFound}}",
          "emptyAreaHint": "{{i18n.emptyFavoritesAreaHint}}"
        }
      },
      "title": "{{i18n.favoritesTitle}}"
    }
  },
  "i18n": {
    "recentsTitle": [
      "CaptionMessages"
    ],
    "favoritesTitle": [
      "CaptionMessages"
    ],
    "noRecentFound": [
      "CaptionMessages"
    ],
    "emptyRecentAreaHint": [
      "CaptionMessages"
    ],
    "noFavoritesFound": [
      "CaptionMessages"
    ],
    "emptyFavoritesAreaHint": [
      "CaptionMessages"
    ]
  }
}
