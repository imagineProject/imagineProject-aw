{
  "actions": {
    "swf_tileCanvasdragStartFn": {
      "actionType": "syncFunction",
      "method": "dragStartFn",
      "inputData": {},
      "deps": "js/tileDragService"
    },
    "swf_tileCanvasdragEndFn": {
      "actionType": "syncFunction",
      "method": "dragEndFn",
      "inputData": {},
      "deps": "js/tileDragService"
    },
    "swf_tileCanvasdragOverFn": {
      "actionType": "syncFunction",
      "method": "dragOverFn",
      "inputData": {},
      "deps": "js/tileDragService"
    },
    "swf_tileCanvasdragEnterFn": {
      "actionType": "syncFunction",
      "method": "dragEnterFn",
      "inputData": {},
      "deps": "js/tileDragService"
    },
    "swf_tileCanvasdragLeaveFn": {
      "actionType": "syncFunction",
      "method": "dragLeaveFn",
      "inputData": {},
      "deps": "js/tileDragService"
    },
    "swf_tileCanvasdropFn": {
      "actionType": "syncFunction",
      "method": "dropFn",
      "inputData": {
        "propertyName": "tileGroups"
      },
      "deps": "js/tileDragService"
    },
    "dragStartAction": {
      "actionType": "syncFunction",
      "method": "dragStart",
      "deps": "js/awDragAndDropService"
    },
    "dragEndAction": {
      "actionType": "syncFunction",
      "method": "dragEnd",
      "deps": "js/awDragAndDropService"
    },
    "dragEnterAction": {
      "actionType": "syncFunction",
      "method": "dragEnter",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/awDragAndDropService"
    },
    "dragLeaveAction": {
      "actionType": "syncFunction",
      "method": "dragLeave",
      "deps": "js/awDragAndDropService"
    },
    "dragOverAction": {
      "actionType": "syncFunction",
      "method": "dragOver",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/awDragAndDropService"
    },
    "dropAction": {
      "actionType": "syncFunction",
      "method": "drop",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/awDragAndDropService"
    },
    "objNavdropAction": {
      "actionType": "syncFunction",
      "method": "processDropOnTree",
      "deps": "js/objectNavigationTreeService"
    },
    "arrangeDragStart": {
      "actionType": "syncFunction",
      "method": "dragStart",
      "inputData": {
        "arrangeData": "{{subPanelContext.arrangeData}}"
      },
      "deps": "js/tcarrange.service"
    },
    "arrangeDisplayedDragOver": {
      "actionType": "syncFunction",
      "method": "dragOverDisplayed",
      "inputData": {
        "arrangeData": "{{subPanelContext.arrangeData}}"
      },
      "deps": "js/tcarrange.service"
    },
    "arrangeDisplayedDrop": {
      "actionType": "syncFunction",
      "method": "addColumns",
      "inputData": {
        "arrangeData": "{{subPanelContext.arrangeData}}",
        "dataProviders": "{{subPanelContext.arrangeData.dataProviders}}"
      },
      "deps": "js/arrange.service"
    },
    "arrangeAvailableDrop": {
      "actionType": "syncFunction",
      "method": "removeColumns",
      "inputData": {
        "arrangeData": "{{subPanelContext.arrangeData}}",
        "dataProviders": "{{subPanelContext.arrangeData.dataProviders}}"
      },
      "deps": "js/arrange.service"
    },
    "arrangeAvailableDragOver": {
      "actionType": "syncFunction",
      "method": "dragOverAvailable",
      "inputData": {
        "arrangeData": "{{subPanelContext.arrangeData}}"
      },
      "deps": "js/tcarrange.service"
    },
    "arrangeAvailableDragLeave": {
      "actionType": "syncFunction",
      "method": "unhighlightAvailableDropArea",
      "inputData": {
        "arrangeData": "{{subPanelContext.arrangeData.highlightedElement}}"
      },
      "deps": "js/tcarrange.service"
    },
    "arrangeDisplayedDragLeave": {
      "actionType": "syncFunction",
      "method": "unhighlightDisplayedDropArea",
      "inputData": {
        "arrangeData": "{{subPanelContext.arrangeData.highlightedElement}}"
      },
      "deps": "js/tcarrange.service"
    },
    "dropObjectSetTreeAction": {
      "actionType": "syncFunction",
      "method": "onDropObjectSetTree",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/awDragAndDropService"
    },
    "dragEnterActionOnObjectSetTree": {
      "actionType": "syncFunction",
      "method": "dragEnterActionOnObjectSetTree",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/awDragAndDropService"
    },
    "dragOverActionOnObjectSetTree": {
      "actionType": "syncFunction",
      "method": "dragOverActionOnObjectSetTree",
      "inputData": {
        "props": "{{props}}"
      },
      "deps": "js/awDragAndDropService"
    },
    "commandDragStart": {
      "actionType": "syncFunction",
      "method": "handleDrag",
      "deps": "js/commandDragService"
    },
    "commandDragEnd": {
      "actionType": "syncFunction",
      "method": "handleDrag",
      "inputData": {},
      "deps": "js/commandDragService"
    },
    "commandDragEnter": {
      "actionType": "syncFunction",
      "method": "handleDrag",
      "inputData": {},
      "deps": "js/commandDragService"
    },
    "commandDragLeave": {
      "actionType": "syncFunction",
      "method": "handleDrag",
      "inputData": {},
      "deps": "js/commandDragService"
    },
    "commandDragOver": {
      "actionType": "syncFunction",
      "method": "handleDrag",
      "inputData": {},
      "deps": "js/commandDragService"
    },
    "commandDrop": {
      "actionType": "syncFunction",
      "method": "handleCommandDrop",
      "inputData": {},
      "deps": "js/AwPersonalizationEngine"
    }
  },
  "dragHandlers": {
    "awDefaultDragHandler": {
      "activeWhen": {
        "condition": "conditions.hasListAndTable"
      },
      "views": [
        "*"
      ],
      "dragActions": {
        "dragStart": "dragStartAction",
        "dragEnd": "dragEndAction"
      }
    },
    "swf_tileCanvasDragHandlers": {
      "activeWhen": true,
      "views": [
        "Gateway"
      ],
      "dragActions": {
        "dragStart": "swf_tileCanvasdragStartFn",
        "dragEnd": "swf_tileCanvasdragEndFn"
      }
    },
    "awArrangeDragHandlers": {
      "activeWhen": true,
      "views": [
        "AwArrangeDisplayed",
        "AwArrangeAvailable"
      ],
      "dragActions": {
        "dragStart": "arrangeDragStart"
      }
    },
    "awCommandDragHandlers": {
      "activeWhen": {
        "condition": "conditions.personalizationIsEnabled"
      },
      "views": [
        "AwCommandList",
        "AwToolbarInternal"
      ],
      "dragActions": {
        "dragStart": "commandDragStart",
        "dragEnd": "commandDragEnd"
      }
    }
  },
  "dropHandlers": {
    "swf_tileCanvasDropHandlers": {
      "activeWhen": true,
      "views": [
        "Gateway"
      ],
      "dropActions": {
        "dragOver": "swf_tileCanvasdragOverFn",
        "dragEnter": "swf_tileCanvasdragEnterFn",
        "dragLeave": "swf_tileCanvasdragLeaveFn",
        "drop": "swf_tileCanvasdropFn"
      }
    },
    "awDefaultDropHandler": {
      "activeWhen": {
        "condition": "conditions.hasListAndTable"
      },
      "views": [
        "*"
      ],
      "dropActions": {
        "dragEnter": "dragEnterAction",
        "dragLeave": "dragLeaveAction",
        "dragOver": "dragOverAction",
        "drop": "dropAction"
      }
    },
    "objNavTreeDropHandler": {
      "views": [
        "objectNavigationTree"
      ],
      "dropActions": {
        "dragEnter": "dragEnterAction",
        "dragLeave": "dragLeaveAction",
        "dragOver": "dragOverAction",
        "drop": "objNavdropAction"
      }
    },
    "awArrangeAvailableDropHandlers": {
      "views": [
        "AwArrangeAvailable"
      ],
      "dropActions": {
        "dragLeave": "arrangeAvailableDragLeave",
        "dragOver": "arrangeAvailableDragOver",
        "drop": "arrangeAvailableDrop"
      }
    },
    "awArrangeDisplayedDropHandlers": {
      "views": [
        "AwArrangeDisplayed"
      ],
      "dropActions": {
        "dragOver": "arrangeDisplayedDragOver",
        "drop": "arrangeDisplayedDrop",
        "dragLeave": "arrangeDisplayedDragLeave"
      }
    },
    "objectSetTreeDropHandler": {
      "views": [
        "AwObjectSetTree"
      ],
      "dropActions": {
        "dragEnter": "dragEnterActionOnObjectSetTree",
        "dragLeave": "dragLeaveAction",
        "dragOver": "dragOverActionOnObjectSetTree",
        "drop": "dropObjectSetTreeAction"
      }
    },
    "awCommandDropHandlers": {
      "activeWhen": {
        "condition": "conditions.personalizationIsEnabled"
      },
      "views": [
        "AwCommandList",
        "AwToolbarInternal"
      ],
      "dropActions": {
        "dragEnter": "commandDragEnter",
        "dragLeave": "commandDragLeave",
        "dragOver": "commandDragOver",
        "drop": "commandDrop"
      }
    }
  },
  "conditions": {
    "hasListAndTable": {
      "expression": "data.dataProviders"
    },
    "personalizationIsEnabled": {
      "expression": "ctx.state.urlAttributes.personalization !== undefined"
    }
  }
}
