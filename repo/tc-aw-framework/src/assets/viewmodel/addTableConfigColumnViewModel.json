{
    "schemaVersion": "1.0.0",
    "actions": {
        "addColumn": {
            "actionType": "JSFunctionAsync",
            "method": "addTableConfigColumn",
            "inputData": {
                "dataFields": "{{data.data}}",
                "dataProvider": "{{subPanelContext.popupOptions.userOptions.context.tableColumnDataProvider}}",
                "tableConfig": "{{subPanelContext.popupOptions.userOptions.context.tableConfig}}",
                "tableConfigState": "{{subPanelContext.popupOptions.userOptions.context.tableConfigState}}",
                "i18n": "{{i18n}}"
            },
            "events": {
                "success": [
                    {
                        "name": "aw.closeAddColumnPanel",
                        "condition": "!subPanelContext.panelPinned"
                    },
                    {
                        "name": "tableConfig.columnAdded",
                        "condition": "subPanelContext.panelPinned"
                    }
                ]
            },
            "deps": "js/tableConfigsService"
        },
        "closeDialog": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
                "editContext": "",
                "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
        },
        "loadAssociatedProperties": {
            "actionType": "JSFunctionAsync",
            "method": "loadAssociatedProperties",
            "inputData": {
                "data": "{{data}}",
                "selected": "{{data.objectTypeListBox}}"
            },
            "outputData": {
                "associatedPropertiesResponse": ""
            },
            "deps": "js/tableConfigsService"
        },
        "loadNextAssociatedProperties": {
            "actionType": "JSFunctionAsync",
            "method": "loadAssociatedProperties",
            "inputData": {
                "data": "{{data}}",
                "selected": "{{data.objectTypeListBox}}",
                "startIndex": "{{data.dataProviders.associatedPropertiesDataProvider.startIndex}}"
            },
            "outputData": {
                "associatedPropertiesResponse": ""
            },
            "deps": "js/tableConfigsService"
        },
        "clearAssociatedProperties": {
            "actionType": "JSFunction",
            "method": "clearAssociatedProperties",
            "inputData": {
                "data": "{{data.associatedProperties}}"
            },
            "outputData": {
                "associatedProperties": ""
            },
            "deps": "js/tableConfigsService"
        }
    },
    "data": {
        "associatedProperties": {
            "displayName": "{{i18n.associatedProperties}}",
            "name": "associatedProperties",
            "type": "STRINGARRAY",
            "isArray": true,
            "isRequired": true,
            "renderingHint": "checkboxoptionlov",
            "dataProvider": "associatedPropertiesDataProvider",
            "uiValue": "",
            "dbValue": []
        },
        "objectTypeListBox": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": ""
        },
        "columnWidth": {
            "type": "INTEGER",
            "displayName": "{{i18n.columnWidth}}",
            "uiValue": "250",
            "dbValue": 250
        },
        "columnHidden": {
            "type": "BOOLEAN",
            "displayName": "{{i18n.columnHidden}}",
            "dbValue": true
        },
        "columnFiltering": {
            "type": "BOOLEAN",
            "displayName": "{{i18n.columnFiltering}}",
            "dbValue": true
        },
        "typeSearchInput": {
            "attributesToInflate": [ "object_name", "parent_types", "type_name" ],
            "internalPropertyName": "",
            "maxToLoad": 50,
            "maxToReturn": 50,
            "providerName": "Awp0TypeSearchProvider",
            "searchCriteria":
            {
                "loadAllSubTypes": "true",
                "listOfIncludeObjectTypes": "BusinessObject",
                "typeSelectorId": "tableConfiguratorTypeSelector"
            },
            "searchFilterMap": {},
            "searchSortCriteria": []
        },
        "columnComplexity": {
            "type": "STRING",
            "isEditable": "true",
            "dbValue": "basic"
        },
        "columnComplexityOptions": {
            "type": "STRING",
            "dbValue": [
                {
                    "propDisplayValue": "{{i18n.basicColumnComplexity}}",
                    "propInternalValue": "basic"
                },
                {
                    "propDisplayValue": "{{i18n.advancedColumnComplexity}}",
                    "propInternalValue": "advanced"
                }
            ]
        },
        "dcpProperty": {
            "type": "STRING",
            "dbValue": "",
            "isRequired": true,
            "displayName": "{{i18n.dcpPropertyTitle}}"
        }
    },
    "dataProviders": {
        "associatedPropertiesDataProvider": {
            "action": "loadAssociatedProperties",
            "nextAction": "loadNextAssociatedProperties",
            "response": "{{data.associatedPropertiesResponse.associatedProperties}}",
            "totalFound": "{{data.associatedPropertiesResponse.totalFound}}"
        }
    },
    "i18n": {
        "propertyTypes": [
            "tableConfigsMessages"
        ],
        "associatedProperties": [
            "tableConfigsMessages"
        ],
        "columnWidth": [
            "tableConfigsMessages"
        ],
        "columnHidden": [
            "tableConfigsMessages"
        ],
        "columnFiltering": [
            "tableConfigsMessages"
        ],
        "add": [
            "tableConfigsMessages"
        ],
        "basicColumnComplexity": [
            "tableConfigsMessages"
        ],
        "advancedColumnComplexity": [
            "tableConfigsMessages"
        ],
        "addTableConfigColumnTypeTitle": [
            "tableConfigsMessages"
        ],
        "addTableConfigColumnTypeDescription": [
            "tableConfigsMessages"
        ],
        "addTableConfigColumnPropertyDescription": [
            "tableConfigsMessages"
        ],
        "addTableConfigColumnPropertyTitle": [
            "tableConfigsMessages"
        ],
        "dcpPropertyTitle": [
            "tableConfigsMessages"
        ],
        "ARRAY_PLACEHOLDER_TEXT": [
            "BaseMessages"
        ],
        "invalidDCP": [
            "tableConfigsMessages"
        ]
    },
    "onEvent": [{
        "eventId": "aw.closeAddColumnPanel",
        "action": "closeDialog"
    },
    {
        "eventId": "primaryWorkArea.selectionChangeEvent",
        "action": "closeDialog"
    },
    {
        "eventId": "tableConfig.columnAdded",
        "action": "clearAssociatedProperties"
    }],
    "lifecycleHooks": {
        "onUpdate": [ {
            "action": "clearAssociatedProperties",
            "observers":[ "fields.objectTypeListBox.value" ]
        } ]
    },
    "conditions": {
        "isValidForm": {
            "expression": "conditions.isBasicColumnValid || conditions.isAdvancedColumnValid"
        },
        "isBasicColumnValid": {
            "expression": "conditions.isBasicColumnComplexity && data.objectTypeListBox.dbValue !== '' && data.associatedProperties.dbValues[0]"
        },
        "isAdvancedColumnValid": {
            "expression": "conditions.isAdvancedColumnComplexity && data.objectTypeListBox.dbValue !== '' && data.dcpProperty.dbValue !== ''"
        },
        "isBasicColumnComplexity": {
            "expression": "data.columnComplexity.dbValue === 'basic'"
        },
        "isAdvancedColumnComplexity": {
            "expression": "data.columnComplexity.dbValue === 'advanced'"
        },
        "isPropertyTypeSelected": {
            "expression": "data.objectTypeListBox.dbValue !== ''"
        }
    }
}
