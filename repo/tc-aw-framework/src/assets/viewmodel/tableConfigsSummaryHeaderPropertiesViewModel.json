{
    "schemaVersion": "1.0.0",
    "lifecycleHooks": {
        "onUpdate": [
            {
                "action": "updatedHeaderProps",
                "observers": [
                    "props.subPanelContext.headerVmo"
                ]
            }
        ],
        "render": "render"
    },
    "actions": {
        "updatedHeaderProps": {
            "actionType": "JSFunction",
            "method": "updateHeaderProps",
            "inputData": {
                "fields": "{{fields}}",
                "headerVmo": "{{props.subPanelContext.headerVmo}}"
            },
            "deps": "js/tableConfigsService"
        },
        "render": {
            "method": "headerPropsRenderer",
            "deps": "js/tableConfigsService"
        }
    },
    "data": {
        "columnConfigId": {
            "displayName": "{{i18n.columnConfigId}}",
            "type": "STRING",
            "isEditable": false,
            "labelPosition": "PROPERTY_LABEL_AT_SIDE",
            "renderingHint": "overflow",
            "dbValue": "",
            "uiValue": ""
        },
        "clientScopeUri": {
            "displayName": "{{i18n.clientScopeUri}}",
            "type": "STRING",
            "isEditable": false,
            "labelPosition": "PROPERTY_LABEL_AT_SIDE",
            "renderingHint": "overflow",
            "dbValue": "",
            "uiValue": ""
        }
    },
    "i18n": {
        "columnConfigId": [ "tableConfigsMessages" ],
        "clientScopeUri": [ "tableConfigsMessages" ]
    }
}
