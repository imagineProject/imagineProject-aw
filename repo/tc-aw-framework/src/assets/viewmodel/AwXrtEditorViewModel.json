{
    "schemaVersion": "1.0.0",
    "imports": [
    ],
    "props": {
    },
    "data": {
        "editor": {
        },
        "content": "",
        "crumbTextBox": {
            "initialValues": {
                "name": ""
            },
            "meta": {}
        },
        "newContent": "",
        "datasetObject": {},
        "datasetName": "",
        "editing": "",
        "datasetNameTextBox": {
            "type": "STRING",
            "isEditable": true,
            "isModifiable": true,
            "hasLov": false,
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "scopeListBox": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "dispValue": "",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "scopeValues": {
            "type": "STRING",
            "dbValue": [
                {
                    "propDisplayValue": "Site",
                    "dispValue": "Site",
                    "propInternalValue": "Site"
                },
                {
                    "propDisplayValue": "Group",
                    "dispValue": "Group",
                    "propInternalValue": "Group"
                },
                {
                    "propDisplayValue": "Role",
                    "dispValue": "Role",
                    "propInternalValue": "Role"
                },
                {
                    "propDisplayValue": "User",
                    "dispValue": "User",
                    "propInternalValue": "User"
                }
            ]
        },
        "objectTypeListBox": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "dispValue": "",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "xrtTypeListBox": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "dispValue": "",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "xrtTypeValues": {
            "type": "STRING",
            "dbValue": [
                {
                    "propDisplayValue": "Summary",
                    "dispValue": "Summary",
                    "propInternalValue": "Summary"
                },
                {
                    "propDisplayValue": "Create",
                    "dispValue": "Create",
                    "propInternalValue": "Create"
                },
                {
                    "propDisplayValue": "Information",
                    "dispValue": "Information",
                    "propInternalValue": "Information"
                },
                {
                    "propDisplayValue": "Revise",
                    "dispValue": "Revise",
                    "propInternalValue": "Revise"
                },
                {
                    "propDisplayValue": "Save As",
                    "dispValue": "Save As",
                    "propInternalValue": "Save As"
                }
            ]
        },
        "locationListBox": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "dispValue": "",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "sublocationListBox": {
            "type": "STRING",
            "hasLov": true,
            "dbValue": "",
            "dispValue": "",
            "labelPosition": "NO_PROPERTY_LABEL"
        },
        "xrtEditorState": {
            "initialValues": {
                "defaultXrt": "%3C?xml%20version=%221.0%22%20encoding=%22UTF-8%22?%3E%0A%3C!--%20Empty%20Rendering%20--%3E%0A%3Crendering%3E%0A%3C/rendering%3E",
                "editingInProgress": false,
                "showLeaveConfirmation": false,
                "xml": "",
                "crumbs": ""
            },
            "meta": {}
        },
        "selectedNodeName": {
            "initialValues":{
                "nodeName": ""
            },
            "meta": {}
        },
        "editorRef": {
            "initialValues":{},
            "meta": {}
        },
        "editingInProgress": {
            "initialValues":{},
            "meta": {}
        }
    },
    "actions": {
        "render": {
            "method": "awXrtEditorRenderFunction",
            "outputData": {
                "xrtEditorTree2": ""
            },
            "deps": "js/AwXrtEditorService"
        },
        "onMount": {
            "actionType": "JSFunction",
            "method": "awXrtEditorOnMount",
            "inputData": {
                "data": "{{data}}",
                "xrtEditorState": "{{fields.xrtEditorState}}"
            },
            "deps": "js/AwXrtEditorService"
        },
        "onUnMount": {
            "actionType": "JSFunction",
            "method": "awXrtEditorOnUnMount",
            "inputData": {
            },
            "deps": "js/AwXrtEditorService"
        },
        "preStartEdit": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "confirmOverrideSiteXRT",
                        "condition": "(ctx.userSession.props.group_name.dbValue !== 'dba' && data.scope !== 'User')"
                    },
                    {
                        "name": "startEditXRT",
                        "condition": "(ctx.userSession.props.group_name.dbValue === 'dba' || data.scope === 'User')"
                    }
                ]
            }
        },
        "startEdit": {
            "actionType": "JSFunction",
            "method": "startEdit",
            "inputData": {
                "data": "{{data}}",
                "groupName": "{{ctx.userSession.props.group_name.dbValue}}",
                "userName": "{{ctx.userSession.props.user_id.uiValue}}",
                "xrtEditorState": "{{fields.xrtEditorState}}",
                "crumbTextBox": "{{fields.crumbTextBox}}",
                "editingInProgress": "{{fields.editingInProgress}}"
            },
            "outputData": {
                "editing": "editing",
                "scopeListBox": "scopeListBox",
                "datasetNameTextBox": "datasetNameTextBox",
                "editDatasetName": "editDatasetName"
            },
            "deps": "js/AwXrtEditorService"
        },
        "cancelEdit": {
            "actionType": "JSFunction",
            "method": "cancelEdit",
            "inputData": {
                "data": "{{data}}",
                "xrtEditorState": "{{fields.xrtEditorState}}",
                "editingInProgress": "{{fields.editingInProgress}}"
            },
            "outputData": {
                "editing": "editing",
                "newContent": "newContent",
                "scopeListBox": "scopeListBox"
            },
            "deps": "js/AwXrtEditorService"
        },
        "openDataset": {
            "actionType": "JSFunctionAsync",
            "method": "openInjectedDataset",
            "inputData": {
                "commandContext": "{{parameters.eventData.commandContext}}"
            },
            "deps": "js/xrtEditorUtilities"
        },
        "openDatasetBatchJob": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "handleLeaveConfirmation",
                    "condition": "conditions.editModeEnabled && conditions.isDirty"
                },{
                    "action": "startNavigation",
                    "condition": "!conditions.isDirty"
                }
            ]
        },
        "startNavigation": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "cancelEdit",
                    "condition": "conditions.editModeEnabled"
                },{
                    "action": "openDataset"
                }
            ]
        },
        "loadXRT": {
            "actionType": "JSFunction",
            "method": "loadXRT",
            "inputData": {
                "data": "{{data}}",
                "type": "{{data.objectTypeListBox.dbValue}}",
                "stylesheetType": "{{data.xrtTypeListBox.dbValue}}",
                "preferenceLocation": "{{data.scopeListBox.dbValue}}",
                "client": "AWC",
                "location": "{{data.locationListBox.dbValue}}",
                "sublocation": "{{data.sublocationListBox.dbValue}}",
                "context": "",
                "xrtEditorState": "{{fields.xrtEditorState}}"
            },
            "deps": "js/AwXrtEditorService"
        },
        "handleLeaveConfirmation": {
            "actionType": "JSFunction",
            "method": "evaluateIsDirty",
            "inputData": {
                "data": "{{data}}",
                "fields": "{{fields}}"
            },
            "deps": "js/AwXrtEditorService",
            "actionMessages": {
                "success": [
                    {
                        "message": "confirmLeave"
                    }
                ]
            }
        },
        "saveEdits": {
            "actionType": "JSFunction",
            "method": "saveEdits",
            "inputData": {
                "data": "{{data}}",
                "xrtEditorState": "{{fields.xrtEditorState}}",
                "crumbs": "{{parameters.eventData.crumbs}}"
            },
            "outputData": {
                "editing": "editing",
                "content": "content",
                "datasetName": "datasetName",
                "datasetObject": "datasetObject",
                "scope": "scope"
            },
            "deps": "js/AwXrtEditorService"
        }
    },
    "ctx": {
    },
    "lifecycleHooks": {
        "render": "render",
        "onMount": "onMount",
        "onUnmount": "onUnMount"
    },
    "conditions": {
        "editModeEnabled": {
            "expression": "fields.editingInProgress.editingInProgress && fields.editingInProgress.editingInProgress === true"
        },
        "isDirty": {
            "expression": "data.newContent && data.newContent !== fields.xrtEditorState.xml"
        }
    },
    "onEvent": [ 
        {
            "eventId": "startEditXRTEditor",
            "action": "preStartEdit"
        }, {
            "eventId": "cancelEditXRTEditor",
            "action": "cancelEdit"
        },{
            "eventId": "saveEditCleanupXRTEditor",
            "action": "saveEditCleanup"
        },{
            "eventId": "openInjectedDataset",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "openDatasetBatchJob"
        },
        {
            "eventId": "startEditXRT",
            "action": "startEdit"
        }, {
            "eventId": "confirmOverrideSiteXRT",
            "message": "confirmOverrideSiteXRTMessage"
        }, {
            "eventId": "confirmLeaveXRT",
            "message": "confirmLeave"
        },
        {
            "eventId": "performSaveEdits",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "saveEdits"
        }
    ],
    "messages": {
        "confirmOverrideSiteXRTMessage": {
            "messageType": "WARNING",
            "messageText": "{{i18n.overrideMsg}}",
            "messageTextParams": ["{{fields.xrtEditorState.currLocation}}"],
            "navigationOptions": [ {
                    "option": "Cancel",
                    "text": "{{i18n.cancel}}"
                },
                {
                    "option": "Override",
                    "text": "{{i18n.override}}",
                    "action": "startEdit"
                }
            ]
        },
        "confirmLeave": {
            "messageType": "WARNING",
            "messageText": "{{i18n.navigationConfirmationSingle}}",
            "messageTextParams": [
                "{{fields.crumbTextBox.value.name}}"
            ],
            "navigationOptions": [
                {
                    "option": "Discard",
                    "text": "{{i18n.discard}}",
                    "action": "cancelEdit"
                },
                {
                    "option": "Save",
                    "text": "{{i18n.save}}",
                    "action": "saveEdits"
                }
            ]
        }
    },
    "i18n": {
        "navigationConfirmationSingle": [
            "editHandlerMessages"
        ],
        "scopeLabel": [
            "XRTEditorMessages"
        ],
        "objectTypeLabel": [
            "XRTEditorMessages"
        ],
        "xrtTypeLabel": [
            "XRTEditorMessages"
        ],
        "locationLabel": [
            "XRTEditorMessages"
        ],
        "sublocationLabel": [
            "XRTEditorMessages"
        ],
        "loadButtonText": [
            "XRTEditorMessages"
        ],
        "editLabel": [
            "XRTEditorMessages"
        ],
        "readOnlyLabel": [
            "XRTEditorMessages"
        ],
        "overrideMsg": [
            "XRTEditorMessages"
        ],
        "cancel": [
            "XRTEditorMessages"
        ],
        "override": [
            "XRTEditorMessages"
        ],
        "noXrtLoadedTitle": [
            "XRTEditorMessages"
        ],
        "noXrtLoadedMessage": [
            "XRTEditorMessages"
        ],
        "noXrtLoadedConvenienceMessage": [
            "XRTEditorMessages"
        ],
        "save": [
            "XRTMessages"
        ],
        "discard": [
            "XRTMessages"
        ]
    }
}
