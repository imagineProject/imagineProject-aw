{
    "schemaVersion": "1.0.0",
    "actions":{
        "handleFocusChange": {
            "actionType": "JSFunction",
            "method": "handleFocusChange",
            "inputData": {
                "parentFocusComponent": "{{props.subPanelContext.context.pageContext.sublocationState.focusComponent}}",
                "selectionModel": "{{data.selectionModels.relationTreeSelectionModel}}"
            },
            "deps": "js/relationsTreeService"
        },
        "handleSublocationFocusChange": {
            "actionType": "JSFunction",
            "method": "handleSublocationFocusChange",
            "inputData": {
                "parentFocusComponent": "{{props.subPanelContext.context.pageContext.sublocationState.isSublocationActive}}",
                "selectionModel": "{{data.selectionModels.relationTreeSelectionModel}}"
            },
            "deps": "js/relationsTreeService"
        },
        "handleSelectionChangeForContainer": {
            "actionType": "JSFunction",
            "method": "handleSelectionChangeForContainer",
            "inputData": {
                "localSelectionData": "{{data.selectionData}}",
                "parentSelectionData": "{{props.subPanelContext.selectionData}}"
            },
            "deps": "js/relationsTreeService"
        },
        "handleInputSelectionChange": {
            "actionType": "JSFunction",
            "method": "handleInputSelectionChange",
            "inputData": {
                "selectionModel": "{{data.selectionModels.relationTreeSelectionModel}}"
            },
            "deps": "js/relationsTreeService"
        }
    },
    "lifecycleHooks": {
        "onUpdate": [
            {
                "action": "handleFocusChange",
                "observers": [ "props.subPanelContext.context.pageContext.sublocationState.focusComponent" ]
            },
            {
                "action": "handleSublocationFocusChange",
                "observers": [ "props.subPanelContext.context.pageContext.sublocationState.isSublocationActive" ]
            },
            {
                "action": "handleSelectionChangeForContainer",
                "observers": [
                    "viewModel.atomicData.selectionData"
                ]
            },
            {
                "action": "handleInputSelectionChange",
                "observers": [
                    "props.subPanelContext.selection[0].uid",
                    "props.subPanelContext.selection.length"
                ]
            }
        ]
    },
    "selectionModels": {
        "relationTreeSelectionModel": {
            "selectionMode": "multiple",
            "selectionTracker": [
                "alternateID",
                "uid"
              ]
        }
    },
    "data":{
        "selectionData": {
            "initialValues": {},
            "meta": {}
        },
        "objectSetState":{
            "initialValues": {
                "totalFound": -1
            },
            "meta": {}
        }
    },
    "props":{
        "sub-panel-context": {
            "type": "object"
        }
    }
}
