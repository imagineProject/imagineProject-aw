{
    "schemaVersion": "1.0.0",
    "actions": {
        "render": {
            "method": "awNamingRuleLovRenderFn",
            "deps": "js/AwNamingRuleLovService"
        },
        "getNamingRuleValues": {
            "actionType": "JSFunction",
            "method": "getNamingRuleValues",
            "inputData": {
                "vmo": "{{props.vmo}}",
                "name": "{{props.name}}"
            },
            "outputData":{
                "lovValues":"lovValues",
                "nLovValues":"nLovValues"
            },
            "deps": "js/AwNamingRuleLovService"
        }
    },
    "data": {},
    "conditions": {},
    "onEvent": [],
    "functions": {},
    "dataProviders": {
        "namingRuleLovProvider": {
            "action": "getNamingRuleValues",
            "response": "{{data.lovValues}}",
            "totalFound": "{{data.nLovValues}}",
            "moreValuesExist": false
        }
    },
    "lifecycleHooks": {
        "render": "render"
    },
    "props": {
        "prop": {
            "type": "field"
        }
    },
    "i18n": {}
}
