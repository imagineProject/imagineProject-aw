{
    "schemaVersion" : "1.0.0",
    "conditions": {
        "isFnd0ClientScope": {
            "expression": "props.subPanelContext.selection[0].type === 'Fnd0ClientScope'"
        },
        "isLeaf": {
            "expression": "props.subPanelContext.selection[0].isLeaf === true"
        },
        "isEmptySelection": {
            "expression": "props.subPanelContext.selection.length === 0"
        }
    },
    "i18n": {
        "noTableConfigSelected": [
            "tableConfigsMessages"
        ],
        "noTableConfigSelectedHint": [
            "tableConfigsMessages"
        ],
        "noContentTableConfigs": [
            "tableConfigsMessages"
        ],
        "noContentTableConfigsHint": [
            "tableConfigsMessages"
        ]
    }
}
