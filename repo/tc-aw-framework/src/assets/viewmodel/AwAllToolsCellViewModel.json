{
    "schemaVersion": "1.0.0",
    "actions": {
        "navigateToTool": {
            "actionType": "JSFunction",
            "method": "performActionAndClose",
            "inputData": {
                "tileAction": "{{props.item.action}}",
                "context" : {},
                "runActionWithViewModel": "{{subPanelContext.runActionWithViewModel}}",
                "popupApi": "{{subPanelContext.popupApi}}"
            },
            "deps": "js/launcherService"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "item": {
            "type": "object"
        }
    }
}