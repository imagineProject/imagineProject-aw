{
    "schemaVersion": "1.0.0",
    "actions": {
        "xrtEditorBreadCrumbNodes": {
            "actionType": "JSFunction",
            "method": "fetchBreadCrumbNodes",
            "inputData": {
                "nodeName": "{{props.nodeName}}",
                "crumbData": "{{data.crumbs}}",
                "datasetName": "{{props.datasetName}}",
                "xrtEditorTreeInfo": "{{props.xrtEditorTreeInfo}}",
                "props": "{{props}}",
                "editingInProgress": "{{props.editingInProgress}}"
            },
            "outputData": {
                "crumbs": "crumbs"
            },
            "deps": "js/xrtEditorUtilities"
        },
        "fetchBreadcrumb": {
            "actionType": "JSFunction",
            "method": "fetchBreadcrumb",
            "inputData": {
                "datasetName": "{{props.datasetName}}",
                "nodeName": "{{props.nodeName}}"
            },
            "outputData": {
                "crumbs": "crumbs"
            },
            "deps": "js/xrtEditorUtilities"
        },
        "saveEditsEvent": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "performSaveEdits",
                        "eventData": {
                            "crumbs": "{{data.crumbs}}",
                            "parameters": "{{parameters}}"
                        }
                    }
                ]
            }
        }
    },
    "data": {
        "crumbs": []
    },
    "lifecycleHooks": {
        "onUpdate": [
        {
            "action": "fetchBreadcrumb",
            "observers": [
                "props.context.datasetName"
            ]
        },
        {
            "action": "xrtEditorBreadCrumbNodes",
            "observers": [
                "props.nodeName",
                "props.cellCommandProps"
            ]
        }
     ]
    },
    "onEvent": [ 
        {
            "eventId": "getXrtEditorCrumbs",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "action": "saveEditsEvent"
        }
    ]
}
