{
    "schemaVersion": "1.0.0",
    "data": {
        "launcherState": {
            "initialValues": {
                "activeView": "pinnedTools"
            },
            "meta": {}
        }
    },
    "lifecycleHooks": {
        "onMount": "fetchTileData"
    },
    "actions": {
        "fetchTileData": {
            "actionType": "JSFunctionAsync",
            "method": "fetchTileData",
            "inputData": {},
            "outputData": {
                "allApps": "allApps",
                "allData": "allData"
            },
            "deps": "js/launcherService"
        }
    }
}
