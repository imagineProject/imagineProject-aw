{
    "schemaVersion": "1.0.0",
    "actions": {

        "updateColumnsSortDirection": {
            "actionType": "JSFunction",
            "method": "updateColumnsSortDirection",
            "inputData": {
                "dataProvider": "{{data.dataProviders.loadedColumnConfigDataProvider}}",
                "columnPropertySortState": "{{atomicData.columnPropertySortState}}"
            },
            "deps": "js/tableConfigsService"
        },
        "loadColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "loadColumnProperties",
            "inputData": {
                "wrapTextState": "{{fields.wrapTextState}}",
                "subPanelContext": "{{props.subPanelContext}}",
                "tableConfigState": "{{fields.tableConfigState}}"
            },
            "outputData": {
                "loadedColumns": "loadedColumns",
                "loadedColumnsTotalFound": "loadedColumnsTotalFound"
            },
            "deps": "js/tableConfigsService"
        },
        "reloadColumnConfigColumns": {
            "actionType": "dataProvider",
            "method": "loadedColumnConfigDataProvider"
        },
        "incrementReloadColumns": {
            "actionType": "JSFunction",
            "method": "incrementReloadColumns",
            "inputData": {
                "reloadColumns": "{{data.reloadColumns}}"
            },
            "outputData": {
                "reloadColumns": ""
            },
            "deps": "js/tableConfigsService"
        },
        "reloadColumnConfigColumnsBatch": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "incrementReloadColumns"
                },
                {
                    "action": "reloadColumnConfigColumns",
                    "condition": "props.subPanelContext.selection[0].type === 'TableConfiguration' && data.reloadColumns !== 1"
                }
            ]
        },
        "startEdit": {
            "actionType": "JSFunctionAsync",
            "method": "loadColumnProperties",
            "inputData": {
                "wrapTextState": "{{fields.wrapTextState}}",
                "subPanelContext": "{{subPanelContext}}",
                "tableConfigState": "{{fields.tableConfigState}}"
            },
            "outputData": {
                "": "loadedColumns"
            },
            "deps": "js/tableConfigsService"
        },
        "saveEdits": {
            "actionType": "JSFunctionAsync",
            "method": "saveEdits",
            "deps": "js/editHandlerService",
            "inputData": {}
        },
        "initializeTableConfigsTable": {
            "actionType": "JSFunction",
            "method": "initializeTableConfigsTable",
            "inputData": {
                "dataProvider": "{{data.dataProviders.loadedColumnConfigDataProvider}}",
                "subPanelContext": "{{subPanelContext}}",
                "wrapTextState": "{{fields.wrapTextState}}",
                "tableConfigState": "{{fields.tableConfigState}}"
            },
            "deps": "js/tableConfigsService"
        }
    },
    "data": {
        "columnPropertySortState": {
            "initialValues": {
                "uid": "",
                "sortDirection": {
                    "dbValue": "",
                    "type": "STRING"
                }
            },
            "meta": {}
        },
        "wrapTextState": {
            "initialValues": {
                "isTextWrapped": false
            },
            "meta": {}
        },
        "tableConfigState": {
            "initialValues": {
                "lastColumnOrder": 100
            },
            "meta": {}
        },
        "reloadColumns": 0
    },
    "columnProviders": {
        "definitionColProvider": {
            "frozenColumnIndex": 0,
            "columns": [{
                    "name": "displayName",
                    "displayName": "{{i18n.propertyName}}",
                    "minWidth": 150,
                    "width": 150,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false,
                    "modifiable": false
                },
                {
                    "name": "associatedTypeDisplayName",
                    "displayName": "{{i18n.typeName}}",
                    "minWidth": 150,
                    "width": 150,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false,
                    "modifiable": false
                },
                {
                    "name": "propertyName",
                    "displayName": "{{i18n.internalPropertyName}}",
                    "minWidth": 100,
                    "width": 300,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false,
                    "modifiable": true
                },
                {
                    "name": "associatedTypeName",
                    "displayName": "{{i18n.internalTypeName}}",
                    "minWidth": 150,
                    "width": 150,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false,
                    "modifiable": true
                },
                {
                    "name": "modifiable",
                    "displayName": "{{i18n.modifiable}}",
                    "minWidth": 125,
                    "width": 125,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false
                },
                {
                    "name": "pixelWidth",
                    "displayName": "{{i18n.pixelWidth}}",
                    "minWidth": 75,
                    "width": 75,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false
                },
                {
                    "name": "displayedColumn",
                    "displayName": "{{i18n.displayedColumn}}",
                    "minWidth": 125,
                    "width": 125,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false
                },
                {
                    "name": "isFilteringEnabled",
                    "displayName": "{{i18n.filteringEnabled}}",
                    "minWidth": 125,
                    "width": 125,
                    "enableColumnMenu": false,
                    "enableColumnMoving": false,
                    "pinnedLeft": false,
                    "enableSorting": false,
                    "isTableCommand": false
                }
            ]
        }
    },
    "dataProviders": {
        "loadedColumnConfigDataProvider": {
            "action": "loadColumnConfig",
            "response": "{{data.loadedColumns}}",
            "totalFound": "{{data.loadedColumnsTotalFound}}",
            "editContext": "TABLE_CONFIG",
            "selectionModelMode": "multiple"
        }
    },
    "grids": {
        "colConfigDefinitionGrid": {
            "dataProvider": "loadedColumnConfigDataProvider",
            "columnProvider": "definitionColProvider",
            "addIconColumn": false,
            "enableArrangeMenu": false,
            "gridOptions": {
                "enableGridMenu": false,
                "enablePinning": false,
                "isFilteringEnabled": false,
                "enableSorting": false
            }
        }
    },
    "functions": {
        "getColumnConfigObjectData": {
            "functionName": "getColumnConfigObjectData"
        }
    },
    "conditions": {},
    "onEvent": [{
            "eventId": "colConfigSummary.contentLoaded",
            "action": "loadColConfigInformation",
            "condition": "ctx.selected && ctx.selected.uid && ctx.selected.uid"
        },
        {
            "eventId": "colConfigSummary.reloadProviders",
            "action": "reloadLoadedColumnConfigDataProvider"
        },
        {
            "eventId": "primaryWorkArea.selectionChangeEvent",
            "action": "loadColConfigInformation",
            "condition": "ctx.selected && ctx.selected.uid && ctx.selected.clientScopeUri"
        },
        {
            "eventId": "tableConfigSummary.saveEdit",
            "action": "saveEdits"
        }
    ],
    "i18n": {
        "tableContents": [ "tableConfigsMessages" ],
        "propertyName": [ "tableConfigsMessages" ],
        "typeName": [ "tableConfigsMessages" ],
        "internalPropertyName": [ "tableConfigsMessages" ],
        "internalTypeName": [ "tableConfigsMessages" ],
        "pixelWidth": [ "tableConfigsMessages" ],
        "displayedColumn": [ "tableConfigsMessages" ],
        "filteringEnabled": [ "tableConfigsMessages" ],
        "modifiable": [ "tableConfigsMessages" ]
    },
    "lifecycleHooks" : {
        "onMount": "initializeTableConfigsTable",
        "onUpdate": [ {
            "action": "reloadColumnConfigColumnsBatch",
            "observers": [
                "props.subPanelContext.selection"
            ]
        },
        {
            "action": "updateColumnsSortDirection",
            "observers": [ "viewModel.atomicData.columnPropertySortState.uid",
                           "viewModel.atomicData.columnPropertySortState.sortDirection.dbValue"
                        ]
        }
    ]
    }
}
