{
    "schemaVersion": "1.0.0",
    "data": {
        "allApps": {
            "displayName": "{{i18n.Awp0AllTools}}",
            "type": "STRING"
        }
    },
    "actions": {
        "goToAllTools": {
            "actionType": "JSFunction",
            "method": "goToAllTools",
            "inputData": {
                "launcherState": "{{props.context.launcherState}}"
            },
            "deps": "js/launcherService"
        },
        "initialize": {
            "actionType": "JSFunction",
            "method": "initializePersonalizedAppChooser",
            "inputData": {
                "allData": "{{props.context.allData}}"
            },
            "outputData": {
                "pinnedDataObjectsLoaded": "pinnedDataObjectsLoaded"
            },
            "deps": "js/launcherService"
        }
    },
    "ctx": {
        "pinnedAppsContext": {
            "parser": {
                "method": "getLauncherContext",
                "deps": "js/launcherService"
            }
        },
        "pinnedDataContext": {
            "parser": {
                "method": "getLauncherContext",
                "deps": "js/launcherService"
            }
        },
        "personalization_pinnedCommands": {
            "aw_pinnedApps": null,
            "aw_pinnedData": null
        }
    },
    "lifecycleHooks": {
        "onMount": "initialize"
    },
    "i18n": {
        "Awp0AllTools": [
            "PersonalizationMessages"
        ],
        "Awp0PinnedTools": [
            "PersonalizationMessages"
        ],
        "Awp0PinnedObjects": [
            "PersonalizationMessages"
        ],
        "Awp0NoPinnedToolsTitle": [
            "PersonalizationMessages"
        ],
        "Awp0NoPinnedToolsHint": [
            "PersonalizationMessages"
        ],
        "Awp0NoPinnedDataTitle": [
            "PersonalizationMessages"
        ],
        "Awp0NoPinnedDataHint": [
            "PersonalizationMessages"
        ]
    },
    "props": {
        "context": {
            "type": "object"
        }
    },
    "conditions":{
        "isPinnedToolsAvailable":{
            "expression": "ctx.personalization_pinnedCommands.aw_pinnedApps.length > 0"
        },
        "isPinnedDataAvailable":{
            "expression": "ctx.personalization_pinnedCommands.aw_pinnedData.length > 0 && data.pinnedDataObjectsLoaded"
        },
        "isExtraSpacingRequiredForScroll":{
            "expression": "ctx.personalization_pinnedCommands.aw_pinnedApps.length % 12 < 7 && ctx.personalization_pinnedCommands.aw_pinnedApps.length % 12 > 0"
        },
        "TwoEmptyDataCellsApplicableForScroll":{
            "expression": "ctx.personalization_pinnedCommands.aw_pinnedData.length % 6 < 3 && ctx.personalization_pinnedCommands.aw_pinnedData.length % 6 > 0"
        },
        "OneEmptyDataCellsApplicableForScroll":{
            "expression": "ctx.personalization_pinnedCommands.aw_pinnedData.length % 6 >= 3 && ctx.personalization_pinnedCommands.aw_pinnedData.length % 6 < 5 && ctx.personalization_pinnedCommands.aw_pinnedData.length % 6 > 0"
        }
    }
}
