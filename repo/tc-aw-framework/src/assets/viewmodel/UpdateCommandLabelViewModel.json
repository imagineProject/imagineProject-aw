{
    "schemaVersion": "1.0.0",
    "data":{
        "updateLabel": {
            "displayName": "{{i18n.Awp0Label}}",
            "type": "STRING",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "{{props.subPanelContext.commandContext.command.title}}",
            "dispValue": "{{props.subPanelContext.commandContext.command.title}}"
        }
    },
    "actions":{
        "cancelUpdateLabel": {
            "actionType": "JSFunction",
            "method": "cancelUpdateLabel",
            "inputData": {
                "popupApi": "{{props.subPanelContext.popupApi}}"
            },
            "deps": "js/updateCommandLabelService"
        },
        "performCommandLabelUpdate": {
            "actionType": "JSFunction",
            "method": "performCommandLabelUpdate",
            "inputData": {
                "anchor": "aw_globalNavigationbar",
                "commandId": "{{props.subPanelContext.commandContext.command.id}}",
                "uid": "{{props.subPanelContext.commandContext.command.handler.action.inputData.uid}}",
                "updatedTitle": "{{data.updateLabel.dbValue}}",
                "popupApi": "{{props.subPanelContext.popupApi}}"
            },
            "deps": "js/updateCommandLabelService"
        }
    },
    "i18n": {
        "Awp0Cancel": ["PersonalizationMessages"],
        "Awp0Done": ["PersonalizationMessages"],
        "Awp0Label": ["PersonalizationMessages"]
    }
}
