{
    "schemaVersion": "1.0.0",
    "data": {
        "_sublocation": {
            "name": "showObject",
            "nameToken": "com.siemens.splm.clientfx.tcui.xrt.AwDetailsSublocation",
            "context": {
                "search": {
                    "hideInContentSearchBox": true
                }
            },
            "selectionQueryParamKey": "s_uid",
            "editSupportParamKeys": [
                "s_uid"
            ],
            "supportedLayouts": [
                "Awp0DetailsOnlyLayout"
            ],
            "viewModeId":"detailsSublocation",
            "defaultLayout": {
                "layout": {
                    "column": [
                        {
                            "row": [
                                {
                                    "secondaryWorkarea": true
                                }
                            ]
                        }
                    ]
                },
                "layoutId": "Awp0DetailsOnlyLayout"
            },
            "viewBase": "AwDetails",
            "clientScopeURI": "AwDetailsSublocation",
            "secondaryWorkarea": true,
            "awSubLocationPref": {
                "liteSummaryHeader": true,
                "hideSingleTabInSWA": true
            },
            "hideRelationsTree": true,
            "defaultToTypeXRTIfNoSublocationXRT": true
        },
        "searchState": {
            "initialValues": {},
            "meta": {}
        },
        "sublocationState": {
            "initialValues": {
                "viewModeContext": {
                    "viewTuples": []
                }
            },
            "meta": {
                "viewModeContext": {
                    "viewTuples": [
                        {
                            "field": "true"
                        }
                    ]
                }
            }
        }
    },
    "actions": {
        "swaTabChange": {
            "actionType": "JSFunction",
            "method": "swaTabChange",
            "inputData": {
                "secondaryActiveTabId": "{{data.sublocationState.secondaryActiveTabId}}"
            },
            "deps": "js/detailsSublocationService"
        },
        "initializeSecondaryActiveTabId": {
            "actionType": "JSFunction",
            "method": "initializeSecondaryActiveTabId",
            "inputData": {
                "sublocationState": "{{fields.sublocationState}}",
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/detailsSublocationService"
        },
        "getDetaislSubLcnContext": {
            "actionType": "JSFunction",
            "method": "getDetaislSubLcnContext",
            "inputData": {
                "secondaryActiveTabId": "{{data.sublocationState.secondaryActiveTabId}}",
                "props.subPanelContext": "{{props.subPanelContext}}"
            },
            "outputData": {
                "detailsSubLcnContext": ""
            },
            "deps": "js/detailsSublocationService"
        },
        "handleStateChange": {
            "actionType": "JSFunctionAsync",
            "method": "initializeSecondaryActiveTabId",
            "inputData": {
                "sublocationState": "{{fields.sublocationState}}",
                "subPanelContext": "{{props.subPanelContext}}"
            },
            "deps": "js/detailsSublocationService"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "onEvent": [ {
        "eventId": "stateChangeSuccess",
        "action": "handleStateChange"
    }],
    "lifecycleHooks": {
        "onMount": "initializeSecondaryActiveTabId",
        "onUpdate": [
            {
                "action": "swaTabChange",
                "observers": [
                    "viewModel.atomicData.sublocationState.secondaryActiveTabId"
                ]
            },
            {
                "action": "getDetaislSubLcnContext",
                "observers": [
                    "viewModel.atomicData.sublocationState.secondaryActiveTabId",
                    "props.subPanelContext"
                ]
            }
        ]
    }
}
