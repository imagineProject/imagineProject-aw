{
    "schemaVersion": "1.0.0",
    "data":{
        "changeOwnerOf": {
            "displayName": "{{i18n.changeOwnerOf}}",
            "type": "STRING",
            "displayValue": ""
        },
        "changeOwnerTo": {
            "displayName": "{{i18n.changeOwnerTo}}",
            "type": "STRING",
            "displayValue": ""
        }
    },
    "actions": {
        "initialize": {
            "actionType": "JSFunction",
            "method": "initialize",
            "inputData": {
                "selectedObjects": "{{props.selectedObjects}}"
            },
            "outputData": {
                "changeOwnerOf.dbValue": "",
                "changeOwnerOf.uiValue": ""
            },
            "deps": "js/tcChangeOwnerService"
        },
        "updateNewChangeOwner": {
            "actionType": "JSFunction",
            "method": "updateNewChangeOwner",
            "inputData": {
                "newOwner": "{{props.selectedUsers[0]}}"
            },
            "outputData": {
                "changeOwnerTo.dbValue": "",
                "changeOwnerTo.uiValue": ""
            },
            "deps": "js/tcChangeOwnerService"
        }
    },
    "i18n": {
        "changeOwnerOf": [ "Awp0ChangeOwnerMessages" ],
        "changeOwnerTo": [ "Awp0ChangeOwnerMessages" ]
    },
    "lifecycleHooks": {
        "onMount": "initialize",
        "onUpdate": [ {
            "action": "updateNewChangeOwner",
            "observers": [ "props.selectedUsers", "props.selectedUsers.length" ]
        } ]
    },
    "props": {
        "selected-objects": {
            "type": "object"
        },
        "selected-users":{
            "type": "object"
        }
    }
}
