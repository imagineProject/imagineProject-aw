{
    "schemaVersion": "1.0.0",
    "data":{
        "selectionLabel": {
            "dbValue": "{{i18n.Selected}}"
        }
    },
    "actions": {
        "buildCrumbs": {
            "actionType": "JSFunction",
            "method": "buildRelationsBreadcrumb",
            "inputData": {
                "selectedString": "{{data.selectionLabel.dbValue}}",
                "selectedObjects": "{{props.selection}}",
                "baseSelection": "{{props.baseSelection}}"
            },
            "outputData": {
                "crumbs": "crumbs"
            },
            "deps": "js/relationsTreeBreadcrumbService"
        }
    },
    "lifecycleHooks": {
        "onUpdate": [
            {
                "action": "buildCrumbs",
                "observers": [
                    "props.selection", "viewModel.data.selectionLabel.dbValue"
                ]
            }
        ],
        "onMount": "buildCrumbs"
    },
    "props": {
        "base-selection": {
            "type": "object"
        },
        "selection": {
            "type": "object"
        }
    },
    "i18n": {
        "Selected": [
            "RelationsMessages"
        ]
    }
}
