{
    "schemaVersion": "1.0.0",
    "data": {
        "selectionData": {
            "initialValues": {},
            "meta": {}
        },
        "searchState": {
            "initialValues": {},
            "meta": {}
        }
    },
    "actions": {
        "handleSelectionChange": {
            "actionType": "JSFunction",
            "method": "handleSelectionChange",
            "inputData": {
                "localSelectionData": "{{fields.selectionData}}",
                "baseSelection": "{{subPanelContext.openedObject}}"
            },
            "deps": "js/AwXrtSublocationService"
        },
        "handleRevisionRuleChange":{
            "actionType": "JSFunction",
            "method": "reloadState",
            "deps": "js/tcDefaultLocationService"
        }
    },
    "onEvent": [
        {
            "eventId": "aw.revisionRuleChangeEvent",
            "action": "handleRevisionRuleChange"
        }
    ],
    "lifecycleHooks": {
        "onUpdate": [
            {
                "action": "handleSelectionChange",
                "observers": [ "viewModel.atomicData.selectionData" ]
            }
        ]
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
