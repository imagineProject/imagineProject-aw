{
    "schemaVersion" : "1.0.0",
    "imports":
    [
        "js/aw-command-panel.directive",
        "js/aw-panel-body.directive",
        "js/aw-clipboard.directive",
        "js/aw-favorite.directive",
        "js/aw-history.directive"
    ],
    "i18n":
    {   "QuickAccessTitle": [ "ZeroCompileCommandMessages" ]
    },
    "onEvent": [
        {
            "eventId": "locationChangeSuccess",
            "inputArgs": {
                "eventId":"locationChangeSuccess",
                "eventData": "{{eventData}}"
            },
            "action": "parseEventDataAndClosePanel"
        }
    ],
    "actions": {
        "parseEventDataAndClosePanel": {
            "actionType": "JSFunction",
            "method": "parseEventDataAndClosePanel",
            "inputData": {
                "eventId": "{{parameters.eventId}}",
                "eventData": "{{parameters.eventData}}",
                "popupId": "{{subPanelContext.popupOptions.popupId}}",
                "panelPinned": "{{subPanelContext.panelPinned}}"

            },
            "deps": "js/quickAccessPanelService"
        },
        "loadOrigUid": {
            "actionType": "JSFunction",
            "method": "initQuickAccessPanel",
            "inputData": {
                "originalParams": "{{ctx.state.params}}"

            },
            "deps": "js/quickAccessPanelService",
            "outputData": {
                "originalParams": "originalParams"

            }
        }
    },
    "lifecycleHooks": {
        "onMount": "loadOrigUid"
    }
}
