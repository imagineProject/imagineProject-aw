{
    "schemaVersion": "1.0.0",
    "actions": {
        "fixTreeStructureBatch": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "fixTreeStructure",
                    "condition": "data.fixTreeStructure"
                }
            ]
        },
        "loadTableConfigs": {
            "actionType": "JSFunctionAsync",
            "method": "loadTableConfigsData",
            "inputData": {
                "treeLoadInput": "{{data.treeLoadInput}}",
                "sortCriteria": "{{data.columnProviders.tableConfigsColumnProvider.sortCriteria}}",
                "searchState": "{{subPanelContext.searchState}}"
            },
            "outputData": {
                "tableLoaded": true,
                "treeLoadResult": "treeLoadResult",
                "fixTreeStructure": "fixTreeStructure"
            },
            "deps": "js/tableConfigsPwaService"
        },
        "fixTreeStructure": {
            "actionType": "JSFunction",
            "method": "fixTreeStructure",
            "inputData": {
                "dataProvider": "{{data.dataProviders.tableConfigsDataProvider}}"
            },
            "outputData": {
                "fixTreeStructure": false
            },
            "deps": "js/tableConfigsPwaService"
        },
        "focusLoadTableConfigs": {
            "actionType": "JSFunctionAsync",
            "method": "loadTableConfigsData",
            "inputData": {
                "treeLoadInput": "{{data.treeLoadInput}}",
                "sortCriteria": "{{data.columnProviders.tableConfigsColumnProvider.sortCriteria}}",
                "searchState": "{{subPanelContext.searchState}}",
                "focusColumnConfigId": "{{ctx.state.params.s_columnConfigId}}",
                "focusTableConfigId": "{{ctx.state.params.s_uid}}",
                "selectionModel": "{{subPanelContext.selectionModel}}",
                "privilegeDbValue": "{{ctx.group.props.privilege.dbValue}}",
                "allowTableConfiguratorAccess": "{{ctx.allowTableConfiguratorAccess}}"
            },
            "outputData": {
                "tableLoaded": true,
                "treeLoadResult": "treeLoadResult"
            },
            "deps": "js/tableConfigsPwaService"
        },
        "selectClientScopeDefault": {
            "actionType": "JSFunction",
            "method": "selectClientScopeDefault",
            "inputData": {
                "treeLoadResult": "{{data.treeLoadResult}}",
                "sortCriteria": "{{data.columnProviders.tableConfigsColumnProvider.sortCriteria}}",
                "searchState": "{{subPanelContext.searchState}}",
                "dataProvider": "{{data.dataProviders.tableConfigsDataProvider}}",
                "selectionModel": "{{subPanelContext.selectionModel}}",
                "s_clientScopeURI": "{{ctx.state.params.s_clientScopeURI}}"
            },
            "outputData": {
                "selectionDone": true
            },
            "deps": "js/tableConfigsPwaService"
        },
        "filterTableConfigsDebounced": {
            "actionType": "JSFunction",
            "method": "filterTableConfigsDataDebounced",
            "inputData": {
                "sortCriteria": "{{data.columnProviders.tableConfigsColumnProvider.sortCriteria}}",
                "searchState": "{{subPanelContext.searchState}}",
                "dataProvider": "{{data.dataProviders.tableConfigsDataProvider}}",
                "selectionModel": "{{subPanelContext.selectionModel}}",
                "searchString": "{{data.tableConfigsSearchBox.dbValue}}"
            },
            "deps": "js/tableConfigsPwaService"
        },
        "filterTableConfigs": {
            "actionType": "JSFunctionAsync",
            "method": "filterTableConfigsData",
            "inputData": {
                "sortCriteria": "{{data.columnProviders.tableConfigsColumnProvider.sortCriteria}}",
                "searchState": "{{subPanelContext.searchState}}",
                "dataProvider": "{{data.dataProviders.tableConfigsDataProvider}}",
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "deps": "js/tableConfigsPwaService"
        },
        "filterTableConfigsBatchAction": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "updateSearchString"
                },
                {
                    "action": "filterTableConfigs",
                    "condition": "data.doFilter === true"
                }
            ]
        },
        "updateSearchString": {
            "actionType": "JSFunction",
            "method": "updateSearchString",
            "inputData": {
                "searchState": "{{subPanelContext.searchState}}",
                "searchString": "{{data.tableConfigsSearchBox.dbValue}}"
            },
            "outputData": {
                "doFilter": ""
            },
            "deps": "js/tableConfigsPwaService"
        },
        "clearSearchBox": {
            "actionType": "JSFunction",
            "method": "clearSearchBox",
            "inputData": {
                "searchBox": "{{fields.tableConfigsSearchBox}}"
            },
            "deps": "js/tableConfigsPwaService"
        },
        "loadAndSelectNewTableDefault": {
            "actionType": "JSFunction",
            "method": "loadAndSelectNewTableDefault",
            "inputData": {
                "sortCriteria": "{{data.columnProviders.tableConfigsColumnProvider.sortCriteria}}",
                "searchState": "{{subPanelContext.searchState}}",
                "dataProvider": "{{data.dataProviders.tableConfigsDataProvider}}",
                "createdTableData": "{{parameters.createdTableData}}",
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "deps": "js/tableConfigsPwaService"
        },
        "selectNewTableConfig": {
            "actionType": "JSFunction",
            "method": "selectNewTableConfig",
            "inputData": {
                "sortCriteria": "{{data.columnProviders.tableConfigsColumnProvider.sortCriteria}}",
                "searchState": "{{subPanelContext.searchState}}",
                "dataProvider": "{{data.dataProviders.tableConfigsDataProvider}}",
                "createdTableConfigData": "{{parameters.createdTableConfigData}}",
                "operatedNode": "{{parameters.operatedNode}}",
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "deps": "js/tableConfigsPwaService"
        },
        "removeTableConfig": {
            "actionType": "JSFunctionAsync",
            "method": "deleteTableConfig",
            "inputData": {
                "selection": "{{parameters.selection}}",
                "dataProvider": "{{data.dataProviders.tableConfigsDataProvider}}",
                "i18n": "{{i18n}}"
            },
            "deps": "js/tableConfigsPwaService"
        }
    },
    "dataProviders": {
        "tableConfigsDataProvider": {
            "action": "loadTableConfigs",
            "nextAction": "loadTableConfigs",
            "prevAction": "loadTableConfigs",
            "focusAction": "focusLoadTableConfigs",
            "initializeAction": "focusLoadTableConfigs",
            "treeLoadResult": "{{data.treeLoadResult}}",
            "selectionModelMode": "single",
            "inputData": {
                "accessMode": "tree",
                "selectionModel": "{{subPanelContext.selectionModel}}",
                "topNodeUid": "top"
            },
            "contextMenuCommandsAnchor": "aw_showTableConfigs_contextMenu"
        }
    },
    "columnProviders": {
        "tableConfigsColumnProvider": {
            "columns": [
                {
                    "name": "fnd0ClientScopeURI",
                    "displayName": "Name",
                    "width": 445,
                    "isTreeNavigation": true,
                    "enableColumnHiding": false
                },
                {
                    "name": "typeDisplayName",
                    "displayName": "Type",
                    "enableColumnMenu": false
                }
            ]
        }
    },
    "grids": {
        "tableConfigsTree": {
            "dataProvider": "tableConfigsDataProvider",
            "columnProvider": "tableConfigsColumnProvider",
            "addIconColumn": false,
            "gridOptions": {
                "flexLastColumn": true,
                "enablePinning": false,
                "enableExpansionStateCaching": false
            }
        }
    },
    "data": {
        "tableConfigsSearchBox": {
            "displayName": "{{i18n.tableConfigsSearchBoxDisplayText}}",
            "type": "STRING",
            "dbValue": ""
        }
    },
    "functions": {},
    "conditions": {
        "isAllowedForTableConfigurator": {
            "expression": "ctx.group.props.privilege.dbValue !== 0 || ctx.allowTableConfiguratorAccess === 'true'"
        }
    },
    "onEvent": [
        {
            "eventId": "tableCreated",
            "action": "loadAndSelectNewTableDefault",
            "inputArgs": {
                "createdTableData": "{{eventData.createdTableData}}"
            }
        },
        {
            "eventId": "tableConfigCreated",
            "action": "selectNewTableConfig",
            "inputArgs": {
                "createdTableConfigData": "{{eventData.createdTableConfigData}}",
                "operatedNode": "{{eventData.operatedNode}}"
            }
        },
        {
            "eventId": "tableConfigPrimary.removeTableConfig",
            "action": "removeTableConfig",
            "inputArgs": {
                "selection": "{{eventData.selectionToRemove}}"
            }
        },
        {
            "eventId": "tableConfigsImported",
            "action": "clearSearchBox"
        }
    ],
    "lifecycleHooks": {
        "onUpdate": [
            {
                "action": "fixTreeStructureBatch",
                "observers": [ "viewModel.dataProviders.tableConfigsDataProvider.viewModelCollection.loadedVMObjects" ]
            },
            {
                "action": "filterTableConfigsDebounced",
                "observers": [ "viewModel.data.tableConfigsSearchBox.dbValue" ]
            }
        ]
    },
    "i18n": {
        "tableConfigsSearchBoxText": [ "tableConfigsMessages" ],
        "tableConfigsSearchBoxDisplayText": [ "tableConfigsMessages" ],
        "tableConfigsRemoveParentTableConfigText": [ "tableConfigsMessages" ],
        "cancel": [ "ZeroCompileCommandMessages" ],
        "delete": [ "ZeroCompileCommandMessages" ],
        "tableConfigDeleteTable": [ "tableConfigsMessages" ],
        "tableConfigDeleteTableConfig": [ "tableConfigsMessages" ]
    }
}
