{
    "schemaVersion": "1.0.0",
    "data": {
        "relationsTreeToggle": {
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "{{ctx.state.urlAttributes.relationsTree}}"
        }
    },
    "actions": {
        "toggleRelationsTree": {
            "actionType": "JSFunction",
            "method": "toggleRelationsTree",
            "inputData": {
                "toggleButtonStatus": "{{data.relationsTreeToggle}}"
            },
            "deps": "js/relationsTreeToggleService"
        }
    }
}
