{
    "schemaVersion": "1.0.0",
    "data": {
        "showMore": {
            "displayName": "{{i18n.SHOW_MORE}}",
            "type": "STRING",
            "isRequired": "false"
        },
        "showLess": {
            "displayName": "{{i18n.SHOW_LESS}}",
            "type": "STRING",
            "isRequired": "false"
        },
        "lessDetails": true
    },
    "actions": {
        "getAboutProperties": {
            "actionType": "JSFunctionAsync",
            "method": "getAboutProperties",
            "outputData":{
                "build": "build",
                "buildId": "buildId",
                "clientBuildTime": "clientBuildTime",
                "clientFramework": "clientFramework",
                "clientViewer": "clientViewer",
                "sessionLog": "sessionLog",
                "copyrightText": "copyrightText"
            },
            "deps": "js/helpAboutService"
        },
        "closePopupWindow": {
            "actionType": "JSFunction",
            "method": "hide",
            "inputData": {
                "popupId": "{{data.popupId}}"
            },
            "deps": "js/popupService"
        },
        "getMoreDetails": {
            "actionType": "JSFunction",
            "method": "getMoreDetails",
            "inputData": {
                "siteName": "{{props.siteName}}"
            },
            "outputData": {
                "lessDetails": "lessDetails"
            },
            "deps": "js/helpAboutService"
        },
        "getLessDetails": {
            "actionType": "JSFunction",
            "method": "getLessDetails",
            "inputData": {},
            "outputData": {
                "lessDetails": "lessDetails"
            },
            "deps": "js/helpAboutService"
        }
    },
    "onEvent": [
        {
            "eventId": "aw.closePopup",
            "action": "closePopupWindow"
        }
    ],
    "lifecycleHooks": {
        "onMount": "getAboutProperties"
    },
    "i18n": {
        "closeText": [
            "ZeroCompileCommandMessages"
        ],
        "COPYRIGHT_MESSAGE": [
            "LoginMessages"
        ],
        "COPYRIGHT_DATE_TEXT": [
            "LoginMessages"
        ],
        "SHOW_MORE": ["BaseMessages"],
        "SHOW_LESS": ["BaseMessages"]
    }
}