{
    "schemaVersion": "1.0.0",
    "imports": [
        "js/aw-command-panel.directive",
        "js/aw-command-bar.directive",
        "js/aw-panel-body.directive",
        "js/visible-when.directive",
        "js/aw-button.directive",
        "js/aw-i18n.directive",
        "js/aw-list-filter.directive",
        "js/aw-checkbox.directive",
        "js/aw-label.directive",
        "js/aw-textbox.directive",
        "js/aw-command-panel-section.directive"
    ],
    "actions": {
        "reveal": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetNamedColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "namedColumnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeUri": "{{function:getClientScopeUri}}",
                        "columnConfigName": "",
                        "columnConfigId": "{{function:getColumnConfigUid}}",
                        "columnsToExclude": []
                    },
                    "namedColumnConfigCriteria": {}
                }
            },
            "outputData": {
                "arrangeData.savedColumnConfigs": "{{json:namedColumnConfigsJSON}}"
            },
            "events": {
                "success": [
                    {
                        "name": "arrangePanel.updateArrangeClientScopeUICtx"
                    }
                ]
            }
        },
        "loadColumnConfigDataProvider": {
            "actionType": "dataProvider",
            "method": "dataProviderColumnConfigs"
        },
        "loadAvailableColumnConfigDataProvider": {
            "actionType": "dataProvider",
            "method": "dataProviderAvailableColumnConfigs"
        },
        "deleteNamedColumnConfig": {
            "actionType": "TcSoaService",
            "serviceName": "Internal-AWS2-2020-05-UiConfig",
            "method": "deleteNamedColumnConfig",
            "inputData": {
                "uid": "{{commandContext.vmo.columnConfigUid}}"
            },
            "events": {
                "success": [
                    {
                        "name": "arrangePanel.namedColumnConfigDeleted",
                        "eventData": {
                            "data": "{{data}}"
                        }
                    },
                    {
                        "name": "hideViewColumnConfigurationsPopup"
                    }
                ],
                "failure": [
                    {
                        "name": "hideViewColumnConfigurationsPopup"
                    }
                ]
            }
        },
        "removeNamedColumnConfigFromProvider": {
            "actionType": "JSFunction",
            "method": "removeNamedColumnConfigFromProvider",
            "inputData": {
                "data": "{{data}}",
                "loadedColumnConfig": "{{parameters.eventData}}"
            },
            "outputData": {
                "arrangeData.savedColumnConfigs": ""
            },
            "deps": "js/arrange.service"
        },
        "actionFilterList": {
            "actionType": "JSFunction",
            "method": "actionFilterList",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData":{
                "arrangeData": "result.arrangeData",
                "dataProvider.dataProviderAvailableColumnConfigs": "result.dataProviderAvailableColumnConfigs",
                "dataProvider.dataProviderColumnConfigs": "result.dataProviderColumnConfigs",
                "columnConfigName": "result.columnConfigName",
                "newColumnConfigName": "result.newColumnConfigName"
            },
            "events": {
                "success": [
                    {
                        "name": "arrangepanel.setCurrentColumnArrangementAsNonModifiable"
                    },
                    {
                        "name": "arrangePanel.columnVisibilityChanged",
                        "eventData": {
                            "data": "{{data}}"
                        }
                    }
                ]
            },
            "deps": "js/arrange.service"
        },
        "loadExistingColumnConfig": {
            "actionType": "JSFunction",
            "method": "loadExistingColumnConfig",
            "inputData": {
                "data": "{{data}}",
                "loadedColumnConfig": "{{parameters.eventData}}"
            },
            "outputData":{
                "arrangeData": "result.arrangeData",
                "newColumnConfig": "result.newColumnConfig",
                "filterBox":"result.filterBox",
                "dataProviderColumnConfigs": "result.dataProviderColumnConfigs",
                "dataProviderAvailableColumnConfigs": "result.dataProviderAvailableColumnConfigs",
                "columnConfigName": "result.columnConfigName",
                "newColumnConfigName":"result.newColumnConfigName"
            },
            "events": {
                "success": [
                    {
                        "name": "arrangePanel.updateNewArrangementCheckboxEditability"
                    },
                    {
                        "name": "arrangePanel.columnVisibilityChanged",
                        "eventData": {
                            "data": "{{data}}"
                        }
                    }
                ]
            },
            "deps": "js/arrange.service"
        },
        "selectColumn": {
            "actionType": "JSFunction",
            "method": "selectColumn",
            "inputData": {
                "data": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "outputData": {
                "dataProvider.dataProviderAvailableColumnConfigs": "result.dataProviderAvailableColumnConfigs",
                "dataProvider.dataProviderColumnConfigs": "result.dataProviderColumnConfigs"
            },
            "deps": "js/arrange.service"
        },
        "selectAvailableColumn": {
            "actionType": "JSFunction",
            "method": "selectAvailableColumn",
            "inputData": {
                "data": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "outputData": {
                "dataProvider.dataProviderAvailableColumnConfigs": "result.dataProviderAvailableColumnConfigs",
                "dataProvider.dataProviderColumnConfigs": "result.dataProviderColumnConfigs"
            },
            "deps": "js/arrange.service"
        },
        "columnVisibilityChanged": {
            "actionType": "JSFunction",
            "method": "columnVisibilityChanged",
            "inputData": {
                "data": "{{parameters.eventData}}"
            },
            "outputData":{
                "arrangeData":"result.arrangeData",
                "newColumnConfig": "result.newColumnConfig"
            },
            "events": {
                "success": [
                    {
                        "name":"exportToExcel.propertiesToExport",
                        "eventData":{
                            "arrangeData":"{{data.arrangeData}}",
                            "newColumnconfig":"{{data.newColumnConfig}}"
                        }
                    }

                ]
            },
            "deps": "js/arrange.service"
        },
        "operationTypeChanged": {
            "actionType": "JSFunction",
            "method": "operationTypeChanged",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData": {
                "filterBox":"result.filterBox",
                "arrangeData":"result.arrangeData"
            },
            "deps": "js/arrange.service"
        },
        "updateColumns": {
            "actionType": "JSFunction",
            "method": "updateColumns",
            "inputData": {
                "data": "{{data}}",
                "eventData": "{{parameters.eventData}}"
            },
            "outputData":{
                "arrangeData": "result.arrangeData",
                "dataProvider.dataProviderAvailableColumnConfigs": "dataProviderAvailableColumnConfigs",
                "dataProvider.dataProviderColumnConfigs": "dataProviderColumnConfigs"
            },
            "events": {
                "success": [
                    {
                        "name":"arrangePanel.updateArrangeColumnData"
                    },
                    {
                        "name": "arrangePanel.columnVisibilityChanged",
                        "eventData": {
                            "data": "{{data}}"
                        }
                    }
                ]
            },
            "deps": "js/arrange.service"
        },
        "markDirty": {
            "actionType": "JSFunction",
            "method": "markDirty",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData":{
                "newColumnConfig":"result.newColumnConfig",
                "arrangeData":"result.arrangeData"
            },
            "events": {
                "success": [
                    {
                        "name":"exportToExcel.propertiesToExport",
                        "eventData":{
                            "arrangeData":"{{data.arrangeData}}",
                            "newColumnconfig":"{{data.newColumnConfig}}"
                        }
                    }
                ]
            },
            "deps": "js/arrange.service"
        },
        "arrange": {
            "actionType": "JSFunction",
            "method": "arrange",
            "inputData": {
                "data": "{{data.arrangeData}}",
                "arrangeType": "saveColumnAndLoadAction"
            },
            "deps": "js/arrange.service"
        },
        "arrangeAndSaveWithExportToExcel":{
            "actionType":"batchJob",
            "steps": [
                {
                    "action": "arrangeAndSave"
                },
                {
                    "action": "arrangeAndSet"
                }
            ]
        },
        "arrangeAndSave": {
            "actionType": "JSFunctionAsync",
            "method": "baseSaveNamedColumnConfig",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "uid": "{{data.arrangeData.loadedColumnConfigUid}}",
                    "columns": "{{function:createSoaColumns}}",
                    "namedColumnConfigCriteria": {
                        "clientScopeUri": "{{data.arrangeData.clientScopeUri}}"
                    }
                }
            },
            "events": {
                "success": [
                    {
                        "name": "exportExcel.eportDoc"
                    }
                ]
            }
        },
        "arrangeAndSet": {
            "actionType": "JSFunctionAsync",
            "method": "baseSaveNamedColumnConfig",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "uid": "{{data.arrangeData.originalColumnConfig.columnConfigUid}}",
                    "columns": [],
                    "namedColumnConfigCriteria": {
                        "clientScopeUri": "{{data.arrangeData.clientScopeUri}}"
                    }
                }
            }
        },
        "CreateNewArrangeSOAActionWithExportToExcel":{
            "actionType": "batchJob",
            "steps": [
                {
                    "action":"updateArrangeColumnData"
                },
                {
                    "action": "arrangeAndCreateSOAAction"
                },
                {
                    "action": "arrangeAndSet"
                }
            ]
        },
        "createNewArrangeSOAAndResetDefaultAndExportToExcel": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action":"updateArrangeColumnData"
                },
                {
                    "action": "arrangeAndCreateSOAAction"
                },
                {
                    "action": "getOrResetColumnConfigExport"
                }
            ]
        },
        "arrangeAndCreateSOAAction": {
            "actionType": "JSFunctionAsync",
            "method": "baseCreateNamedColumnConfig",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "namedColumnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeUri": "{{data.arrangeData.clientScopeUri}}",
                        "columnConfigName": "{{data.newColumnConfigName.dbValue}}",
                        "columnConfigId": "{{data.arrangeData.columnConfigId}}",
                        "columnsToExclude": []
                    },
                    "columns": "{{function:createSoaColumns}}",
                    "namedColumnConfigCriteria": {
                        "columnConfigOriginUid": "{{data.arrangeData.loadedColumnConfigUid}}"
                    }
                }
            },
            "events": {
                "success": [
                    {
                        "name": "exportExcel.eportDoc"
                    }
                ],
                "failure": [
                    {
                        "name":"exportExcel.unregisterExportCmdContext"
                    }
                ]
            },
            "actionMessages": {
                "failure": [
                    {
                        "message": "arrangePanelConfigFailure"
                    }
                ]
            }
        },
        "arrangeAndSetDefault":{
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "arrangeAndSave"
                },
                {
                    "action": "getOrResetColumnConfigExport"
                }
            ]
        },
        "arrangeAndCreate": {
            "actionType": "JSFunction",
            "method": "arrange",
            "inputData": {
                "data": "{{data.arrangeData}}",
                "arrangeType": "saveAsNewColumnAndLoadAction"
            },
            "deps": "js/arrange.service"
        },
        "preLoadColumnConfig": {
            "actionType": "JSFunction",
            "method": "preLoadColumnConfig",
            "deps": "js/arrange.service",
            "inputData": {
                "loadedColumnConfig": "{{parameters.eventData.loadedColumnConfig}}"
            }
        },
        "preRemoveColumnConfig": {
            "actionType": "JSFunction",
            "method": "preRemoveColumnConfig",
            "deps": "js/arrange.service",
            "inputData": {
                "namedColumnConfig": "{{commandContext.vmo}}"
            }
        },
        "removeColumnConfig": {
            "actionType": "JSFunction",
            "method": "removeColumns",
            "deps": "js/arrange.service",
            "inputData": {
                "arrangeData": "{{data.arrangeData}}",
                "data": "{{data.dataProviders}}",
                "eventData": "{{parameters.eventData}}"
            },
            "outputData": {
                "arrangeData": "result.arrangeData",
                "dataProvider.dataProviderColumnConfigs": "result.dataProviderColumnConfigs"
            }
        },
        "addAvailableColumnConfig": {
            "actionType": "JSFunction",
            "method": "addColumns",
            "deps": "js/arrange.service",
            "inputData": {
                "arrangeData": "{{data.arrangeData}}",
                "dataProviders": "{{data.dataProviders}}",
                "eventData": "{{parameters.eventData}}"
            },
            "outputData": {
                "arrangeData": "result.arrangeData",
                "dataProvider.dataProviderColumnConfigs": "result.dataProviderColumnConfigs"
            }
        },
        "loadAvailableColumns": {
            "actionType": "JSFunctionAsync",
            "method": "loadAvailableColumns",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData": {
                "availableColumns": "availableColumns",
                "totalFound": "totalFound"
            },
            "deps": "js/arrange.service"
        },
        "startLoadingAdditionalColumns": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "toggleLoadingAdditionalColumns"
                },
                {
                    "action": "reloadAvailableColumns"
                }
            ]
        },
        "toggleLoadingAdditionalColumns": {
            "actionType": "JSFunction",
            "method": "toggleLoadingAdditionalColumns",
            "inputData": {
                "data": "{{data}}"
            },
            "deps": "js/arrange.service"
        },
        "reloadAvailableColumns": {
            "actionType": "dataProvider",
            "method": "dataProviderAvailableColumnConfigs"
        },
        "updateArrangeClientScopeUICtx":{
            "actionType":"JSFunction",
            "method":"updateArrangeClientScopeUICtx",
            "inputData": {
                "data": "{{data}}",
                "subPanelContext": "{{subPanelContext}}"
            },
            "outputData":{
                "arrangeData":"arrangeData",
                "primaryWorkAreaColumnConfigType": "primaryWorkAreaColumnConfigType"
            },
            "events":{
                "success":[
                    {
                        "name": "arrangePanel.listOfColumnConfigsRetrieved"
                    }
                ]
            },
            "deps": "js/ExcelExportToOfficeApp"
        },
        "getOrResetColumnConfigExport":{
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": "{{function:getOrResetColumnConfigExportInput}}"
                }
            }
        },
        "setCurrentColumnArrangementAsNonModifiable":{
            "actionType":"JSFunction",
            "method":"setCurrentColumnArrangementAsNonModifiable",
            "inputData":{
                "data": "{{data}}"
            },
            "outputData":{
                "arrangeData":"arrangeData"
            },
            "deps": "js/ExcelExportToOfficeApp"
        },
        "updateArrangeColumnData":{
            "actionType":"JSFunction",
            "method":"updateArrangeColumnData",
            "inputData":{
                "data": "{{data}}"
            },
            "outputData":{
                "updatedArrangedData":"updatedArrangedData",
                "newColumnConfig":"newColumnConfig"
            },
            "events":{
                "success":[
                    {
                        "name": "arrangePanel.updateNewArrangementCheckboxEditability"
                    }
                ]
            },
            "deps": "js/ExcelExportToOfficeApp"
        },
        "updateNewArrangementCheckboxEditability":{
            "actionType":"JSFunction",
            "method":"updateNewArrangementCheckboxEditability",
            "inputData":{
                "isSaveAsNewColumnConfig": "{{data.newColumnConfig.dbValue}}"
            },
            "deps": "js/ExcelExportToOfficeApp"
        },
        "reloadArrangePanel":{
            "actionType":"JSFunction",
            "method":"reloadArrangePanel",
            "inputData":{
                "data":"{{data}}"
            },
            "deps": "js/ExcelExportToOfficeApp"
        }
    },
    "data": {
        "filterBox": {
            "dbValue": "",
            "displayName": "",
            "type": "STRING"
        },
        "filterAvailableBox": {
            "dbValue": "",
            "displayName": "",
            "type": "STRING"
        },
        "loadLessColumnsTitle": {
            "dbValue": "",
            "displayName": "{{i18n.loadLessColumnsTitle}}",
            "type": "STRING"
        },
        "columnConfigName": {
            "dbValue": "",
            "uiValue": "",
            "type": "STRING",
            "displayName": "{{i18n.arrangeConfigNameTitle}}",
            "propertyName": "columnConfigName",
            "isNull": false,
            "propApi": {}
        },
        "newColumnConfigName": {
            "dbValue": "testColumnConfigName",
            "type": "STRING",
            "displayName": "{{i18n.datasetName}}",
            "propertyName": "newColumnConfigName",
            "isNull": false,
            "isEditable": true,
            "isEnabled": true,
            "propApi": {},
            "inputType": "text",
            "requiredText": "{{i18n.arrangeNewConfigNameTitleRequired}}",
            "maxLength": 512
        },
        "newColumnConfig": {
                "dbValue": false,
                "uiValue": "",
                "type": "BOOLEAN",
                "displayName": "{{i18n.arrangeNewConfigTitle}}",
                "propertyName": "newColumnConfig",
                "isNull": false,
                "isEditable": true,
                "isEnabled": true,
                "propApi": {},
                "labelPosition": "PROPERTY_LABEL_AT_RIGHT"
        },
        "arrangeData": {
            "columnConfigId": null,
            "filter": "",
            "columnDefs": null,
            "availableColumnDefs": null,
            "filteredColumnDefs": null,
            "filteredAvailableColumnDefs": null,
            "allColumnsVisible": true,
            "dirty": false,
            "operationType": "configured",
            "columnsLoadInfo": {}
        }
    },
    "dataProviders": {
        "dataProviderColumnConfigs": {
            "action": "actionFilterList",
            "response": "{{data.arrangeData.filteredColumnDefs}}",
            "totalFound": "{{data.arrangeData.filteredColumnDefs.length}}",
            "selectionModelMode": "multiple",
            "deps": "js/arrange.service"
        },
        "dataProviderAvailableColumnConfigs": {
            "action": "loadAvailableColumns",
            "response": "{{data.availableColumns}}",
            "totalFound": "{{data.totalFound}}",
            "selectionModelMode": "multiple",
            "deps": "js/arrange.service"
        }
    },
    "i18n": {
        "arrangeAndSaveButtonTitle": [
            "ArrangeColumnsMessages"
        ],
        "arrangeAndCreateButtonTitle": [
            "ArrangeColumnsMessages"
        ],
        "arrangeConfigNameTitle": [
            "ArrangeColumnsMessages"
        ],
        "arrangeNewConfigNameTitleRequired": [
            "ArrangeColumnsMessages"
        ],
        "arrangeNewConfigTitle": [
            "ArrangeColumnsMessages"
        ],
        "arrangeAdminTitle": [
            "ArrangeColumnsMessages"
        ],
        "defaultNewColumnConfigName": [
            "ArrangeColumnsMessages"
        ],
        "datasetName": [
            "awAddDirectiveMessages"
        ],
        "arrangeMenu": [
            "treeTableMessages"
        ],
        "availableColumnsTitle": [
            "ArrangeColumnsMessages"
        ],
        "tableColumnsTitle": [
            "ArrangeColumnsMessages"
        ],
        "loadMoreColumnsTitle": [
            "ArrangeColumnsMessages"
        ],
        "loadLessColumnsTitle": [
            "ArrangeColumnsMessages"
        ]
    },
    "onEvent": [
        {
            "eventId":"arrangePanel.updateArrangeColumnData",
            "action":"updateArrangeColumnData"
        },
        {
            "eventId":"arrangePanel.updateNewArrangementCheckboxEditability",
            "action":"updateNewArrangementCheckboxEditability"
        },
        {
            "eventId":"changeColumnConfigwithDefault",
            "action":"getOrResetColumnConfigExport"
        },
        {
            "eventId":"arrangePanel.updateArrangeClientScopeUICtx",
            "action":"updateArrangeClientScopeUICtx"
        },
        {
            "eventId":"setOriginalColumnConfig",
            "action":"arrangeAndSet"
        },
        {
            "eventId": "dataProviderColumnConfigs.selectionChangeEvent",
            "cacheEventData": true,
            "action": "selectColumn"
        },
        {
            "eventId": "dataProviderAvailableColumnConfigs.selectionChangeEvent",
            "cacheEventData": true,
            "action": "selectAvailableColumn"
        },
        {
            "eventId": "arrangePanel.columnVisibilityChanged",
            "cacheEventData": false,
            "action": "columnVisibilityChanged",
            "inputArgs": {
                "eventData": "{{eventData.data}}"
            }
        },
        {
            "eventId": "columnChanged",
            "cacheEventData": false,
            "action": "updateColumns",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "operationTypeChanged",
            "cacheEventData": false,
            "action": "operationTypeChanged"
        },
        {
            "eventId": "arrangePanel.columnConfigLoaded",
            "action": "preLoadColumnConfig",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "arrangePanel.columnConfigLoadRedirect",
            "action": "loadExistingColumnConfig",
            "inputArgs": {
                "eventData": "{{eventData}}"
            },
            "cacheEventData": true
        },
        {
            "eventId": "arrangePanel.columnConfigRemoveRedirect",
            "action": "removeNamedColumnConfigFromProvider",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "arrangePanel.listOfColumnConfigsRetrieved",
            "action": "loadColumnConfigDataProvider"
        },
        {
            "eventId": "arrangePanel.listOfColumnConfigsRetrieved",
            "action": "loadAvailableColumnConfigDataProvider"
        },
        {
            "eventId": "arrangePanel.deleteNamedColumnConfig",
            "action": "deleteNamedColumnConfig"
        },
        {
            "eventId": "arrangePanel.namedColumnConfigDeleted",
            "action": "preRemoveColumnConfig"
        },
        {
            "eventId": "dataProviderAvailableColumnConfigs.listDoubleClick",
            "action": "addAvailableColumnConfig",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "dataProviderColumnConfigs.listDoubleClick",
            "action": "removeColumnConfig",
            "inputArgs": {
                "eventData": "{{eventData}}"
            }
        },
        {
            "eventId": "saveNewArrangementAndExport",
            "action": "CreateNewArrangeSOAActionWithExportToExcel"
        },
        {
            "eventId":"createNewArrangementAndResetOrgColumnConfig",
            "action": "createNewArrangeSOAAndResetDefaultAndExportToExcel"
        },
        {
            "eventId": "updateExisitingColumnArrangementWithExport",
            "action": "arrangeAndSaveWithExportToExcel"
        },
        {
            "eventId":"updateExistingArrangementAndResetOrgColumnConfig",
            "action":"arrangeAndSetDefault"
        },
        {
            "eventId":"revealArrangePanel",
            "action":"reveal"
        },
        {
            "eventId":"arrangepanel.setCurrentColumnArrangementAsNonModifiable",
            "action":"setCurrentColumnArrangementAsNonModifiable"
        }
    ],
    "functions": {
        "createSoaColumns": {
            "functionName": "createNamedSoaColumns",
            "parameters": [
                "{{data.updatedArrangedData}}"
            ],
            "deps": "js/arrange.service"
        },
        "getClientScopeUri": {
            "functionName": "getClientScopeUri",
            "parameters": [
                "{{props.subPanelContext}}"
            ],
            "deps": "js/ExcelExportToOfficeApp"
        },
        "createSoaColumnsForDefault": {
            "functionName": "createSoaColumnsForDefault",
            "parameters": [
                "{{data.arrangeData.columnConfig}}"
            ]
        },
        "getColumnConfigUid":{
            "functionName": "getColumnConfigUid",
            "deps": "js/ExcelExportToOfficeApp"
        },
        "getOrResetColumnConfigExportInput":{
            "functionName":"getOrResetColumnConfigExportInput",
            "parameters": [
                "{{props.subPanelContext}}",
                "{{data.primaryWorkAreaColumnConfigType}}"
            ],
            "deps": "js/ExcelExportToOfficeApp"
        }
    },
    "lifecycleHooks": {
        "onMount": "reveal",
        "onUpdate": [ {
            "action": "reloadArrangePanel",
            "observers": [ "props.subPanelContext.selectionData.selected" ]
        } ]
    },
    "messages": {
        "arrangePanelConfigFailure": {
            "messageType": "ERROR",
            "messageText": "{{errorCode}}"
        }
    }
}
