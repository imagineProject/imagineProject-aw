{
    "schemaVersion": "1.0.0",
    "actions": {
        "backGroundRender": {
            "actionType": "JSFunction",
            "method": "backGroundRender",
            "deps": "js/hosting/interopSamAuthUtil"
        },
        "backgroundOnMount": {
            "actionType": "JSFunction",
            "method": "backgroundOnMount",
            "inputData": {
                "dispatch": "{{data.dispatch}}"
            },
            "outputData": {
                "isLoading": "isLoading"
            },
            "deps": "js/hosting/interopSamAuthUtil"
        },
        "onLoadingUpdate": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [
                    {
                        "name": "ssoloader-progress.start",
                        "excludeLocalDataCtx": true,
                        "condition": "conditions.isLoading"
                    },
                    {
                        "name": "ssoloader-progress.end",
                        "excludeLocalDataCtx": true,
                        "condition": "conditions.isNotLoading"
                    }
                ]
            }
        }
    },
    "data": {
        "isLoading": false,
        "openPopupLink": {
            "displayName": "{{i18n.openLoginWindow}}",
            "type": "STRING",
            "isRequired": "true"
        }
    },
    "conditions": {
        "isLoading": {
            "expression": "data.isLoading"
        },
        "isNotLoading": {
            "expression": "!data.isLoading"
        }
    },
    "lifecycleHooks": {
        "render": "backGroundRender",
        "onMount": "backgroundOnMount",
        "onUpdate": [
            {
                "action": "onLoadingUpdate",
                "observers": [
                    "viewModel.data.isLoading"
                ]
            }
        ]
    },
    "i18n": {
        "loginProgress": [
            "hostingMessages"
        ],
        "openLoginWindow": [
            "hostingMessages"
        ],
        "windowClosed": [
            "hostingMessages"
        ]
    }
}
