{
    "schemaVersion": "1.0.0",
    "imports":[],
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "actions":
    {
        "fileChangeAction": {
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "setFileParameters"
                },
                {
                    "action": "registerCtxforImport"
                },
                {
                    "action": "registerSharedData"
                }
            ]
        },
        "setFileParameters": {
            "actionType": "JSFunction",
            "method": "setFileParameters",
            "inputData": {
                "fileName": "{{parameters.fileName}}",
                "validFile": "{{parameters.validFile}}",
                "fileNameNoExt": "{{parameters.fileNameNoExt}}",
                "fileExt": "{{parameters.fileExt}}",
                "formData": "{{parameters.formData}}"
            },
            "outputData": {
                "fileName": "fileName",
                "validFile": "validFile",
                "fileNameNoExt": "fileNameNoExt",
                "fileExt": "fileExt",
                "formData": "formData"
            },
            "deps": "js/fileUploadUtils"
        },
        "closePanelDialog": {
            "actionType": "JSFunction",
            "method": "closeDialog",
            "inputData": {
              "editContext": "INFO_PANEL_CONTEXT",
              "popupId": "{{subPanelContext.popupOptions.popupId}}"
            },
            "deps": "js/dialogService"
          },
        "registerCtxforImport":{
            "actionType": "JSFunction",
            "method": "registerCtxforImport",
            "inputData": {
                "data": "{{data}}"
            },
            "outputData": {
                "fileName": "fileName",
                "validFile": "validFile",
                "fileNameNoExt": "fileNameNoExt",
                "fileExt": "fileExt",
                "formData": "formData"
            },
            "deps": "js/ExcelImportNew"
        },
        "registerSharedData":{
            "actionType": "JSFunction",
            "method": "registerSharedData",
            "inputData": {
                "data": "{{data}}",
                "sharedData": "{{subPanelContext.sharedData}}"
            },
            "deps": "js/ExcelImportNew"
        },
        "prepareSelectedSepcData":{
            "actionType": "JSFunction",
            "method": "prepareSelectedSepcData",
            "inputData": {
                "subPanelContext":"{{subPanelContext.baseSelection}}",
                "selectionData":"{{data.eventData.selectedObjects[0]}}"
            },
            "outputData": {
                "selectedSpecObj": ""
            },
            "deps": "js/ExcelImportNew"
        }
    },

    "onEvent":
    [
        {
            "eventId": "primaryWorkArea.selectionChangeEvent",
            "action": "prepareSelectedSepcData",
            "cacheEventData": true
        },
        {
            "eventId": "closeDialog",
            "action": "closePanelDialog"
        }
    ],
    "lifecycleHooks": {
        "onMount": "prepareSelectedSepcData"
    },
    "data": {

        "selectFile": {
            "displayName": "{{i18n.selectFile}}",
            "type": "STRING"
        },
        "importHelptooltipView": {
            "view": "Arm0ImportHelpTooltip"
        },
        "importType":{
            "dbValue":""
        },
        "viewModel": ""
    },

    "functions":
    {
    },

    "conditions":
    {
    },

    "messages":
    {
        "notificationForImportSpecificationMsg": {
            "messageType": "INFO",
            "messageText": "{{i18n.notificationForImportSpecification}}"
        },
        "successImportSpecification": {
            "messageType": "INFO",
            "messageText": "{{i18n.successImportSpecification}}"
        }
    },

    "i18n":
    {

        "importTitle":
        [
            "ExcelRoundTripMessages"
        ],
        "selectFile": [
            "ExcelRoundTripMessages"
        ],
        "locationLabel": [
            "ExcelRoundTripMessages"
        ],
        "notificationForImportSpecification":
        [
            "ExcelRoundTripMessages"
        ],
        "ImportType": [
            "ExcelRoundTripMessages"
        ],
        "savedRules": [
            "ExcelRoundTripMessages"
        ],
        "requiredLabel": [
            "ExcelRoundTripMessages"
        ],
        "successImportSpecification": [
            "ExcelRoundTripMessages"
        ]
    }
}
