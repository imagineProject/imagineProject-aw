{
    "schemaVersion": "1.0.0",
    "data": {
        "personalizationToggle": {
            "type": "BOOLEAN",
            "isRequired": "false",
            "isEditable": "true",
            "dbValue": "{{ctx.state.urlAttributes.personalization}}"
        }
    },
    "actions": {
        "togglePersonalization": {
            "actionType": "JSFunction",
            "method": "togglePersonalization",
            "inputData": {
                "toggleButtonStatus": "{{data.personalizationToggle}}"
            },
            "deps": "js/personalizationToggleService"
        }
    }
}
