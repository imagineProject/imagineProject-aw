{
    "schemaVersion": "1.0.0",
    "data": {
        "xrtEditorTree": []
    },
    "actions": {
        "fetchTreeComponents": {
            "actionType": "JSFunctionAsync",
            "method": "fetchTreeComponents",
            "inputData": {
                "dsInfo": "{{props.xrtEditorState.dsInfo}}",
                "xmlContent": "{{props.xrtEditorState.xml}}"
            },
            "outputData": {
                "xrtEditorTree": ""
            },
            "deps": "js/xrtEditorUtilities"
        },
        "xrtEditorTreeNavigation": {
            "actionType": "JSFunction",
            "method": "xrtEditorTreeNavigationHandler",
            "inputData": {
              "selectedNodeName": "{{props.nodeName}}",
              "xmlContent": "{{props.xrtEditorState.xml}}"
            },
            "outputData": {
                "xrtEditorTree": ""
            },
            "deps": "js/xrtEditorUtilities"
        },
        "xrtEditorNodeSelection": {
            "actionType": "JSFunction",
            "method": "xrtEditorTreeNodeSelection",
            "inputData": {
              "editor": "{{props.editor}}",
              "lineNumber": "{{parameters.eventData.node.lineNum}}"
            },
            "deps": "js/xrtEditorUtilities"
        }
    },
    "lifecycleHooks": {
        "onUpdate": [ {
            "action": "fetchTreeComponents",
            "observers": [ "props.xrtEditorState.xml" ]
        }]
    },
    "chartProviders": {
    },
    "props": {
        "content": {
            "type": "string"
        }
    },
    "onEvent": [
        {
          "eventId": "xrtEditorTree.treeNodeSelected",
          "inputArgs": {
            "eventData": "{{eventData}}"
          },
          "action": "xrtEditorNodeSelection"
        }
    ]
}
