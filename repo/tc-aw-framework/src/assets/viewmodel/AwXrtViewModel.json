{
    "schemaVersion": "1.0.0",
    "imports": [],
    "props": {
        "type": {
            "type": "string"
        },
        "object-type": {
            "type": "string"
        },
        "vmo": {
            "type": "object"
        },
        "sub-panel-context": {
            "type": "object"
        },
        "xrt-state": {
            "type": "object"
        },
        "active-state": {
            "type": "object"
        },
        "revise-saveas-info": {
            "type": "object"
        },
        "edit-context-key": {
            "type": "string"
        },
        "edit-handler": {
            "type": "object"
        },
        "disable-deep-copy": {
            "type": "string"
        },
        "selection-data": {
            "type": "object"
        },
        "active-page-id": {
            "type": "string"
        }
    },
    "data": {
        "isEnableResize": {
            "stateValue": false
        }
    },
    "actions": {
        "render": {
            "method": "awXrtRenderFunction",
            "deps": "js/AwXrtService"
        },
        "updateXrtSummary": {
            "actionType": "JSFunctionAsync",
            "method": "populateVisibleXrtTabsAndData",
            "inputData": {
                "selectedObject": "{{props.vmo}}",
                "activePageId": "{{props.activePageId}}",
                "type": "{{props.type}}",
                "objectType": "{{props.objectType}}",
                "context": "{{props.subPanelContext.context}}",
                "reviseSaveAsInfo": "{{props.reviseSaveasInfo}}",
                "editHandler": "{{props.editHandler}}"
            },
            "outputData": {
                "xrtData": "activeTabContent",
                "xrtPages": "childTabs",
                "extraInfo": "extraInfo"
            },
            "deps": "js/AwXrtService"
        }
    },
    "onEvent": [],
    "lifecycleHooks": {
        "render": "render",
        "onUpdate": {
            "action": "updateXrtSummary",
            "observers": [
                "props.vmo",
                "props.objectType",
                "props.activePageId"
            ]
        }
    }
}