{
    "schemaVersion": "1.0.0",
    "actions": {
        "initializeContextMenu": {
            "actionType": "JSFunction",
            "method": "initializeContextMenu",
            "deps": "js/viewerPvwContextMenuService",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences":"{{fields.contextMenuPreferences}}"
            },
            "outputData": {
                "PLMVisWeb": "PLMVisWeb",
                "viewer": "viewer"
            }
        },
        "updatePvwContextMenuShadedWithEdges": {
            "actionType": "JSFunction",
            "method": "updatePvwContextMenuShadedWithEdges",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "updatePvwContextMenuTrihedron": {
            "actionType": "JSFunction",
            "method": "updatePvwContextMenuTrihedron",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "onUpdateContextMenuCmd": {
            "actionType": "JSFunction",
            "method": "updatePvwContextMenuCommand",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "onUpdatetoggleTrihedronCmd": {
            "actionType": "JSFunction",
            "method": "updateTrihedronFromPVW",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "onUpdatetoggleShadedWithEdgesCmd": {
            "actionType": "JSFunction",
            "method": "updateShadedViewerPreferenceFromPVW",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "onUpdateSelectedSectionCmd": {
            "actionType": "JSFunction",
            "method": "updateSectionCmdFromPVW",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "onDeleteMeasurementCmd": {
            "actionType": "JSFunction",
            "method": "deleteMeasurementFromPVW",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "onPmiEntityHideCmd": {
            "actionType": "JSFunction",
            "method": "hidePmiEntityFromPVW",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}",
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "onClean3dView": {
            "actionType": "JSFunction",
            "method": "clean3dViewFromPvw",
            "inputData": {
                "contextMenuPreferences": "{{fields.contextMenuPreferences}}"
            },
            "events": {
                "success": [
                    {
                        "name": "showConfirmClean3dViewMessage"
                    }
                ]
            },
            "deps": "js/viewerPvwContextMenuService"
        },
        "clean3dViewAction": {
            "actionType": "JSFunction",
            "method": "executeRemoveAnalysisResultCommand",
            "deps": "js/viewerContext.service",
            "inputData": {
                "viewerContextData": "{{subPanelContext.viewerContextData}}"
            }
        },
        "onUpdatePVWBatchJob": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "onUpdateContextMenuCmd",
                "condition": "fields.contextMenuPreferences.command!=='' && fields.contextMenuPreferences.command!=='pvwClean3DViewCmd' && (fields.contextMenuPreferences.command ==='hidePartCmd' || fields.contextMenuPreferences.command ==='hideSelectedCmd' || fields.contextMenuPreferences.command.includes('ViewCmd') || fields.contextMenuPreferences.command.includes('OnlyCmd') || fields.contextMenuPreferences.command.includes('AllCmd'))"
            },
            {
                "action": "onUpdatetoggleTrihedronCmd",
                "condition": "fields.contextMenuPreferences.command!=='' && fields.contextMenuPreferences.command ==='toggleTrihedronCmd'"
            },
            {
                "action": "onUpdatetoggleShadedWithEdgesCmd",
                "condition": "fields.contextMenuPreferences.command ==='toggleShadedWithEdgesCmd'"
            },
            {
                "action": "onUpdateSelectedSectionCmd",
                "condition": "fields.contextMenuPreferences.command.includes('SectionCmd')"
            },
            {
                "action": "onDeleteMeasurementCmd",
                "condition": "fields.contextMenuPreferences.command ==='deleteMeasurementCmd'"
            },
            {
                "action": "onPmiEntityHideCmd",
                "condition": "fields.contextMenuPreferences.command ==='hidePMICmd'"
            },
            {
                "action": "onClean3dView",
                "condition": "fields.contextMenuPreferences.command ==='pvwClean3DViewCmd'"
            }
         ]
        },
        "updatePvwContextMenuBatchJob": {
            "actionType": "batchJob",
            "steps": [ {
                "action": "updatePvwContextMenuShadedWithEdges",
                "condition": "props.subPanelContext.viewerAtomicData.pvwContextMenuObject && props.subPanelContext.viewerAtomicData.pvwContextMenuObject.pvwContext && props.subPanelContext.viewerAtomicData.pvwContextMenuObject.pvwContext === 'shadedwithEdgesSelected'"
            },
            {
                "action": "updatePvwContextMenuTrihedron",
                "condition": "props.subPanelContext.viewerAtomicData.pvwContextMenuObject && props.subPanelContext.viewerAtomicData.pvwContextMenuObject.pvwContext && props.subPanelContext.viewerAtomicData.pvwContextMenuObject.pvwContext === 'trihedronChanged'"
            }
         ]
        }
    },
    "lifecycleHooks": {
        "onMount": "initializeContextMenu",
        "onUpdate": [
            {
                "action": "updatePvwContextMenuBatchJob",
                "observers": [ "props.subPanelContext.viewerAtomicData.pvwContextMenuObject" ]
            },
            {
                "action": "onUpdatePVWBatchJob",
                "observers": [ "viewModel.atomicData.contextMenuPreferences.command" ]
            }
        ]
    },
    "data": {
        "parent": ".page-container",
        "contextMenuPreferences": {
            "initialValues": {
                "shadedWithEdgesSelected": "",
                "command": "",
                "isTrihedronSelected":"",
                "partsSelected":[],
                "pmisSelected":[],
                "planeSelected":{},
                "planeDeleted":{},
                "measurementsSelected":[],
                "measurementsDeleted":[],
                "measureShowEdges":false,
                "showSectionManipulatorSelected":true,
                "section":{
                    "showSectionManipulator":true
                },
                "openSpace":{
                    "standardViews":false,
                    "topView":false,
                    "bottomView":false,
                    "leftView":false,
                    "rightView":false,
                    "frontView":false,
                    "backView":false,
                    "positiveIsometricView":false,
                    "negativeIsometricView":false,
                    "isometricView":false,
                    "trimetricView":false
                }
            },
            "meta": {}
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        },
        "viewer-state-prop": {
            "type": "object"
        }
    },
    "messages": {
        "confirmClean3dView": {
            "messageType": "WARNING",
            "messageText": "{{i18n.removeAnalysisResultMessage}}",
            "navigationOptions": [ {
                    "option": "Cancel",
                    "text": "{{i18n.removeAnalysisResultCancelButtonText}}"
                },
                {
                    "option": "Remove",
                    "text": "{{i18n.removeAnalysisResultRemoveButtonText}",
                    "action": "clean3dViewAction"
                }
            ]
        }
    },
    "onEvent": [ {
        "eventId": "showConfirmClean3dViewMessage",
        "message": "confirmClean3dView"
    } ],
    "i18n": {
        "removeAnalysisResultMessage": [
            "Awv0threeDViewerMessages"
        ],
        "removeAnalysisResultCancelButtonText": [
            "Awv0threeDViewerMessages"
        ],
        "removeAnalysisResultRemoveButtonText": [
            "Awv0threeDViewerMessages"
        ]
    }
}
