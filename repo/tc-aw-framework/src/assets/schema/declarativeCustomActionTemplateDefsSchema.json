{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "description": "",
    "definitions": {
        "actionDef": {
            "oneOf": [
                {
                    "if": {
                        "properties": {
                            "actionType": {
                                "const": "setSelection"
                            }
                        }
                    },
                    "then": {
                        "$ref": "#/definitions/setSelection"
                    },
                    "else": false
                },
                {
                    "if": {
                        "properties": {
                            "actionType": {
                                "const": "saveEdits"
                            }
                        }
                    },
                    "then": {
                        "$ref": "#/definitions/saveEdits"
                    },
                    "else": false
                },
                {
                    "if": {
                        "properties": {
                            "actionType": {
                                "const": "executeViewOrientationCommand"
                            }
                        }
                    },
                    "then": {
                        "$ref": "#/definitions/executeViewOrientationCommand"
                    },
                    "else": false
                }
            ]
        },
        "executeViewOrientationCommand": {
            "type": "object",
            "description": "",
            "additionalProperties": false,
            "required": [
                "actionType"
            ],
            "properties": {
                "actionType": {
                    "type": "string",
                    "description": "",
                    "const": "executeViewOrientationCommand"
                },
                "inputData": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "JSON data for the action input. For ex. 'request' header can be the inputData in case of 'RESTService' actionType with method 'Get'.",
                    "properties": {
                        "viewerContextNamespace": {
                            "type": "string"
                        },
                        "cameraOrientation": {
                            "type": "string"
                        }
                    }
                },
                "outputData": {
                    "type": "object",
                    "description": "JSON data for the action output. As part of this, the result of the action is mapped to view model data."
                },
                "events": {
                    "$ref": "#/definitions/actionMessagesDef",
                    "description": "Events can be fired and listened/handled in declarative View Models. They are a means of a View Model communicating with other View Models or UI elements. 'Actions' can fire events."
                },
                "actionMessages": {
                    "$ref": "#/definitions/actionMessagesDef",
                    "description": "User messages. It can be made condition based"
                }
            }
        },
        "setSelection": {
            "type": "object",
            "description": "",
            "additionalProperties": false,
            "required": [
                "actionType"
            ],
            "properties": {
                "actionType": {
                    "type": "string",
                    "description": "",
                    "const": "setSelection"
                },
                "inputData": {
                    "type": "object",
                    "description": "JSON data for the action input. For ex. 'request' header can be the inputData in case of 'RESTService' actionType with method 'Get'.",
                    "additionalProperties": false,
                    "properties": {
                        "selectionModel": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object"
                                }
                            ]
                        },
                        "newSelection": {
                            "oneOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "object"
                                }
                            ]
                        }
                    }
                },
                "outputData": {
                    "type": "object",
                    "description": "JSON data for the action output. As part of this, the result of the action is mapped to view model data."
                },
                "events": {
                    "$ref": "#/definitions/actionMessagesDef",
                    "description": "Events can be fired and listened/handled in declarative View Models. They are a means of a View Model communicating with other View Models or UI elements. 'Actions' can fire events."
                },
                "actionMessages": {
                    "$ref": "#/definitions/actionMessagesDef",
                    "description": "User messages. It can be made condition based"
                }
            }
        },
        "saveEdits": {
            "type": "object",
            "description": "",
            "additionalProperties": false,
            "required": [
                "actionType"
            ],
            "properties": {
                "actionType": {
                    "type": "string",
                    "description": "",
                    "const": "saveEdits"
                },
                "inputData": {
                    "type": "object",
                    "description": "JSON data for the action input. For ex. 'request' header can be the inputData in case of 'RESTService' actionType with method 'Get'."
                },
                "outputData": {
                    "type": "object",
                    "description": "JSON data for the action output. As part of this, the result of the action is mapped to view model data."
                },
                "events": {
                    "$ref": "#/definitions/actionMessagesDef",
                    "description": "Events can be fired and listened/handled in declarative View Models. They are a means of a View Model communicating with other View Models or UI elements. 'Actions' can fire events."
                },
                "actionMessages": {
                    "$ref": "#/definitions/actionMessagesDef",
                    "description": "User messages. It can be made condition based"
                },
                "deps": {
                    "type": "string",
                    "description": "Dependent files needed by the action. For ex. In case of actionType 'JSFunction', you would need to add a deps on some js file path."
                }
            }
        }
    }
}
