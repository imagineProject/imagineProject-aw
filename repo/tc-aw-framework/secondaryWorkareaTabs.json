{
  "$schema": "declarativeSecondaryWorkareaTabsSchema-1.0.0.json",
  "tabs": {
    "1": {
      "name": "awXrt",
      "priority": 100,
      "method": "loadXrtDataForTab",
      "deps": "js/AwXrtService",
      "visibleWhen": "selection.length === 1 && context.isXrtApplicable",
      "hasChildTabs": true
    },
    "FavoritesSWAEmptyState": {
      "name": "",
      "priority": 10,
      "view": "FavoritesSWAEmptyState",
      "visibleWhen": "selection.length === 0 && (context.clientScopeURI === 'Awp0MyFavorites' || context.clientScopeURI === 'Awp0MyRecent')"
    },
    "compareTitlemultiSelectCompare": {
      "name": {
        "source": "/i18n/UIMessages",
        "key": "compareTitle"
      },
      "priority": 200,
      "view": "multiSelectCompare",
      "visibleWhen": "selection.length > 1"
    },
    "AwSecondaryWorkareaNoSkeleton": {
      "name": "",
      "priority": 10,
      "view": "AwSecondaryWorkareaNoSkeleton",
      "visibleWhen": "selection.length === 0 && context.clientScopeURI === 'Awp0MyIdDisplayRules'"
    },
    "showTableConfigs": {
      "name": "showTableConfigs",
      "priority": 300,
      "view": "showTableConfigsSummary",
      "visibleWhen": "context.parentStateName === 'com_siemens_splm_clientfx_tableconfig:tableConfigsLocation' && selection.length === 1 && selection[0].isLeaf === true && selection[0].type !== 'Fnd0ClientScope'"
    },
    "tableConfigsEmptyState": {
      "name": "tableConfigsEmptyState",
      "priority": 290,
      "view": "tableConfigsEmptyState",
      "visibleWhen": "context.parentStateName === 'com_siemens_splm_clientfx_tableconfig:tableConfigsLocation' && (selection.length === 0 || selection[0].isLeaf !== true || selection[0].type === 'Fnd0ClientScope')"
    }
  }
}
