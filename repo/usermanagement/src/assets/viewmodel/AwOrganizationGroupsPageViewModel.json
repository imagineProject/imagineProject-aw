{
    "schemaVersion" : "1.0.0",
    "data":{
        "_provider": {
            "breadcrumbConfig": {
                "vm" : "AwSearchBreadcrumb"
            },
            "label": {
                "source": "/i18n/UsermanagementMessages",
                "key": "groupTitle"
            },
            "clientScopeURI": "Um0ShowGroup",
            "nameToken": "com.siemens.splm.client.usermanagement:groupsublocation",
            "context": {
                "search": {
                    "provider": "um0AdminDataProvider",
                    "criteria": {
                        "resourceProviderContentType": "Group"
                    },
                    "sortType": "Alphabetical",
                    "maxToLoad": 50,
                    "maxToReturn": 50,
                    "showLoadingText": true
                }
            },
            "selectionMode": "single",
            "policy": "/policies/adminObjectPropertyPolicy.json",
            "hideRelationsTree": true,
            "viewBase": "people"
        }
    },
    "onEvent": [
        {
            "eventId": "OrgList.registerCtxForNewNodes",
            "cacheEventData": true,
            "action": "registerCtxForNewNodes"
        },
        {
            "eventId": "OrgList.unRegisterCtxForNewNodes",
            "cacheEventData": true,
            "action": "unRegisterCtxForNewNodes"            
        }
    ],
    "actions": {
        "registerCtxForNewNodes":{
            "actionType": "JSFunction",
            "method": "registerCtxForNewNodes",
            "inputData": {
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/um0AddInAnOrganizationService"
        },
        "unRegisterCtxForNewNodes":{
            "actionType": "JSFunction",
            "method": "unRegisterCtxForNewNodes",
            "inputData": {
            },
            "deps": "js/um0AddInAnOrganizationService"
        }
    }
}
