{
    "schemaVersion": "1.0.0",
    "imports": [],
    "data": {
        "tableLoaded": false
    },
    "actions": {
        "initDataProvider": {
            "actionType": "JSFunction",
            "method": "initSearch",
            "inputData": {
                "data": "{{data.actions}}",
                "actionName": "doGridDataProvider",
                "tableLoaded": "{{data.tableLoaded}}"
            },
            "deps": "js/awSearchService"
        },
        "doArrangeEvent": {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "resetColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [ {
                        "scope": "LoginUser",
                        "scopeName": "",
                        "clientName": "AWClient",
                        "resetColumnConfig": true,
                        "columnConfigQueryInfos": [ {
                            "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}",
                            "operationType": "configured",
                            "typeNames": [ "WorkspaceObject" ],
                            "columnsToExclude": []
                        } ],
                        "businessObjects": [ {} ]
                    } ]
                }
            },
            "outputData": {
                "dataProviders.gridDataProvider.columnConfig": "columnConfigurations[0].columnConfigurations[0]"
            }
        },
        "saveColumnConfigLoadData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "operationType": "as_arranged",
                        "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}"
                    },
                    "saveColumnConfigData": {
                        "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}",
                        "columnConfigId": "{{data.dataProviders.gridDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.gridDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    },
                    "searchInput": {
                        "maxToLoad": 50,
                        "maxToReturn": 50,
                        "providerName": "{{subPanelContext.searchState.provider}}",
                        "searchCriteria": "{{subPanelContext.searchState.criteria}}",
                        "searchFilterFieldSortType": "{{subPanelContext.searchState.sortType}}",
                        "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                        "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}",
                        "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}"
                    },
                    "inflateProperties": true
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "output": "{{function:processOutputForOrganization}}",
                "tableLoaded": true
            }
        },
        "doGridDataProvider": {
            "actionType": "dataProvider",
            "method": "gridDataProvider"
        },
        "loadData": {
            "actionType": "JSFunctionAsync",
            "method": "loadData",
            "inputData": {
                "0": {
                    "attributesToInflate": "{{subPanelContext.searchState.tableViewProperties}}",
                    "maxToLoad": "{{subPanelContext.searchState.maxToLoad}}",
                    "maxToReturn": "{{subPanelContext.searchState.maxToReturn}}",
                    "providerName": "{{subPanelContext.searchState.provider}}",
                    "searchFilterFieldSortType": "{{subPanelContext.searchState.sortType}}",
                    "cursor": {
                        "startIndex":"{{data.dataProviders.gridDataProvider.cursorObject.startIndex}}",
                        "endIndex":"{{data.dataProviders.gridDataProvider.cursorObject.endIndex}}",
                        "startReached":"{{data.dataProviders.gridDataProvider.cursorObject.startReached}}",
                        "endReached":"{{data.dataProviders.gridDataProvider.cursorObject.endReached}}"
                    },
                    "focusObjUid": "{{ctx.newlyCreatedObj[0].uid}}",
                    "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                    "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}",
                    "searchCriteria": "{{subPanelContext.searchState.criteria}}"
                },
                "1": {
                    "clientName": "AWClient",
                    "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}"
                },
                "2": null,
                "3": true,
                "4": "{{ctx.newlyCreatedObj}}"
            },

            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "searchResults",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "tableLoaded": true,
                "output": "{{function:processOutputForOrganization}}",
                "dataProviders.gridDataProvider.cursorObject": "cursor"
            },
            "events": {
                "success": [ {
                    "name": "orgTable.selectFirstItem",
                    "condition": "ctx.newlyCreatedObj && ctx.newlyCreatedObj.length > 0"
                } ]
            },
            "deps": "js/userMgmtService"
        },
        "loadNextData": {
            "actionType": "JSFunctionAsync",
            "method": "loadData",
            "inputData": {
                "0": {
                    "maxToLoad": "{{subPanelContext.searchState.maxToLoad}}",
                    "maxToReturn": "{{subPanelContext.searchState.maxToReturn}}",
                    "providerName": "{{subPanelContext.searchState.provider}}",
                    "searchFilterFieldSortType": "{{subPanelContext.searchState.sortType}}",
                    "cursor": {
                        "startIndex":"{{data.dataProviders.gridDataProvider.cursorObject.startIndex}}",
                        "endIndex":"{{data.dataProviders.gridDataProvider.cursorObject.endIndex}}",
                        "startReached":"{{data.dataProviders.gridDataProvider.cursorObject.startReached}}",
                        "endReached":"{{data.dataProviders.gridDataProvider.cursorObject.endReached}}"
                    },
                    "pagingType": "GetNextPage",
                    "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                    "searchSortCriteria": "{{subPanelContext.searchState.sortCriteria}}",
                    "searchCriteria": "{{subPanelContext.searchState.criteria}}"
                },
                "1": {
                    "clientName": "AWClient",
                    "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}"
                },
                "2": null,
                "3": false,
                "4": null,
                "5": "{{data.dataProviders.gridDataProvider._enableAccScroll}}",
                "6": "{{data.dataProviders.gridDataProvider.startIndex}}"
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "searchResults",
                "tableLoaded": true,
                "output": "{{function:processOutputForOrganization}}",
                "dataProviders.gridDataProvider.cursorObject": "cursor"
            },
            "deps": "js/userMgmtService"
        },
        "loadPrevData": {
            "actionType": "JSFunctionAsync",
            "method": "loadData",
            "inputData": {
                "0": {
                    "maxToLoad": "{{subPanelContext.searchState.maxToLoad}}",
                    "maxToReturn": "{{subPanelContext.searchState.maxToReturn}}",
                    "providerName": "{{subPanelContext.searchState.provider}}",
                    "searchFilterFieldSortType": "{{subPanelContext.searchState.sortType}}",
                    "cursor": {
                        "startIndex":"{{data.dataProviders.gridDataProvider.cursorObject.startIndex}}",
                        "endIndex":"{{data.dataProviders.gridDataProvider.cursorObject.endIndex}}",
                        "startReached":"{{data.dataProviders.gridDataProvider.cursorObject.startReached}}",
                        "endReached":"{{data.dataProviders.gridDataProvider.cursorObject.endReached}}"
                    },
                    "pagingType": "GetPreviousPage",
                    "searchFilterMap6": "{{subPanelContext.searchState.activeFilterMap}}",
                    "searchSortCriteria": "{{subPanelContext.searchState.sortCriteria}}",
                    "searchCriteria": "{{subPanelContext.searchState.criteria}}"
                },
                "1": {
                    "clientName": "AWClient",
                    "clientScopeURI": "{{subPanelContext.provider.clientScopeURI}}"
                },
                "2": null,
                "3": false,
                "4": null,
                "5": "{{data.dataProviders.gridDataProvider._enableAccScroll}}",
                "6": "{{data.dataProviders.gridDataProvider.startIndex}}"
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "searchResults",
                "tableLoaded": true,
                "output": "{{function:processOutputForOrganization}}",
                "dataProviders.gridDataProvider.cursorObject": "cursor"
            },
            "deps": "js/userMgmtService"
        },
        "plTableClientRefresh": {
            "actionType": "Event",
            "method": "Event",
            "inputData": {
                "events": [ {
                    "name": "gridView.plTable.clientRefresh"
                } ]
            }
        },
        "selectFirstItem": {
            "actionType": "JSFunction",
            "method": "selectCreatedItem",
            "inputData": {
                "selectionModel": "{{data.dataProviders.gridDataProvider.selectionModel}}"
            },
            "events": {
                "success": [ {
                    "name": "OrgList.unRegisterCtxForNewNodes"
                } ]
            },
            "deps": "js/userMgmtService"
        },
        "showAddObjectsUser": {
            "actionType": "JSFunction",
            "method": "OpenDialogAction",
            "inputData": {
                "input": {
                    "commandId": "Um0ShowAddObjects",
                    "commandContext":"{{subPanelContext}}",
                    "dialogAction":"{{data.actions.dialogAction}}",
                    "isPinUnpinEnabled":true,
                    "panelType":"User"
                }
            },
            "deps": "js/um0AddInAnOrganizationService"
        },
        "dialogAction": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                }
            }
        }
    },
    "dataProviders": {
        "gridDataProvider": {
            "action": "loadData",
            "nextAction": "loadNextData",
            "previousAction": "loadPrevData",
            "editContext": "TABLE_CONTEXT",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "selectionModelMode": "multiple",
            "inputData": {
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands",
            "contextMenuCommandsAnchor": "org_ContextMenu"
        }
    },

    "columnProviders": {
        "clientScopeUI": {
            "saveColumnAction": "saveColumnConfigLoadData",
            "resetColumnAction": "resetColumnConfig",
            "sortCriteria": [],
            "commandProperty": "object_name"
        }
    },

    "grids": {
        "gridView": {
            "dataProvider": "gridDataProvider",
            "columnProvider": "clientScopeUI",
            "gridOptions": {
                "enableSorting": false,
                "enablePinning": true
            }
        }
    },
    "onEvent": [
        {
            "eventId": "primaryWorkarea.multiSelectAction",
            "action": "plTableClientRefresh"
        },
        {
            "eventId": "orgTable.selectFirstItem",
            "action": "selectFirstItem"
        }
    ],
    "functions":
    {
        "processOutputForOrganization": {
            "functionName": "processOutputForOrganization",
            "parameters": [
                "{{data}}",
                "{{subPanelContext.searchState}}"
            ],
            "deps": "js/userMgmtService"
        }
    },
    "lifecycleHooks": {
        "onMount": "initDataProvider"
    },
     "i18n": {
        "nothingHere":[
            "UsermanagementMessages"
        ],
        "noSubGroupOrRoleHint":[
            "UsermanagementMessages"
        ],
        "noUserHint":[
            "UsermanagementMessages"
        ],
        "addUserTitle":[
            "UsermanagementMessages"
        ]
     }
}
