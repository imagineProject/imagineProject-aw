    "getConfirmationForDeleteCalendar": {
      "actionType": "Event",
      "method": "Event",
      "inputData": {
        "events": [
          {
            "name": "cal.deleteCalendar",
            "condition": ""
          }
        ]
      },
      "actionMessages": {
        "success": [
          {
            "condition": "ctx.mselected.length==1",
            "message": "deleteCalendarSingle"
          },
          {
            "condition": "ctx.mselected.length>1",
            "message": "deleteCalendarMultiple"
          }
        ]
      }
    },
    "deleteCalendar": {
      "actionType": "TcSoaService",
      "serviceName": "CalendarManagement-2007-01-CalendarManagement",
      "method": "deleteTCCalendars",
      "inputData": {
        "tccalendarsToDelete": "{{function:getSelectedObjects}}"
      },
      "events": {
        "success": [
          {
            "name": "primaryWorkarea.reset",
            "condition": "conditions.deleteUserCalendarCommandVisibility"
          },
          {
            "name": "resetUserCalendarPage",
            "condition": "ctx.userCalendar"
          }
        ]
      },
      "actionMessages": {
        "failure": [
          {
            "message": "calDeleteSoaErrorFailureMsg"
          }
        ]
      },
      "deps": "js/AwUserCalendarUtils"
    }
