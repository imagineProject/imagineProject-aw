    "performRemoveOperation": {
      "actionType": "TcSoaService",
      "serviceName": "Administration-2017-05-RoleManagement",
      "method": "removeRolesFromGroup",
      "deps": "js/userMgmtService",
      "inputData": {
        "roleGroupStructs": "{{function:getInputDataForRemoveRoleAndUser}}"
      },
      "outputData": {
        "removeRolesFromGroupResponse": ""
      },
      "events": {
        "success": [
          {
            "name": "cdm.relatedModified",
            "condition": "ctx.pselected",
            "eventData": {
              "refreshLocationFlag": false,
              "relatedModified": [
                "{{ctx.pselected}}"
              ]
            }
          },
          {
            "name": "primaryWorkarea.reset",
            "condition": "!conditions.isTreeMode && !ctx.pselected"
          },
          {
            "name": "OrgTree.reloadOrgTree",
            "condition": "conditions.isTreeMode",
            "eventData": {
              "isRemoved": true
            }
          }
        ],
        "failure": [
          {
            "name": "cdm.relatedModified",
            "condition": "ctx.pselected",
            "eventData": {
              "refreshLocationFlag": false,
              "relations": "",
              "relatedModified": [
                "{{ctx.pselected}}"
              ]
            }
          },
          {
            "name": "primaryWorkarea.reset",
            "condition": "!conditions.isTreeMode && removeRolesFromGroupResponse.updated && !ctx.pselected"
          },
          {
            "name": "OrgTree.reloadOrgTree",
            "condition": "conditions.isTreeMode && removeRolesFromGroupResponse.updated",
            "eventData": {
              "isRemoved": true
            }
          }
        ]
      },
      "actionMessages": {
        "failure": [
          {
            "message": "removeRoleOperationNonAuthFailure",
            "condition": "!removeRolesFromGroupResponse.updated && removeRolesFromGroupResponse.partialErrors[0].errorValues[0].code === 10733"
          },
          {
            "message": "removRoleUserOperationSingleFailure",
            "condition": "ctx.mselected.length === 1 && !removeRolesFromGroupResponse.updated && removeRolesFromGroupResponse.partialErrors[0].errorValues[0].code !== 10733"
          },
          {
            "message": "removeRoleOperationMultiFailure",
            "condition": "ctx.mselected.length !== 1 && removeRolesFromGroupResponse.partialErrors && removeRolesFromGroupResponse.partialErrors[0].errorValues[0].code !== 10733"
          }
        ],
        "success": [
          {
            "message": "removeRoleOperationSuccess"
          }
        ]
      }
    },
    "performRemoveOperationForUserObjects": {
      "actionType": "TcSoaService",
      "serviceName": "Administration-2017-05-UserManagement",
      "method": "removeGroupMembers",
      "deps": "js/userMgmtService",
      "inputData": {
        "userRoleGroupStructs": "{{function:getInputDataForRemoveRoleAndUser}}"
      },
      "outputData": {
        "removeGroupMembersResponse": ""
      },
      "events": {
        "success": [
          {
            "name": "cdm.relatedModified",
            "condition": "ctx.pselected",
            "eventData": {
              "refreshLocationFlag": false,
              "relatedModified": [
                "{{ctx.pselected}}"
              ]
            }
          },
          {
            "name": "primaryWorkarea.reset",
            "condition": "!conditions.isTreeMode && !ctx.pselected"
          },
          {
            "name": "OrgTree.reloadOrgTree",
            "condition": "conditions.isTreeMode",
            "eventData": {
              "isRemoved": true
            }
          }
        ],
        "failure": [
          {
            "name": "cdm.relatedModified",
            "condition": "ctx.pselected",
            "eventData": {
              "refreshLocationFlag": false,
              "relations": "",
              "relatedModified": [
                "{{ctx.pselected}}"
              ]
            }
          },
          {
            "name": "primaryWorkarea.reset",
            "condition": "!conditions.isTreeMode && removeGroupMembersResponse.ServiceData.deleted && !ctx.pselected"
          },
          {
            "name": "OrgTree.reloadOrgTree",
            "condition": "conditions.isTreeMode && removeGroupMembersResponse.ServiceData.deleted",
            "eventData": {
              "isRemoved": true
            }
          }
        ]
      },
      "actionMessages": {
        "failure": [
          {
            "message": "removeUserOperationNonAuthFailure",
            "condition": "!removeGroupMembersResponse.ServiceData.deleted && removeGroupMembersResponse.ServiceData.partialErrors[0].errorValues[0].code === 10733"
          },
          {
            "message": "removRoleUserOperationSingleFailure",
            "condition": "ctx.mselected.length === 1 && !removeGroupMembersResponse.ServiceData.deleted && removeGroupMembersResponse.ServiceData.partialErrors[0].errorValues[0].code !== 10733"
          },
          {
            "message": "removeUserOperationMultiFailure",
            "condition": "ctx.mselected.length !== 1 && removeGroupMembersResponse.ServiceData.partialErrors  && removeGroupMembersResponse.ServiceData.partialErrors[0].errorValues[0].code !== 10733"
          }
        ],
        "success": [
          {
            "message": "removeUserOperationSuccess"
          }
        ]
      }
    },
    "openCreateBaseCalendarPanel": {
      "actionType": "JSFunction",
      "method": "activateCommandPanel",
      "deps": "js/commandPanel.service",
      "inputData": {
