{
    "schemaVersion" : "1.0.0",
    "imports": [],
    "actions" :{
        "updateProductSnapshotAction":{
            "actionType": "JSFunction",
            "method": "renameProductSnapshotAndNotify",
            "inputData":
            {
                "snapshotName": "{{data.snapshotName.dbValue}}",
                "data":"{{data}}",
                "snapshotPanelData":"{{subPanelContext.snapshotPanelData}}",
                "subPanelContext":"{{subPanelContext}}"
            },
            "deps": "js/viewerProductSnapshotService"
        },
        "renderEditPanelTextBox":{
            "actionType": "JSFunction",
            "method": "renderEditPanelTextBox",
            "inputData":{
                "snapshotNameValue":"{{subPanelContext.snapshotPanelData.snapshotBeingEdit.cellHeader1}}",
                "snapshotName":"{{data.snapshotName}}"
            },
            "outputData":{
                "snapshotName":""
            },
            "deps": "js/viewerProductSnapshotService"
        }
    },
    "data":{
        "snapshotName":
        {
            "displayName": "{{i18n.newProductSnapshotNameLabel}}",
            "type": "STRING",
            "maxLength": 90,
            "isRequired": "true",
            "isEditable": "true",
            "dbValue":"{{i18n.defaultSnapshotText}}"
        }
    },
    "lifecycleHooks": {
        "onUpdate": [ {
            "action": "renderEditPanelTextBox",
            "observers": [ "props.subPanelContext.snapshotPanelData.activeView" ]
        } ]
    },
    "i18n":
    {
        "updateButtonText": [ "ViewerSnapshotMessages" ],
        "newProductSnapshotNameLabel": [ "ViewerSnapshotMessages" ],
        "updatedProductSnapshotSuccessfully": [ "ViewerSnapshotMessages" ],
        "failedToUpdate": [ "ViewerSnapshotMessages" ],
        "defaultSnapshotText": ["ViewerSnapshotMessages"]
    }
}

