{
    "schemaVersion": "1.0.0",
    "lifecycleHooks": {
        "onMount": "initialize",
        "onUpdate": [
            {
                "action": "onPreferencesChange",
                "observers": [
                    "fields.plmpreferences"
                ]
            }
        ]
    },
    "data": {
        "plmpreferences": {
            "meta": {}
        },
        "parent": ".aw-layout-workareaMain"
    },
    "actions": {
        "initialize": {
            "actionType": "JSFunction",
            "method": "initializeMarkup",
            "deps": "js/viewer3dMarkupPLMToolkitService",
            "inputData": {
                "input": "{{fields.plmpreferences}}"
            },
            "outputData": {
                "viewer": "viewer",
                "PLMVisWeb": "PLMVisWeb"
            }
        },
        "onPreferencesChange": {
            "actionType": "JSFunction",
            "method": "updatePreferences",
            "inputData": {
                "input": "{{data.plmpreferences}}"
            },
            "deps": "js/viewer3dMarkupPLMToolkitService"
        },
        "rightPanelDialog": {
            "actionType": "dialog",
            "inputData": {
                "options": {
                }
            }
        }
    }
}
