{
    "schemaVersion": "1.0.0",
    "conditions": {
        "isProductSnapshotVisibleCond": {
            "expression": "subPanelContext.context.occContext.topElement.modelType.typeHierarchyArray.indexOf('Fnd0AppSession') === -1"
        },
        "isSessionSnapshotVisibleCond": {
            "expression": "subPanelContext.context.occContext.topElement.modelType.typeHierarchyArray.indexOf('Fnd0AppSession') !== -1"
        }
    }
}
