{
  "slots": {
    "markupSlot": {
      "name": "markupPVWToolbar",
      "view": "MarkupToolbar",
      "activeWhen": {
        "condition": "conditions.display3dOnScreenMarkupToolbar"
      }
    }
  },
  "conditions": {
    "display3dOnScreenMarkupToolbar": {
      "expression": "context.onScreen3dMarkupContext.display3dMarkupToolbar && context.renderLocation === 'CSR' "
    }
  }
}
