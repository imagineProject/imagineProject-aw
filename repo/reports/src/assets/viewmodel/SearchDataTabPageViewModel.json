{
    "schemaVersion": "1.0.0",
    "selectionModels": {
        "searchSelectionModel": {
            "selectionMode": "single"
        }
    },
    "actions": {
        "setPresetFiltersAndUpdateSearchState":{
            "actionType": "batchJob",
            "steps": [ {
                "action": "setPresetFilters"
            }, {
                "action": "updateSearchState"
            }]
        },
        "updateSearchState": {
            "actionType": "JSFunction",
            "method": "updateAtomicDataValue",
            "inputData": {
                "AtomicObj": "{{props.subPanelContext.searchState}}",
                "value": {
                    "label" : {
                        "source" : "/i18n/SearchMessages",
                        "key": "resultsText"
                    }
                }
            },
            "deps": "js/addObjectUtils"
        },
        "setPresetFilters": {
            "actionType": "JSFunction",
            "method": "setPresetFilters",
            "inputData": {
                "value": true
            },
            "deps": "js/filterPanelUtils"
        }
    },
    "lifecycleHooks": {
        "onMount": "setPresetFiltersAndUpdateSearchState"
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
