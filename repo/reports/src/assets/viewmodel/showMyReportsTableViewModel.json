{
    "schemaVersion": "1.0.0",
    "imports": [],
    "actions": {
        "doArrangeEvent": {
            "actionType": "JSFunctionAsync",
            "method": "arrangeColumns",
            "inputData": {
                "declViewModel": "{{data}}",
                "eventData": "{{data.eventData}}"
            },
            "deps": "js/columnArrangeService"
        },
        "resetColumnConfig": {
            "actionType": "JSFunctionAsync",
            "method": "baseGetOrResetUIColumnConfigs",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "getOrResetUiConfigsIn": [ {
                        "scope": "LoginUser",
                        "scopeName": "",
                        "clientName": "AWClient",
                        "resetColumnConfig": true,
                        "columnConfigQueryInfos": [ {
                            "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}",
                            "operationType": "configured",
                            "typeNames": [ "WorkspaceObject" ],
                            "columnsToExclude": []
                        } ],
                        "businessObjects": [ {} ]
                    } ]
                }
            },
            "outputData": {
                "dataProviders.gridDataProvider.columnConfig": "columnConfigurations[0].columnConfigurations[0]"
            }
        },
        "doGridDataProvider": {
            "actionType": "dataProvider",
            "method": "gridDataProvider"
        },
        "saveColumnConfigLoadData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "attributesToInflate": "{{subPanelContext.provider.context.search.tableViewProperties}}",
                        "maxToLoad": 50,
                        "maxToReturn": 50,
                        "providerName": "Awp0SavedQuerySearchProvider",
                        "searchCriteria": "{{function:getSearchCriteria}}",
                        "searchFilterFieldSortType": "{{subPanelContext.provider.context.search.sortType}}",
                        "startIndex": "{{data.dataProviders.listDataProvider.startIndex}}",
                        "searchFilterMap6": "{{subPanelContext.provider.context.search.activeFilterMap}}",
                        "searchSortCriteria": "{{data.columnProviders.clientScopeUI.sortCriteria}}"
                    },
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "operationType": "as_arranged",
                        "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}"
                    },
                    "saveColumnConfigData": {
                        "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}",
                        "columnConfigId": "{{data.dataProviders.gridDataProvider.columnConfig.columnConfigId}}",
                        "columns": "{{data.dataProviders.gridDataProvider.newColumns}}",
                        "scope": "LoginUser",
                        "scopeName": ""
                    }
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "output": "{{function:processOutput}}"
            }
        },
        "loadData": {
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "maxToLoad": 50,
                        "maxToReturn": 50,
                        "providerName": "Awp0SavedQuerySearchProvider",
                        "searchCriteria": "{{function:getSearchCriteria}}",
                        "searchFilterFieldSortType": "{{subPanelContext.provider.context.search.sortType}}",
                        "startIndex": "{{data.dataProviders.gridDataProvider.startIndex}}",
                        "searchFilterMap6": "{{subPanelContext.provider.context.search.activeFilterMap}}",
                        "searchSortCriteria": "{{function:getSortCriteria}}",
                        "attributesToInflate": "{{subPanelContext.provider.context.search.tableViewProperties}}"
                    },

                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "{{ctx.sublocation.clientScopeURI}}"
                    }
                }
            },
            "outputData": {
                "totalFound": "totalFound",
                "searchResults": "{{json:searchResultsJSON}}",
                "dataProviders.gridDataProvider.columnConfig": "columnConfig",
                "output": "{{function:processOutput}}"
            }
        }
    },
    "dataProviders": {
        "gridDataProvider": {
            "action": "loadData",
            "editContext": "TABLE_CONTEXT",
            "response": "{{data.searchResults}}",
            "totalFound": "{{data.totalFound}}",
            "inputData": {
                "selectionModel": "{{subPanelContext.selectionModel}}"
            },
            "commandsAnchor": "com.siemens.splm.clientfx.tcui.commands.modelObjectCellListActionCommands"
        }
    },
    "columnProviders": {
        "clientScopeUI": {
            "saveColumnAndLoadAction": "saveColumnConfigLoadData",
            "resetColumnAction": "resetColumnConfig",
            "sortCriteria": [],
            "commandProperty": "object_name"
        }
    },
    "grids": {
        "gridView": {
            "dataProvider": "gridDataProvider",
            "columnProvider": "clientScopeUI",
            "enableArrangeMenu": true,
            "gridOptions": {
                "enableGridMenu": true
            }
        }
    },
    "onEvent": [ {
        "eventId": "columnArrange",
        "cacheEventData": true,
        "action": "doArrangeEvent"
    } ],
    "functions": {
        "getSearchCriteria": {
            "functionName": "getSearchCriteria",
            "parameters": [
                "{{data.dataProviders.gridDataProvider.startIndex}}"
            ],
            "deps": "js/showMyReportsService"
        },
        "getSortCriteria": {
            "functionName": "getSortCriteria",
            "parameters": [
                "{{subPanelContext.provider.context.search.sortCriteria}}",
                "{{data.columnProviders.clientScopeUI.sortCriteria}}"
            ],
            "deps": "js/showMyReportsService"
        },
        "processOutput": {
            "functionName": "processOutput",
            "parameters": [
                "{{data}}",
                "{{subPanelContext.searchState}}"
            ],
            "deps": "js/showMyReportsService"
        }
    },
    "i18n": {
        "noSavedReport": [
            "ReportChartMessages"
        ],
        "noSavedReportHint": [
            "ReportChartMessages"
        ]
    }
}
