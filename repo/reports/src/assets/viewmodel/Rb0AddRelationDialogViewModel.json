{
    "schemaVersion": "1.0.0",
    "actions": {
        "backAction":{
            "actionType": "JSFunction",
            "method": "updateAtomicDataValue",
            "inputData": {
                "AtomicObj": "{{fields.activeState}}",
                "value": {
                    "activeView": "AddRelationDialog"
                }
            },
            "deps": "js/addObjectUtils"
        }
    },
    "data": {
        "activeState": {
            "initialValues": {
                "activeView": "AddRelationDialog"
            },
            "meta": {}
        },
        "searchState": {
            "initialValues": {
                "autoApplyFilters": false,
                "dependentDateFilters":false,
                "showAutoUpdateFilteringOption": true,
                "bulkFiltering": true,
                "provider":"Awp0FullTextSearchProvider",
                "criteria": {},
                "label" : {
                    "source" : "/i18n/SearchMessages",
                    "key": "resultsText"
                }
            },
            "meta": {
                "categories": [ {
                    "filterValues": [ {
                        "selected": {
                            "field": "true",
                            "type": "ViewModelProperty"
                        }
                    } ]
                } ]
            }
        }
    },
    "conditions": {
        "addRelationVisible":{
            "expression": "!conditions.SegmentFilterVisible"
        },
        "SegmentFilterVisible":{
            "expression": "data.activeState.activeView === 'Rb0SegmentFilterPanel'"
        }
    },
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    },
    "i18n": {
        "addRelations": [
            "ReportChartMessages"
        ],
        "editRelations": [
            "ReportChartMessages"
        ],
        "addFilter": [
            "ReportChartMessages"
        ],
        "editFilter": [
            "ReportChartMessages"
        ]
    }
}