{
    "schemaVersion": "1.0.0",
    "actions":
    {
        "revealReport":
        {
            "actionType": "JSFunction",
            "method": "validateReveal",
            "inputData":
            {
                "data": "{{data}}",
                "vmo": "{{subPanelContext.selected}}"
            },
            "outputData":{
                "showAwReport": "isAwReport",
                "showDefaultMessage": "showMsg",
                "selectedReport": "selected",
                "selectedSourceObject": "selectedSourceObject"
            },

            "deps": "js/Rb0ReportsPage"
        },
        "refreshPanelData":
        {
            "actionType": "JSFunction",
            "method": "refreshPanelData",
            "inputData":
            {
                "data": "{{data}}",
                "vmo": "{{subPanelContext.selected}}"
            },
            "outputData":{
                "showDefaultMessage": "showDefaultMessage"
            },

            "deps": "js/Rb0ReportsPage"
        },
        "updateAWSourceReportAction":{
            "actionType": "JSFunction",
            "method": "updateAWSourceReportAction",
            "inputData":
            {
                "data": "{{data}}"
            },
            "outputData":{
                "showAwReport": "showAwReport",
                "selectedReport": "selected",
                "selectedSourceObject": "selectedSourceObject"
            },
            "deps": "js/Rb0ReportsPage"
        },
        "updateTCSourceReportAction":{
            "actionType": "JSFunction",
            "method": "updateTCSourceReportAction",
            "inputData":
            {
                "data": "{{data}}",
                "vmo": "{{subPanelContext.selected}}"
            },
            "outputData":{
                "showAwReport": "showAwReport"
            },
            "deps": "js/Rb0ReportsPage"
        },
        "openGenerateReport":{
            "actionType": "batchJob",
            "steps": [
                {
                    "action": "activateSummaryCommandPanel",
                    "condition": "conditions.isSelectedObjectReportDefn"
                },
                {
                    "action": "activateItemCommandPanel",
                    "condition": "!conditions.isSelectedObjectReportDefn"
                }
            ]
        },
        "activateSummaryCommandPanel":{
            "actionType": "JSFunction",
            "method": "activateCommandPanel",
            "deps": "js/commandPanel.service",
            "inputData": {
                "commandId": "Awp0ReportsSummary",
                "location": "aw_toolsAndInfo"
            }
        },
        "activateItemCommandPanel":{
            "actionType": "JSFunctionAsync",
            "deps": "js/command.service",
            "method": "executeCommand",
            "inputData": {
                "0": "Awp0InContextReports",
                "1": "",
                "2": "",
                "3": "",
                "4": "{{parameters.commandActionExecutor.runActionWithViewModel}}"
            }
        },
        "initialize":{
            "actionType": "batchJob",
            "steps": [{
                "action": "loadDashboardTabs",
                "condition": "!ctx.dashboardObjects"
            }]
        },
        "loadDashboardTabs":{
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "attributesToInflate": ["owning_user", "Fnd0Applicable_Assignment"],
                        "maxToLoad": -1,
                        "maxToReturn": -1,
                        "providerName": "Rb0ReportsDataProvider",
                        "searchCriteria": {
                            "isFilterMapRequired": "False",
                            "sourceObject": "",
                            "relationsPath": "{{function:getRelationsPathForDashboardTabsLoading}}"
                        },
                        "searchFilterFieldSortType": "",
                        "startIndex": "",
                        "searchFilterMap6": "",
                        "searchSortCriteria": ""
                    },
                    "inflateProperties": true,
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Awp0ReportBuilder"
                    }
                },
                "1": {
                    "types": [ {
                        "name": "Rb0ReportsDashboard",
                        "properties": [
                            {
                                "name": "rb0DashboardName"
                            },
                            {
                                "name": "rb0SourceDashboard"
                            },
                            {
                                "name": "rb0DashboardDescription"
                            },
                            {
                                "name": "rb0DashboardLocation"
                            },
                            {
                                "name": "rb0DashboardId"
                            },
                            {
                                "name": "rb0DashboardTemplatesList"
                            },
                            {
                                "name": "owning_user"
                            },
                            {
                                "name": "Fnd0Applicable_Assignment"
                            }
                        ]
                    } ]
                }
            },
            "outputData":{
                "ctx.dashboardObjects": "{{json:searchResultsJSON}}"
            }
        }
    },
    "lifecycleHooks": {
        "onMount": "initialize",
        "onUpdate":[
            {
                "action": "revealReport",
                "observers": ["props.subPanelContext.selected"]
            },
            {
                "action": "refreshPanelData",
                "observers": ["props.subPanelContext.context.pageContext.sublocationState.updateHTMLReport"]
            },
            {
                "action": "updateAWSourceReportAction",
                "observers": ["props.subPanelContext.context.pageContext.sublocationState.updateAWSourceReport"]
            },
            {
                "action": "updateTCSourceReportAction",
                "observers": ["props.subPanelContext.context.pageContext.sublocationState.updateTCSourceReport"]
            }
        ]
    },
    "data":
    {
        "url":
        {
            "type": "STRING",
            "dbValue": ""
        },
        "showAwReport": false,
        "dashboardLocation": ["Reports"]
    },
    "i18n":
    {
        "doLiveIntegration":
        [
            "ReportMessages"
        ],
        "reportsPage":
        [
            "ReportMessages"
        ],
        "showNoDataFoundMessage":
        [
            "ReportMessages"
        ],
        "reportsTabDefaultMessage":
        [
            "ReportMessages"
        ],
        "addDashboardReportWithPanel":[
            "ReportChartMessages"
        ],
        "generateReportHint":[
            "ReportChartMessages"
        ],
        "generateAdvCommandName":[
            "ReportChartMessages"
        ],
        "noReportAvailable": [
            "ReportChartMessages"
        ]
    },
    "messages":
    {
        "showNoDataFoundMessage":
        {
            "messageType": "INFO",
            "messageText": "{{i18n.showNoDataFoundMessage}}"
        }
    },
    "conditions":{
        "isSelectedObjectReportDefn": {
            "expression": "props.subPanelContext.selected.type === 'ReportDefinition'"
        }
    },
    "onEvent":[{
        "eventId": "reportsTab.reset",
        "action": "revealReport"
    }],
    "functions": {
        "getRelationsPathForDashboardTabsLoading":{
            "functionName": "getRelationsPathForDashboardTabsLoading",
            "parameters": ["{{data.dashboardLocation}}"],
            "deps": "js/showMyDashboardService"
        }
    }
}
