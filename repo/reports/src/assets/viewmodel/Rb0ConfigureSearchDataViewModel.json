{
    "schemaVersion": "1.0.0",
    "data": {
        "localData": {
            "initialValues": {},
            "meta": {}
        }
    },
    "actions": {
        "getConfigureSearchTabs":{
            "actionType": "JSFunction",
            "method": "getConfigureSearchTabs",
            "inputData": {
                "data": "{{i18n}}",
                "searchState": "{{subPanelContext.reportsState}}"
            },
            "outputData": {
                "tabsModel.dbValue": ""
            },
            "deps": "js/AwConfigureReportViewerService"
        },
        "dummyAction": {
            "actionType": "JSFunction",
            "method": "updateAtomicDataValue",
            "inputData": {
                "AtomicObj": "{{fields.localData}}",
                "value": {
                    "dummy": "{{!data.localData.dummy}}"
                }
            },
            "deps": "js/addObjectUtils"
        }
    },
    "i18n": {
        "dataTabName": [
            "ReportChartMessages"
        ],
        "itemTabName": [
            "ReportChartMessages"
        ],
        "results": [
            "ReportChartMessages"
        ],
        "advanced": [
            "ReportChartMessages"
        ],
        "customSearch": [
            "ReportChartMessages"
        ]
    },
    "conditions": {
        "isSummaryReport":{
            "expression": "ctx.state.params.reportType==='0'"
        }
    },
    "lifecycleHooks": {
        "onMount": "getConfigureSearchTabs",
        "onUpdate": [{
            "action": "getConfigureSearchTabs",
            "observers": [
                "viewModel.ctx.state.params.reportType"
            ]
        }]
    },
    "onEvent":[
        {
            "eventId": "reportTable.performSearchCompleted",
            "action": "dummyAction"
        }
    ],
    "props": {
        "sub-panel-context": {
            "type": "object"
        }
    }
}
