{
    "schemaVersion": "1.0.0",
    "actions":{
        "initialize":{
            "actionType": "batchJob",
            "steps": [{
                "action": "loadDashboardTabs",
                "condition": "!ctx.dashboardObjects"
            }]
        },
        "loadDashboardTabs":{
            "actionType": "JSFunctionAsync",
            "method": "basePerformSearchViewModel",
            "deps": "js/tcDataManagementService",
            "inputData": {
                "0": {
                    "searchInput": {
                        "attributesToInflate": ["owning_user", "Fnd0Applicable_Assignment"],
                        "maxToLoad": -1,
                        "maxToReturn": -1,
                        "providerName": "Rb0ReportsDataProvider",
                        "searchCriteria": {
                            "isFilterMapRequired": "False",
                            "sourceObject": "",
                            "relationsPath": "{{function:getRelationsPathForDashboardTabsLoading}}"
                        },
                        "searchFilterFieldSortType": "",
                        "startIndex": "",
                        "searchFilterMap6": "",
                        "searchSortCriteria": ""
                    },
                    "inflateProperties": true,
                    "columnConfigInput": {
                        "clientName": "AWClient",
                        "clientScopeURI": "Awp0ReportBuilder"
                    }
                },
                "1": {
                    "types": [ {
                        "name": "Rb0ReportsDashboard",
                        "properties": [
                            {
                                "name": "rb0DashboardName"
                            },
                            {
                                "name": "rb0SourceDashboard"
                            },
                            {
                                "name": "rb0DashboardDescription"
                            },
                            {
                                "name": "rb0DashboardLocation"
                            },
                            {
                                "name": "rb0DashboardId"
                            },
                            {
                                "name": "rb0DashboardTemplatesList"
                            },
                            {
                                "name": "owning_user"
                            },
                            {
                                "name": "Fnd0Applicable_Assignment"
                            }
                        ]
                    } ]
                }
            },
            "outputData":{
                "ctx.dashboardObjects": "{{json:searchResultsJSON}}"
            }
        }
    },
    "data": {
        "dashboardLocation": ["Reports"]
    },
    "lifecycleHooks": {
        "onMount": "initialize"
    },
    "functions": {
        "getRelationsPathForDashboardTabsLoading":{
            "functionName": "getRelationsPathForDashboardTabsLoading",
            "parameters": ["{{data.dashboardLocation}}"],
            "deps": "js/showMyDashboardService"
        }
    }
}
