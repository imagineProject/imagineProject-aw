{
  "slots": {
    "CreateReportTemplateSubLocationPWACommandBarSlot": {
      "name": "aw_pwaCommandBar",
      "view": "CreateReportTemplateTaskbar",
      "activeWhen": {
        "condition": "conditions.isCreateReportTemplateSubLocation"
      }
    },
    "CreateReportTemplateSubLocationTitleSlot": {
      "name": "aw_headerTitle",
      "view": "CreateReportTemplateTitle",
      "activeWhen": {
        "condition": "conditions.isCreateReportTemplateSubLocation"
      }
    },
    "ReportDashboardSubLocationPWACommandBarSlot": {
      "name": "aw_pwaCommandBar",
      "view": "ShowMyDashboardImageTaskbar",
      "activeWhen": {
        "condition": "conditions.isReportDashboardSubLocation"
      }
    },
    "tcReportDashboardTile": {
      "name": "reportDashboardTile",
      "view": "DashboardReportTile",
      "activeWhen": {
        "condition": "conditions.isTcReportTile"
      }
    },
    "tcRAReportDashboardTile": {
      "name": "reportDashboardTile",
      "view": "DashboardTcraReportTile",
      "activeWhen": {
        "condition": "conditions.isTcRAReportTile"
      }
    }
  },
  "conditions": {
    "isCreateReportTemplateSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com.siemens.splm.reports:createReportTemplate'"
    },
    "isReportDashboardSubLocation": {
      "expression": "ctx.sublocation.nameToken === 'com.siemens.splm.reports:showMyDashboard' && ctx.ViewModeContext.ViewModeContext === 'ImageView'"
    },
    "isTcReportTile": {
      "expression": "context.selectedReport.props.rd_source.dbValues[0] === 'Active Workspace'"
    },
    "isTcRAReportTile": {
      "expression": "context.selectedReport.props.rd_source.dbValues[0] === 'TcRA'"
    }
  }
}
